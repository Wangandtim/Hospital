:host { display: block; }
.ui-pager {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 30rpx 0 18rpx;
  min-height: 64rpx;
}
.ui-pager-text { font-size: 24rpx; color: #8A938F; letter-spacing: 0.04em; }
.ui-pager-error { color: #A64842; }
.ui-pager-dots { display: flex; gap: 6rpx; }
.ui-pager-dot {
  width: 8rpx; height: 8rpx; border-radius: 50%;
  background: #A8874F;
  animation: ui-pager-blink 1s infinite;
}
.ui-pager-dot:nth-child(2) { animation-delay: 0.2s; }
.ui-pager-dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes ui-pager-blink {
  0%, 100% { opacity: 0.25; }
  50% { opacity: 1; }
}
.ui-pager-line { width: 56rpx; height: 1rpx; background: #E5E5DE; }
