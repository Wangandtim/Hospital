.admin-manage-page {
  padding-top: 24rpx;
}

.admin-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 0;
}

.admin-add {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--r-pill);
  background: var(--primary);
  color: #fff;
  font-size: 34rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.admin-search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 92rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  box-shadow: var(--shadow-1);
}

.admin-search-input {
  flex: 1;
  height: 84rpx;
  font-size: var(--fs-body);
  color: var(--ink);
}

.admin-row {
  min-height: 112rpx;
}

.admin-avatar {
  width: 80rpx;
  height: 80rpx;
  flex: none;
  border-radius: var(--r-pill);
  background: var(--tint-2);
  color: var(--primary);
  font-family: var(--font-serif);
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.admin-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 8rpx;
}

.admin-pager-info {
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.admin-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(23, 29, 27, 0.45);
}

.admin-modal-card {
  width: 630rpx;
  max-height: 82vh;
  overflow-y: auto;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  padding: 32rpx 32rpx 28rpx;
  box-shadow: var(--shadow-3);
}

.admin-modal-title {
  font-size: var(--fs-h2);
  color: var(--ink);
  margin-bottom: 12rpx;
}

.admin-kv {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.admin-kv-last {
  border-bottom: none;
  margin-top: 8rpx;
}

.admin-k {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  flex-shrink: 0;
}

.admin-v {
  font-size: var(--fs-caption);
  color: var(--ink);
  text-align: right;
  margin-left: 24rpx;
  word-break: break-all;
}

.admin-modal-field {
  margin-top: 22rpx;
  margin-bottom: 0;
}

.admin-field-input {
  flex: 1;
  height: 84rpx;
  font-size: var(--fs-body);
  color: var(--ink);
}

.admin-modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.admin-modal-actions .ui-btn {
  flex: 1;
}
