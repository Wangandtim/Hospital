<view class="ui-page admin-manage-page">
  <view class="admin-topbar">
    <view class="ui-back" bindtap="goBack" hover-class="hover-fade">←</view>
    <view class="admin-add" bindtap="goToAdd" hover-class="hover-fade">＋</view>
  </view>

  <view class="ui-title-block">
    <view class="ui-eyebrow ui-eyebrow-gold">ADMIN ROSTER</view>
    <view class="ui-title">管理员管理</view>
    <view class="ui-subtitle">共 {{adminList.length}} 位管理员</view>
  </view>

  <view class="admin-search">
    <input
      class="admin-search-input"
      placeholder="搜索用户名或姓名"
      placeholder-class="ui-input-ph"
      bindinput="onSearchInput"
      value="{{searchKeyword}}"
    />
    <view class="ui-chip" bindtap="showFilter" hover-class="hover-fade">筛选</view>
  </view>

  <view class="ui-panel admin-list-panel">
    <view class="ui-panel-body ui-panel-body-flush">
      <view class="ui-empty" wx:if="{{adminList.length === 0}}">
        <view class="ui-empty-mark">管</view>
        <view class="ui-empty-title">暂无管理员</view>
      </view>
      <view wx:else>
        <view
          class="ui-row admin-row"
          wx:for="{{adminList}}"
          wx:key="adminId"
          bindtap="goToDetail"
          data-admin-id="{{item.adminId}}"
          hover-class="hover-fade"
        >
          <view class="admin-avatar">{{item.avatarChar || '管'}}</view>
          <view class="ui-row-main">
            <view class="ui-row-title">{{item.realName}}</view>
            <view class="admin-meta">
              <text class="ui-caption">{{item.username}}</text>
              <view class="ui-tag">{{item.roleText}}</view>
            </view>
          </view>
          <view class="ui-state {{item.status === 1 ? 'ui-state-ok' : 'ui-state-full'}}">
            <i></i>
            {{item.status === 1 ? '正常' : '禁用'}}
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="ui-inline-pager" wx:if="{{totalPages > 1}}">
    <view class="ui-btn ui-btn-outline ui-btn-sm {{currentPage === 0 ? 'ui-btn-disabled' : ''}}" bindtap="onPrevPage" hover-class="hover-fade">上一页</view>
    <text class="admin-pager-info">第 {{currentPage + 1}} / {{totalPages}} 页</text>
    <view class="ui-btn ui-btn-outline ui-btn-sm {{currentPage === totalPages - 1 ? 'ui-btn-disabled' : ''}}" bindtap="onNextPage" hover-class="hover-fade">下一页</view>
  </view>

  <view class="admin-modal" wx:if="{{showModal}}" bindtap="closeModal">
    <view class="admin-modal-card" catchtap="noop">
      <view class="admin-modal-title ui-serif">管理员详情</view>

      <view class="admin-kv">
        <text class="admin-k">用户名</text>
        <text class="admin-v">{{form.username}}</text>
      </view>
      <view class="admin-kv">
        <text class="admin-k">角色</text>
        <text class="admin-v">{{form.roleText}}</text>
      </view>
      <view class="admin-kv" wx:if="{{form.hospitalId}}">
        <text class="admin-k">所属医院</text>
        <text class="admin-v">{{form.hospitalId}}</text>
      </view>
      <view class="admin-kv" wx:if="{{form.auditStatus === 0 || form.auditStatus === 1}}">
        <text class="admin-k">审核状态</text>
        <text class="admin-v">{{form.auditStatus === 1 ? '已通过' : '待审核'}}</text>
      </view>

      <view class="ui-field admin-modal-field">
        <view class="ui-field-label">真实姓名</view>
        <view class="ui-input">
          <input class="admin-field-input" value="{{form.realName}}" bindinput="onRealNameInput" placeholder="请输入真实姓名" placeholder-class="ui-input-ph" />
        </view>
      </view>
      <view class="ui-field admin-modal-field">
        <view class="ui-field-label">联系电话</view>
        <view class="ui-input">
          <input class="admin-field-input" value="{{form.phone}}" bindinput="onPhoneInput" placeholder="请输入联系电话" placeholder-class="ui-input-ph" />
        </view>
      </view>
      <view class="ui-field admin-modal-field">
        <view class="ui-field-label">重置密码</view>
        <view class="ui-input">
          <input class="admin-field-input" password value="{{form.password}}" bindinput="onPasswordInput" placeholder="留空则不修改" placeholder-class="ui-input-ph" />
        </view>
      </view>

      <view class="admin-kv admin-kv-last">
        <text class="admin-k">启用账号</text>
        <switch checked="{{form.status === 1}}" color="#0F5B50" bindchange="onStatusChange" />
      </view>

      <view class="admin-modal-actions">
        <view class="ui-btn ui-btn-danger ui-btn-sm" bindtap="deleteAdmin" hover-class="hover-fade">删除</view>
        <view class="ui-btn ui-btn-outline ui-btn-sm" bindtap="closeModal" hover-class="hover-fade">取消</view>
        <view class="ui-btn ui-btn-primary ui-btn-sm" bindtap="saveAdmin" hover-class="ui-btn-loading">{{saving ? '保存中...' : '保存'}}</view>
      </view>
    </view>
  </view>
</view>
