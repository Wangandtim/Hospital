<view class="ui-page admin-login-page">
  <view class="admin-topbar">
    <view class="ui-back" bindtap="goBack" hover-class="hover-fade">←</view>
  </view>

  <view class="admin-login-brand ui-rise">
    <view class="admin-login-crest">
      <image class="admin-login-crest-img" src="/assets/logo/logo-mark-reverse-64.png" mode="aspectFit" />
    </view>
    <view class="admin-login-word ui-serif">健康联防</view>
    <view class="admin-login-rule"></view>
    <view class="admin-login-sub">ADMIN CONSOLE · 管理端</view>
  </view>

  <view class="ui-title-block ui-rise">
    <view class="ui-eyebrow ui-eyebrow-gold">ADMIN ACCESS</view>
    <view class="ui-title">管理员登录</view>
  </view>

  <view class="ui-panel ui-rise">
    <view class="ui-panel-body">
      <view class="ui-field">
        <view class="ui-field-label">用户名</view>
        <view class="ui-input">
          <input
            class="admin-field-input"
            placeholder="请输入管理员用户名"
            placeholder-class="ui-input-ph"
            bindinput="onUsernameInput"
            bindconfirm="handleLogin"
            value="{{username}}"
          />
        </view>
      </view>

      <view class="ui-field">
        <view class="ui-field-label">密码</view>
        <view class="ui-input">
          <input
            class="admin-field-input"
            placeholder="请输入密码"
            placeholder-class="ui-input-ph"
            password="{{true}}"
            bindinput="onPasswordInput"
            bindconfirm="handleLogin"
            value="{{password}}"
          />
        </view>
      </view>

      <button class="ui-btn ui-btn-primary admin-login-submit" bindtap="handleLogin" hover-class="ui-btn-loading">登录</button>

      <view class="admin-login-link" bindtap="goToRegister" hover-class="hover-fade">注册管理员账号</view>
    </view>
  </view>
</view>
