.admin-login-page {
  padding-top: 24rpx;
}

.admin-topbar {
  display: flex;
  align-items: center;
  padding: 8rpx 0 0;
}

.admin-login-brand {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-top: 56rpx;
}

.admin-login-crest {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.admin-login-crest-img {
  width: 56rpx;
  height: 56rpx;
  display: block;
}

.admin-login-word {
  font-size: 44rpx;
  letter-spacing: 0.1em;
  color: var(--ink);
  line-height: 1.1;
}

.admin-login-rule {
  width: 40rpx;
  height: 3rpx;
  background: var(--gold);
  margin-top: 14rpx;
}

.admin-login-sub {
  font-size: var(--fs-micro);
  letter-spacing: 0.24em;
  color: var(--ink-3);
  margin-top: 12rpx;
}

.admin-field-input {
  flex: 1;
  height: 84rpx;
  font-size: var(--fs-h3);
  color: var(--ink);
}

.admin-login-submit {
  width: 100%;
  margin-top: 12rpx;
  letter-spacing: 0.08em;
}

.admin-login-link {
  margin-top: 28rpx;
  padding: 12rpx 0;
  text-align: center;
  font-size: var(--fs-caption);
  color: var(--primary);
}
