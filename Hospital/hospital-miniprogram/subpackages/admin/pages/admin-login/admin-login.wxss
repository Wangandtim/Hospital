.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #0d9488 0%, #08979c 100%);
}

.header {
  padding: 100rpx 40rpx 60rpx;
  display: flex;
  align-items: center;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.back-icon {
  font-size: 48rpx;
  color: white;
  font-weight: bold;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: white;
}

.form-section {
  background: white;
  margin: 0 40rpx;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.form-item {
  margin-bottom: 40rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #f0fdfa;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.btn-login {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #0d9488 0%, #08979c 100%);
  color: white;
  font-size: 36rpx;
  font-weight: bold;
  border-radius: 50rpx;
  margin-top: 40rpx;
  line-height: 100rpx;
  box-shadow: 0 4rpx 20rpx rgba(13, 148, 136, 0.4);
}

.btn-login::after {
  border: none;
}

.tips {
  text-align: center;
  margin-top: 40rpx;
}

.tips text {
  font-size: 24rpx;
  color: #999;
}
