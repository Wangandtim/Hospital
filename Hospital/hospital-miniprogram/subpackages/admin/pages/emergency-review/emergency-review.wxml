<view class="ui-page emergency-review-page">
  <view class="admin-topbar">
    <view class="ui-back" bindtap="goBack" hover-class="hover-fade">←</view>
  </view>

  <view class="ui-title-block">
    <view class="ui-eyebrow ui-eyebrow-gold">EMERGENCY REVIEW</view>
    <view class="ui-title">应急事项审核</view>
  </view>

  <view class="ui-panel review-panel">
    <view class="ui-panel-body">
      <view class="freeze-head">
        <view class="freeze-main">
          <view class="ui-panel-title">应急通道状态</view>
          <view class="freeze-hospital">{{hospitalName || '尚未选择医院'}}</view>
        </view>
        <view class="ui-btn ui-btn-outline ui-btn-sm" bindtap="openHospitalPicker" hover-class="hover-fade">选择医院</view>
      </view>

      <view class="freeze-status-row">
        <view class="ui-state {{lockInfo && lockInfo.locked ? 'ui-state-stop' : (lockInfo ? 'ui-state-ok' : 'ui-state-full')}}">
          <i></i>
          {{lockInfo ? (lockInfo.locked ? '已冻结' : '正常') : '加载中...'}}
        </view>
        <view class="ui-caption freeze-reason" wx:if="{{lockInfo && lockInfo.locked}}">{{lockInfo.lockReason || '未填写原因'}}</view>
      </view>

      <view class="ui-caption" wx:if="{{lockInfo && lockInfo.lockUntil}}">解冻时间：{{lockInfo.lockUntil}}</view>
      <view class="ui-caption" wx:if="{{lockInfo}}">今日应急写操作：{{lockInfo.todayWrites}} 次</view>

      <view class="freeze-actions">
        <view class="ui-btn ui-btn-danger ui-btn-sm" wx:if="{{hospitalId && (!lockInfo || !lockInfo.locked)}}" bindtap="freezeHospital" hover-class="hover-fade">冻结 24 小时</view>
        <view class="ui-btn ui-btn-outline ui-btn-sm" wx:if="{{lockInfo && lockInfo.locked}}" bindtap="unfreezeHospital" hover-class="hover-fade">解除冻结</view>
      </view>
    </view>
  </view>

  <view class="review-picker-mask" wx:if="{{pickerOpen}}" bindtap="closeHospitalPicker"></view>
  <view class="review-picker" wx:if="{{pickerOpen}}">
    <view class="review-picker-head">
      <view class="ui-panel-title">选择医院</view>
      <view class="review-picker-close" bindtap="closeHospitalPicker" hover-class="hover-fade">关闭</view>
    </view>

    <view class="review-region">
      <picker class="review-region-picker" range="{{provinces}}" value="{{provinceIndex}}" bindchange="bindProvinceChange">
        <view class="review-region-item">{{province || '省份'}}</view>
      </picker>
      <picker class="review-region-picker" range="{{cities}}" value="{{cityIndex}}" bindchange="bindCityChange" disabled="{{!province}}">
        <view class="review-region-item">{{city || '城市'}}</view>
      </picker>
      <picker class="review-region-picker" range="{{districts}}" value="{{districtIndex}}" bindchange="bindDistrictChange" disabled="{{!city}}">
        <view class="review-region-item">{{district || '区县'}}</view>
      </picker>
    </view>

    <view class="review-search">
      <view class="ui-input review-search-input">
        <input
          class="review-search-field"
          placeholder="搜索医院名称"
          placeholder-class="ui-input-ph"
          value="{{hospitalKeyword}}"
          bindinput="bindKeywordInput"
          confirm-type="search"
          bindconfirm="searchHospitals"
        />
      </view>
      <view class="ui-btn ui-btn-outline ui-btn-sm" bindtap="searchHospitals" hover-class="hover-fade">搜索</view>
    </view>

    <scroll-view class="review-hosp-list" scroll-y>
      <view
        class="ui-row review-hosp-row"
        wx:for="{{hospitalList}}"
        wx:key="hospitalId"
        data-id="{{item.hospitalId}}"
        data-name="{{item.hospitalName}}"
        bindtap="chooseHospital"
        hover-class="hover-fade"
      >
        <view class="ui-row-main">
          <view class="ui-row-title">{{item.hospitalName}}</view>
          <view class="ui-row-desc">{{item.address}}</view>
        </view>
        <view class="ui-chev">›</view>
      </view>
      <view class="ui-empty review-pick-empty" wx:if="{{hospitalList.length === 0}}">
        <view class="ui-empty-title">未找到医院</view>
      </view>
    </scroll-view>

    <view class="ui-pagebar">
      <button class="ui-btn ui-btn-outline ui-btn-sm ui-pagebar-btn {{hospitalPage <= 0 ? 'ui-btn-disabled' : ''}}" disabled="{{hospitalPage <= 0}}" bindtap="prevHospitalPage">上一页</button>
      <view class="ui-pagebar-info">{{hospitalPage + 1}} / {{hospitalTotalPages}} · 共 {{hospitalTotal}} 家</view>
      <button class="ui-btn ui-btn-outline ui-btn-sm ui-pagebar-btn {{hospitalPage + 1 >= hospitalTotalPages ? 'ui-btn-disabled' : ''}}" disabled="{{hospitalPage + 1 >= hospitalTotalPages}}" bindtap="nextHospitalPage">下一页</button>
    </view>
  </view>

  <view class="ui-panel review-panel" wx:if="{{supervisorPending.length > 0}}">
    <view class="ui-panel-head">
      <view class="ui-panel-title">待确认归档</view>
      <view class="ui-tag ui-tag-gold">{{supervisorPending.length}}</view>
    </view>
    <view class="ui-panel-body ui-panel-body-flush">
      <view class="review-item" wx:for="{{supervisorPending}}" wx:key="requestId">
        <view class="review-main">
          <view class="review-doctor">{{item.hospitalName}} · {{item.doctorName}} · {{item.doctorTitle}}</view>
          <view class="review-line">原因：{{item.reason}}</view>
          <view class="review-line">状态：{{item.statusText}}{{item.overdue ? '（已逾期）' : ''}}{{item.reportMissing ? '（待补交报告）' : ''}}</view>
          <view class="review-line" wx:if="{{item.reportScope}}">改动范围：{{item.reportScope}}</view>
          <view class="review-line" wx:if="{{item.reportImpact}}">影响预估：{{item.reportImpact}}</view>
        </view>
        <view class="review-actions">
          <view class="ui-btn ui-btn-outline ui-btn-sm" wx:if="{{item.certIdAvailable}}" data-request-id="{{item.requestId}}" data-type="idCard" bindtap="previewEmergencyCert" hover-class="hover-fade">身份证</view>
          <view class="ui-btn ui-btn-outline ui-btn-sm" wx:if="{{item.certLicenseAvailable}}" data-request-id="{{item.requestId}}" data-type="license" bindtap="previewEmergencyCert" hover-class="hover-fade">资格证</view>
          <view class="ui-btn ui-btn-primary ui-btn-sm" wx:if="{{!item.reportMissing}}" data-id="{{item.requestId}}" bindtap="confirmSupervisorRequest" hover-class="ui-btn-loading">确认归档</view>
          <view class="ui-btn ui-btn-danger ui-btn-sm" wx:if="{{!item.reportMissing}}" data-id="{{item.requestId}}" bindtap="rejectSupervisorRequest" hover-class="hover-fade">驳回异常</view>
        </view>
      </view>
    </view>
  </view>

  <view class="ui-panel review-panel" wx:else>
    <view class="ui-empty">
      <view class="ui-empty-mark">审</view>
      <view class="ui-empty-title">暂无待确认事项</view>
    </view>
  </view>
</view>
