.emergency-review-page {
  padding-top: 24rpx;
}

.admin-topbar {
  display: flex;
  align-items: center;
  padding: 8rpx 0 0;
}

.review-panel {
  margin-top: 20rpx;
}

.freeze-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.freeze-main {
  flex: 1;
  min-width: 0;
}

.freeze-hospital {
  margin-top: 6rpx;
  font-size: var(--fs-body);
  color: var(--ink);
  line-height: 1.4;
}

.freeze-status-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.freeze-reason {
  flex: 1;
  min-width: 0;
}

.freeze-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.review-item {
  min-height: 96rpx;
  padding: 24rpx 26rpx;
  border-top: 1rpx solid var(--line);
}

.review-item:first-child {
  border-top: none;
}

.review-main {
  min-width: 0;
}

.review-doctor {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
}

.review-line {
  margin-top: 6rpx;
  font-size: var(--fs-caption);
  color: var(--ink-2);
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}

.review-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.review-actions .ui-btn {
  min-width: 0;
  flex: 1;
}

.review-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(23, 29, 27, 0.45);
}

.review-picker {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  display: flex;
  flex-direction: column;
  max-height: 80vh;
  padding: 24rpx var(--gutter) calc(24rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  border-radius: var(--r-lg) var(--r-lg) 0 0;
  box-shadow: var(--shadow-3);
}

.review-picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid var(--line);
}

.review-picker-close {
  padding: 8rpx 4rpx;
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.review-region {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.review-region-picker {
  flex: 1;
  min-width: 0;
}

.review-region-item {
  height: 76rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-sm);
  background: var(--surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-micro);
  color: var(--ink-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.review-search {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 0;
}

.review-search-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
}

.review-search-field {
  flex: 1;
  height: 72rpx;
  font-size: var(--fs-body);
  color: var(--ink);
}

.review-hosp-list {
  height: 38vh;
}

.review-hosp-row {
  min-height: 96rpx;
  padding-left: 0;
  padding-right: 0;
}

.review-pick-empty {
  padding: 48rpx 0;
}

.review-pager {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 16rpx;
}

.review-pager-info {
  flex: 1;
  text-align: center;
  font-size: var(--fs-micro);
  color: var(--ink-3);
}
