page {
  background: #f0fdfa;
  min-height: 100vh;
}

.container {
  padding-bottom: 40rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  background: linear-gradient(135deg, #0d9488 0%, #0d9488 100%);
  color: white;
}

.back-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
}

.header-placeholder {
  width: 80rpx;
}

.review-body {
  padding: 30rpx;
}

.key-tip {
  font-size: 24rpx;
  color: #5b7c7a;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.guard-card {
  background: #ffffff;
  border: 1rpx solid #e2f2ef;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.supervisor-card {
  border: 1rpx solid #fde68a;
  background: #fffbeb;
}

.guard-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #143634;
  margin-bottom: 10rpx;
}

.supervisor-card .guard-title {
  color: #92400e;
}

.guard-text {
  font-size: 24rpx;
  color: #5b7c7a;
  line-height: 1.6;
}

.request-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-top: 1rpx solid #f1f5f9;
}

.request-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.request-doctor {
  font-size: 26rpx;
  font-weight: 600;
  color: #143634;
}

.request-reason {
  font-size: 24rpx;
  color: #5b7c7a;
  margin-top: 4rpx;
}

.request-time {
  font-size: 22rpx;
  color: #8aa5a2;
  margin-top: 4rpx;
}

.request-report {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #475569;
  line-height: 1.5;
  word-break: break-all;
  white-space: pre-wrap;
}

.request-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.request-actions-wrap {
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10rpx;
}

.snapshot-btn {
  margin-left: 20rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  color: #0f766e;
  background: #f0fdfa;
  border: 1rpx solid #ccfbf1;
  border-radius: 28rpx;
}

.snapshot-btn::after {
  border: none;
}

.request-reject {
  color: #b91c1c;
  background: #fef2f2;
  border-color: #fecaca;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #5b7c7a;
}

.freeze-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  margin: 12rpx 0;
  background: #f0fdfa;
  border: 1rpx solid #ccfbf1;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #143634;
}

.freeze-arrow {
  font-size: 24rpx;
  color: #5b7c7a;
}

.freeze-status {
  margin: 12rpx 0 6rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #0f766e;
}

.freeze-status.is-locked {
  color: #b91c1c;
}

.freeze-actions {
  margin-top: 16rpx;
  justify-content: flex-start;
}

.freeze-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.freeze-hospital-wrap {
  flex: 1;
  min-width: 0;
}

.freeze-hospital {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #143634;
}

.picker-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  background: rgba(15, 23, 42, 0.45);
}

.picker-panel {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 101;
  display: flex;
  flex-direction: column;
  max-height: 78vh;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
}

.picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #143634;
}

.picker-close {
  padding: 8rpx 12rpx;
  font-size: 26rpx;
  color: #5b7c7a;
}

.region-row {
  display: flex;
  gap: 12rpx;
}

.region-row picker {
  flex: 1;
}

.region-item {
  padding: 14rpx 16rpx;
  background: #f5f7fa;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #143634;
  text-align: center;
}

.search-row {
  display: flex;
  gap: 12rpx;
  margin: 16rpx 0;
}

.search-input {
  flex: 1;
  height: 68rpx;
  padding: 0 20rpx;
  background: #f5f7fa;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.hospital-pick-list {
  flex: 1;
  min-height: 280rpx;
  max-height: 46vh;
}

.hospital-pick-item {
  padding: 18rpx 8rpx;
  border-bottom: 1rpx solid #eef2f6;
}

.pick-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #143634;
}

.pick-addr {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #5b7c7a;
}

.pick-empty {
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #5b7c7a;
  text-align: center;
}

.pager-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 16rpx;
}

.pager-btn {
  flex: 0 0 auto;
  height: 60rpx;
  margin: 0;
  padding: 0 24rpx;
  font-size: 24rpx;
  line-height: 60rpx;
  color: #0d9488;
  background: #f5f7fa;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
}

.pager-btn::after {
  border: none;
}

.pager-btn[disabled] {
  color: #cbd5e1;
}

.pager-info {
  flex: 1;
  font-size: 22rpx;
  color: #5b7c7a;
  text-align: center;
}
