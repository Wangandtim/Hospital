<view class="ui-page admin-register-page">
  <view class="admin-topbar">
    <view class="ui-back" bindtap="goBack" hover-class="hover-fade">←</view>
  </view>

  <view class="ui-title-block">
    <view class="ui-eyebrow ui-eyebrow-gold">ADMIN REGISTER</view>
    <view class="ui-title">管理员注册</view>
    <view class="ui-subtitle">填写资料后提交审核</view>
  </view>

  <view class="ui-panel">
    <view class="ui-panel-body">
      <view class="ui-field">
        <view class="ui-field-label">用户名 *</view>
        <view class="ui-input">
          <input class="admin-field-input" placeholder="请输入用户名" placeholder-class="ui-input-ph" bindinput="onUsernameInput" value="{{form.username}}" />
        </view>
      </view>

      <view class="ui-field">
        <view class="ui-field-label">密码 *</view>
        <view class="ui-input">
          <input class="admin-field-input" placeholder="请输入密码" placeholder-class="ui-input-ph" password="{{true}}" bindinput="onPasswordInput" value="{{form.password}}" />
        </view>
      </view>

      <view class="ui-field">
        <view class="ui-field-label">确认密码 *</view>
        <view class="ui-input">
          <input class="admin-field-input" placeholder="请再次输入密码" placeholder-class="ui-input-ph" password="{{true}}" bindinput="onConfirmPasswordInput" value="{{form.confirmPassword}}" />
        </view>
      </view>

      <view class="ui-field">
        <view class="ui-field-label">真实姓名 *</view>
        <view class="ui-input">
          <input class="admin-field-input" placeholder="请输入真实姓名" placeholder-class="ui-input-ph" bindinput="onRealNameInput" value="{{form.realName}}" />
        </view>
      </view>

      <view class="ui-field">
        <view class="ui-field-label">联系电话</view>
        <view class="ui-input">
          <input class="admin-field-input" placeholder="请输入联系电话（选填）" placeholder-class="ui-input-ph" bindinput="onPhoneInput" value="{{form.phone}}" />
        </view>
      </view>

      <view class="ui-field" wx:if="{{hospitalList.length > 0}}">
        <view class="ui-field-label">所属医院 *</view>
        <picker mode="selector" range="{{hospitalNames}}" bindchange="onHospitalChange">
          <view class="ui-input admin-picker">
            <text class="admin-picker-text {{selectedHospitalName ? '' : 'admin-placeholder'}}">{{selectedHospitalName || '请选择医院'}}</text>
            <view class="ui-chev">›</view>
          </view>
        </picker>
      </view>

      <view class="ui-field">
        <view class="ui-field-label">身份证照片 *</view>
        <view class="admin-upload" bindtap="chooseIdCardImage" hover-class="hover-fade">
          <image wx:if="{{idCardImage}}" src="{{idCardImage}}" mode="aspectFit" class="admin-upload-img" />
          <view wx:else class="admin-upload-empty">
            <view class="admin-upload-mark">＋</view>
            <text class="admin-upload-text">点击上传身份证照片</text>
          </view>
        </view>
      </view>

      <view class="ui-field">
        <view class="ui-field-label">工作证照片 *</view>
        <view class="admin-upload" bindtap="chooseWorkCardImage" hover-class="hover-fade">
          <image wx:if="{{workCardImage}}" src="{{workCardImage}}" mode="aspectFit" class="admin-upload-img" />
          <view wx:else class="admin-upload-empty">
            <view class="admin-upload-mark">＋</view>
            <text class="admin-upload-text">点击上传工作证照片</text>
          </view>
        </view>
      </view>

      <button class="ui-btn ui-btn-primary admin-submit" bindtap="handleRegister" hover-class="ui-btn-loading">提交注册</button>
    </view>
  </view>

  <view class="admin-modal" wx:if="{{showSuccess}}">
    <view class="admin-mask"></view>
    <view class="admin-success">
      <view class="admin-success-mark">✓</view>
      <view class="admin-success-title ui-serif">提交成功</view>
      <view class="admin-success-desc">注册信息已提交，请等待管理员审核</view>
      <button class="ui-btn ui-btn-primary admin-success-btn" bindtap="goToLogin">返回登录</button>
    </view>
  </view>
</view>
