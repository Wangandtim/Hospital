<view class="container">
  <view class="header">
    <view class="back-btn" bindtap="goBack" hover-class="hover-scale">
      <image class="back-icon" src="/images/icons/ic-arrow-14b8a6.png" mode="aspectFit" />
    </view>
    <view class="title">管理员注册</view>
  </view>

  <view class="form-section">
    <view class="form-item">
      <view class="form-label">用户名 *</view>
      <input class="form-input" placeholder="请输入用户名" bindinput="onUsernameInput" value="{{form.username}}" />
    </view>

    <view class="form-item">
      <view class="form-label">密码 *</view>
      <input class="form-input" placeholder="请输入密码" password="{{true}}" bindinput="onPasswordInput" value="{{form.password}}" />
    </view>

    <view class="form-item">
      <view class="form-label">确认密码 *</view>
      <input class="form-input" placeholder="请再次输入密码" password="{{true}}" bindinput="onConfirmPasswordInput" value="{{form.confirmPassword}}" />
    </view>

    <view class="form-item">
      <view class="form-label">真实姓名 *</view>
      <input class="form-input" placeholder="请输入真实姓名" bindinput="onRealNameInput" value="{{form.realName}}" />
    </view>

    <view class="form-item">
      <view class="form-label">联系电话</view>
      <input class="form-input" placeholder="请输入联系电话（选填）" bindinput="onPhoneInput" value="{{form.phone}}" />
    </view>

    <view class="form-item" wx:if="hospitalList.length > 0">
      <view class="form-label">所属医院 *</view>
      <picker mode="selector" range="{{hospitalNames}}" bindchange="onHospitalChange">
        <view class="picker-view" hover-class="hover-fade">
          <text>{{selectedHospitalName || '请选择医院'}}</text>
          <image class="picker-arrow" src="/images/icons/ic-arrow-14b8a6.png" mode="aspectFit" />
        </view>
      </picker>
    </view>

    <view class="form-item">
      <view class="form-label">身份证照片 *</view>
      <view class="upload-area" bindtap="chooseIdCardImage" hover-class="hover-fade">
        <image wx:if="{{idCardImage}}" src="{{idCardImage}}" mode="aspectFit" class="uploaded-image" />
        <view wx:else class="upload-placeholder">
          <image class="upload-icon" src="/images/icons/ic-camera-14b8a6.png" mode="aspectFit" />
          <text class="upload-text">点击上传身份证照片</text>
        </view>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">工作证照片 *</view>
      <view class="upload-area" bindtap="chooseWorkCardImage" hover-class="hover-fade">
        <image wx:if="{{workCardImage}}" src="{{workCardImage}}" mode="aspectFit" class="uploaded-image" />
        <view wx:else class="upload-placeholder">
          <image class="upload-icon" src="/images/icons/ic-doc-14b8a6.png" mode="aspectFit" />
          <text class="upload-text">点击上传工作证照片</text>
        </view>
      </view>
    </view>

    <button class="btn-register" bindtap="handleRegister" hover-class="hover-scale">提交注册</button>
  </view>

  <view class="success-modal" wx:if="{{showSuccess}}">
    <view class="modal-mask"></view>
    <view class="success-content">
      <view class="success-icon">
        <image class="success-icon-img" src="/images/icons/ic-check-ffffff.png" mode="aspectFit" />
      </view>
      <view class="success-title">提交成功</view>
      <view class="success-desc">您的注册信息已提交，请等待审核</view>
      <view class="success-tips">审核结果将通过短信通知您</view>
      <button class="btn-confirm" bindtap="goToLogin" hover-class="hover-scale">返回登录</button>
    </view>
  </view>
</view>