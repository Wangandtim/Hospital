.admin-register-page {
  padding-top: 24rpx;
}

.admin-topbar {
  display: flex;
  align-items: center;
  padding: 8rpx 0 0;
}

.admin-field-input {
  flex: 1;
  height: 84rpx;
  font-size: var(--fs-body);
  color: var(--ink);
}

.admin-picker {
  justify-content: space-between;
}

.admin-picker-text {
  font-size: var(--fs-body);
  color: var(--ink);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.admin-placeholder {
  color: var(--ink-4);
}

.admin-upload {
  height: 220rpx;
  border: 1rpx dashed var(--line-strong);
  border-radius: var(--r-md);
  background: var(--surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.admin-upload-img {
  width: 100%;
  height: 100%;
  display: block;
}

.admin-upload-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.admin-upload-mark {
  width: 68rpx;
  height: 68rpx;
  border-radius: 16rpx;
  background: var(--tint-2);
  color: var(--primary);
  font-size: 34rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.admin-upload-text {
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.admin-submit {
  width: 100%;
  margin-top: 12rpx;
}

.admin-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.admin-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(23, 29, 27, 0.5);
}

.admin-success {
  position: relative;
  width: 580rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  padding: 64rpx 40rpx 48rpx;
  text-align: center;
  box-shadow: var(--shadow-3);
}

.admin-success-mark {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 28rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.admin-success-title {
  font-size: var(--fs-h2);
  color: var(--ink);
}

.admin-success-desc {
  margin-top: 12rpx;
  font-size: var(--fs-caption);
  color: var(--ink-2);
  line-height: 1.7;
}

.admin-success-btn {
  width: 100%;
  margin-top: 40rpx;
}
