.container {
  min-height: 100vh;
  background: #f5f7fa;
}

.header {
  padding: 100rpx 40rpx 60rpx;
  display: flex;
  align-items: center;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e6fffa;
  border-radius: 50%;
  box-shadow: 0 8rpx 20rpx rgba(13, 148, 136, 0.12);
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #143634;
}

.form-section {
  background: #ffffff;
  margin: 0 40rpx;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.form-item {
  margin-bottom: 40rpx;
}

.form-label {
  font-size: 28rpx;
  color: #143634;
  margin-bottom: 16rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
}

.form-label::before {
  content: '';
  width: 6rpx;
  height: 24rpx;
  background: #0d9488;
  border-radius: 3rpx;
  margin-right: 12rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #f0fdfa;
  border: 1rpx solid #e6fffa;
  border-radius: 22rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #143634;
  box-sizing: border-box;
}

.picker-view {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  background: #f0fdfa;
  border: 1rpx solid #e6fffa;
  border-radius: 22rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #143634;
}

.picker-arrow {
  width: 32rpx;
  height: 32rpx;
}

.upload-area {
  width: 100%;
  height: 220rpx;
  border: 2rpx dashed #ccfbf1;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0fdfa;
  transition: all 0.3s;
}

.upload-area:active {
  background: #e6fffa;
  border-color: #0d9488;
}

.uploaded-image {
  width: 100%;
  height: 100%;
  border-radius: 26rpx;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.upload-icon {
  width: 48rpx;
  height: 48rpx;
}

.upload-text {
  font-size: 28rpx;
  color: #5b7c7a;
}

.btn-register {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #0d9488 0%, #08979c 100%);
  color: white;
  font-size: 36rpx;
  font-weight: bold;
  border-radius: 999rpx;
  margin-top: 40rpx;
  line-height: 100rpx;
  box-shadow: 0 10rpx 24rpx rgba(13, 148, 136, 0.28);
}

.btn-register::after {
  border: none;
}

.btn-register:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.tips {
  text-align: center;
  margin-top: 30rpx;
}

.tips text {
  font-size: 24rpx;
  color: #5b7c7a;
}

.required-tag {
  color: #ef4444;
  margin-left: 6rpx;
  font-size: 24rpx;
}

.success-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.success-content {
  position: relative;
  width: 600rpx;
  background: #ffffff;
  border-radius: 36rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  border: 1rpx solid #e6fffa;
  box-shadow: 0 24rpx 56rpx rgba(13, 148, 136, 0.22);
}

.success-icon {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #0d9488 0%, #08979c 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 30rpx;
}

.success-icon-img {
  width: 48rpx;
  height: 48rpx;
}

.success-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #143634;
  margin-bottom: 20rpx;
}

.success-desc {
  font-size: 30rpx;
  color: #5b7c7a;
  margin-bottom: 15rpx;
  line-height: 1.6;
}

.success-tips {
  font-size: 26rpx;
  color: #94aeab;
  margin-bottom: 50rpx;
}

.btn-confirm {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #0d9488 0%, #08979c 100%);
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 999rpx;
  line-height: 96rpx;
  box-shadow: 0 10rpx 24rpx rgba(13, 148, 136, 0.28);
}

.btn-confirm::after {
  border: none;
}

.form-item:last-child {
  margin-bottom: 0;
}