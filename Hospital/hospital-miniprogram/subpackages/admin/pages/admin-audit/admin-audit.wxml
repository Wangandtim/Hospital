<view class="ui-page admin-audit-page">
  <view class="admin-topbar">
    <view class="ui-back" bindtap="goBack" hover-class="hover-fade">←</view>
  </view>

  <view class="ui-title-block">
    <view class="ui-eyebrow ui-eyebrow-gold">ADMIN REVIEW</view>
    <view class="ui-title">管理员审核</view>
  </view>

  <view class="ui-segmented admin-filter">
    <view class="ui-seg {{filter === 'pending' ? 'ui-seg-active' : ''}}" bindtap="setFilter" data-filter="pending" hover-class="hover-fade">
      待审核 ({{pendingCount}})
    </view>
    <view class="ui-seg {{filter === 'approved' ? 'ui-seg-active' : ''}}" bindtap="setFilter" data-filter="approved" hover-class="hover-fade">
      已通过
    </view>
    <view class="ui-seg {{filter === 'rejected' ? 'ui-seg-active' : ''}}" bindtap="setFilter" data-filter="rejected" hover-class="hover-fade">
      已拒绝
    </view>
  </view>

  <view class="admin-list" wx:if="{{auditList.length > 0}}">
    <view class="ui-panel admin-audit-card" wx:for="{{auditList}}" wx:key="adminId">
      <view class="admin-audit-head">
        <view class="admin-avatar">{{item.avatarChar || '管'}}</view>
        <view class="admin-audit-main">
          <view class="admin-audit-name">{{item.realName}}</view>
          <view class="ui-caption">用户名：{{item.username}}</view>
        </view>
        <view class="ui-pill ui-pill-wait" wx:if="{{item.auditStatus === 0}}">待审核</view>
        <view class="ui-pill ui-pill-done" wx:elif="{{item.auditStatus === 1}}">已通过</view>
        <view class="ui-pill ui-pill-pay" wx:elif="{{item.auditStatus === 2}}">已拒绝</view>
      </view>

      <view class="admin-audit-body">
        <view class="admin-kv">
          <text class="admin-k">联系电话</text>
          <text class="admin-v">{{item.phone || '未填写'}}</text>
        </view>
        <view class="admin-kv">
          <text class="admin-k">所属医院</text>
          <text class="admin-v">{{item.hospitalName || '未知医院'}}</text>
        </view>
        <view class="admin-kv">
          <text class="admin-k">申请时间</text>
          <text class="admin-v">{{item.createTime || '未知'}}</text>
        </view>
        <view class="admin-kv" wx:if="{{item.auditComment}}">
          <text class="admin-k">审核备注</text>
          <text class="admin-v">{{item.auditComment}}</text>
        </view>
      </view>

      <view class="admin-audit-foot" wx:if="{{item.auditStatus === 0}}">
        <view class="ui-btn ui-btn-danger ui-btn-sm admin-act" bindtap="rejectAdmin" data-admin="{{item}}" hover-class="hover-fade">拒绝</view>
        <view class="ui-btn ui-btn-primary ui-btn-sm admin-act" bindtap="approveAdmin" data-admin="{{item}}" hover-class="ui-btn-loading">通过</view>
      </view>
    </view>
  </view>

  <view class="ui-empty" wx:if="{{auditList.length === 0}}">
    <view class="ui-empty-mark">审</view>
    <view class="ui-empty-title">暂无{{filter === 'pending' ? '待审核' : (filter === 'approved' ? '已通过' : '已拒绝')}}的申请</view>
  </view>

  <view class="admin-modal" wx:if="{{showRejectModal}}">
    <view class="admin-mask" bindtap="closeRejectModal"></view>
    <view class="admin-dialog">
      <view class="admin-dialog-head">
        <view class="ui-panel-title">拒绝申请</view>
        <view class="admin-dialog-close" bindtap="closeRejectModal" hover-class="hover-fade">×</view>
      </view>
      <view class="admin-dialog-body">
        <view class="ui-field">
          <view class="ui-field-label">拒绝原因</view>
          <textarea class="ui-textarea" bindinput="onRejectReasonInput" value="{{rejectReason}}" placeholder="请输入拒绝原因" placeholder-class="ui-input-ph"></textarea>
        </view>
      </view>
      <view class="admin-dialog-foot">
        <button class="ui-btn ui-btn-outline ui-btn-sm admin-act" bindtap="closeRejectModal" hover-class="hover-fade">取消</button>
        <button class="ui-btn ui-btn-danger ui-btn-sm admin-act" bindtap="submitReject" hover-class="ui-btn-loading">确认拒绝</button>
      </view>
    </view>
  </view>
</view>
