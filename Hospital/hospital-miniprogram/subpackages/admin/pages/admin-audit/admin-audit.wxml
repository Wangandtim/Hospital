<view class="container">
  <view class="header">
    <view hover-class="hover-press" hover-stay-time="150" class="back-btn" bindtap="goBack">
      <text class="back-icon">←</text>
    </view>
    <view class="title">管理员审核</view>
  </view>

  <view class="filter-tabs">
    <view hover-class="hover-press" hover-stay-time="150" 
      class="tab-item {{filter === 'pending' ? 'active' : ''}}" 
      bindtap="setFilter" 
      data-filter="pending"
    >
      待审核 ({{pendingCount}})
    </view>
    <view hover-class="hover-press" hover-stay-time="150" 
      class="tab-item {{filter === 'approved' ? 'active' : ''}}" 
      bindtap="setFilter" 
      data-filter="approved"
    >
      已通过
    </view>
    <view hover-class="hover-press" hover-stay-time="150" 
      class="tab-item {{filter === 'rejected' ? 'active' : ''}}" 
      bindtap="setFilter" 
      data-filter="rejected"
    >
      已拒绝
    </view>
  </view>

  <view class="audit-list" wx:if="{{auditList.length > 0}}">
    <view class="audit-card" wx:for="{{auditList}}" wx:key="adminId">
      <view class="card-header">
        <view class="applicant-info">
          <view class="avatar">{{item.realName.charAt(0)}}</view>
          <view class="info">
            <view class="name">{{item.realName}}</view>
            <view class="meta">用户名：{{item.username}}</view>
          </view>
        </view>
        <view class="status-tag" wx:if="{{item.auditStatus === 0}}">待审核</view>
        <view class="status-tag approved" wx:elif="{{item.auditStatus === 1}}">已通过</view>
        <view class="status-tag rejected" wx:elif="{{item.auditStatus === 2}}">已拒绝</view>
      </view>
      
      <view class="card-body">
        <view class="detail-row">
          <text class="label">联系电话：</text>
          <text class="value">{{item.phone || '未填写'}}</text>
        </view>
        <view class="detail-row">
          <text class="label">所属医院：</text>
          <text class="value">{{item.hospitalName || '未知医院'}}</text>
        </view>
        <view class="detail-row">
          <text class="label">申请时间：</text>
          <text class="value">{{item.createTime || '未知'}}</text>
        </view>
        <view class="detail-row" wx:if="{{item.auditComment}}">
          <text class="label">审核备注：</text>
          <text class="value">{{item.auditComment}}</text>
        </view>
      </view>

      <view class="card-footer" wx:if="{{item.auditStatus === 0}}">
        <view hover-class="hover-press" hover-stay-time="150" class="btn-reject" bindtap="rejectAdmin" data-admin="{{item}}">拒绝</view>
        <view hover-class="hover-press" hover-stay-time="150" class="btn-approve" bindtap="approveAdmin" data-admin="{{item}}">通过</view>
      </view>
    </view>
  </view>

  <view class="empty-tip" wx:if="{{auditList.length === 0}}">
    <text>暂无{{filter === 'pending' ? '待审核' : (filter === 'approved' ? '已通过' : '已拒绝')}}的申请</text>
  </view>

  <view class="modal" wx:if="{{showRejectModal}}">
    <view hover-class="hover-press" hover-stay-time="150" class="modal-mask" bindtap="closeRejectModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text>拒绝申请</text>
        <view hover-class="hover-press" hover-stay-time="150" class="modal-close" bindtap="closeRejectModal">×</view>
      </view>
      <view class="modal-body">
        <view class="form-item">
          <view class="form-label">拒绝原因</view>
          <textarea class="form-textarea" bindinput="onRejectReasonInput" value="{{rejectReason}}" placeholder="请输入拒绝原因"></textarea>
        </view>
      </view>
      <view class="modal-footer">
        <button hover-class="hover-press" hover-stay-time="150" class="btn-cancel" bindtap="closeRejectModal">取消</button>
        <button hover-class="hover-press" hover-stay-time="150" class="btn-reject-submit" bindtap="submitReject">确认拒绝</button>
      </view>
    </view>
  </view>
</view>