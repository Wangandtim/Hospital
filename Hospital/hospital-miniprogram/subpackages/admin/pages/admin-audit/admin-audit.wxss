.container {
  min-height: 100vh;
  background: #f5f7fa;
}

.header {
  display: flex;
  align-items: center;
  padding: 80rpx 40rpx 30rpx;
  background: linear-gradient(135deg, #0d9488 0%, #08979c 100%);
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 48rpx;
  color: white;
  font-weight: bold;
}

.title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  color: white;
  margin-right: 60rpx;
}

.filter-tabs {
  display: flex;
  background: #fff;
  padding: 15rpx 40rpx;
  gap: 15rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 15rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 40rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background: linear-gradient(135deg, #0d9488, #08979c);
  color: #fff;
}

.audit-list {
  padding: 20rpx 40rpx;
}

.audit-card {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx;
  border-bottom: 1rpx solid #f4f7f6;
}

.applicant-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #0d9488, #08979c);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.info .name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.info .meta {
  font-size: 24rpx;
  color: #999;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 26rpx;
  background: #f0fdfa;
  color: #999;
}

.status-tag.approved {
  background: #f6ffed;
  color: #52c41a;
}

.status-tag.rejected {
  background: #fff2f0;
  color: #ff4d4f;
}

.card-body {
  padding: 20rpx 25rpx;
}

.detail-row {
  display: flex;
  padding: 12rpx 0;
}

.detail-row .label {
  font-size: 26rpx;
  color: #999;
  min-width: 140rpx;
}

.detail-row .value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
  word-break: break-all;
}

.card-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 25rpx;
  border-top: 1rpx solid #f4f7f6;
}

.btn-reject 
{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  text-align: center;
  padding: 18rpx;
  background: #fff1f0;
  color: #ff4d4f;
  font-size: 28rpx;
  border-radius: 16rpx;
}

.btn-approve 
{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  text-align: center;
  padding: 18rpx;
  background: linear-gradient(135deg, #0d9488, #08979c);
  color: #fff;
  font-size: 28rpx;
  border-radius: 16rpx;
}

.empty-tip {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.modal-content {
  width: 90%;
  max-width: 650rpx;
  background: #fff;
  border-radius: 32rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-header text {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.modal-body {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 25rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-textarea {
  width: 100%;
  height: 200rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx 35rpx;
}

.btn-cancel 
{
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 88rpx;
  background: #f0fdfa;
  color: #666;
  font-size: 30rpx;
  border-radius: 54rpx;
  border: none;
}

.btn-cancel::after {
  border: none;
}

.btn-reject-submit 
{
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 88rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 30rpx;
  border-radius: 54rpx;
  border: none;
}

.btn-reject-submit::after {
  border: none;
}