.admin-audit-page {
  padding-top: 24rpx;
}

.admin-topbar {
  display: flex;
  align-items: center;
  padding: 8rpx 0 0;
}

.admin-filter {
  margin-bottom: 24rpx;
}

.admin-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.admin-audit-card {
  margin-bottom: 0;
}

.admin-audit-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 26rpx 26rpx 20rpx;
  border-bottom: 1rpx solid var(--line);
}

.admin-avatar {
  width: 80rpx;
  height: 80rpx;
  flex: none;
  border-radius: var(--r-pill);
  background: var(--tint-2);
  color: var(--primary);
  font-family: var(--font-serif);
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.admin-audit-main {
  flex: 1;
  min-width: 0;
}

.admin-audit-name {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
  line-height: 1.35;
}

.admin-audit-body {
  padding: 12rpx 26rpx 16rpx;
}

.admin-kv {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.admin-kv:last-child {
  border-bottom: none;
}

.admin-k {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  flex-shrink: 0;
}

.admin-v {
  font-size: var(--fs-caption);
  color: var(--ink);
  text-align: right;
  margin-left: 24rpx;
  word-break: break-all;
}

.admin-audit-foot {
  display: flex;
  gap: 18rpx;
  padding: 20rpx 26rpx;
  border-top: 1rpx solid var(--line);
}

.admin-act {
  flex: 1;
}

.admin-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.admin-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(23, 29, 27, 0.5);
}

.admin-dialog {
  position: relative;
  width: 630rpx;
  max-height: 82vh;
  overflow-y: auto;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-3);
}

.admin-dialog-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx 20rpx;
  border-bottom: 1rpx solid var(--line);
}

.admin-dialog-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--ink-3);
  line-height: 1;
}

.admin-dialog-body {
  padding: 24rpx 28rpx;
}

.admin-dialog-foot {
  display: flex;
  gap: 18rpx;
  padding: 0 28rpx 28rpx;
}
