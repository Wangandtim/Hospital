.admin-page {
  padding-top: 8rpx;
}

.admin-page .ui-brand-word {
  max-width: 500rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.admin-page .ui-notice {
  margin-top: 20rpx;
}

.admin-stat {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 28rpx;
  padding: 32rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-1);
}

.admin-stat-main {
  flex: 1;
  min-width: 0;
}

.admin-stat-value {
  font-family: var(--font-serif);
  font-size: var(--fs-h1);
  line-height: 1.2;
  color: var(--primary);
}

.admin-stat-label {
  margin-top: 4rpx;
  font-size: var(--fs-micro);
  letter-spacing: 0.08em;
  color: var(--ink-3);
}

.admin-menu {
  margin-top: 28rpx;
}

.admin-row {
  min-height: 112rpx;
}

.admin-row .ui-row-title {
  font-size: var(--fs-h3);
}
