.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 30rpx;
}

.header {
  background: linear-gradient(135deg, #0d9488 0%, #08979c 100%);
  padding: 40rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 10rpx 24rpx rgba(13, 148, 136, 0.22);
}

.header-left {
  flex: 1;
}

.hospital-name {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 8rpx;
}

.admin-role {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.logout-btn 
{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  color: white;
  font-size: 26rpx;
  padding: 15rpx 30rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
}

.stats-section {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
}

.stat-card {
  flex: 1;
  background: white;
  border-radius: 20rpx;
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.stat-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 15rpx;
  background: #f0fdfa;
  border-radius: 50%;
}

.stat-icon-img {
  width: 40rpx;
  height: 40rpx;
}

.stat-info {
  text-align: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #0f766e;
  margin-bottom: 5rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #5b7c7a;
}

.menu-section {
  padding: 0 30rpx;
  margin-bottom: 30rpx;
}

.menu-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #143634;
  margin-bottom: 20rpx;
}

.menu-card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
  position: relative;
}

.menu-icon-bg {
  width: 80rpx;
  height: 80rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 25rpx;
  background: #f0fdfa;
  border: 1rpx solid #e6fffa;
}

.bg-blue {
  background: #f0fdfa;
}

.bg-green {
  background: #f0fdfa;
}

.bg-orange {
  background: #fffbeb;
  border-color: #fef3c7;
}

.bg-purple {
  background: #f0fdfa;
}

.menu-icon {
  width: 40rpx;
  height: 40rpx;
}

.menu-content {
  flex: 1;
}

.menu-title-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #143634;
  margin-bottom: 5rpx;
}

.menu-desc {
  font-size: 24rpx;
  color: #5b7c7a;
}

.menu-arrow {
  width: 24rpx;
  height: 24rpx;
}

.audit-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #ef4444;
  color: white;
  font-size: 22rpx;
  padding: 5rpx 15rpx;
  border-radius: 999rpx;
  margin-right: 30rpx;
}

.quick-section {
  padding: 0 30rpx;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #143634;
  margin-bottom: 20rpx;
}

.quick-grid {
  display: flex;
  gap: 20rpx;
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 15rpx;
  background: #f0fdfa;
  border: 1rpx solid #e6fffa;
  border-radius: 26rpx;
}

.quick-icon-img {
  width: 40rpx;
  height: 40rpx;
}

.quick-label {
  font-size: 24rpx;
  color: #5b7c7a;
}

.info-section {
  margin: 0 30rpx;
  padding: 30rpx;
}

.card {
  background: white;
  border-radius: 20rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.info-item {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0fdfa;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #5b7c7a;
}

.info-value {
  font-size: 26rpx;
  color: #143634;
  text-align: right;
  flex: 1;
  margin-left: 30rpx;
}