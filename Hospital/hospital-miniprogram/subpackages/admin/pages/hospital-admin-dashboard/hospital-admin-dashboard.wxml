<view class="ui-page hospital-admin-page">
  <view class="ui-head">
    <view class="ui-brand">
      <view class="ui-brand-word hosp-brand-word">{{hospitalName}}</view>
      <view class="ui-brand-rule"></view>
      <view class="ui-brand-sub">HOSPITAL ADMIN</view>
    </view>
    <view class="ui-icon-btn" bindtap="handleLogout" hover-class="hover-fade">退出</view>
  </view>

  <view class="stat-grid">
    <view class="stat-card">
      <view class="ui-plate"><image class="ui-plate-img" src="/images/ui-icons/department.svg" mode="aspectFit" /></view>
      <view class="stat-value ui-num">{{deptCount}}</view>
      <view class="stat-label">科室总数</view>
    </view>
    <view class="stat-card">
      <view class="ui-plate"><image class="ui-plate-img" src="/images/ui-icons/doctor.svg" mode="aspectFit" /></view>
      <view class="stat-value ui-num">{{doctorCount}}</view>
      <view class="stat-label">医生总数</view>
    </view>
    <view class="stat-card">
      <view class="ui-plate"><image class="ui-plate-img" src="/images/ui-icons/schedule.svg" mode="aspectFit" /></view>
      <view class="stat-value ui-num">{{scheduleCount}}</view>
      <view class="stat-label">今日排班</view>
    </view>
  </view>

  <view class="ui-panel hosp-panel">
    <view class="ui-panel-head">
      <view class="ui-panel-title">管理功能</view>
      <view class="ui-micro">MANAGE</view>
    </view>
    <view class="ui-panel-body ui-panel-body-flush">
      <view class="ui-row hosp-row" bindtap="goToDeptManagement" hover-class="hover-fade">
        <view class="ui-plate"><image class="ui-plate-img" src="/images/ui-icons/department.svg" mode="aspectFit" /></view>
        <view class="ui-row-main"><view class="ui-row-title">科室管理</view></view>
        <view class="ui-chev">›</view>
      </view>
      <view class="ui-row hosp-row" bindtap="goToDoctorManagement" hover-class="hover-fade">
        <view class="ui-plate"><image class="ui-plate-img" src="/images/ui-icons/doctor.svg" mode="aspectFit" /></view>
        <view class="ui-row-main"><view class="ui-row-title">医生管理</view></view>
        <view class="ui-chev">›</view>
      </view>
      <view class="ui-row hosp-row" bindtap="goToScheduleManagement" hover-class="hover-fade">
        <view class="ui-plate"><image class="ui-plate-img" src="/images/ui-icons/schedule.svg" mode="aspectFit" /></view>
        <view class="ui-row-main"><view class="ui-row-title">排班管理</view></view>
        <view class="ui-chev">›</view>
      </view>
      <view class="ui-row hosp-row" bindtap="goToArticleManage" hover-class="hover-fade">
        <view class="ui-plate"><image class="ui-plate-img" src="/images/ui-icons/report.svg" mode="aspectFit" /></view>
        <view class="ui-row-main"><view class="ui-row-title">内容管理</view></view>
        <view class="ui-chev">›</view>
      </view>
      <view class="ui-row hosp-row" bindtap="goToDoctorAudit" hover-class="hover-fade">
        <view class="ui-plate"><image class="ui-plate-img" src="/images/ui-icons/clipboard.svg" mode="aspectFit" /></view>
        <view class="ui-row-main"><view class="ui-row-title">医生审核</view></view>
        <view class="ui-tag ui-tag-gold" wx:if="{{auditCount > 0}}">{{auditCount}}</view>
        <view class="ui-chev">›</view>
      </view>
    </view>
  </view>

  <view class="ui-panel hosp-panel">
    <view class="ui-panel-head">
      <view class="ui-panel-title">快捷操作</view>
      <view class="ui-micro">QUICK</view>
    </view>
    <view class="ui-panel-body">
      <view class="ui-quick-grid">
        <view class="ui-quick" bindtap="goToAddDept" hover-class="hover-fade">
          <view class="ui-quick-ico"><image class="ui-quick-ico-img" src="/images/ui-icons/plus.svg" mode="aspectFit" /></view>
          <view class="ui-quick-label">新增科室</view>
        </view>
        <view class="ui-quick" bindtap="goToViewDoctors" hover-class="hover-fade">
          <view class="ui-quick-ico"><image class="ui-quick-ico-img" src="/images/ui-icons/doctor.svg" mode="aspectFit" /></view>
          <view class="ui-quick-label">查看医生</view>
        </view>
        <view class="ui-quick" bindtap="goToViewSchedule" hover-class="hover-fade">
          <view class="ui-quick-ico"><image class="ui-quick-ico-img" src="/images/ui-icons/schedule.svg" mode="aspectFit" /></view>
          <view class="ui-quick-label">今日排班</view>
        </view>
        <view class="ui-quick ui-quick-gold" bindtap="goToBatchImport" hover-class="hover-fade">
          <view class="ui-quick-ico"><image class="ui-quick-ico-img" src="/images/ui-icons/navigation.svg" mode="aspectFit" /></view>
          <view class="ui-quick-label">批量导入医生</view>
        </view>
      </view>
    </view>
  </view>

  <view class="ui-panel hosp-panel">
    <view class="ui-panel-head">
      <view class="ui-panel-title">医院信息</view>
      <view class="ui-micro">PROFILE</view>
    </view>
    <view class="ui-panel-body ui-panel-body-flush">
      <view class="ui-row hosp-row">
        <view class="ui-row-label">医院名称</view>
        <view class="ui-row-main"><view class="ui-row-val">{{hospitalName}}</view></view>
      </view>
      <view class="ui-row hosp-row">
        <view class="ui-row-label">医院等级</view>
        <view class="ui-row-main"><view class="ui-row-val">{{hospitalLevel}}</view></view>
      </view>
      <view class="ui-row hosp-row">
        <view class="ui-row-label">联系电话</view>
        <view class="ui-row-main"><view class="ui-row-val">{{hospitalPhone}}</view></view>
      </view>
      <view class="ui-row hosp-row">
        <view class="ui-row-label">医院地址</view>
        <view class="ui-row-main"><view class="ui-row-val">{{hospitalAddress}}</view></view>
      </view>
    </view>
  </view>
</view>
