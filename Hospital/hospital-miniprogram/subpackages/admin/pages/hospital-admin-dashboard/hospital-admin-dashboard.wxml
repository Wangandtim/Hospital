<view class="container">
  <!-- 顶部信息栏 -->
  <view class="header">
    <view class="header-left">
      <view class="hospital-name">{{hospitalName}}</view>
      <view class="admin-role">医院管理员</view>
    </view>
    <view class="logout-btn" bindtap="handleLogout" hover-class="hover-fade">退出</view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-section">
    <view class="stat-card">
      <view class="stat-icon">
        <image class="stat-icon-img" src="/images/icons/ic-hospital-14b8a6.png" mode="aspectFit" />
      </view>
      <view class="stat-info">
        <view class="stat-value">{{deptCount}}</view>
        <view class="stat-label">科室总数</view>
      </view>
    </view>
    <view class="stat-card">
      <view class="stat-icon">
        <image class="stat-icon-img" src="/images/icons/ic-doctor-14b8a6.png" mode="aspectFit" />
      </view>
      <view class="stat-info">
        <view class="stat-value">{{doctorCount}}</view>
        <view class="stat-label">医生总数</view>
      </view>
    </view>
    <view class="stat-card">
      <view class="stat-icon">
        <image class="stat-icon-img" src="/images/icons/ic-calendar-14b8a6.png" mode="aspectFit" />
      </view>
      <view class="stat-info">
        <view class="stat-value">{{scheduleCount}}</view>
        <view class="stat-label">今日排班</view>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-title">管理功能</view>
    
    <view class="menu-card" bindtap="goToDeptManagement" hover-class="hover-scale">
      <view class="menu-icon-bg bg-blue">
        <image class="menu-icon" src="/images/icons/ic-grid-14b8a6.png" mode="aspectFit" />
      </view>
      <view class="menu-content">
        <view class="menu-title-text">科室管理</view>
        <view class="menu-desc">管理医院科室信息</view>
      </view>
      <image class="menu-arrow" src="/images/icons/ic-arrow-14b8a6.png" mode="aspectFit" />
    </view>

    <view class="menu-card" bindtap="goToDoctorManagement" hover-class="hover-scale">
      <view class="menu-icon-bg bg-green">
        <image class="menu-icon" src="/images/icons/ic-doctor-14b8a6.png" mode="aspectFit" />
      </view>
      <view class="menu-content">
        <view class="menu-title-text">医生管理</view>
        <view class="menu-desc">查看医院医生信息</view>
      </view>
      <image class="menu-arrow" src="/images/icons/ic-arrow-14b8a6.png" mode="aspectFit" />
    </view>

    <view class="menu-card" bindtap="goToScheduleManagement" hover-class="hover-scale">
      <view class="menu-icon-bg bg-orange">
        <image class="menu-icon" src="/images/icons/ic-calendar-14b8a6.png" mode="aspectFit" />
      </view>
      <view class="menu-content">
        <view class="menu-title-text">排班管理</view>
        <view class="menu-desc">查看医生排班信息</view>
      </view>
      <image class="menu-arrow" src="/images/icons/ic-arrow-14b8a6.png" mode="aspectFit" />
    </view>

    <view class="menu-card" bindtap="goToArticleManage" hover-class="hover-scale">
      <view class="menu-icon-bg bg-cyan">
        <image class="menu-icon" src="/images/icons/ic-doc-14b8a6.png" mode="aspectFit" />
      </view>
      <view class="menu-content">
        <view class="menu-title-text">内容管理</view>
        <view class="menu-desc">发布文章、推文与通知到患者首页</view>
      </view>
      <image class="menu-arrow" src="/images/icons/ic-arrow-14b8a6.png" mode="aspectFit" />
    </view>

    <view class="menu-card" bindtap="goToDoctorAudit" hover-class="hover-scale">
      <view class="menu-icon-bg bg-purple">
        <image class="menu-icon" src="/images/icons/ic-check-14b8a6.png" mode="aspectFit" />
      </view>
      <view class="menu-content">
        <view class="menu-title-text">医生审核</view>
        <view class="menu-desc">审核医生注册申请</view>
      </view>
      <image class="menu-arrow" src="/images/icons/ic-arrow-14b8a6.png" mode="aspectFit" />
      <view class="audit-badge" wx:if="{{auditCount > 0}}">{{auditCount}}</view>
    </view>
  </view>

  <!-- 快捷操作 -->
  <view class="quick-section">
    <view class="section-title">快捷操作</view>
    <view class="quick-grid">
      <view class="quick-item" bindtap="goToAddDept" hover-class="hover-scale">
        <view class="quick-icon">
          <image class="quick-icon-img" src="/images/icons/ic-check-14b8a6.png" mode="aspectFit" />
        </view>
        <view class="quick-label">新增科室</view>
      </view>
      <view class="quick-item" bindtap="goToViewDoctors" hover-class="hover-scale">
        <view class="quick-icon">
          <image class="quick-icon-img" src="/images/icons/ic-scan-14b8a6.png" mode="aspectFit" />
        </view>
        <view class="quick-label">查看医生</view>
      </view>
      <view class="quick-item" bindtap="goToViewSchedule" hover-class="hover-scale">
        <view class="quick-icon">
          <image class="quick-icon-img" src="/images/icons/ic-calendar-14b8a6.png" mode="aspectFit" />
        </view>
        <view class="quick-label">今日排班</view>
      </view>
      <view class="quick-item" bindtap="goToBatchImport" hover-class="hover-scale">
        <view class="quick-icon">
          <image class="quick-icon-img" src="/images/icons/ic-doc-14b8a6.png" mode="aspectFit" />
        </view>
        <view class="quick-label">批量导入医生</view>
      </view>
    </view>
  </view>

  <!-- 医院信息 -->
  <view class="info-section card">
    <view class="section-title">医院信息</view>
    <view class="info-item">
      <view class="info-label">医院名称</view>
      <view class="info-value">{{hospitalName}}</view>
    </view>
    <view class="info-item">
      <view class="info-label">医院等级</view>
      <view class="info-value">{{hospitalLevel}}</view>
    </view>
    <view class="info-item">
      <view class="info-label">联系电话</view>
      <view class="info-value">{{hospitalPhone}}</view>
    </view>
    <view class="info-item">
      <view class="info-label">医院地址</view>
      <view class="info-value">{{hospitalAddress}}</view>
    </view>
  </view>
</view>