.intro-edit-page {
  padding-top: 16rpx;
  padding-bottom: 160rpx;
}

.intro-edit-head {
  display: flex;
  align-items: center;
  padding: 24rpx 0 8rpx;
}

.intro-edit-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--ink);
}

.intro-edit-title {
  margin-left: 12rpx;
  font-family: var(--font-serif);
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--ink);
}

.intro-edit-form {
  margin-top: 24rpx;
}

.intro-edit-fee {
  flex: 1;
  height: 96rpx;
  font-size: var(--fs-h3);
  color: var(--ink);
}

.intro-edit-submit {
  margin-top: 40rpx;
}

.intro-photo-card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  padding: 24rpx 26rpx;
  margin-bottom: 24rpx;
}
.intro-photo-label { font-size: var(--fs-caption); color: var(--ink-2); }
.intro-photo-row { display: flex; align-items: center; gap: 24rpx; margin-top: 16rpx; }
.intro-photo {
  width: 136rpx; height: 136rpx; border-radius: var(--r-md);
  background: var(--surface-2); border: 1rpx solid var(--line);
  overflow: hidden; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
}
.intro-photo-img { width: 100%; height: 100%; display: block; }
.intro-photo-empty { font-size: 48rpx; color: var(--ink-4); line-height: 1; }
.intro-photo-actions { flex: 1; display: flex; flex-direction: column; align-items: flex-start; gap: 12rpx; }
.intro-photo-remove { font-size: var(--fs-micro); color: var(--danger); }

.intro-cert-section { margin-top: 36rpx; }
.intro-cert-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 16rpx; }
.intro-cert-add {
  font-size: var(--fs-caption);
  color: var(--primary);
  border: 1rpx solid var(--line);
  border-radius: var(--r-pill);
  padding: 8rpx 24rpx;
}
.intro-cert-list { border: 1rpx solid var(--line); border-radius: var(--r-lg); overflow: hidden; background: var(--surface); }
.intro-cert-item { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 20rpx; }
.intro-cert-item + .intro-cert-item { border-top: 1rpx solid var(--line); }
.intro-cert-thumb {
  width: 88rpx; height: 88rpx; flex-shrink: 0;
  border-radius: var(--r-sm); overflow: hidden;
  background: var(--surface-2); border: 1rpx solid var(--line);
  display: flex; align-items: center; justify-content: center;
}
.intro-cert-thumb-img { width: 100%; height: 100%; display: block; }
.intro-cert-thumb-empty { font-size: var(--fs-micro); color: var(--ink-3); }
.intro-cert-main { flex: 1; min-width: 0; }
.intro-cert-title { font-size: var(--fs-body); color: var(--ink); font-weight: 600; }
.intro-cert-meta { font-size: var(--fs-micro); color: var(--ink-3); margin-top: 4rpx; }
.intro-cert-ops { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8rpx; width: 200rpx; flex-shrink: 0; }
.intro-cert-op {
  min-width: 48rpx; height: 44rpx; padding: 0 10rpx;
  border: 1rpx solid var(--line); border-radius: 6rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: var(--fs-micro); color: var(--ink-2);
}
.intro-cert-op.off { opacity: .3; }
.intro-cert-op.danger { color: var(--danger); border-color: #EAD2CE; }
.intro-cert-empty {
  padding: 40rpx 0; text-align: center;
  font-size: var(--fs-caption); color: var(--ink-3);
  border: 1rpx dashed var(--line-strong); border-radius: var(--r-lg);
}
.intro-cert-form {
  margin-top: 20rpx; padding: 24rpx;
  background: var(--surface); border: 1rpx solid var(--line); border-radius: var(--r-lg);
}
.intro-cert-date { flex: 1; font-size: var(--fs-h3); color: var(--ink); }
.intro-cert-image-row { display: flex; align-items: center; gap: 20rpx; margin-top: 8rpx; }
.intro-cert-image {
  width: 136rpx; height: 96rpx; flex-shrink: 0;
  border-radius: var(--r-sm); overflow: hidden;
  background: var(--surface-2); border: 1rpx solid var(--line);
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; color: var(--ink-4);
}
.intro-cert-image-hint { font-size: var(--fs-caption); color: var(--primary); }
.intro-cert-form-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 24rpx; }

