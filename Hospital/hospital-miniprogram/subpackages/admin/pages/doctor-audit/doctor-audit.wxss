.container {
  min-height: 100vh;
  background: #f5f7fa;
}

.header {
  display: flex;
  align-items: center;
  padding: 80rpx 40rpx 30rpx;
  background: linear-gradient(135deg, #0d9488 0%, #08979c 100%);
  box-shadow: 0 10rpx 24rpx rgba(13, 148, 136, 0.22);
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  color: white;
  margin-right: 60rpx;
}

.filter-tabs {
  display: flex;
  background: #fff;
  padding: 15rpx 40rpx;
  gap: 15rpx;
  border-bottom: 1rpx solid #e6fffa;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 15rpx;
  font-size: 28rpx;
  color: #5b7c7a;
  border-radius: 999rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background: #0d9488;
  color: #fff;
  font-weight: 600;
}

.audit-list {
  padding: 24rpx 30rpx;
}

.audit-card {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx;
  border-bottom: 1rpx solid #f0fdfa;
}

.applicant-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #0d9488, #08979c);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.avatar-icon {
  width: 36rpx;
  height: 36rpx;
}

.info .name {
  font-size: 32rpx;
  font-weight: bold;
  color: #143634;
  margin-bottom: 8rpx;
}

.info .meta {
  font-size: 24rpx;
  color: #0f766e;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #f0fdfa;
  color: #5b7c7a;
}

.status-tag.approved {
  background: #e6fffa;
  color: #0f766e;
}

.status-tag.rejected {
  background: #fef2f2;
  color: #ef4444;
}

.card-body {
  padding: 20rpx 25rpx;
}

.detail-row {
  display: flex;
  padding: 12rpx 0;
}

.detail-row .label {
  font-size: 26rpx;
  color: #5b7c7a;
  min-width: 160rpx;
}

.detail-row .value {
  font-size: 26rpx;
  color: #143634;
  flex: 1;
  word-break: break-all;
}

.card-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 26rpx 26rpx;
  border-top: 1rpx solid #f0fdfa;
}

.btn-reject 
{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  text-align: center;
  padding: 18rpx;
  background: #fef2f2;
  color: #ef4444;
  font-size: 28rpx;
  border-radius: 999rpx;
}

.btn-approve 
{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  text-align: center;
  padding: 18rpx;
  background: #0d9488;
  color: #fff;
  font-size: 28rpx;
  border-radius: 999rpx;
}

.empty-tip {
  text-align: center;
  padding: 100rpx 0;
  color: #5b7c7a;
  font-size: 28rpx;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.modal-content {
  width: 90%;
  max-width: 650rpx;
  background: #fff;
  border-radius: 36rpx;
  overflow: hidden;
  border: 1rpx solid #e6fffa;
  box-shadow: 0 24rpx 56rpx rgba(13, 148, 136, 0.22);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0fdfa;
}

.modal-header text {
  font-size: 34rpx;
  font-weight: bold;
  color: #143634;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-close-icon {
  width: 28rpx;
  height: 28rpx;
}

.modal-body {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 25rpx;
}

.form-label {
  font-size: 28rpx;
  color: #5b7c7a;
  margin-bottom: 12rpx;
}

.form-textarea {
  width: 100%;
  height: 200rpx;
  border: 1rpx solid #e6fffa;
  border-radius: 22rpx;
  padding: 20rpx;
  font-size: 30rpx;
  background: #f0fdfa;
  color: #143634;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx 35rpx;
}

.btn-cancel 
{
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 88rpx;
  background: #f0fdfa;
  color: #0f766e;
  font-size: 30rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e6fffa;
}

.btn-cancel::after {
  border: none;
}

.btn-reject-submit 
{
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 88rpx;
  background: #ef4444;
  color: #fff;
  font-size: 30rpx;
  border-radius: 999rpx;
  border: none;
}

.btn-reject-submit::after {
  border: none;
}