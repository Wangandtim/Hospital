<view class="ui-page emergency-login-page">
  <view class="admin-topbar">
    <view class="ui-back" bindtap="goBack" hover-class="hover-fade">←</view>
  </view>

  <view class="ui-title-block emergency-title">
    <view class="emergency-crest">急</view>
    <view class="ui-eyebrow ui-eyebrow-gold">EMERGENCY ACCESS</view>
    <view class="ui-title">应急管理员登录</view>
  </view>

  <view class="ui-panel">
    <view class="ui-panel-body">
      <view class="ui-field">
        <view class="ui-field-label">选择医院</view>
        <view class="ui-input emergency-select" bindtap="showHospitalPicker" hover-class="hover-fade">
          <text class="emergency-select-text {{selectedHospitalName ? '' : 'ui-input-ph'}}">{{selectedHospitalName || '请选择医院'}}</text>
          <view class="ui-chev">›</view>
        </view>
      </view>

      <view class="ui-field">
        <view class="ui-field-label">当日管理密钥</view>
        <view class="ui-input">
          <input
            class="emergency-field-input"
            placeholder="当日密钥或常设应急码"
            placeholder-class="ui-input-ph"
            password="{{true}}"
            bindinput="onKeyInput"
            bindconfirm="handleLogin"
            value="{{dailyKey}}"
          />
        </view>
      </view>

      <button class="ui-btn ui-btn-primary emergency-submit" bindtap="handleLogin" hover-class="ui-btn-loading">确认登录</button>
    </view>
  </view>

  <view class="emergency-picker" wx:if="{{showPicker}}" bindtap="hidePicker">
    <view class="emergency-mask"></view>
    <view class="emergency-sheet" catchtap="stopPropagation">
      <view class="emergency-sheet-head">
        <view class="ui-panel-title">选择医院</view>
        <view class="emergency-sheet-close" bindtap="hidePicker" hover-class="hover-fade">关闭</view>
      </view>

      <view class="ui-input emergency-search">
        <input
          class="emergency-search-input"
          placeholder="搜索医院名称"
          placeholder-class="ui-input-ph"
          bindinput="onHospitalSearch"
          value="{{searchKeyword}}"
        />
      </view>

      <scroll-view scroll-y class="emergency-hosp-list">
        <view
          class="ui-row emergency-hosp-row"
          wx:for="{{filteredHospitals}}"
          wx:key="hospitalId"
          bindtap="selectHospital"
          data-hospital-id="{{item.hospitalId}}"
          data-hospital-name="{{item.hospitalName}}"
          hover-class="hover-fade"
        >
          <view class="ui-row-main">
            <view class="ui-row-title">{{item.hospitalName}}</view>
            <view class="ui-row-desc">{{item.address || ''}}</view>
          </view>
          <view class="ui-chev">›</view>
        </view>
        <view class="ui-empty" wx:if="{{filteredHospitals.length === 0}}">
          <view class="ui-empty-title">未找到匹配的医院</view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
