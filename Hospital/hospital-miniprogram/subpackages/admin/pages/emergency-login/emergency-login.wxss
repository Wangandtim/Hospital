.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #0d9488 0%, #08979c 100%);
}

.header {
  padding: 100rpx 40rpx 60rpx;
  display: flex;
  align-items: center;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.back-icon {
  font-size: 48rpx;
  color: white;
  font-weight: bold;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: white;
}

.form-section {
  background: white;
  margin: 0 40rpx;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.brand {
  text-align: center;
  margin-bottom: 50rpx;
}

.brand-icon {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fffbeb;
  border: 1rpx solid #fef3c7;
  border-radius: 50%;
}

.brand-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.brand-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #0f766e;
  margin-bottom: 10rpx;
}

.brand-desc {
  font-size: 26rpx;
  color: #999;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #f0fdfa;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.select-input {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.select-value {
  font-size: 30rpx;
  color: #143634;
}

.select-placeholder {
  font-size: 30rpx;
  color: #999;
}

.select-arrow {
  width: 28rpx;
  height: 28rpx;
  transform: rotate(-90deg);
}

.btn-login {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #0d9488 0%, #08979c 100%);
  color: white;
  font-size: 36rpx;
  font-weight: bold;
  border-radius: 50rpx;
  margin-top: 40rpx;
  line-height: 100rpx;
  box-shadow: 0 4rpx 20rpx rgba(13, 148, 136, 0.4);
}

.btn-login::after {
  border: none;
}

.tips {
  text-align: center;
  margin-top: 24rpx;
}

.tips text {
  font-size: 24rpx;
  color: #999;
}

.hospital-picker {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.picker-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.picker-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 70vh;
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0fdfa;
}

.picker-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #143634;
}

.picker-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.picker-close-icon {
  width: 28rpx;
  height: 28rpx;
}

.picker-search {
  padding: 20rpx 30rpx;
}

.picker-search-input {
  width: 100%;
  height: 76rpx;
  border: 1rpx solid #e6fffa;
  border-radius: 38rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  background: #f0fdfa;
  color: #143634;
  box-sizing: border-box;
}

.picker-list {
  max-height: 50vh;
}

.picker-item {
  padding: 25rpx 30rpx;
  border-bottom: 1rpx solid #f0fdfa;
}

.hospital-name {
  font-size: 30rpx;
  color: #143634;
  display: block;
  margin-bottom: 8rpx;
}

.hospital-address {
  font-size: 24rpx;
  color: #5b7c7a;
}

.empty-hint {
  text-align: center;
  padding: 60rpx;
  color: #5b7c7a;
}
