.emergency-login-page {
  padding-top: 24rpx;
}

.admin-topbar {
  display: flex;
  align-items: center;
  padding: 8rpx 0 0;
}

.emergency-title {
  padding-top: 40rpx;
}

.emergency-crest {
  width: 76rpx;
  height: 76rpx;
  margin-bottom: 24rpx;
  border-radius: 22rpx;
  background: var(--gold-tint);
  border: 1rpx solid var(--gold-line);
  color: var(--gold-ink);
  font-family: var(--font-serif);
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.emergency-select {
  justify-content: space-between;
}

.emergency-select-text {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.emergency-field-input {
  flex: 1;
  height: 84rpx;
  font-size: var(--fs-body);
  color: var(--ink);
}

.emergency-submit {
  width: 100%;
  margin-top: 12rpx;
}

.emergency-picker {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.emergency-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(23, 29, 27, 0.5);
}

.emergency-sheet {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 72vh;
  display: flex;
  flex-direction: column;
  background: var(--surface);
  border-radius: var(--r-lg) var(--r-lg) 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: var(--shadow-3);
}

.emergency-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx var(--gutter) 20rpx;
  border-bottom: 1rpx solid var(--line);
}

.emergency-sheet-close {
  padding: 8rpx 4rpx;
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.emergency-search {
  margin: 20rpx var(--gutter);
  height: 80rpx;
}

.emergency-search-input {
  flex: 1;
  height: 72rpx;
  font-size: var(--fs-body);
  color: var(--ink);
}

.emergency-hosp-list {
  height: 40vh;
}

.emergency-hosp-row {
  min-height: 96rpx;
  padding-left: var(--gutter);
  padding-right: var(--gutter);
}
