<view class="ui-page emergency-department-page">
  <view class="ui-head">
    <view class="ui-brand">
      <view class="ui-brand-word dept-brand-word">{{hospitalName}}</view>
      <view class="ui-brand-rule"></view>
      <view class="ui-brand-sub">EMERGENCY · DEPARTMENTS</view>
    </view>
    <view class="ui-icon-btn" bindtap="handleLogout" hover-class="hover-fade">退出</view>
  </view>

  <view class="dept-tags">
    <view class="ui-tag">{{emergencyEntry === 'doctor' ? '医生应急权限' : '应急管理员'}}</view>
    <view class="ui-tag {{expireSoon ? 'ui-tag-danger' : 'ui-tag-gold'}}" wx:if="{{remainText}}">剩余 {{remainText}}</view>
  </view>

  <view class="admin-search">
    <input
      class="admin-search-input"
      placeholder="搜索科室名称"
      placeholder-class="ui-input-ph"
      bindinput="onSearchInput"
      value="{{searchKeyword}}"
    />
    <view class="admin-add" bindtap="goToAdd" hover-class="hover-fade">＋</view>
  </view>

  <view class="dept-list">
    <view
      class="ui-panel dept-panel"
      wx:for="{{departmentList}}"
      wx:key="deptId"
      bindtap="goToDetail"
      data-dept-id="{{item.deptId}}"
      hover-class="hover-card"
    >
      <view class="dept-head">
        <view class="ui-plate"><image class="ui-plate-img" src="{{item.deptIcon}}" mode="aspectFit" /></view>
        <view class="dept-head-main">
          <view class="dept-title-row">
            <text class="dept-name">{{item.deptName}}</text>
            <view class="ui-tag ui-tag-gold" wx:if="{{item.isFlagship === 1}}">重点科室</view>
          </view>
          <view class="dept-sub">{{item.deptCode || '-'}} · {{item.manager || '-'}}</view>
        </view>
        <view class="ui-chev">›</view>
      </view>

      <view class="dept-body">
        <view class="dept-kv">
          <text class="dept-k">联系电话</text>
          <text class="dept-v">{{item.phone || '-'}}</text>
        </view>
        <view class="dept-kv">
          <text class="dept-k">服务时间</text>
          <text class="dept-v">{{item.serviceTime || '暂无服务时间'}}</text>
        </view>
      </view>

      <view class="dept-foot">
        <view class="ui-btn ui-btn-outline ui-btn-sm" bindtap="goToEdit" data-dept-id="{{item.deptId}}" hover-class="hover-fade">编辑</view>
        <view class="ui-btn ui-btn-danger ui-btn-sm" bindtap="handleDelete" data-dept-id="{{item.deptId}}" hover-class="hover-fade">删除</view>
      </view>
    </view>
  </view>

  <view class="ui-empty" wx:if="{{departmentList.length === 0}}">
    <view class="ui-empty-mark">科</view>
    <view class="ui-empty-title">暂无科室数据</view>
  </view>

  <view class="admin-modal" wx:if="{{showAddModal}}" bindtap="closeModal">
    <view class="admin-modal-card" catchtap="stopPropagation">
      <view class="dept-modal-head">
        <view class="ui-panel-title">{{isEdit ? '编辑科室' : '新增科室'}}</view>
        <view class="dept-modal-close" bindtap="closeModal" hover-class="hover-fade">×</view>
      </view>

      <view class="ui-field">
        <view class="ui-field-label">科室名称 *</view>
        <view class="ui-input">
          <input class="admin-field-input" placeholder="请输入科室名称" placeholder-class="ui-input-ph" bindinput="onDeptNameInput" value="{{form.deptName}}" />
        </view>
      </view>
      <view class="ui-field">
        <view class="ui-field-label">科室编码</view>
        <view class="ui-input">
          <input class="admin-field-input" placeholder="请输入科室编码" placeholder-class="ui-input-ph" bindinput="onDeptCodeInput" value="{{form.deptCode}}" />
        </view>
      </view>
      <view class="ui-field">
        <view class="ui-field-label">负责人</view>
        <view class="ui-input">
          <input class="admin-field-input" placeholder="请输入负责人姓名" placeholder-class="ui-input-ph" bindinput="onManagerInput" value="{{form.manager}}" />
        </view>
      </view>
      <view class="ui-field">
        <view class="ui-field-label">联系电话</view>
        <view class="ui-input">
          <input class="admin-field-input" placeholder="请输入联系电话" placeholder-class="ui-input-ph" bindinput="onPhoneInput" value="{{form.phone}}" />
        </view>
      </view>

      <view class="dept-modal-foot">
        <button class="ui-btn ui-btn-outline ui-btn-sm admin-act" bindtap="closeModal" hover-class="hover-fade">取消</button>
        <button class="ui-btn ui-btn-primary ui-btn-sm admin-act" bindtap="handleSubmit" hover-class="ui-btn-loading">{{isEdit ? '保存修改' : '确认添加'}}</button>
      </view>
    </view>
  </view>
</view>
