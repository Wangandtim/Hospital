.emergency-department-page {
  padding-top: 8rpx;
}

.dept-brand-word {
  max-width: 520rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.dept-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.admin-search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 92rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  box-shadow: var(--shadow-1);
}

.admin-search-input {
  flex: 1;
  height: 84rpx;
  font-size: var(--fs-body);
  color: var(--ink);
}

.admin-add {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  border-radius: var(--r-pill);
  background: var(--primary);
  color: #fff;
  font-size: 34rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dept-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.dept-panel {
  margin-bottom: 0;
}

.dept-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 26rpx;
  border-bottom: 1rpx solid var(--line);
}

.dept-head-main {
  flex: 1;
  min-width: 0;
}

.dept-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.dept-name {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
  line-height: 1.35;
}

.dept-sub {
  margin-top: 6rpx;
  font-size: var(--fs-micro);
  color: var(--ink-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.dept-body {
  padding: 8rpx 26rpx 16rpx;
}

.dept-kv {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
  border-bottom: 1rpx solid var(--line);
}

.dept-kv:last-child {
  border-bottom: none;
}

.dept-k {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  flex-shrink: 0;
}

.dept-v {
  font-size: var(--fs-caption);
  color: var(--ink);
  text-align: right;
  margin-left: 24rpx;
  word-break: break-all;
}

.dept-foot {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 26rpx;
  border-top: 1rpx solid var(--line);
}

.dept-foot .ui-btn {
  flex: 1;
}

.admin-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(23, 29, 27, 0.45);
}

.admin-modal-card {
  width: 630rpx;
  max-height: 82vh;
  overflow-y: auto;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  padding: 32rpx 32rpx 28rpx;
  box-shadow: var(--shadow-3);
}

.dept-modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid var(--line);
}

.dept-modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--ink-3);
  line-height: 1;
}

.admin-field-input {
  flex: 1;
  height: 84rpx;
  font-size: var(--fs-body);
  color: var(--ink);
}

.dept-modal-foot {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}

.admin-act {
  flex: 1;
}
