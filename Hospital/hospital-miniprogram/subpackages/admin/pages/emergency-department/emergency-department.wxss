.container {
  min-height: 100vh;
  background: #f5f7fa;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 30rpx;
  background: linear-gradient(135deg, #0d9488 0%, #08979c 100%);
  box-shadow: 0 10rpx 24rpx rgba(13, 148, 136, 0.22);
}

.hospital-info {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.hospital-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.role-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.3);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.role-tag.expire-soon {
  color: #7c2d12;
  background: #fef3c7;
  margin-left: 8rpx;
}

.logout-btn 
{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 15rpx 25rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #fff;
}

.search-section {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #e6fffa;
}

.search-input {
  flex: 1;
  height: 70rpx;
  border: 1rpx solid #d9f2ef;
  border-radius: 35rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  background: #fff;
  color: #143634;
}

.add-btn {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0d9488;
  border-radius: 35rpx;
  box-shadow: 0 10rpx 22rpx rgba(13, 148, 136, 0.24);
}

.add-icon {
  width: 32rpx;
  height: 32rpx;
}

.department-list {
  padding: 20rpx;
}

.department-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 15rpx;
}

.dept-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #143634;
}

.flagship-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #b45309;
  background: #fef3c7;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.card-content {
  margin-bottom: 15rpx;
}

.info-item {
  display: flex;
  margin-bottom: 10rpx;
}

.info-label {
  font-size: 26rpx;
  color: #5b7c7a;
  width: 140rpx;
}

.info-value {
  font-size: 26rpx;
  color: #143634;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 15rpx;
  border-top: 1rpx solid #f0fdfa;
}

.service-time {
  font-size: 24rpx;
  color: #94aeab;
}

.actions {
  display: flex;
  gap: 20rpx;
}

.action-btn 
{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
}

.action-btn.edit {
  background: #f0fdfa;
  color: #0f766e;
}

.action-btn.delete {
  background: #fef2f2;
  color: #ef4444;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #5b7c7a;
}

.add-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 36rpx 36rpx 0 0;
  max-height: 80vh;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #e6fffa;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #143634;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-close-icon {
  width: 28rpx;
  height: 28rpx;
}

.modal-body {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 25rpx;
}

.form-label {
  font-size: 28rpx;
  color: #143634;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #e6fffa;
  border-radius: 22rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background: #f0fdfa;
  color: #143634;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  border-top: 1rpx solid #e6fffa;
}

.btn-cancel 
{
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 80rpx;
  background: #f0fdfa;
  color: #0f766e;
  border-radius: 999rpx;
  font-size: 30rpx;
  border: 1rpx solid #e6fffa;
}

.btn-confirm 
{
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 80rpx;
  background: #0d9488;
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  border: none;
}