.dms-page { padding-top: 8rpx; padding-bottom: calc(200rpx + env(safe-area-inset-bottom)); }

.dms-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  height: 96rpx;
  padding: 0 24rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
}

.dms-picker-value {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  color: var(--ink);
}

.dms-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.dms-slot {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--line);
  border-radius: var(--r-sm);
  background: var(--surface);
  font-size: var(--fs-caption);
  color: var(--ink-2);
  font-variant-numeric: tabular-nums;
}

.dms-slot.on {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
  font-weight: 600;
}

.dms-slot.off {
  background: var(--surface-2);
  border-color: var(--line);
  color: var(--ink-4);
}

.dms-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
  min-height: 48rpx;
}

.dms-selected {
  font-size: var(--fs-caption);
  font-weight: 600;
  color: var(--primary);
}

.dms-required {
  font-size: var(--fs-micro);
  color: var(--ink-3);
}

.dms-remark { min-height: 180rpx; }

.dms-bar .ui-btn { flex: 1; min-width: 0; }

.dms-confirm { flex: 2 !important; }
.dms-skip { flex: 1 !important; }
