.container {
  min-height: 100vh;
  background: #f0fdfa;
  padding-bottom: 120rpx;
}

.header {
  background: linear-gradient(135deg, #0d9488 0%, #08979c 100%);
  padding: 60rpx 30rpx;
  text-align: center;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 15rpx;
}

.header-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.main-content {
  padding: 30rpx;
}

.section {
  background: #ffffff;
  border-radius: 36rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #e6fffa;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.14);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #143634;
  margin-bottom: 20rpx;
}

.date-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx;
  background: #f0fdfa;
  border-radius: 22rpx;
  border: 1rpx solid #ccfbf1;
}

.picker-value {
  font-size: 28rpx;
  color: #143634;
}

.picker-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.time-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.time-slot {
  width: calc(33.33% - 10rpx);
  padding: 20rpx 10rpx;
  text-align: center;
  background: #f0fdfa;
  border: 1rpx solid #ccfbf1;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #5b7c7a;
  transition: all 0.3s;
}

.time-slot.selected {
  background: #ecfdf9;
  border-color: #14b8a6;
  color: #0f766e;
}

.time-slot.disabled {
  background: #f0f0f0;
  border-color: #ddd;
  color: #999;
  opacity: 0.5;
}

.time-info {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.selected-count {
  font-size: 24rpx;
  color: #0f766e;
  font-weight: 500;
}

.required-hint {
  font-size: 24rpx;
  color: #94aeab;
}

.remark-input {
  width: 100%;
  height: 150rpx;
  padding: 20rpx;
  background: #f0fdfa;
  border-radius: 22rpx;
  border: 1rpx solid #ccfbf1;
  font-size: 26rpx;
  color: #143634;
  box-sizing: border-box;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  display: flex;
  gap: 20rpx;
  border-top: 1rpx solid #e6fffa;
  box-shadow: 0 -8rpx 24rpx rgba(13, 148, 136, 0.12);
}

.confirm-btn {
  flex: 2;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #0d9488 0%, #08979c 100%);
  color: white;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 54rpx;
}

.confirm-btn[disabled] {
  background: #ccc;
}

.skip-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f7fa;
  color: #666;
  font-size: 30rpx;
  border-radius: 54rpx;
}