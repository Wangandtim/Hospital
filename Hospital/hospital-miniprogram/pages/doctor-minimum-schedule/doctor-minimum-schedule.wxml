<view class="ui-page dms-page">
  <view class="ui-title-block">
    <view class="ui-eyebrow ui-eyebrow-gold">MINIMUM SCHEDULE</view>
    <view class="ui-title">设置保底排班</view>
  </view>

  <view class="ui-panel">
    <view class="ui-panel-head">
      <view class="ui-panel-title">选择日期</view>
    </view>
    <view class="ui-panel-body">
      <view class="dms-picker" bindtap="showDatePicker" hover-class="hover-fade">
        <text class="dms-picker-value">{{selectedDate || '请选择日期'}}</text>
        <text class="ui-chev">›</text>
      </view>
    </view>
  </view>

  <view class="ui-panel">
    <view class="ui-panel-head">
      <view class="ui-panel-title">每段人数</view>
    </view>
    <view class="ui-panel-body">
      <picker class="dms-picker" mode="selector" range="{{patientOptions}}" value="{{patientIndex}}" bindchange="onPatientChange">
        <view class="dms-picker-value">{{patientOptions[patientIndex]}} 人 / 段</view>
        <text class="ui-chev">›</text>
      </picker>
    </view>
  </view>

  <view class="ui-panel">
    <view class="ui-panel-head">
      <view class="ui-panel-title">选择时间段</view>
      <view class="ui-micro">需满 2 小时</view>
    </view>
    <view class="ui-panel-body">
      <view class="dms-grid">
        <view
          wx:for="{{slotCells}}"
          wx:key="time"
          class="dms-slot {{item.selected ? 'on' : ''}} {{item.disabled ? 'off' : ''}}"
          bindtap="toggleTimeSlot"
          data-index="{{index}}"
          hover-class="hover-fade"
        >
          {{item.time}}
        </view>
      </view>
      <view class="dms-info">
        <text class="dms-selected">已选择 {{selectedSlots.length}} 个时段</text>
        <text class="dms-required">需选择 {{requiredSlots}} 个时段（2 小时）</text>
      </view>
    </view>
  </view>

  <view class="ui-panel">
    <view class="ui-panel-head">
      <view class="ui-panel-title">备注（可选）</view>
    </view>
    <view class="ui-panel-body">
      <textarea
        class="ui-textarea dms-remark"
        placeholder="请输入备注信息（如：普通门诊）"
        bindinput="onRemarkInput"
        value="{{remark}}"
      />
    </view>
  </view>

  <view class="ui-action-bar dms-bar">
    <view
      class="ui-btn dms-confirm {{canConfirm ? 'ui-btn-primary' : 'ui-btn-disabled'}}"
      bindtap="confirmSchedule"
      disabled="{{!canConfirm}}"
      hover-class="hover-scale"
    >确认设置</view>
    <view class="ui-btn ui-btn-outline dms-skip" bindtap="skipSetting" hover-class="hover-fade">稍后设置</view>
  </view>
</view>
