.info-page { min-height: 100vh; padding-top: 4rpx; padding-bottom: 200rpx; }

.info-identity {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  padding: 26rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-1);
}
.info-ava {
  width: 92rpx; height: 92rpx;
  border-radius: 50%;
  background: var(--tint);
  color: var(--primary);
  font-family: var(--font-serif);
  font-size: 38rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.info-identity-main { flex: 1; min-width: 0; }
.info-identity-name { font-family: var(--font-serif); font-size: 36rpx; font-weight: 600; color: var(--ink); }
.info-identity-sub { font-size: 22rpx; color: var(--ink-3); margin-top: 6rpx; }

.field-last { margin-bottom: 4rpx; }
.gender-row { display: flex; gap: 16rpx; }
.gender-opt {
  flex: 1;
  height: 88rpx;
  border-radius: var(--r-md);
  border: 1rpx solid var(--line);
  background: var(--surface);
  color: var(--ink-2);
  font-size: 30rpx;
  display: flex; align-items: center; justify-content: center;
}
.gender-opt.on {
  border-color: var(--primary);
  background: var(--tint);
  color: var(--primary);
  font-weight: 600;
}
.display-value { font-size: 30rpx; color: var(--ink); padding: 12rpx 0; }

.info-note { font-size: 22rpx; color: var(--ink-3); line-height: 1.7; padding: 18rpx 4rpx 0; }
