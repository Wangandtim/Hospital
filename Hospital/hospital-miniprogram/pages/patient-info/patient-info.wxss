page {
  background-color: #f0fdfa;
  min-height: 100vh;
}

.container {
  min-height: 100vh;
  background-color: #f0fdfa;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  color: #fff;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 36rpx;
  color: #fff;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
}

.placeholder {
  width: 60rpx;
}

.form-content {
  padding: 30rpx;
  padding-bottom: 200rpx;
}

.form-item {
  background-color: #fff;
  border: 1rpx solid #e6fffa;
  border-radius: 36rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.14);
}

.label {
  display: block;
  font-size: 28rpx;
  color: #143634;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.input {
  width: 100%;
  height: 80rpx;
  font-size: 30rpx;
  color: #143634;
  border-bottom: 1rpx solid #e6fffa;
  padding-bottom: 12rpx;
}

.input[disabled] {
  color: #94aeab;
}

.display-value {
  font-size: 30rpx;
  color: #143634;
  height: 80rpx;
  line-height: 80rpx;
}

.gender-options {
  display: flex;
  gap: 20rpx;
}

.gender-option {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50rpx;
  border: 1rpx solid #e6fffa;
  background-color: #f0fdfa;
  font-size: 28rpx;
  color: #5b7c7a;
  transition: all 0.3s;
}

.gender-option.selected {
  border-color: #14b8a6;
  background-color: #ecfdf9;
  color: #0f766e;
  font-weight: 600;
}

.textarea {
  width: 100%;
  height: 160rpx;
  font-size: 28rpx;
  color: #143634;
  border: 1rpx solid #e6fffa;
  border-radius: 22rpx;
  padding: 20rpx;
  background-color: #f0fdfa;
  box-sizing: border-box;
}

.textarea[disabled] {
  color: #94aeab;
  background-color: #f4fbfa;
}

.action-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #fff;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 -8rpx 24rpx rgba(13, 148, 136, 0.1);
}

.action-btn 
{
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 88rpx;
  border-radius: 54rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}

.action-btn.skip {
  background-color: #f0fdfa;
  border: 1rpx solid #e6fffa;
  color: #5b7c7a;
}

.action-btn.primary {
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  color: #fff;
  box-shadow: 0 10rpx 24rpx rgba(13, 148, 136, 0.3);
}
