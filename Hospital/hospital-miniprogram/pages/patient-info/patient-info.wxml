<view class="ui-page info-page">
  <view class="ui-head">
    <view class="ui-brand">
      <view class="ui-brand-word">{{isCreate ? '添加就诊人' : mode === 'view' ? '患者档案' : familyId ? '编辑家庭成员' : '编辑就诊人'}}</view>
      <view class="ui-brand-rule"></view>
      <view class="ui-brand-sub">{{isCreate ? 'ADD FAMILY MEMBER' : mode === 'view' ? 'PATIENT FILE' : 'EDIT PATIENT'}}</view>
    </view>
    <view class="ui-icon-btn" bindtap="goBack">返回</view>
  </view>

  <view class="info-identity">
    <view class="info-ava">{{initial}}</view>
    <view class="info-identity-main">
      <view class="info-identity-name">{{patient.name || '未填写'}}</view>
      <view class="info-identity-sub">{{familyId || isCreate ? '家庭成员信息，仅用于挂号与结算' : '身份证已实名核验 · 信息仅用于挂号与结算'}}</view>
    </view>
    <view class="ui-pill ui-pill-done" wx:if="{{!familyId && !isCreate}}">已认证</view>
    <view class="ui-pill ui-pill-wait" wx:else>家庭成员</view>
  </view>

  <view class="ui-panel">
    <view class="ui-panel-body">
      <view class="ui-field">
        <view class="ui-field-label">姓名</view>
        <input class="ui-input" placeholder="请输入姓名" placeholder-class="ui-input-ph" value="{{patient.name}}" bindinput="onNameInput" disabled="{{mode === 'view'}}" />
      </view>

      <view class="ui-field">
        <view class="ui-field-label">性别</view>
        <view class="gender-row" wx:if="{{mode === 'edit'}}">
          <view class="gender-opt {{patient.gender === 'M' ? 'on' : ''}}" data-value="M" bindtap="onGenderChange" hover-class="hover-fade">男</view>
          <view class="gender-opt {{patient.gender === 'F' ? 'on' : ''}}" data-value="F" bindtap="onGenderChange" hover-class="hover-fade">女</view>
        </view>
        <view class="display-value" wx:else>{{patient.gender === 'M' ? '男' : patient.gender === 'F' ? '女' : '未填写'}}</view>
      </view>

      <view class="ui-field">
        <view class="ui-field-label">年龄</view>
        <input class="ui-input" type="number" placeholder="请输入年龄" placeholder-class="ui-input-ph" value="{{patient.age}}" bindinput="onAgeInput" disabled="{{mode === 'view'}}" />
      </view>

      <view class="ui-field">
        <view class="ui-field-label">手机号</view>
        <input class="ui-input" type="number" placeholder="请先登录绑定手机号" placeholder-class="ui-input-ph" value="{{patient.phone}}" disabled />
      </view>

      <view class="ui-field field-last">
        <view class="ui-field-label">病史</view>
        <textarea class="ui-textarea" placeholder="请描述病史或其他需要说明的情况" placeholder-class="ui-input-ph" value="{{patient.medicalHistory}}" bindinput="onMedicalHistoryInput" disabled="{{mode === 'view'}}" />
      </view>
    </view>
  </view>

  <view class="info-note">信息变更后需重新实名核验；如需新增家庭成员，请返回就诊人列表。</view>
</view>

<view class="ui-action-bar" wx:if="{{mode === 'edit'}}">
  <view class="ui-btn ui-btn-danger" wx:if="{{canDelete}}" bindtap="deletePatient">删除</view>
  <view class="ui-btn ui-btn-outline" wx:elif="{{isCreate}}" bindtap="skip">取消</view>
  <view class="ui-btn ui-btn-outline" wx:else bindtap="skip">跳过</view>
  <view class="ui-btn ui-btn-primary" bindtap="submitForm">保存</view>
</view>
<view class="ui-action-bar" wx:if="{{mode === 'view'}}">
  <view class="ui-btn ui-btn-primary" bindtap="goToEdit">编辑档案</view>
</view>
