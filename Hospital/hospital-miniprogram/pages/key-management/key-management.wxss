page {
  background: #f5f7fa;
  min-height: 100vh;
}

.container {
  padding-bottom: 40rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  background: linear-gradient(135deg, #0d9488 0%, #08979c 100%);
  color: white;
}

.back-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
}

.header-placeholder {
  width: 80rpx;
}

.hospital-info {
  padding: 30rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e6fffa;
}

.hospital-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #143634;
}

.key-detail, .key-list {
  padding: 30rpx;
}

.recovery-card {
  background: #fffdf5;
  border-color: #fef3c7;
}

.guard-card {
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.guard-card.guard-locked {
  background: #fff7ed;
  border-color: #fed7aa;
}

.guard-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #143634;
  margin-bottom: 10rpx;
}

.guard-text {
  font-size: 24rpx;
  color: #5b7c7a;
  line-height: 1.6;
}

.snapshot-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-top: 1rpx solid #f1f5f9;
}

.snapshot-main {
  flex: 1;
  min-width: 0;
}

.snapshot-label {
  font-size: 26rpx;
  color: #143634;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.snapshot-time {
  font-size: 22rpx;
  color: #8aa5a2;
  margin-top: 4rpx;
}

.snapshot-btn {
  margin-left: 20rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  color: #0f766e;
  background: #f0fdfa;
  border: 1rpx solid #ccfbf1;
  border-radius: 28rpx;
}

.snapshot-btn::after {
  border: none;
}

.request-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-top: 1rpx solid #f1f5f9;
}

.request-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.request-doctor {
  font-size: 26rpx;
  font-weight: 600;
  color: #143634;
}

.request-reason {
  font-size: 24rpx;
  color: #5b7c7a;
  margin-top: 4rpx;
}

.request-time {
  font-size: 22rpx;
  color: #8aa5a2;
  margin-top: 4rpx;
}

.request-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.request-reject {
  color: #b91c1c;
  background: #fef2f2;
  border-color: #fecaca;
}

.key-tip {
  font-size: 24rpx;
  color: #5b7c7a;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.key-toolbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.toolbar-select {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 24rpx;
  background: #f0fdfa;
  border: 1rpx solid #ccfbf1;
  border-radius: 38rpx;
  font-size: 26rpx;
  color: #143634;
}

.toolbar-btn {
  width: 200rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #0d9488 0%, #08979c 100%);
  border-radius: 38rpx;
  padding: 0;
}

.toolbar-btn::after {
  border: none;
}

.key-card {
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #e2e8f0;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.key-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.key-label {
  font-size: 28rpx;
  color: #666;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 20rpx;
  border-radius: 26rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.status-tag.valid {
  background: #dcfce7;
  color: #16a34a;
}

.status-tag.invalid {
  background: #fef2f2;
  color: #dc2626;
}

.status-tag.expired {
  background: #fef3c7;
  color: #d97706;
}

.key-value {
  position: relative;
  font-size: 36rpx;
  font-weight: bold;
  color: #143634;
  letter-spacing: 4rpx;
  padding: 20rpx;
  background: #f0fdfa;
  border: 1rpx solid #e6fffa;
  border-radius: 22rpx;
  margin-bottom: 16rpx;
  font-family: monospace;
}

.copy-icon {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 32rpx;
  height: 32rpx;
}

.key-meta {
  margin-bottom: 24rpx;
}

.meta-item {
  font-size: 26rpx;
  color: #94aeab;
}

.key-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn 
{
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 80rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.action-btn.renew {
  background: linear-gradient(135deg, #0d9488 0%, #08979c 100%);
  color: white;
  box-shadow: 0 10rpx 24rpx rgba(13, 148, 136, 0.24);
}

.action-btn.invalidate {
  background: #f5f7fa;
  color: #666;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #5b7c7a;
  margin-bottom: 30rpx;
}

.generate-btn 
{
  display: flex;
  align-items: center;
  justify-content: center;
  width: 400rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #0d9488 0%, #08979c 100%);
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 58rpx;
  border: none;
}

.request-actions-wrap {
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10rpx;
}

.request-report {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #475569;
  line-height: 1.5;
  word-break: break-all;
  white-space: pre-wrap;
}

.supervisor-card {
  border: 1rpx solid #fde68a;
  background: #fffbeb;
}

.supervisor-card .guard-title {
  color: #92400e;
}