.km-page { padding-top: 8rpx; padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }

.km-top {
  display: flex;
  align-items: flex-start;
  padding-top: 24rpx;
}
.km-top .ui-back { margin-bottom: 0; }

.km-hospital {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 104rpx;
  padding: 20rpx 26rpx;
}

.km-plate-text {
  font-family: var(--font-serif);
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--primary);
}

.km-hospital-name {
  font-family: var(--font-serif);
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
}

.km-key {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 96rpx;
  padding: 20rpx 22rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  border-radius: var(--r-sm);
  margin-bottom: 16rpx;
}

.km-key-text {
  flex: 1;
  min-width: 0;
  font-family: "SF Pro Display", "DIN Alternate", monospace;
  font-size: var(--fs-h3);
  font-weight: 600;
  letter-spacing: 0.12em;
  color: var(--ink);
  word-break: break-all;
}

.km-copy {
  flex-shrink: 0;
  font-size: var(--fs-micro);
  color: var(--primary);
  background: var(--tint);
  border-radius: var(--r-pill);
  padding: 8rpx 18rpx;
}

.km-meta {
  font-size: var(--fs-micro);
  color: var(--ink-3);
  line-height: 1.7;
  margin-bottom: 6rpx;
}

.km-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.km-actions .ui-btn,
.km-actions .km-btn { flex: 1; }

.km-recovery { border-color: var(--gold-line); }
.km-recovery .ui-panel-head {
  background: var(--gold-tint);
  padding-bottom: 18rpx;
}

.km-empty-btn { margin-top: 28rpx; min-width: 320rpx; }

.km-guard.is-locked {
  background: var(--warn-tint);
  border-color: var(--gold-line);
}

.km-guard-text {
  font-size: var(--fs-caption);
  color: var(--ink-2);
  line-height: 1.7;
}

.km-req {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 120rpx;
  padding: 22rpx 26rpx;
}
.km-req + .km-req { border-top: 1rpx solid var(--line); }

.km-req-main { flex: 1; min-width: 0; }

.km-req-doctor {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
}

.km-req-line {
  font-size: var(--fs-micro);
  color: var(--ink-2);
  line-height: 1.6;
  margin-top: 4rpx;
  word-break: break-all;
}

.km-req-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
  max-width: 300rpx;
}

.km-snap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 104rpx;
  padding: 18rpx 26rpx;
}
.km-snap + .km-snap { border-top: 1rpx solid var(--line); }

.km-snap-main { flex: 1; min-width: 0; }

.km-snap-label {
  font-size: var(--fs-caption);
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.km-snap-time {
  font-size: var(--fs-micro);
  color: var(--ink-3);
  margin-top: 4rpx;
}

.km-toolbar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 8rpx 0 24rpx;
}

.km-toolbar-picker { flex: 1; min-width: 0; }

.km-select {
  justify-content: space-between;
  padding: 0 20rpx;
}

.km-select-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.km-generate {
  flex-shrink: 0;
  height: 96rpx;
  font-size: var(--fs-caption);
  padding: 0 26rpx;
}

.km-allkeys-name { flex: 1; min-width: 0; }
