.article-page { min-height: 100vh; }

.article-hero {
  width: 100%;
  height: 360rpx;
  display: block;
  background: var(--tint-2);
}
.article-hero-empty {
  background: var(--tint-2);
  display: flex;
  align-items: center;
  justify-content: center;
}
.article-hero-mark {
  width: 108rpx; height: 108rpx;
  border-radius: 50%;
  border: 1rpx solid var(--line);
  background: var(--surface);
  color: var(--gold-ink);
  font-family: var(--font-serif);
  font-size: 44rpx;
  display: flex; align-items: center; justify-content: center;
}

.article-wrap {
  position: relative;
  margin-top: -56rpx;
  padding-top: 0;
  padding-bottom: 48rpx;
}
.article-card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-xl);
  padding: 34rpx 30rpx 30rpx;
  box-shadow: var(--shadow-2);
}
.article-meta-row { display: flex; align-items: center; gap: 14rpx; flex-wrap: wrap; }
.article-date { font-size: 22rpx; color: var(--ink-3); letter-spacing: 0.06em; }
.article-publisher { font-size: 22rpx; color: var(--ink-3); margin-left: auto; }
.article-title {
  font-size: 48rpx;
  line-height: 1.35;
  color: var(--ink);
  margin-top: 18rpx;
}
.article-stats { font-size: 22rpx; color: var(--ink-4); margin-top: 12rpx; letter-spacing: 0.04em; }
.article-stat-dot { margin: 0 8rpx; }

.article-summary {
  margin-top: 24rpx;
  padding: 18rpx 22rpx;
  background: var(--surface-2);
  border-left: 4rpx solid var(--gold);
  border-radius: var(--r-sm);
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.75;
}
.article-divider { margin: 26rpx 0; }

.article-body { padding-bottom: 8rpx; }
.article-p {
  font-size: 30rpx;
  color: var(--ink-2);
  line-height: 1.95;
  margin-bottom: 18rpx;
}
.article-empty { font-size: 26rpx; color: var(--ink-3); padding: 20rpx 0; }

.article-foot {
  margin-top: 28rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.8;
}
.article-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.article-actions .ui-btn { flex: 1; }
