<view class="article-page {{elderly ? 'elderly' : ''}}">
  <block wx:if="{{loading}}">
    <view class="article-hero article-hero-skeleton"></view>
    <view class="ui-page article-wrap">
      <view class="ui-skeleton ui-skeleton-card article-skeleton-card"></view>
      <view class="ui-skeleton ui-skeleton-card article-skeleton-body"></view>
    </view>
  </block>

  <block wx:elif="{{error}}">
    <view class="ui-page article-error">
      <view class="ui-empty">
        <view class="ui-empty-mark">告</view>
        <view class="ui-empty-title">{{error}}</view>
        <view class="ui-empty-hint">请检查网络后重试，或返回全部公告</view>
        <view class="ui-empty-action">
          <view class="ui-btn ui-btn-primary" bindtap="retryLoad">重新加载</view>
          <view class="ui-btn ui-btn-outline" bindtap="goNoticeList">全部公告</view>
        </view>
      </view>
    </view>
  </block>

  <block wx:else>
    <image class="article-hero" wx:if="{{coverFull}}" src="{{coverFull}}" mode="aspectFill" binderror="onCoverError" />
    <view class="article-hero article-hero-empty" wx:else>
      <view class="article-hero-mark">告</view>
    </view>

    <view class="ui-page article-wrap">
      <view class="article-card">
        <view class="article-meta-row">
          <view class="ui-tag ui-tag-gold">{{article.category || '院内动态'}}</view>
          <text class="article-date">{{dateText}}</text>
          <text class="article-publisher">{{extra.publisher || '—'}}</text>
        </view>
        <view class="article-title ui-serif">{{article.title}}</view>
        <view class="article-stats">
          <text>阅读 {{extra.readCount || '—'}}</text>
        </view>

        <view class="article-summary" wx:if="{{article.summary}}">{{article.summary}}</view>
        <view class="ui-divider article-divider"></view>

        <view class="article-body">
          <view class="article-p" wx:for="{{paragraphs}}" wx:key="index">{{item}}</view>
          <view class="article-empty" wx:if="{{paragraphs.length === 0}}">暂无正文内容</view>
        </view>
      </view>

      <view class="ui-panel" wx:if="{{extra.relatedSlots && extra.relatedSlots.length > 0}}">
        <view class="ui-panel-head">
          <view class="ui-panel-title">相关号源</view>
          <view class="ui-micro">同科室 · 可改约</view>
        </view>
        <view class="ui-panel-body ui-panel-body-flush">
          <view class="ui-row" wx:for="{{extra.relatedSlots}}" wx:key="index">
            <view class="ui-row-main">
              <view class="ui-row-title">{{item.doctorName}} · {{item.date}}</view>
              <view class="ui-row-desc">{{item.period}} · 余 {{item.remaining}}</view>
            </view>
            <view class="ui-row-val">改约</view>
          </view>
        </view>
      </view>

      <view class="article-foot">
        <view>发布单位：{{extra.publisher || '—'}} · 咨询 {{extra.phone || '—'}}</view>
      </view>

      <view class="article-actions">
        <view class="ui-btn ui-btn-outline" bindtap="goNoticeList">全部公告</view>
        <view class="ui-btn ui-btn-primary" bindtap="goMyAppointments">我的预约</view>
      </view>
    </view>
  </block>
</view>
