.help-page { min-height: 100vh; padding-top: 4rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }

.help-guide {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  padding: 28rpx 26rpx;
  box-shadow: var(--shadow-1);
}
.help-guide-title {
  font-size: 34rpx;
  color: var(--ink);
  margin-bottom: 22rpx;
}
.help-steps { display: flex; align-items: flex-start; }
.help-step { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.help-step-no {
  width: 52rpx; height: 52rpx; line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  font-family: var(--font-serif);
  font-size: 26rpx;
}
.help-step-text { font-size: 22rpx; color: var(--ink-2); text-align: center; line-height: 1.4; }
.help-step-line { width: 36rpx; height: 1rpx; background: var(--line-strong); flex-shrink: 0; margin-top: 26rpx; }

.faq-item { padding: 24rpx 26rpx; }
.faq-item + .faq-item { border-top: 1rpx solid var(--line); }
.faq-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.faq-q { flex: 1; font-size: 30rpx; color: var(--ink); font-weight: 500; line-height: 1.55; }
.faq-arrow { font-size: 32rpx; color: var(--ink-4); flex-shrink: 0; transition: transform 0.2s ease; }
.faq-arrow.open { transform: rotate(90deg); color: var(--primary); }
.faq-a {
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  background: var(--surface-2);
  border-radius: var(--r-sm);
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.75;
}

.help-online { margin-top: 28rpx; }
