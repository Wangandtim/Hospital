.hospital-doctor-page {
  min-height: 100vh;
  padding-top: 16rpx;
  padding-bottom: 48rpx;
}

.filter-search {
  margin-bottom: var(--s3);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-size: var(--fs-body);
  color: var(--ink);
}

.doctor-list {
  padding-bottom: var(--s3);
}

.hospital-retry {
  margin-top: 20rpx;
  display: inline-flex;
}

.doctor-dept {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.doctor-dept-name {
  font-size: var(--fs-caption);
  color: var(--ink-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
