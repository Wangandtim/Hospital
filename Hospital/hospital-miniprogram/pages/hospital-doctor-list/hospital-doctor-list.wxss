page {
  background: #f0fdfa;
  min-height: 100vh;
}

.container {
  padding-bottom: 40rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  color: white;
}

.back-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
}

.header-placeholder {
  width: 80rpx;
}

.filter-section {
  padding: 20rpx 30rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e6fffa;
}

.search-bar {
  position: relative;
}

.search-input {
  width: 100%;
  height: 80rpx;
  background: #f0fdfa;
  border: 1rpx solid #e6fffa;
  border-radius: 50rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #143634;
}

.doctor-list {
  padding: 20rpx 30rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 30rpx;
  opacity: 0.7;
}

.empty-text {
  font-size: 28rpx;
  color: #94aeab;
}

.doctor-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #e6fffa;
  border-radius: 36rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.14);
}

.doctor-avatar {
  width: 100rpx;
  height: 100rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 50%;
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  flex-shrink: 0;
  margin-right: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(13, 148, 136, 0.24);
}

.doctor-info {
  flex: 1;
}

.doctor-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.doctor-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #143634;
  margin-right: 16rpx;
}

.doctor-title 
{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #0f766e;
  background: #ecfdf9;
  border: 1rpx solid #ccfbf1;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.doctor-detail {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.dept-name {
  font-size: 26rpx;
  color: #5b7c7a;
  margin-right: 16rpx;
}

.doctor-id {
  font-size: 22rpx;
  color: #94aeab;
  background: #f0fdfa;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.doctor-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #94aeab;
}

.doctor-arrow {
  font-size: 40rpx;
  color: #94aeab;
}
