.triage-page { min-height: 100vh; padding-top: 8rpx; }
.triage-page .ui-page { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }

.triage-title-wrap { margin-top: 40rpx; }
.triage-title { font-size: 60rpx; line-height: 1.3; letter-spacing: -0.04em; margin-top: 10rpx; }
.triage-sub { font-size: 26rpx; color: #8A938F; margin-top: 12rpx; line-height: 1.7; }

/* 语音 */
.triage-voice { display: flex; flex-direction: column; align-items: center; margin-top: 48rpx; }
.triage-mic {
  width: 248rpx; height: 248rpx;
  border-radius: 50%;
  background: #0F5B50;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 20rpx 48rpx rgba(15, 91, 80, 0.24);
}
.triage-mic-on { background: #87672F; transform: scale(0.98); }
.triage-mic-ico { display: flex; flex-direction: column; align-items: center; }
.triage-mic-body { width: 48rpx; height: 88rpx; border-radius: 24rpx; background: #F7F1E4; }
.triage-mic-stem { width: 6rpx; height: 30rpx; background: #F7F1E4; margin-top: 4rpx; }
.triage-mic-base { width: 64rpx; height: 6rpx; border-radius: 6rpx; background: #F7F1E4; }
.triage-mic-hint { font-size: 30rpx; color: #4B5652; margin-top: 24rpx; }
.triage-heard {
  width: 100%;
  margin-top: 32rpx;
  background: #FFFDFA;
  border: 1rpx solid #E5D7BC;
  border-radius: 28rpx;
  padding: 28rpx;
  text-align: center;
}
.triage-heard-text { font-family: "Songti SC", serif; font-size: 40rpx; color: #171D1B; margin-top: 10rpx; line-height: 1.45; }
.triage-heard-actions { display: flex; gap: 16rpx; justify-content: center; margin-top: 24rpx; }

/* 输入卡 */
.triage-input-card {
  margin-top: 32rpx;
  background: #FFFDFA;
  border: 1rpx solid #E5E5DE;
  border-radius: 32rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(23, 29, 27, 0.05);
}
.triage-textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: 32rpx;
  line-height: 1.7;
  color: #171D1B;
  box-sizing: border-box;
}
.triage-chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.triage-chip { height: 56rpx; padding: 0 22rpx; font-size: 24rpx; }
.triage-subject {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  margin-top: 12rpx;
  border-top: 1rpx solid #EFEEE8;
}
.triage-subject-value { font-size: 28rpx; color: #171D1B; }
.triage-submit { width: 100%; margin-top: 12rpx; }

/* 常见不适 */
.triage-ails { margin-top: 16rpx; }
.triage-ail-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14rpx; }
.triage-ail-grid-compact { grid-template-columns: repeat(3, 1fr); }
.triage-ail {
  min-height: 84rpx;
  border: 1rpx solid #E5E5DE;
  background: #FFFDFA;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #4B5652;
  padding: 12rpx 8rpx;
  text-align: center;
}
.triage-ail:active { background: #EFF4F1; }
.triage-switch { text-align: center; font-size: 26rpx; color: #87672F; margin-top: 20rpx; }

.triage-foot { font-size: 22rpx; color: #B6BDB9; line-height: 1.8; margin-top: 40rpx; text-align: center; }

/* 统一按钮宽度 */
.triage-wide-btn { width: 100%; margin-top: 28rpx; }
.triage-secondary { text-align: center; font-size: 26rpx; color: #8A938F; padding: 20rpx 0; }

/* 补资料 / 补问 */
.triage-field + .triage-field { margin-top: 24rpx; }
.triage-opt-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.triage-opt {
  min-height: 72rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid #E5E5DE;
  background: #FFFDFA;
  font-size: 28rpx;
  color: #4B5652;
  display: flex;
  align-items: center;
  justify-content: center;
}
.triage-opt-on { border-color: #0F5B50; background: #0F5B50; color: #fff; }

.triage-clarify { margin-top: 16rpx; }
.triage-clarify-q { font-size: 30rpx; color: #171D1B; line-height: 1.6; margin-bottom: 16rpx; }
.triage-clarify-hint { font-size: 24rpx; color: #8A938F; line-height: 1.7; margin-top: 16rpx; }

/* 分级横幅 */
.triage-tier {
  border-radius: 28rpx;
  padding: 28rpx 26rpx;
  margin: 16rpx 0 20rpx;
  background: #FFFDFA;
  border: 1rpx solid #E5E5DE;
}
.triage-tier-low { border-left: 4rpx solid #A8874F; background: #FBF8F1; }
.triage-tier-medium { border-left: 4rpx solid #0F5B50; background: #F5F9F7; }
.triage-tier-high { border-left: 4rpx solid #A64842; background: #FBF3F2; }
.triage-tier-title { font-family: "Songti SC", serif; font-size: 40rpx; color: #171D1B; line-height: 1.35; margin-top: 8rpx; }
.triage-tier-sub { font-size: 26rpx; color: #4B5652; line-height: 1.7; margin-top: 8rpx; }

/* 推荐卡 */
.triage-rec {
  background: #FFFDFA;
  border: 1rpx solid #E5D7BC;
  border-radius: 28rpx;
  padding: 26rpx;
  box-shadow: 0 8rpx 24rpx rgba(23, 29, 27, 0.06);
}
.triage-rec-top { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.triage-rec-hospital { font-size: 26rpx; color: #4B5652; }
.triage-rec-dept-row { display: flex; align-items: center; gap: 16rpx; margin-top: 12rpx; }
.triage-rec-dept { font-size: 52rpx; line-height: 1.3; letter-spacing: -0.03em; }
.triage-rec-rows { margin-top: 18rpx; }
.triage-rec-row { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 0; border-top: 1rpx solid #EFEEE8; font-size: 26rpx; }
.triage-rec-k { color: #8A938F; flex-shrink: 0; }
.triage-rec-v { color: #171D1B; text-align: right; }
.triage-rec-fee { color: #87672F; font-family: "Songti SC", serif; font-size: 34rpx; }
.triage-rec-reason { font-size: 24rpx; color: #8A938F; line-height: 1.8; margin-top: 16rpx; padding-top: 14rpx; border-top: 1rpx solid #EFEEE8; }
.triage-rec-expert { display: flex; align-items: flex-start; gap: 12rpx; margin-top: 14rpx; }
.triage-rec-expert-text { flex: 1; font-size: 24rpx; color: #87672F; line-height: 1.7; }

.triage-notice { margin-top: 20rpx; padding: 4rpx 6rpx; }
.triage-notice-line { font-size: 24rpx; color: #8A938F; line-height: 1.85; }

.triage-low { margin-top: 24rpx; padding: 22rpx 24rpx; background: #FBF8F1; border: 1rpx solid #EFE7D6; border-radius: 24rpx; }
.triage-low-title { font-size: 28rpx; color: #87672F; }
.triage-low-q { font-size: 26rpx; color: #4B5652; line-height: 1.8; margin-top: 8rpx; }
.triage-low-hint { font-size: 22rpx; color: #8A938F; margin-top: 8rpx; }

.triage-evidence-toggle { font-size: 24rpx; color: #0F5B50; padding: 20rpx 0 8rpx; }
.triage-evidence { padding: 0 4rpx 8rpx; }
.triage-evidence-line { font-size: 22rpx; color: #8A938F; line-height: 1.8; }

.triage-lock { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; padding: 16rpx 20rpx; border: 1rpx solid #E5D7BC; background: #F7F1E4; border-radius: 16rpx; }
.triage-lock-text { font-size: 24rpx; color: #87672F; }
.triage-lock-time { font-size: 22rpx; color: #8A938F; }
.triage-lock-pay { margin: 20rpx 0; }

.triage-blocked { font-size: 24rpx; color: #A64842; line-height: 1.7; margin-top: 16rpx; }

/* 支付 */
.triage-pay-hero { text-align: center; padding: 40rpx 0 28rpx; }
.triage-pay-amount { font-family: "Songti SC", serif; font-size: 88rpx; line-height: 1.2; color: #171D1B; margin-top: 8rpx; }
.triage-pay-desc { font-size: 26rpx; color: #8A938F; margin-top: 8rpx; }

/* 成功 */
.triage-success { text-align: center; padding-top: 48rpx; }
.triage-success-mark { width: 128rpx; height: 128rpx; border-radius: 50%; background: #EFF4F1; border: 1rpx solid #D3E2DC; display: flex; align-items: center; justify-content: center; margin: 0 auto 24rpx; }
.triage-success-check { width: 72rpx; height: 72rpx; border-radius: 50%; background: #0F5B50; color: #fff; font-size: 36rpx; display: flex; align-items: center; justify-content: center; }
.triage-success-title { font-size: 64rpx; margin-top: 10rpx; }
.triage-success-sub { font-size: 26rpx; color: #8A938F; line-height: 1.75; margin-top: 12rpx; }
.triage-success-card { margin-top: 32rpx; text-align: left; }

.elderly .triage-title { font-size: 68rpx; }
.elderly .triage-sub { font-size: 32rpx; }
.elderly .triage-mic { width: 300rpx; height: 300rpx; }
.elderly .triage-mic-body { width: 60rpx; height: 108rpx; }
.elderly .triage-mic-hint { font-size: 36rpx; }
.elderly .triage-ail { min-height: 108rpx; font-size: 36rpx; }
.elderly .triage-ail-grid-compact { grid-template-columns: repeat(2, 1fr); }
.elderly .triage-opt { min-height: 88rpx; font-size: 34rpx; }
.elderly .triage-secondary { font-size: 30rpx; padding: 26rpx 0; }
.elderly .triage-foot { font-size: 26rpx; }
