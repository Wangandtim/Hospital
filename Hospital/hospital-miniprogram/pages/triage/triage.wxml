<view class="triage-page {{elderly ? 'elderly' : ''}}">
  <!-- 1. 输入 -->
  <block wx:if="{{step === 'input'}}">
    <view class="ui-page">
      <view class="ui-head">
        <view class="ui-brand">
          <view class="ui-brand-word">智能分诊</view>
          <view class="ui-brand-rule"></view>
          <view class="ui-brand-sub">TRIAGE · 30 秒判断科室</view>
        </view>
        <view class="ui-icon-btn" bindtap="goHome">首页</view>
      </view>

      <view class="triage-title-wrap">
        <view class="ui-eyebrow ui-eyebrow-gold">先说不舒服的地方</view>
        <view class="triage-title ui-serif">{{voiceMode ? '哪里不舒服？' : '说说哪里不舒服。'}}</view>
        <view class="triage-sub" wx:if="{{!elderly}}">一句话就够，帮你判断科室、医生和号源。</view>
      </view>

      <!-- 长辈语音态 -->
      <view class="triage-voice" wx:if="{{voiceMode}}">
        <view
          class="triage-mic {{recording ? 'triage-mic-on' : ''}}"
          bindtouchstart="startRecord"
          bindtouchend="stopRecord"
          bindtouchcancel="stopRecord"
        >
          <view class="triage-mic-ico">
            <view class="triage-mic-body"></view>
            <view class="triage-mic-stem"></view>
            <view class="triage-mic-base"></view>
          </view>
        </view>
        <view class="triage-mic-hint">{{recording ? '正在听你说，松开结束' : (asrLoading ? '正在识别…' : '按住话筒，说出哪里不舒服')}}</view>

        <view class="triage-heard" wx:if="{{showHeard}}">
          <view class="ui-micro">您说的是不是</view>
          <view class="triage-heard-text">{{heardText}}</view>
          <view class="triage-heard-actions">
            <button class="ui-btn ui-btn-primary ui-btn-sm" bindtap="confirmHeard">对，就是这个</button>
            <button class="ui-btn ui-btn-outline ui-btn-sm" bindtap="retryRecord">重说一遍</button>
          </view>
        </view>
      </view>

      <view class="triage-ails" wx:if="{{voiceMode}}">
        <view class="ui-group-title">也可以直接点一下</view>
        <view class="triage-ail-grid">
          <view class="triage-ail" wx:for="{{commonAils}}" wx:key="text" data-text="{{item.text}}" bindtap="tapAil">{{item.label}}</view>
        </view>
        <view class="triage-switch" bindtap="switchToText">换成打字描述 ›</view>
      </view>

      <!-- 文本输入 -->
      <block wx:if="{{!voiceMode}}">
        <view class="triage-input-card">
          <textarea
            class="triage-textarea"
            placeholder="例如：咳嗽三天了，还有点发热"
            maxlength="120"
            value="{{inputText}}"
            bindinput="onInput"
            auto-height
          />
          <view class="triage-chips">
            <view class="ui-chip triage-chip" wx:for="{{chips}}" wx:key="*this" data-text="{{item}}" bindtap="tapChip">{{item}}</view>
          </view>
          <view class="triage-subject" bindtap="toggleSubject">
            <view class="ui-caption">为谁问诊</view>
            <view class="triage-subject-value">{{subject === 'SELF' ? '我自己' : '替长辈问'}} <text class="ui-chev">›</text></view>
          </view>
          <button class="ui-btn ui-btn-primary triage-submit {{loading ? 'ui-btn-loading' : ''}}" bindtap="submitInput">
            {{loading ? '正在判断…' : '开始判断'}}
          </button>
        </view>

        <view class="triage-ails">
          <view class="ui-section-head">
            <text class="ui-section-title">常见不适</text>
            <text class="ui-section-sub">快捷选择</text>
          </view>
          <view class="triage-ail-grid triage-ail-grid-compact">
            <view class="triage-ail" wx:for="{{commonAils}}" wx:key="text" data-text="{{item.text}}" bindtap="tapAil">{{item.label}}</view>
          </view>
        </view>
      </block>

      <view class="triage-foot">分诊建议仅供参考，急重症请直接前往急诊或拨打 120。</view>
    </view>
  </block>

  <!-- 2. 补资料 -->
  <block wx:elif="{{step === 'profile'}}">
    <view class="ui-page">
      <view class="ui-title-block">
        <view class="ui-eyebrow ui-eyebrow-gold">补充信息</view>
        <view class="ui-title">{{copyTitle}}</view>
        <view class="ui-subtitle">{{copySubtitle}}</view>
      </view>
      <view class="ui-panel">
        <view class="ui-panel-body">
          <view class="triage-field" wx:for="{{missingFields}}" wx:key="key">
            <view class="ui-field-label">请选择{{item.label}}</view>
            <view class="triage-opt-grid">
              <view
                class="triage-opt {{profileAnswers[item.key] === opt.value ? 'triage-opt-on' : ''}}"
                wx:for="{{item.options}}"
                wx:for-item="opt"
                wx:key="value"
                data-key="{{item.key}}"
                data-value="{{opt.value}}"
                bindtap="chooseProfile"
              >{{opt.label}}</view>
            </view>
          </view>
        </view>
      </view>
      <button class="ui-btn ui-btn-primary triage-wide-btn" bindtap="submitProfile">继续</button>
    </view>
  </block>

  <!-- 3. 结构化补问 -->
  <block wx:elif="{{step === 'clarify'}}">
    <view class="ui-page">
      <view class="triage-tier triage-tier-low">
        <view class="triage-tier-title">{{copyTitle}}</view>
        <view class="triage-tier-sub">{{copySubtitle}}</view>
      </view>

      <view class="ui-panel triage-clarify" wx:for="{{clarifyQuestions}}" wx:key="key">
        <view class="ui-panel-body">
          <view class="triage-clarify-q">{{item.question}}</view>
          <view class="triage-opt-grid">
            <view
              class="triage-opt {{clarifyAnswers[item.key] === opt ? 'triage-opt-on' : ''}}"
              wx:for="{{item.options}}"
              wx:for-item="opt"
              wx:key="*this"
              data-key="{{item.key}}"
              data-value="{{opt}}"
              bindtap="chooseClarify"
            >{{opt}}</view>
          </view>
        </view>
      </view>

      <view class="triage-clarify-hint" wx:if="{{clarifyHint}}">{{clarifyHint}}</view>
      <button class="ui-btn ui-btn-primary triage-wide-btn" bindtap="submitClarify">继续判断</button>
    </view>
  </block>

  <!-- 4. 结果 -->
  <block wx:elif="{{step === 'result'}}">
    <view class="ui-page">
      <view class="triage-tier {{tierClass}}">
        <view class="ui-eyebrow ui-eyebrow-gold">分诊建议</view>
        <view class="triage-tier-title ui-serif">{{copyTitle}}</view>
        <view class="triage-tier-sub">{{copySubtitle}}</view>
      </view>

      <view class="triage-rec" wx:if="{{recommender}}">
        <view class="triage-rec-top">
          <view class="triage-rec-hospital">{{recommender.hospitalName}}</view>
          <view class="ui-tag ui-tag-gold" wx:if="{{recommender.level}}">{{recommender.level}}</view>
        </view>
        <view class="triage-rec-dept ui-serif">{{recommender.departmentName}}</view>
        <view class="triage-rec-rows">
          <view class="triage-rec-row"><text class="triage-rec-k">医生</text><text class="triage-rec-v">{{recommender.doctorName}} {{recommender.doctorTitle}}</text></view>
          <view class="triage-rec-row"><text class="triage-rec-k">时间</text><text class="triage-rec-v">{{recommender.dateText}} {{recommender.timeSlot}}</text></view>
          <view class="triage-rec-row"><text class="triage-rec-k">挂号费</text><text class="triage-rec-v triage-rec-fee">¥{{recommender.fee}}</text></view>
        </view>
        <view class="triage-rec-reason">{{recommender.matchReason}}</view>
        <view class="triage-rec-expert" wx:if="{{expertLabel}}">
          <view class="ui-tag ui-tag-gold">{{expertLabel}}</view>
          <view class="triage-rec-expert-text">{{expertReason}}</view>
        </view>
      </view>

      <view class="triage-notice" wx:if="{{notices.length > 0}}">
        <view class="triage-notice-line" wx:for="{{notices}}" wx:key="*this">· {{item}}</view>
      </view>

      <view wx:if="{{!elderly && alternatives.length > 0}}">
        <view class="ui-section-head">
          <text class="ui-section-title">其他可选</text>
          <text class="ui-section-sub">ALTERNATIVE</text>
        </view>
        <view class="ui-panel">
          <view class="ui-panel-body ui-panel-body-flush">
            <view class="ui-row" wx:for="{{alternatives}}" wx:key="scheduleId">
              <view class="ui-row-main">
                <view class="ui-row-title">{{item.hospitalName}} · {{item.doctorName}}</view>
                <view class="ui-row-desc">{{item.dateText}} {{item.timeSlot}} · ¥{{item.fee}}</view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="triage-low" wx:if="{{tier === 'LOW'}}">
        <view class="triage-low-title">补充这些问题，判断会更准</view>
        <view class="triage-low-q" wx:for="{{followUps}}" wx:key="*this">{{index + 1}}. {{item}}</view>
        <view class="triage-low-hint">{{lowHint}}</view>
      </view>

      <view class="triage-evidence-toggle" wx:if="{{!elderly && evidence.length > 0}}" bindtap="toggleEvidence">
        {{showEvidence ? '收起判断依据' : '查看判断依据'}}
      </view>
      <view class="triage-evidence" wx:if="{{showEvidence}}">
        <view class="triage-evidence-line" wx:for="{{evidence}}" wx:key="detail">· {{item.detail}}</view>
      </view>

      <view class="triage-lock" wx:if="{{lock && !lockExpired}}">
        <view class="triage-lock-text">号源已为你保留</view>
        <view class="triage-lock-time" wx:if="{{!elderly}}">剩余 {{countdownText}}</view>
      </view>

      <view class="triage-blocked" wx:if="{{!bookingAllowed && tier !== 'LOW'}}">{{bookingBlockedReason}}</view>

      <button class="ui-btn ui-btn-primary triage-wide-btn" bindtap="primaryAction">{{primaryText}}</button>
      <view class="triage-secondary" wx:if="{{secondaryText}}" bindtap="secondaryAction">{{secondaryText}}</view>
      <view class="triage-secondary" wx:if="{{tertiaryText}}" bindtap="tertiaryAction">{{tertiaryText}}</view>
    </view>
  </block>

  <!-- 5. 付款 -->
  <block wx:elif="{{step === 'pay'}}">
    <view class="ui-page">
      <view class="triage-pay-hero">
        <view class="ui-eyebrow">挂号费</view>
        <view class="triage-pay-amount ui-num">¥{{lock.fee}}</view>
        <view class="triage-pay-desc">{{lock.hospitalName}} · {{lock.departmentName}}</view>
      </view>

      <view class="ui-panel">
        <view class="ui-panel-body ui-panel-body-flush">
          <view class="ui-row"><view class="ui-row-label">医生</view><view class="ui-row-main"></view><view class="ui-row-val">{{lock.doctorName}} {{lock.doctorTitle}}</view></view>
          <view class="ui-row"><view class="ui-row-label">时间</view><view class="ui-row-main"></view><view class="ui-row-val ui-row-val-gold">{{lock.dateText}} {{lock.timeSlot}}</view></view>
        </view>
      </view>

      <view class="triage-lock triage-lock-pay">
        <view class="triage-lock-text">号源保留中</view>
        <view class="triage-lock-time" wx:if="{{!elderly}}">剩余 {{countdownText}}</view>
      </view>

      <button class="ui-btn ui-btn-primary triage-wide-btn {{paying ? 'ui-btn-loading' : ''}}" bindtap="payNow">{{paying ? '支付中…' : '确认支付'}}</button>
      <view class="triage-secondary" bindtap="payLater">稍后支付</view>
    </view>
  </block>

  <!-- 6. 成功 -->
  <block wx:elif="{{step === 'success'}}">
    <view class="ui-page triage-success">
      <view class="triage-success-mark">
        <view class="triage-success-check">✓</view>
      </view>
      <view class="ui-eyebrow ui-eyebrow-gold">BOOKING CONFIRMED</view>
      <view class="triage-success-title ui-serif">预约成功</view>
      <view class="triage-success-sub">请提前 10 分钟到院，凭预约信息取号就诊</view>

      <view class="ui-panel triage-success-card">
        <view class="ui-panel-body ui-panel-body-flush">
          <view class="ui-row"><view class="ui-row-label">医院</view><view class="ui-row-main"></view><view class="ui-row-val">{{appointment.hospitalName}}</view></view>
          <view class="ui-row"><view class="ui-row-label">科室</view><view class="ui-row-main"></view><view class="ui-row-val">{{appointment.departmentName}}</view></view>
          <view class="ui-row"><view class="ui-row-label">医生</view><view class="ui-row-main"></view><view class="ui-row-val">{{appointment.doctorName}} {{appointment.doctorTitle}}</view></view>
          <view class="ui-row"><view class="ui-row-label">时间</view><view class="ui-row-main"></view><view class="ui-row-val ui-row-val-gold">{{appointment.dateText}} {{appointment.timeSlot}}</view></view>
        </view>
      </view>

      <button class="ui-btn ui-btn-primary triage-wide-btn" bindtap="goMyAppointments">查看我的预约</button>
      <view class="triage-secondary" bindtap="goHome">返回首页</view>
    </view>
  </block>
</view>
