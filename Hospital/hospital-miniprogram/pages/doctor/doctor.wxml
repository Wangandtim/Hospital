<view class="doctor-page">
  <view class="ui-flow">
    <view class="ui-flow-bars">
      <i class="done"></i><i class="done"></i><i class="now"></i><i></i><i></i><i></i><i></i><i></i>
    </view>
    <view class="ui-flow-meta">
      <b>03</b><text>/ 08</text>
      <text class="name">选择医生</text>
      <view class="back" bindtap="goBack"><text>←</text><text>返回</text></view>
    </view>
  </view>

  <view class="ui-page doctor-page-inner">
    <view class="doctor-crumb" wx:if="{{currentHospital}}">{{currentHospital.hospitalName}} · {{currentHospital.campus}}</view>

    <view class="ui-title-block">
      <view class="ui-eyebrow ui-eyebrow-gold">DOCTORS</view>
      <view class="ui-title">{{deptId ? '科室医生' : '全部医生'}}</view>
      <view class="ui-subtitle">共 {{pager.total || 0}} 位医生</view>
    </view>

    <view class="ui-search doctor-search">
      <view class="ui-search-ico"></view>
      <input
        class="ui-search-input"
        placeholder="搜索医生姓名、擅长或科室"
        value="{{keyword}}"
        bindinput="onKeywordInput"
        bindconfirm="onKeywordInput"
        confirm-type="search"
      />
      <view wx:if="{{keyword}}" class="ui-search-clear" bindtap="clearKeyword">清除</view>
    </view>

    <view class="ui-segmented doctor-titles">
      <view
        class="ui-seg {{titleIndex === index ? 'ui-seg-active' : ''}}"
        wx:for="{{titles}}"
        wx:key="value"
        data-index="{{index}}"
        bindtap="onTitleTap"
      >{{item.label}}</view>
    </view>

    <view class="doctor-list">
      <view class="doctor-group" wx:for="{{groups}}" wx:key="deptId">
        <view class="doctor-group-head">
          <text class="doctor-group-name">{{item.deptName}}</text>
          <text class="doctor-group-total">{{item.doctorTotal}} 位</text>
        </view>

        <view
          class="ui-doctor {{doc.available ? '' : 'is-full'}}"
          wx:for="{{item.doctors}}"
          wx:for-item="doc"
          wx:key="doctorId"
          bindtap="viewDoctor"
          data-id="{{doc.doctorId}}"
          hover-class="hover-fade"
        >
          <view class="ui-doctor-photo">
            <image wx:if="{{doc.photoUrlFull}}" class="ui-doctor-photo-img" src="{{doc.photoUrlFull}}" mode="aspectFill" />
            <text wx:else>{{doc.avatarText}}</text>
          </view>
          <view class="ui-doctor-main">
            <view class="ui-doctor-name-row">
              <text class="ui-doctor-name">{{doc.name}}</text>
              <text class="ui-doctor-title">{{doc.titleText}}</text>
            </view>
            <view class="ui-doctor-line2" wx:if="{{doc.expertise}}">{{doc.expertise}}</view>
            <view class="ui-doctor-flags">
              <view class="ui-tag" wx:for="{{doc.flags}}" wx:for-item="flag" wx:key="index">{{flag}}</view>
            </view>
          </view>
          <view class="ui-doctor-side">
            <view class="ui-doctor-fee">¥{{doc.consultationFee || '—'}}</view>
            <view wx:if="{{doc.available}}" class="ui-state ui-state-ok"><i></i>余 {{doc.remaining}}</view>
            <view wx:else class="ui-state ui-state-full"><i></i>约满</view>
            <view wx:if="{{doc.available}}" class="ui-doctor-book" catchtap="makeAppointment" data-id="{{doc.doctorId}}">预约</view>
            <view wx:else class="ui-doctor-book ui-doctor-book-outline">不可约</view>
          </view>
        </view>

        <view
          wx:if="{{item.doctorHasMore}}"
          class="doctor-group-more"
          catchtap="expandGroup"
          data-dept-id="{{item.deptId}}"
          data-doctor-page="{{item.doctorPage}}"
        >展开更多</view>
      </view>

      <ui-empty
        wx:if="{{pager.status === 'empty'}}"
        mark="医"
        title="暂无医生"
        hint="换个科室或日期看看"
      />

      <view wx:if="{{isLoading && groups.length === 0}}">
        <view class="ui-skeleton ui-skeleton-card" wx:for="{{[1,2]}}" wx:key="index"></view>
      </view>

      <view bindtap="onReachBottom">
        <ui-pager
          status="{{pager.status}}"
          hasMore="{{pager.hasMore}}"
          total="{{pager.total}}"
          error="{{pager.error}}"
          bindretry="retryLoad"
        />
      </view>
    </view>
  </view>
</view>
