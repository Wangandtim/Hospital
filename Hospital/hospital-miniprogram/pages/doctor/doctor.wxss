.doctor-page { min-height: 100vh; padding-top: 8rpx; }
.doctor-page-inner { padding-bottom: 48rpx; }
.doctor-crumb { font-size: 24rpx; color: #8A938F; letter-spacing: 0.04em; }
.doctor-list { padding-bottom: 24rpx; }

.doctor-search { margin-bottom: 20rpx; }
.doctor-titles { margin-bottom: 24rpx; }

.doctor-group { margin-bottom: 24rpx; }

.doctor-group-head {
  position: sticky;
  top: 0;
  z-index: 6;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  padding: 18rpx 0 12rpx;
  background: var(--paper);
  border-bottom: 1rpx solid var(--line);
}

.doctor-group-name {
  font-family: var(--font-serif);
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
}

.doctor-group-total { font-size: var(--fs-micro); color: var(--ink-3); }

.doctor-group-more {
  text-align: center;
  padding: 18rpx 0 8rpx;
  font-size: var(--fs-caption);
  color: var(--primary);
}
