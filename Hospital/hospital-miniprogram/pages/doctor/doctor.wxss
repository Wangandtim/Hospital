.doctor-list {
  margin-bottom: 20rpx;
}

.doctor-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.doctor-avatar {
  width: 96rpx;
  height: 96rpx;
  margin-right: 20rpx;
  padding: 18rpx;
  box-sizing: border-box;
  background: #ecfdf9;
  border-radius: 50%;
  flex-shrink: 0;
}

.doctor-info {
  flex: 1;
}

.doctor-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #143634;
  margin-bottom: 8rpx;
}

.doctor-title {
  font-size: 26rpx;
  color: #0f766e;
  margin-bottom: 4rpx;
}

.doctor-expertise {
  font-size: 24rpx;
  color: #94aeab;
}

.btn-appointment {
  background: #14b8a6;
  color: white;
  border: none;
  border-radius: 999rpx;
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  line-height: 1.4;
  box-shadow: 0 6rpx 16rpx rgba(13, 148, 136, 0.2);
}

.btn-appointment::after {
  border: none;
}

.no-schedule {
  font-size: 24rpx;
  color: #94aeab;
  background: #f0fdfa;
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #94aeab;
  font-size: 28rpx;
}

/* 医院横幅样式 */
.hospital-banner {
  margin-bottom: 30rpx;
  background: linear-gradient(135deg, #0d9488 0%, #14b8a6 100%);
  color: white;
  border: none;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.22);
}

.hospital-banner-name {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.hospital-banner-level {
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  display: inline-flex; align-items: center; justify-content: center;
  margin-bottom: 10rpx;
}

.hospital-banner-address {
  font-size: 24rpx;
  opacity: 0.9;
  line-height: 1.6;
}
