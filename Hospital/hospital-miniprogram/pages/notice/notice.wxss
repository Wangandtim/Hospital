.notice-page { min-height: 100vh; padding-top: 4rpx; padding-bottom: 40rpx; }
.notice-sub { font-size: 24rpx; color: var(--ink-3); padding: 0 0 20rpx; }
.notice-list { padding-top: 4rpx; }

.notice-card {
  display: flex;
  gap: 22rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  padding: 26rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-1);
  overflow: hidden;
}
.notice-cover {
  width: 150rpx; height: 150rpx;
  border-radius: var(--r-sm);
  background: var(--surface-2);
  flex-shrink: 0;
}
.notice-main { flex: 1; min-width: 0; }
.notice-meta { display: flex; align-items: center; gap: 14rpx; }
.notice-date { font-size: 22rpx; color: var(--ink-3); letter-spacing: 0.06em; }
.notice-title {
  font-family: var(--font-serif);
  font-size: 36rpx; font-weight: 600; color: var(--ink);
  line-height: 1.45;
  margin-top: 12rpx;
}
.notice-brief {
  font-size: 26rpx; color: var(--ink-2);
  line-height: 1.65;
  margin-top: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.notice-foot {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--line);
}
.notice-publisher { font-size: 22rpx; color: var(--ink-3); }
