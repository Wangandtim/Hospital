.today-page {
  min-height: 100vh;
  padding-top: 16rpx;
  padding-bottom: 48rpx;
}

.schedule-list {
  padding-bottom: var(--s4);
}

.schedule-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 26rpx;
}

.schedule-time {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.time-start,
.time-end {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
}

.time-divider {
  font-size: var(--fs-caption);
  color: var(--ink-4);
}

.schedule-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.schedule-status {
  display: flex;
}

.schedule-detail {
  font-size: var(--fs-caption);
  color: var(--ink-2);
}

.schedule-action {
  flex-shrink: 0;
}

.status-tag {
  border: 1rpx solid transparent;
}

.status-available {
  background: var(--tint);
  border-color: #D3E2DC;
  color: var(--primary);
}

.status-full {
  background: var(--danger-tint);
  border-color: #EAD2CE;
  color: var(--danger);
}

.status-cancelled {
  background: var(--surface-2);
  border-color: var(--line);
  color: var(--ink-3);
}

.status-pending {
  background: var(--gold-tint);
  border-color: var(--gold-line);
  color: var(--gold-ink);
}

.status-completed {
  background: var(--tint);
  border-color: #D3E2DC;
  color: var(--primary);
}

.status-inprogress {
  background: var(--tint);
  border-color: #D3E2DC;
  color: var(--primary);
}

/* ---------- 预约弹层 ---------- */
.appointment-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(23, 29, 27, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 40rpx;
}

.modal-content {
  width: 100%;
  max-height: 80vh;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  overflow: hidden;
  box-shadow: var(--shadow-3);
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
}

.modal-title {
  font-family: var(--font-serif);
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--r-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  line-height: 1;
  color: var(--ink-3);
}

.modal-body {
  max-height: 60vh;
  overflow-y: auto;
}

.patient-name {
  font-size: var(--fs-body);
  font-weight: 500;
  color: var(--ink);
}

.patient-detail {
  margin-top: 4rpx;
  font-size: var(--fs-micro);
  color: var(--ink-3);
}

.modal-empty {
  padding: 48rpx 24rpx;
}
