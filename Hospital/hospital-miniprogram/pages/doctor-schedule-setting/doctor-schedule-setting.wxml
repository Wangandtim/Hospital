<view class="ui-page dss-page">
  <view class="ui-title-block">
    <view class="ui-eyebrow ui-eyebrow-gold">WEEKLY SCHEDULE</view>
    <view class="ui-title">我的出诊时间</view>
  </view>

  <view class="dss-week">
    <view hover-class="hover-press" hover-stay-time="150" class="dss-day" wx:for="{{weekDays}}" wx:key="day" bindtap="toggleDay" data-day="{{item.day}}">
      <view class="dss-day-head">
        <text class="dss-day-name">{{item.name}}</text>
        <view class="dss-toggle {{item.enabled ? 'on' : 'off'}}">{{item.statusText}}</view>
      </view>

      <view class="dss-slots">
        <view class="dss-slot" wx:for="{{item.slots}}" wx:key="settingId" wx:for-item="slot">
          <view class="dss-slot-main">
            <view class="dss-slot-time">{{slot.startTime}} - {{slot.endTime}}</view>
            <view class="dss-slot-detail">{{slot.detailText}}</view>
          </view>
          <view class="ui-btn ui-btn-danger ui-btn-sm dss-del" bindtap="deleteTimeSlot" data-id="{{slot.settingId}}" hover-class="hover-fade">删除</view>
        </view>

        <view hover-class="hover-press" hover-stay-time="150" class="dss-add" bindtap="openTimeSlotModal" data-day="{{item.day}}" wx:if="{{item.enabled}}">
          <text class="dss-add-icon">＋</text>
          <text>添加时段</text>
        </view>
      </view>
    </view>
  </view>

  <view class="dss-mask" wx:if="{{showTimeSlotModal}}" bindtap="closeTimeSlotModal"></view>
  <view class="dss-modal" wx:if="{{showTimeSlotModal}}" catchtap="stopPropagation">
    <view class="dss-modal-head">
      <view class="dss-modal-title">添加出诊时段</view>
      <view class="ui-icon-btn dss-modal-close" bindtap="closeTimeSlotModal" hover-class="hover-fade">×</view>
    </view>

    <view class="dss-modal-body">
      <view class="ui-field">
        <view class="ui-field-label">开始时间</view>
        <picker mode="time" value="{{newTimeSlot.startTime}}" bindchange="onStartTimeChange">
          <view class="ui-input dss-picker">
            <text>{{newTimeSlot.startTime || '选择时间'}}</text>
            <text class="ui-chev">▾</text>
          </view>
        </picker>
      </view>

      <view class="ui-field">
        <view class="ui-field-label">结束时间</view>
        <picker mode="time" value="{{newTimeSlot.endTime}}" bindchange="onEndTimeChange">
          <view class="ui-input dss-picker">
            <text>{{newTimeSlot.endTime || '选择时间'}}</text>
            <text class="ui-chev">▾</text>
          </view>
        </picker>
      </view>

      <view class="ui-field">
        <view class="ui-field-label">时段时长（分钟）</view>
        <picker mode="selector" range="{{slotDurations}}" value="{{slotDurationIndex}}" bindchange="onSlotDurationChange">
          <view class="ui-input dss-picker">
            <text>{{newTimeSlot.slotDuration}}分钟</text>
            <text class="ui-chev">▾</text>
          </view>
        </picker>
      </view>

      <view class="ui-field dss-field-last">
        <view class="ui-field-label">每时段最大预约人数</view>
        <picker mode="selector" range="{{maxPatientOptions}}" value="{{maxPatientsIndex}}" bindchange="onMaxPatientsChange">
          <view class="ui-input dss-picker">
            <text>{{newTimeSlot.maxPatientsPerSlot}}人</text>
            <text class="ui-chev">▾</text>
          </view>
        </picker>
      </view>
    </view>

    <view class="dss-modal-actions">
      <button class="ui-btn ui-btn-outline" bindtap="closeTimeSlotModal" hover-class="hover-fade">取消</button>
      <button class="ui-btn ui-btn-primary" bindtap="saveTimeSlot" hover-class="hover-press">确定</button>
    </view>
  </view>
</view>
