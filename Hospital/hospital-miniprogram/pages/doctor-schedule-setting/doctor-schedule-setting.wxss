.dss-page { padding-top: 8rpx; padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }

.dss-week { display: flex; flex-direction: column; gap: 20rpx; }

.dss-day {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  padding: 24rpx 26rpx;
  box-shadow: var(--shadow-1);
}

.dss-day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid var(--line);
}

.dss-day-name {
  font-family: var(--font-serif);
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
}

.dss-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  height: 64rpx;
  padding: 0 22rpx;
  border-radius: var(--r-pill);
  font-size: var(--fs-caption);
  font-weight: 600;
}

.dss-toggle.on {
  background: var(--tint);
  color: var(--primary);
}

.dss-toggle.off {
  background: var(--surface-2);
  color: var(--ink-3);
  border: 1rpx solid var(--line);
}

.dss-slots { padding-top: 18rpx; }

.dss-slot {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 96rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.dss-slot:last-child { border-bottom: none; }

.dss-slot-main { flex: 1; min-width: 0; }

.dss-slot-time {
  font-size: var(--fs-body);
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

.dss-slot-detail {
  font-size: var(--fs-micro);
  color: var(--ink-3);
  margin-top: 4rpx;
}

.dss-del { flex-shrink: 0; }

.dss-add {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 96rpx;
  margin-top: 16rpx;
  border: 1rpx dashed var(--line-strong);
  border-radius: var(--r-md);
  background: var(--surface-2);
  color: var(--primary);
  font-size: var(--fs-caption);
}

.dss-add-icon { font-size: var(--fs-h3); line-height: 1; }

.dss-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  margin-top: 16rpx;
  border-radius: var(--r-md);
  background: var(--surface-2);
  font-size: var(--fs-micro);
  color: var(--ink-3);
}

.dss-mask {
  position: fixed;
  inset: 0;
  background: rgba(23, 29, 27, 0.48);
  z-index: 30;
}

.dss-modal {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  top: 50%;
  transform: translateY(-50%);
  max-height: 82vh;
  overflow-y: auto;
  background: var(--surface);
  border-radius: var(--r-lg);
  padding: 30rpx var(--s4) 26rpx;
  box-sizing: border-box;
  z-index: 40;
  animation: ui-rise 0.24s ease both;
}

.dss-modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 22rpx;
}

.dss-modal-title {
  font-family: var(--font-serif);
  font-size: var(--fs-h2);
  color: var(--ink);
}

.dss-modal-close { flex-shrink: 0; }

.dss-modal-body { padding-bottom: 4rpx; }

.dss-picker {
  justify-content: space-between;
  font-size: var(--fs-body);
}

.dss-field-last { margin-bottom: 0; }

.dss-modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}
.dss-modal-actions .ui-btn { flex: 1; }
