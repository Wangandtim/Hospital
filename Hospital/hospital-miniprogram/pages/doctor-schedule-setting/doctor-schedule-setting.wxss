.container {
  min-height: 100vh;
  background-color: #f0fdfa;
  padding: 20rpx;
}

.header {
  background-color: #0d9488;
  color: #ffffff;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  opacity: 0.8;
}

.week-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.day-card {
  width: calc(50% - 10rpx);
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.day-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #eee;
}

.day-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.toggle-switch 
{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 20rpx;
  border-radius: 26rpx;
  font-size: 24rpx;
}

.toggle-switch.on {
  background-color: #0d9488;
  color: #ffffff;
}

.toggle-switch.off {
  background-color: #f0f0f0;
  color: #999;
}

.time-slots {
  min-height: 80rpx;
}

.time-slot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
}

.slot-info text {
  display: block;
  font-size: 24rpx;
  color: #333;
}

.slot-detail {
  font-size: 20rpx !important;
  color: #999 !important;
  margin-top: 5rpx;
}

.delete-btn {
  color: #ff4d4f;
  font-size: 24rpx;
}

.add-slot {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  color: #999;
  font-size: 24rpx;
}

.add-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
  color: #0d9488;
}

.hint-text {
  padding: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #999;
  background-color: #fafafa;
  border-radius: 12rpx;
  margin-top: 10rpx;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 80%;
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.modal-body {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 25rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.picker-value {
  padding: 20rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  text-align: center;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #eee;
}

.btn-cancel, .btn-confirm {
  flex: 1;
  padding: 25rpx;
  font-size: 30rpx;
  border-radius: 0;
}

.btn-cancel {
  background-color: #f0fdfa;
  color: #666;
}

.btn-confirm {
  background-color: #0d9488;
  color: #ffffff;
}