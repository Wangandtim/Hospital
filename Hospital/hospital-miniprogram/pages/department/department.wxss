.dept-list {
  margin-bottom: 20rpx;
}

.dept-item {
  margin-bottom: 20rpx;
}

.dept-header {
  margin-bottom: 15rpx;
}

.dept-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.dept-desc {
  font-size: 26rpx;
  color: #595959;
  margin-bottom: 10rpx;
  line-height: 1.6;
}

.dept-actions {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: flex-end;
}

.dept-action {
  font-size: 26rpx;
  color: #0d9488;
}

/* 医院横幅样式 */
.hospital-banner {
  margin-bottom: 30rpx;
  background: linear-gradient(135deg, #0d9488 0%, #5cdbd3 100%);
  color: white;
}

.hospital-banner-name {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.hospital-banner-level {
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  display: inline-flex; align-items: center; justify-content: center;
  margin-bottom: 10rpx;
}

.hospital-banner-address {
  font-size: 24rpx;
  opacity: 0.9;
  line-height: 1.6;
}
