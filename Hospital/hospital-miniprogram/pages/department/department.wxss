.dept-page { min-height: 100vh; padding-top: 8rpx; }

.dept-inst {
  background: #FFFDFA;
  border: 1rpx solid #E5E5DE;
  border-radius: 28rpx;
  padding: 24rpx;
}
.dept-inst-top { display: flex; align-items: flex-start; gap: 18rpx; }
.dept-inst .ui-inst-crest { width: 72rpx; height: 72rpx; border-radius: 18rpx; }
.dept-inst-main { flex: 1; min-width: 0; }
.dept-inst-name { font-size: 34rpx; line-height: 1.35; color: #171D1B; }
.dept-inst-change {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #0F5B50;
  border: 1rpx solid #D3E2DC;
  background: #EFF4F1;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
}

.dept-list { padding-bottom: 24rpx; }
.dept-chev { margin-top: 16rpx; }

.elderly .dept-inst-name { font-size: 42rpx; }
.elderly .dept-inst .ui-inst-tag { font-size: 26rpx; }
.elderly .dept-chev { font-size: 40rpx; }
