.er-page { min-height: 100vh; padding-top: 4rpx; padding-bottom: 48rpx; }

.er-band {
  background: var(--danger-tint);
  border: 1rpx solid #EAD2CE;
  border-radius: var(--r-lg);
  padding: 30rpx 28rpx;
}
.er-kicker {
  font-size: 22rpx;
  letter-spacing: 0.16em;
  color: var(--danger);
  text-transform: uppercase;
}
.er-title {
  font-family: var(--font-serif);
  font-size: 44rpx;
  line-height: 1.4;
  color: #7C2F2A;
  margin-top: 12rpx;
}
.er-desc { font-size: 26rpx; color: var(--ink-2); line-height: 1.75; margin-top: 12rpx; }

.er-call {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 18rpx;
  padding: 26rpx 28rpx;
  border-radius: var(--r-lg);
  background: var(--danger);
  color: #fff;
  box-shadow: 0 12rpx 28rpx rgba(166, 72, 66, 0.24);
}
.er-call-icon-img { width: 42rpx; height: 42rpx; display: block; }
.er-call-icon {
  width: 76rpx; height: 76rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  font-family: var(--font-serif);
  font-size: 34rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.er-call-main { flex: 1; }
.er-call-num { font-family: var(--font-serif); font-size: 48rpx; line-height: 1.2; }
.er-call-sub { font-size: 22rpx; color: rgba(255, 255, 255, 0.8); }
.er-call-action { font-size: 24rpx; color: rgba(255, 255, 255, 0.9); }
.er-link { color: var(--danger); }

.er-steps {
  margin-top: 20rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  overflow: hidden;
}
.er-step { display: flex; gap: 18rpx; padding: 22rpx 26rpx; }
.er-step + .er-step { border-top: 1rpx solid var(--line); }
.er-step-no {
  width: 44rpx; height: 44rpx;
  border-radius: 50%;
  background: var(--danger-tint);
  color: var(--danger);
  font-family: var(--font-serif);
  font-size: 24rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
}
.er-step-body { flex: 1; min-width: 0; }
.er-step-title { font-size: 30rpx; font-weight: 600; color: var(--ink); }
.er-step-desc { font-size: 24rpx; color: var(--ink-2); margin-top: 4rpx; line-height: 1.65; }

.er-notice {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  background: var(--danger-tint);
  border-left: 4rpx solid var(--danger);
  border-radius: var(--r-sm);
}
.er-notice-tag { font-size: 22rpx; font-weight: 600; color: var(--danger); flex-shrink: 0; }
.er-notice-text { flex: 1; font-size: 24rpx; color: var(--ink-2); line-height: 1.65; }

.er-links { display: flex; gap: 20rpx; margin-top: 26rpx; }
.er-links .ui-btn { flex: 1; }
