page {
  background: #fff1f2;
}

.page {
  min-height: 100vh;
  padding: 60rpx 36rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.warn-circle {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background: #e11d48;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 36rpx rgba(225, 29, 72, 0.28);
}

.warn-icon {
  font-size: 84rpx;
  font-weight: 700;
  color: #ffffff;
}

.warn-title {
  margin-top: 28rpx;
  font-size: 52rpx;
  font-weight: 700;
  color: #9f1239;
  letter-spacing: 4rpx;
}

.warn-reason {
  margin-top: 18rpx;
  font-size: 32rpx;
  color: #881337;
  text-align: center;
  line-height: 1.7;
}

.advice-card {
  width: 100%;
  margin-top: 40rpx;
  padding: 30rpx;
  box-sizing: border-box;
  background: #ffffff;
  border: 2rpx solid #fecdd3;
  border-radius: 26rpx;
}

.advice-line {
  font-size: 30rpx;
  color: #5f1a2b;
  line-height: 1.9;
}

.call-btn {
  width: 100%;
  margin-top: 46rpx;
  height: 116rpx;
  line-height: 116rpx;
  text-align: center;
  border-radius: 30rpx;
  background: #e11d48;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  box-shadow: 0 12rpx 28rpx rgba(225, 29, 72, 0.30);
}

.btn-press {
  opacity: 0.88;
  transform: scale(0.985);
}

.ghost-btn {
  width: 100%;
  margin-top: 24rpx;
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  border-radius: 28rpx;
  background: #ffffff;
  border: 2rpx solid #fda4af;
  color: #9f1239;
  font-size: 34rpx;
  font-weight: 600;
}

.hospital-phone {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: #fff1f2;
  color: #9f1239;
  font-size: 30rpx;
  line-height: 1.6;
  font-weight: 600;
  text-align: center;
}

.home-link {
  margin-top: 36rpx;
  font-size: 28rpx;
  color: #881337;
}
