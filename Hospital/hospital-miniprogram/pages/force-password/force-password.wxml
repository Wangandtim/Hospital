<view class="ui-page force-password-page">
  <view class="ui-head">
    <view class="ui-brand">
      <view class="ui-brand-word">修改登录密码</view>
      <view class="ui-brand-rule"></view>
      <view class="ui-brand-sub">首次登录需设置新密码</view>
    </view>
  </view>

  <view class="fp-form">
    <view class="ui-field">
      <view class="ui-field-label">原密码</view>
      <view class="ui-input">
        <input
          class="fp-input"
          password="{{true}}"
          placeholder="请输入当前密码"
          placeholder-class="ui-input-ph"
          value="{{oldPassword}}"
          data-field="oldPassword"
          bindinput="onInput"
        />
      </view>
    </view>

    <view class="ui-field">
      <view class="ui-field-label">新密码</view>
      <view class="ui-input">
        <input
          class="fp-input"
          password="{{true}}"
          placeholder="至少 6 位"
          placeholder-class="ui-input-ph"
          value="{{newPassword}}"
          data-field="newPassword"
          bindinput="onInput"
        />
      </view>
    </view>

    <view class="ui-field">
      <view class="ui-field-label">确认新密码</view>
      <view class="ui-input">
        <input
          class="fp-input"
          password="{{true}}"
          placeholder="再次输入新密码"
          placeholder-class="ui-input-ph"
          value="{{confirmPassword}}"
          data-field="confirmPassword"
          bindinput="onInput"
        />
      </view>
    </view>
  </view>

  <button class="ui-btn ui-btn-primary fp-submit" bindtap="submit" hover-class="ui-btn-loading">保存并进入</button>
  <view class="fp-back" bindtap="goBack">返回登录</view>
</view>
