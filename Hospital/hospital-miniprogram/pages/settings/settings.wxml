<view class="ui-page settings-page {{elderly ? 'elderly' : ''}}">
  <view class="ui-head">
    <view class="ui-brand">
      <view class="ui-brand-word">设置</view>
      <view class="ui-brand-rule"></view>
      <view class="ui-brand-sub">SETTINGS · PREFERENCES</view>
    </view>
    <view class="ui-icon-btn" bindtap="goHelp">帮助</view>
  </view>

  <view class="ui-group-title">长辈关怀</view>
  <view class="ui-panel">
    <view class="ui-panel-body ui-panel-body-flush">
      <view class="ui-row">
        <view class="ui-row-main">
          <view class="ui-row-title">长辈模式</view>
          <view class="ui-row-desc">字号更大、按钮更醒目，主要页面切换适老布局</view>
        </view>
        <switch checked="{{elderly}}" color="#0F5B50" bindchange="onElderlyChange" />
      </view>
      <view class="settings-tip" wx:if="{{elderly}}">已开启长辈模式，首页与预约页已切换为适老布局</view>
    </view>
  </view>

  <view class="ui-group-title">就诊偏好</view>
  <view class="ui-panel">
    <view class="ui-panel-body ui-panel-body-flush">
      <view class="ui-row" bindtap="goChangeHospital" hover-class="hover-fade">
        <view class="ui-row-main">
          <view class="ui-row-title">默认就诊医院</view>
          <view class="ui-row-desc">{{selectedHospital ? selectedHospital.hospitalName : '未选择，点击前往选择'}}</view>
        </view>
        <view class="ui-chev">›</view>
      </view>
    </view>
  </view>

  <view class="ui-group-title">智能服务</view>
  <view class="ui-panel">
    <view class="ui-panel-body ui-panel-body-flush">
      <view class="ui-row" bindtap="goAgent" hover-class="hover-fade">
        <view class="ui-row-main">
          <view class="ui-row-title">智能分诊</view>
          <view class="ui-row-desc">说说哪里不舒服，帮你判断科室和号源</view>
        </view>
        <view class="ui-tag ui-tag-primary">已上线</view>
        <view class="ui-chev">›</view>
      </view>
    </view>
  </view>

  <view class="ui-group-title">协议与隐私</view>
  <view class="ui-panel">
    <view class="ui-panel-body ui-panel-body-flush">
      <view class="ui-row" bindtap="goUserAgreement" hover-class="hover-fade">
        <view class="ui-row-main">
          <view class="ui-row-title">用户协议</view>
          <view class="ui-row-desc">预约、报到、取消与用户行为规范</view>
        </view>
        <view class="ui-chev">›</view>
      </view>
      <view class="ui-row" bindtap="goPrivacyPolicy" hover-class="hover-fade">
        <view class="ui-row-main">
          <view class="ui-row-title">隐私政策</view>
          <view class="ui-row-desc">我们收集哪些信息、如何使用与保护</view>
        </view>
        <view class="ui-chev">›</view>
      </view>
    </view>
  </view>

  <view class="ui-group-title">其他</view>
  <view class="ui-panel">
    <view class="ui-panel-body ui-panel-body-flush">
      <view class="ui-row" bindtap="goHelp" hover-class="hover-fade">
        <view class="ui-row-main"><view class="ui-row-title">帮助中心</view></view>
        <view class="ui-chev">›</view>
      </view>
      <view class="ui-row" bindtap="goContact" hover-class="hover-fade">
        <view class="ui-row-main"><view class="ui-row-title">联系我们</view></view>
        <view class="ui-chev">›</view>
      </view>
      <view class="ui-row" bindtap="clearCache" hover-class="hover-fade">
        <view class="ui-row-main"><view class="ui-row-title">清除缓存</view></view>
        <view class="ui-chev">›</view>
      </view>
      <view class="ui-row" bindtap="checkUpdate" hover-class="hover-fade">
        <view class="ui-row-main"><view class="ui-row-title">检查更新</view></view>
        <view class="ui-chev">›</view>
      </view>
      <view class="ui-row" bindtap="showAbout" hover-class="hover-fade">
        <view class="ui-row-main"><view class="ui-row-title">关于我们</view></view>
        <view class="ui-row-val">v{{version}}</view>
      </view>
    </view>
  </view>

  <view class="settings-footer">长辈模式可随时关闭，不影响其他功能</view>
</view>
