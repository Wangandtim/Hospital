.settings-page { min-height: 100vh; padding-top: 4rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }

.settings-tip {
  margin: 0 26rpx 20rpx;
  padding: 16rpx 20rpx;
  background: var(--tint);
  border-radius: var(--r-sm);
  font-size: 24rpx;
  color: var(--primary);
}
.settings-footer {
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-4);
  margin-top: 24rpx;
}
