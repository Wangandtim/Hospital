.login-page {
  min-height: 100vh;
  padding: 56rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}
.login-arc {
  position: absolute;
  right: -220rpx;
  top: -160rpx;
  width: 620rpx;
  height: 620rpx;
  border: 1rpx solid #E5D7BC;
  border-radius: 50%;
  opacity: 0.9;
  pointer-events: none;
}
.login-arc::after {
  content: "";
  position: absolute;
  inset: 48rpx;
  border: 1rpx solid #EFE7D6;
  border-radius: 50%;
}
.login-inner { position: relative; z-index: 1; }

.login-brand { display: flex; flex-direction: column; align-items: flex-start; }
.login-crest {
  width: 76rpx; height: 76rpx;
  border-radius: 22rpx;
  background: #0F5B50;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 20rpx;
}
.login-crest-cross { position: relative; width: 32rpx; height: 32rpx; }
.login-crest-cross::before,
.login-crest-cross::after { content: ""; position: absolute; background: #fff; border-radius: 2rpx; }
.login-crest-cross::before { left: 50%; top: 0; width: 6rpx; height: 32rpx; margin-left: -3rpx; }
.login-crest-cross::after { top: 50%; left: 0; height: 6rpx; width: 32rpx; margin-top: -3rpx; }
.login-brand-word {
  font-size: 44rpx;
  letter-spacing: 0.1em;
  color: #171D1B;
  line-height: 1.1;
}
.login-brand-rule { width: 40rpx; height: 3rpx; background: #A8874F; margin-top: 14rpx; }
.login-brand-sub { font-size: 22rpx; letter-spacing: 0.24em; color: #8A938F; margin-top: 12rpx; }

.login-title-wrap { margin-top: 72rpx; }
.login-eyebrow { margin-bottom: 18rpx; }
.login-title {
  font-size: 68rpx;
  line-height: 1.28;
  letter-spacing: -0.045em;
  color: #171D1B;
}
.login-desc {
  font-size: 26rpx;
  color: #8A938F;
  margin-top: 16rpx;
  line-height: 1.75;
}

.login-panel {
  margin-top: 56rpx;
  background: #FFFDFA;
  border: 1rpx solid #E5E5DE;
  border-radius: 40rpx;
  padding: 32rpx 32rpx 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(23, 29, 27, 0.05);
}
.login-inst {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #E5E5DE;
  margin-bottom: 24rpx;
}
.login-inst .ui-inst-crest { width: 72rpx; height: 72rpx; border-radius: 18rpx; }
.login-inst .ui-inst-crest-cross { width: 28rpx; height: 28rpx; }
.login-inst .ui-inst-crest-cross::before { height: 28rpx; width: 5rpx; margin-left: -2.5rpx; }
.login-inst .ui-inst-crest-cross::after { width: 28rpx; height: 5rpx; margin-top: -2.5rpx; }
.login-inst-name { font-size: 32rpx; color: #171D1B; }
.login-inst .ui-micro { margin-top: 4rpx; }

.login-segment { margin-bottom: 32rpx; }

.login-input { flex: 1; height: 92rpx; font-size: 32rpx; color: #171D1B; }
.login-ph { color: #B6BDB9; }

.login-code-row { display: flex; align-items: center; gap: 16rpx; }
.login-code-input { flex: 1; }
.login-code-btn {
  height: 96rpx;
  padding: 0 26rpx;
  border-radius: 24rpx;
  border: 1rpx solid #0F5B50;
  color: #0F5B50;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #FFFDFA;
}
.login-code-btn-disabled { border-color: #E5E5DE; color: #B6BDB9; }

.login-mode {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #87672F;
  padding: 8rpx 0 28rpx;
}
.login-mode-line { width: 28rpx; height: 2rpx; background: #A8874F; }

.login-doctor-tip { font-size: 24rpx; color: #8A938F; padding-bottom: 24rpx; }

.login-submit {
  width: 100%;
  margin-top: 8rpx;
  letter-spacing: 0.08em;
}

.login-links {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-top: 28rpx;
  font-size: 26rpx;
}
.login-link { color: #0F5B50; }
.login-link-muted { color: #8A938F; }
.login-sep { width: 1rpx; height: 24rpx; background: #E5E5DE; }

.login-trust {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 36rpx;
  margin-top: 40rpx;
  font-size: 22rpx;
  color: #8A938F;
  letter-spacing: 0.06em;
}
.login-trust-item { display: flex; align-items: center; gap: 8rpx; }
.login-trust-dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: #A8874F; }

.login-aux {
  margin-top: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 22rpx;
  color: #B6BDB9;
}
.login-aux-sep { color: #D4D7D0; }
