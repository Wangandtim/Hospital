/* 登录页 · official-v4 深青 / 暖纸 */
.login-page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  padding-top: 16rpx;
  background: var(--primary);
}
.login-inner { position: relative; z-index: 1; }

/* 三段式背景：顶部深青纯色 → 渐变 → 实景照片 */
.login-bg {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  background: var(--primary);
  overflow: hidden;
}
.login-bg-media {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
}
.login-bg-solid {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 40vh;
  z-index: 1;
  background: linear-gradient(180deg, #0F5B50 0%, #0F5B50 60%, rgba(15, 91, 80, 0) 100%);
}
.login-bg-scrim {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  background: linear-gradient(
    180deg,
    rgba(15, 91, 80, 0.62) 0%,
    rgba(15, 91, 80, 0.34) 34%,
    rgba(15, 91, 80, 0.16) 54%,
    rgba(15, 91, 80, 0.52) 100%
  );
}

/* 右上装饰弧线：1px 线稿语言，只留极轻的金色内圈 */
.login-arc {
  position: absolute;
  right: -240rpx;
  top: -200rpx;
  z-index: 1;
  width: 680rpx;
  height: 680rpx;
  border: 1rpx solid rgba(255, 253, 250, 0.16);
  border-radius: 50%;
  pointer-events: none;
}
.login-arc::after {
  content: "";
  position: absolute;
  inset: 56rpx;
  border: 1rpx solid rgba(228, 207, 169, 0.45);
  border-radius: 50%;
  opacity: 0.55;
}

/* 深青底上的品牌与标题 */
.login-page .ui-brand-word { color: #FFFDFA; }
.login-page .ui-brand-sub { color: rgba(255, 253, 250, 0.66); }
.login-page .ui-brand-rule { background: rgba(255, 253, 250, 0.7); }
.login-page .ui-eyebrow { color: #E4CFA9; }

.login-head { padding: 20rpx 0 4rpx; align-items: center; }
.login-crest {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 253, 250, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.login-crest-img { width: 52rpx; height: 52rpx; display: block; }

.login-hero { margin-top: 28rpx; }
.login-desc {
  margin-top: 12rpx;
  max-width: 600rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: rgba(255, 253, 250, 0.72);
}

.login-panel {
  margin-top: 30rpx;
  box-shadow: 0 24rpx 64rpx rgba(6, 38, 33, 0.26);
}
.login-body { padding: 30rpx 30rpx 32rpx; }

.login-segment { margin-bottom: 30rpx; }

/* 微信一键登录 */
.login-wechat {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  margin-bottom: 6rpx;
  background: var(--tint-2);
  border: 1rpx solid var(--tint);
  border-radius: var(--r-md);
  transition: transform 0.12s ease, opacity 0.12s ease, background-color 0.12s ease;
}
.login-wechat-ico {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  font-family: var(--font-serif);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.login-wechat-main { flex: 1; min-width: 0; }
.login-wechat-title { font-size: 30rpx; font-weight: 600; color: var(--primary); }

.login-or {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 24rpx 0 18rpx;
}
.login-or-line { flex: 1; height: 1rpx; background: var(--line); }
.login-or text { font-size: var(--fs-micro); color: var(--ink-4); flex-shrink: 0; letter-spacing: 0.06em; }

/* 表单 */
.login-field { margin-bottom: 24rpx; }
.login-field .ui-field-label { transition: color 0.12s ease; }
.login-field.is-focus .ui-field-label { color: var(--primary); }
.login-field.is-error .ui-field-label { color: var(--danger); }

.login-input-box {
  transition: border-color 0.12s ease, background-color 0.12s ease;
}
.login-input-box.ui-input-focus {
  border-color: var(--primary);
  background: var(--surface);
}
.login-input { flex: 1; height: 92rpx; font-size: var(--fs-h3); color: var(--ink); }
.login-ph { color: var(--ink-4); }

.login-code-row { display: flex; align-items: center; gap: 14rpx; }
.login-code-input { flex: 1; }
.login-code-btn {
  height: 96rpx;
  padding: 0 24rpx;
  border-radius: var(--r-md);
  border: 1rpx solid var(--primary);
  color: var(--primary);
  font-size: var(--fs-caption);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--surface);
  transition: transform 0.12s ease, opacity 0.12s ease, border-color 0.12s ease, color 0.12s ease;
}
.login-code-btn-disabled { border-color: var(--line); color: var(--ink-4); }

.login-mode {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: var(--fs-caption);
  color: var(--gold-ink);
  padding: 2rpx 0 26rpx;
}
.login-mode-line { width: 28rpx; height: 2rpx; background: var(--gold); }

.login-form-msg { margin: 0 0 18rpx; }

.login-submit {
  width: 100%;
  letter-spacing: 0.06em;
  transition: transform 0.12s ease, opacity 0.12s ease, background-color 0.12s ease;
}
.login-press { transform: scale(0.982) translateY(2rpx); opacity: 0.94; }

.login-links {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-top: 26rpx;
  font-size: var(--fs-caption);
}
.login-link { color: var(--primary); transition: opacity 0.12s ease; }
.login-link-muted { color: var(--ink-3); }
.login-sep { width: 1rpx; height: 24rpx; background: var(--line); }

.login-aux {
  margin-top: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: var(--fs-micro);
  color: rgba(255, 253, 250, 0.66);
}
.login-aux-sep { color: rgba(255, 253, 250, 0.34); }

/* 长辈模式：字号与热区只增不减 */
.login-page.elderly .ui-brand-word { font-size: 48rpx; }
.login-page.elderly .ui-brand-sub { font-size: 26rpx; }
.login-page.elderly .login-crest { width: 84rpx; height: 84rpx; border-radius: 20rpx; }
.login-page.elderly .login-crest-img { width: 60rpx; height: 60rpx; }
.login-page.elderly .login-desc { font-size: 32rpx; margin-top: 14rpx; }
.login-page.elderly .login-body { padding: 34rpx 32rpx 36rpx; }
.login-page.elderly .ui-seg { height: 76rpx; font-size: 30rpx; }
.login-page.elderly .login-wechat { padding: 28rpx; }
.login-page.elderly .login-wechat-ico { width: 76rpx; height: 76rpx; font-size: 32rpx; }
.login-wechat-ico-img { width: 40rpx; height: 40rpx; display: block; }
.login-page.elderly .login-wechat-ico-img { width: 48rpx; height: 48rpx; }
.login-page.elderly .login-wechat-title { font-size: 36rpx; }
.login-page.elderly .ui-field-label { font-size: 30rpx; }
.login-page.elderly .login-input-box { height: 108rpx; }
.login-page.elderly .login-input { height: 104rpx; font-size: 36rpx; }
.login-page.elderly .login-code-btn { height: 108rpx; font-size: 30rpx; }
.login-page.elderly .login-mode { font-size: 30rpx; padding-bottom: 30rpx; }
.login-page.elderly .login-submit { height: 116rpx; font-size: 40rpx; }
.login-page.elderly .login-links { font-size: 30rpx; margin-top: 30rpx; }
.login-page.elderly .login-aux { font-size: 26rpx; }
