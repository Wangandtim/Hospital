<view class="container">
  <view class="header">
    <view class="back-btn" bindtap="goBack" hover-class="hover-fade">
      <text class="back-icon">←</text>
    </view>
    <view class="title">医生管理</view>
    <view class="add-btn" bindtap="openAddModal" hover-class="hover-scale">+ 添加</view>
  </view>

  <view class="search-bar">
    <input class="search-input" placeholder="搜索医生姓名/编号" bindinput="onSearchInput" value="{{searchKeyword}}" />
  </view>

  <view class="hospital-groups" wx:if="{{hospitalGroups.length > 0}}">
    <view class="hospital-group" wx:for="{{hospitalGroups}}" wx:key="hospitalId">
      <view class="hospital-header" bindtap="toggleHospital" data-hospital-id="{{item.hospitalId}}" hover-class="hover-fade">
        <view class="hospital-name">{{item.hospitalName}}</view>
        <view class="doctor-count">共 {{item.doctors.length}} 位医生</view>
        <view class="expand-icon">{{expandedHospital === item.hospitalId ? '▼' : '▶'}}</view>
      </view>
      <view class="dept-groups" wx:if="{{expandedHospital === item.hospitalId || !expandedHospital}}">
        <view class="dept-group" wx:for="{{item.deptGroups}}" wx:key="deptId" wx:for-item="deptGroup">
          <view class="dept-header">
            <view class="dept-name">{{deptGroup.deptName}}</view>
            <view class="dept-count">{{deptGroup.doctors.length}}人</view>
          </view>
          <view class="doctor-list">
            <view class="doctor-card" wx:for="{{deptGroup.doctors}}" wx:key="doctorId" wx:for-item="doctor">
              <image class="doctor-avatar" src="/images/icons/ic-doctor-14b8a6.png" mode="aspectFit" />
              <view class="doctor-info">
                <view class="doctor-header">
                  <view class="doctor-name">{{doctor.name}}</view>
                  <view class="doctor-title">{{doctor.title}}</view>
                </view>
                <view class="doctor-meta">
                  <text class="meta-tag">{{item.hospitalName}}</text>
                  <text class="meta-tag">{{deptGroup.deptName}}</text>
                </view>
                <view class="doctor-detail">
                  <text class="detail-item">专长：{{doctor.expertise || '暂无'}}</text>
                  <text class="detail-divider">|</text>
                  <text class="detail-item">挂号费：¥{{doctor.consultationFee || 30}}</text>
                </view>
              </view>
              <view class="doctor-actions">
                <view class="action-btn action-edit" bindtap="openEditModal" data-doctor="{{doctor}}" hover-class="hover-fade">编辑</view>
                <view class="action-btn action-delete" bindtap="deleteDoctor" data-doctor="{{doctor}}" hover-class="hover-fade">删除</view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-tip" wx:if="{{hospitalGroups.length === 0}}">
    <text>暂无医生数据</text>
  </view>

  <view class="modal" wx:if="{{showAddModal}}">
    <view hover-class="hover-press" hover-stay-time="150" class="modal-mask" bindtap="closeModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text>{{editingDoctor ? '编辑医生' : '添加医生'}}</text>
        <view class="modal-close" bindtap="closeModal" hover-class="hover-fade">
          <image class="modal-close-icon" src="/images/icons/ic-close-94aeab.png" mode="aspectFit" />
        </view>
      </view>
      <view class="modal-body">
        <view class="form-item" wx:if="!editingDoctor">
          <view class="form-label">所属医院 *</view>
          <picker mode="selector" range="{{hospitalList}}" range-key="hospitalName" bindchange="onHospitalSelectChange">
            <view class="picker-value">{{selectedHospitalName}}</view>
          </picker>
        </view>
        <view class="form-item">
          <view class="form-label">科室 *</view>
          <picker mode="selector" range="{{departments}}" range-key="deptName" bindchange="onDeptChange">
            <view class="picker-value">{{selectedDeptName}}</view>
          </picker>
        </view>
        <view class="form-item">
          <view class="form-label">姓名 *</view>
          <input class="form-input" data-field="name" bindinput="onFormInput" value="{{formData.name}}" placeholder="请输入医生姓名" />
        </view>
        <view class="form-item">
          <view class="form-label">职称 *</view>
          <input class="form-input" data-field="title" bindinput="onFormInput" value="{{formData.title}}" placeholder="如：主任医师、主治医师" />
        </view>
        <view class="form-item">
          <view class="form-label">专业特长</view>
          <input class="form-input" data-field="expertise" bindinput="onFormInput" value="{{formData.expertise}}" placeholder="如：心血管疾病、高血压" />
        </view>
        <view class="form-item">
          <view class="form-label">性别</view>
          <radio-group bindchange="onGenderChange">
            <label class="radio-label"><radio value="M" checked="{{formData.gender === 'M'}}" /> 男</label>
            <label class="radio-label"><radio value="F" checked="{{formData.gender === 'F'}}" /> 女</label>
          </radio-group>
        </view>
        <view class="form-item">
          <view class="form-label">联系电话</view>
          <input class="form-input" data-field="phone" bindinput="onFormInput" value="{{formData.phone}}" placeholder="请输入联系电话" />
        </view>
        <view class="form-item">
          <view class="form-label">挂号费（元）</view>
          <input class="form-input" type="number" data-field="consultationFee" bindinput="onFormInput" value="{{formData.consultationFee}}" placeholder="请输入挂号费" />
        </view>
      </view>
      <view class="modal-footer">
        <button class="btn-cancel" bindtap="closeModal" hover-class="hover-fade">取消</button>
        <button class="btn-confirm" bindtap="submitDoctor" hover-class="hover-scale">保存</button>
      </view>
    </view>
  </view>
</view>