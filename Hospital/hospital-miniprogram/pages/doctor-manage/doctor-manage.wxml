<view class="ui-page docm-page">
  <view class="docm-top">
    <view class="ui-back" bindtap="goBack" hover-class="hover-fade">←</view>
    <view class="ui-btn ui-btn-primary ui-btn-sm" bindtap="openAddModal" hover-class="hover-scale">＋ 添加</view>
  </view>

  <view class="ui-title-block docm-title">
    <view class="ui-eyebrow ui-eyebrow-gold">DOCTORS</view>
    <view class="ui-title">医生管理</view>
    <view class="ui-subtitle">共 {{doctors.length}} 位医生</view>
  </view>

  <view class="ui-search docm-search">
    <view class="ui-search-ico"></view>
    <input class="docm-search-input" placeholder="搜索医生姓名 / 编号" bindinput="onSearchInput" value="{{searchKeyword}}" />
  </view>

  <view class="docm-groups" wx:if="{{hospitalGroups.length > 0}}">
    <view class="ui-panel docm-group" wx:for="{{hospitalGroups}}" wx:key="hospitalId">
      <view class="docm-hospital" bindtap="toggleHospital" data-hospital-id="{{item.hospitalId}}" hover-class="hover-fade">
        <view class="ui-plate docm-plate-text">院</view>
        <view class="ui-row-main">
          <view class="docm-hospital-name">{{item.hospitalName}}</view>
          <view class="ui-row-desc">共 {{item.doctors.length}} 位医生</view>
        </view>
        <view class="ui-icon-btn docm-toggle">{{expandedHospital === item.hospitalId ? '▼' : '▶'}}</view>
      </view>

      <view class="docm-depts" wx:if="{{expandedHospital === item.hospitalId || !expandedHospital}}">
        <view class="docm-dept" wx:for="{{item.deptGroups}}" wx:key="deptId" wx:for-item="deptGroup">
          <view class="docm-dept-head">
            <view class="ui-plate">
              <image class="ui-plate-img" src="{{deptGroup.deptIcon}}" mode="aspectFit" />
            </view>
            <view class="docm-dept-name">{{deptGroup.deptName}}</view>
            <view class="ui-tag">{{deptGroup.doctors.length}} 人</view>
          </view>

          <view class="docm-doc" wx:for="{{deptGroup.doctors}}" wx:key="doctorId" wx:for-item="doctor">
            <view class="ui-doctor-ava docm-ava">医</view>
            <view class="docm-doc-main">
              <view class="docm-name-row">
                <text class="docm-name">{{doctor.name}}</text>
                <view class="ui-tag">{{doctor.title}}</view>
              </view>
              <view class="docm-tags">
                <view class="ui-tag">{{item.hospitalName}}</view>
                <view class="ui-tag">{{deptGroup.deptName}}</view>
              </view>
              <view class="docm-detail">专长：{{doctor.expertise || '暂无'}}</view>
              <view class="docm-detail">挂号费：¥{{doctor.consultationFee || 30}}</view>
            </view>
            <view class="docm-doc-actions">
              <view class="ui-btn ui-btn-outline ui-btn-sm" bindtap="openEditModal" data-doctor="{{doctor}}" hover-class="hover-fade">编辑</view>
              <view class="ui-btn ui-btn-danger ui-btn-sm" bindtap="deleteDoctor" data-doctor="{{doctor}}" hover-class="hover-fade">删除</view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="ui-empty" wx:if="{{hospitalGroups.length === 0}}">
    <view class="ui-empty-mark">医</view>
    <view class="ui-empty-title">暂无医生数据</view>
    <view class="ui-empty-hint">添加医生，或调整搜索关键词</view>
  </view>

  <view class="docm-mask" wx:if="{{showAddModal}}" bindtap="closeModal"></view>
  <view class="docm-sheet" wx:if="{{showAddModal}}">
    <view class="docm-sheet-head">
      <view class="docm-sheet-title">{{editingDoctor ? '编辑医生' : '添加医生'}}</view>
      <view class="ui-icon-btn docm-close" bindtap="closeModal" hover-class="hover-fade">×</view>
    </view>

    <view class="docm-sheet-body">
      <view class="ui-field" wx:if="!editingDoctor">
        <view class="ui-field-label">所属医院 *</view>
        <picker mode="selector" range="{{hospitalList}}" range-key="hospitalName" bindchange="onHospitalSelectChange">
          <view class="ui-input docm-picker">
            <text class="docm-picker-text">{{selectedHospitalName}}</text>
            <text class="ui-chev">▾</text>
          </view>
        </picker>
      </view>
      <view class="ui-field">
        <view class="ui-field-label">科室 *</view>
        <picker mode="selector" range="{{departments}}" range-key="deptName" bindchange="onDeptChange">
          <view class="ui-input docm-picker docm-dept-picker">
            <view class="ui-plate sm">
              <image class="ui-plate-img" src="{{selectedDeptIcon}}" mode="aspectFit" />
            </view>
            <text class="docm-picker-text">{{selectedDeptName}}</text>
            <text class="ui-chev">▾</text>
          </view>
        </picker>
      </view>
      <view class="ui-field">
        <view class="ui-field-label">姓名 *</view>
        <input class="ui-input docm-input" data-field="name" bindinput="onFormInput" value="{{formData.name}}" placeholder="请输入医生姓名" />
      </view>
      <view class="ui-field">
        <view class="ui-field-label">职称 *</view>
        <input class="ui-input docm-input" data-field="title" bindinput="onFormInput" value="{{formData.title}}" placeholder="如：主任医师、主治医师" />
      </view>
      <view class="ui-field">
        <view class="ui-field-label">专业特长</view>
        <input class="ui-input docm-input" data-field="expertise" bindinput="onFormInput" value="{{formData.expertise}}" placeholder="如：心血管疾病、高血压" />
      </view>
      <view class="ui-field">
        <view class="ui-field-label">性别</view>
        <radio-group class="docm-radio-group" bindchange="onGenderChange">
          <label class="docm-radio-label"><radio value="M" checked="{{formData.gender === 'M'}}" color="#0F5B50" /> 男</label>
          <label class="docm-radio-label"><radio value="F" checked="{{formData.gender === 'F'}}" color="#0F5B50" /> 女</label>
        </radio-group>
      </view>
      <view class="ui-field">
        <view class="ui-field-label">联系电话</view>
        <input class="ui-input docm-input" data-field="phone" bindinput="onFormInput" value="{{formData.phone}}" placeholder="请输入联系电话" />
      </view>
      <view class="ui-field">
        <view class="ui-field-label">挂号费（元）</view>
        <input class="ui-input docm-input" type="number" data-field="consultationFee" bindinput="onFormInput" value="{{formData.consultationFee}}" placeholder="请输入挂号费" />
      </view>
    </view>

    <view class="docm-sheet-actions">
      <button class="ui-btn ui-btn-outline" bindtap="closeModal" hover-class="hover-fade">取消</button>
      <button class="ui-btn ui-btn-primary" bindtap="submitDoctor" hover-class="hover-scale">保存</button>
    </view>
  </view>
</view>
