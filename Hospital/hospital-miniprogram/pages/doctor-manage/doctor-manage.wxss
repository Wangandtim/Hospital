.docm-page { padding-top: 8rpx; padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }

.docm-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-top: 24rpx;
}
.docm-top .ui-back { margin-bottom: 0; }

.docm-title { padding-top: 24rpx; }

.docm-search { margin-bottom: 24rpx; height: 96rpx; }

.docm-search-input {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  color: var(--ink);
}

.docm-groups { display: flex; flex-direction: column; gap: 20rpx; }

.docm-group { margin-bottom: 0; }

.docm-hospital {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 116rpx;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid var(--line);
}

.docm-plate-text {
  font-family: var(--font-serif);
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--primary);
}

.docm-hospital-name {
  font-family: var(--font-serif);
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
  line-height: 1.35;
}

.docm-toggle { flex-shrink: 0; font-size: var(--fs-caption); color: var(--ink-3); }

.docm-depts { padding: 24rpx; display: flex; flex-direction: column; gap: 22rpx; }

.docm-dept {
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  overflow: hidden;
  background: var(--surface-2);
}

.docm-dept-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 100rpx;
  padding: 16rpx 22rpx;
  background: var(--surface);
  border-bottom: 1rpx solid var(--line);
}

.docm-dept-name {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.docm-doc {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx;
  background: var(--surface);
}
.docm-doc + .docm-doc { border-top: 1rpx solid var(--line); }

.docm-ava { width: 80rpx; height: 80rpx; font-size: var(--fs-body); }

.docm-doc-main { flex: 1; min-width: 0; }

.docm-name-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  flex-wrap: wrap;
}

.docm-name {
  font-family: var(--font-serif);
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
}

.docm-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.docm-detail {
  font-size: var(--fs-micro);
  color: var(--ink-3);
  margin-top: 6rpx;
  line-height: 1.6;
}

.docm-doc-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex-shrink: 0;
}

.docm-mask {
  position: fixed;
  inset: 0;
  background: rgba(23, 29, 27, 0.48);
  z-index: 30;
}

.docm-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 90vh;
  overflow-y: auto;
  background: var(--surface);
  border-radius: var(--r-lg) var(--r-lg) 0 0;
  padding: 30rpx var(--gutter) calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  z-index: 40;
  animation: ui-rise 0.24s ease both;
}

.docm-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 24rpx;
}

.docm-sheet-title {
  font-family: var(--font-serif);
  font-size: var(--fs-h2);
  color: var(--ink);
}

.docm-close { flex-shrink: 0; }

.docm-sheet-body { padding-bottom: 8rpx; }

.docm-input { width: 100%; box-sizing: border-box; }

.docm-picker {
  justify-content: space-between;
  gap: 12rpx;
  color: var(--ink);
}

.docm-dept-picker { justify-content: flex-start; }

.docm-picker-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.docm-radio-group {
  display: flex;
  align-items: center;
  gap: 32rpx;
  min-height: 96rpx;
  padding: 0 4rpx;
}

.docm-radio-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: var(--fs-body);
  color: var(--ink);
}

.docm-sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}
.docm-sheet-actions .ui-btn { flex: 1; }
