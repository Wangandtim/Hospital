<view class="ui-page hospital-page">
  <view class="ui-flow hospital-flow">
    <view class="ui-flow-bars">
      <i class="now"></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
    </view>
    <view class="ui-flow-meta">
      <b>01</b><text>/ 08</text>
      <text class="name">选择医院</text>
    </view>
  </view>

  <view class="ui-title-block">
    <view class="ui-eyebrow ui-eyebrow-gold">HOSPITAL DIRECTORY</view>
    <view class="ui-title">选择医院</view>
    <view class="ui-subtitle">共 {{pager.total || 0}} 家合作医院，按距离与地区筛选</view>
  </view>

  <view class="hospital-filter">
    <view class="hospital-filter-bar" bindtap="toggleFilterPanel">
      <view class="hospital-filter-text">
        {{selectedProvince || selectedCity || selectedDistrict ? (selectedProvince + ' ' + selectedCity + ' ' + selectedDistrict) : '地区筛选'}}
      </view>
      <view class="hospital-filter-arrow">{{showFilterPanel ? '收起' : '筛选'}}</view>
    </view>

    <view class="ui-panel hospital-filter-panel" wx:if="{{showFilterPanel}}">
      <view class="ui-panel-body ui-panel-body-flush">
        <view class="ui-row">
          <view class="ui-row-label">省份</view>
          <picker class="hospital-picker" mode="selector" range="{{provinces}}" value="{{provinceIndex}}" bindchange="onProvinceChange">
            <view class="ui-row-val">{{selectedProvince || '全部'}} <text class="ui-chev">›</text></view>
          </picker>
        </view>
        <view class="ui-row">
          <view class="ui-row-label">城市</view>
          <picker class="hospital-picker" mode="selector" range="{{cities}}" value="{{cityIndex}}" bindchange="onCityChange" disabled="{{!selectedProvince}}">
            <view class="ui-row-val">{{selectedCity || '全部'}} <text class="ui-chev">›</text></view>
          </picker>
        </view>
        <view class="ui-row">
          <view class="ui-row-label">区县</view>
          <picker class="hospital-picker" mode="selector" range="{{districts}}" value="{{districtIndex}}" bindchange="onDistrictChange" disabled="{{!selectedCity}}">
            <view class="ui-row-val">{{selectedDistrict || '全部'}} <text class="ui-chev">›</text></view>
          </picker>
        </view>
      </view>
    </view>

    <view class="hospital-filter-actions" wx:if="{{showFilterPanel || selectedProvince || selectedCity || selectedDistrict}}">
      <view class="ui-btn ui-btn-outline ui-btn-sm" bindtap="clearFilter">清除筛选</view>
      <view class="ui-btn ui-btn-primary ui-btn-sm" bindtap="toggleFilterPanel">完成</view>
    </view>
  </view>

  <view class="hospital-list">
    <view
      class="hospital-card ui-rise"
      wx:for="{{hospitals}}"
      wx:key="hospitalId"
      bindtap="selectHospital"
      data-hospital="{{item}}"
      hover-class="hover-card"
    >
      <view class="hospital-card-top">
        <view class="ui-inst-crest"><image class="ui-inst-crest-img" src="/assets/logo/logo-mark-reverse-64.png" mode="aspectFit" /></view>
        <view class="hospital-card-main">
          <view class="hospital-card-name">{{item.hospitalName}}</view>
          <view class="hospital-card-tags">
            <view class="ui-tag ui-tag-gold">{{item.levelText}}</view>
            <view class="ui-tag">{{item.distanceText}}</view>
            <view class="ui-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="index">{{tag}}</view>
          </view>
        </view>
        <view class="hospital-card-select">选择</view>
      </view>
      <view class="hospital-card-meta">{{item.addressText}}</view>
      <view class="hospital-card-foot">
        <view class="hospital-card-meta-small">门诊 {{item.serviceTime}} · 总机 {{item.switchboard}}</view>
        <view class="hospital-card-region">{{item.regionText}}</view>
      </view>
    </view>

    <ui-empty
      wx:if="{{pager.status === 'empty'}}"
      mark="院"
      title="没有符合条件的医院"
      hint="试试放宽地区筛选，或到「周边医院」按距离查找"
    />

    <view wx:if="{{isLoading && hospitals.length === 0}}">
      <view class="ui-skeleton ui-skeleton-card" wx:for="{{[1,2,3]}}" wx:key="index"></view>
    </view>

    <view bindtap="onReachBottom">
      <ui-pager
        status="{{pager.status}}"
        hasMore="{{pager.hasMore}}"
        total="{{pager.total}}"
        error="{{pager.error}}"
        bindretry="retryLoad"
      />
    </view>
  </view>
</view>
