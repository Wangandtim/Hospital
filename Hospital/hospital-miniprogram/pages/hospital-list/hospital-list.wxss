.container {
  min-height: 100vh;
  background-color: #f0fdfa;
}

.filter-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #e6fffa;
}

.filter-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.filter-text {
  flex: 1;
  font-size: 28rpx;
  color: #143634;
}

.filter-arrow {
  font-size: 24rpx;
  color: #94aeab;
}

.filter-panel {
  background-color: #ffffff;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #e6fffa;
}

.filter-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.filter-label {
  width: 120rpx;
  font-size: 28rpx;
  color: #5b7c7a;
}

.picker-value {
  flex: 1;
  font-size: 28rpx;
  color: #143634;
  padding: 15rpx;
  background-color: #f0fdfa;
  border: 1rpx solid #e6fffa;
  border-radius: 16rpx;
  text-align: center;
}

.filter-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.btn-clear, .btn-confirm {
  flex: 1;
  padding: 20rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  border: none;
}

.btn-clear {
  background-color: #ecfdf9;
  border: 1rpx solid #ccfbf1;
  color: #0f766e;
}

.btn-confirm {
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(13, 148, 136, 0.24);
}

.hospital-list {
  padding: 20rpx;
}

.hospital-item {
  display: flex;
  background-color: #ffffff;
  padding: 30rpx;
  margin-bottom: 24rpx;
  border-radius: 36rpx;
  border: 1rpx solid #e6fffa;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.14);
}

.hospital-info {
  flex: 1;
}

.hospital-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #143634;
  margin-bottom: 10rpx;
}

.hospital-level {
  display: inline-flex; align-items: center; justify-content: center;
  background-color: #ecfdf9;
  color: #0f766e;
  border: 1rpx solid #ccfbf1;
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  margin-bottom: 10rpx;
}

.hospital-address {
  font-size: 26rpx;
  color: #5b7c7a;
  margin-bottom: 10rpx;
}

.hospital-region {
  font-size: 24rpx;
  color: #94aeab;
  margin-bottom: 10rpx;
}

.hospital-phone {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #5b7c7a;
}

.phone-icon {
  width: 26rpx;
  height: 26rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.hospital-action {
  display: flex;
  align-items: center;
  justify-content: center;
}

.select-btn 
{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  color: #ffffff;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  box-shadow: 0 8rpx 20rpx rgba(13, 148, 136, 0.24);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 20rpx;
  opacity: 0.7;
}

.empty-text {
  font-size: 28rpx;
  color: #94aeab;
}

.loading {
  display: flex;
  justify-content: center;
  padding: 40rpx;
}

.loading text {
  font-size: 28rpx;
  color: #94aeab;
}

.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  background-color: #ffffff;
  margin-top: 20rpx;
  border-top: 1rpx solid #e6fffa;
}

.page-btn {
  padding: 14rpx 30rpx;
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.page-btn.disabled {
  background: #e6fffa;
  color: #94aeab;
  box-shadow: none;
}

.page-info {
  margin: 0 30rpx;
  text-align: center;
}

.page-info text {
  display: block;
  font-size: 26rpx;
  color: #143634;
}

.total-count {
  font-size: 24rpx;
  color: #94aeab;
  margin-top: 5rpx;
}
