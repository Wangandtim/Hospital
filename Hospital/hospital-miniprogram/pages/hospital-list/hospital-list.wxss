.hospital-page { padding-top: 8rpx; }
.hospital-flow { margin: 0 calc(-1 * var(--gutter)) 20rpx; }

.hospital-filter { margin-bottom: 20rpx; }
.hospital-filter-bar {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  background: #FFFDFA;
  border: 1rpx solid #E5E5DE;
  border-radius: 20rpx;
}
.hospital-filter-text { font-size: 28rpx; color: #171D1B; flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.hospital-filter-arrow { font-size: 26rpx; color: #0F5B50; flex-shrink: 0; margin-left: 16rpx; }
.hospital-filter-panel { margin-top: 12rpx; margin-bottom: 0; }
.hospital-picker { flex-shrink: 0; }
.hospital-filter-actions { display: flex; gap: 16rpx; margin-top: 16rpx; }
.hospital-filter-actions .ui-btn { flex: 1; }

.hospital-card {
  background: #FFFDFA;
  border: 1rpx solid #E5E5DE;
  border-radius: 28rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 1rpx 2rpx rgba(23, 29, 27, 0.04);
}
.hospital-card-top { display: flex; align-items: flex-start; gap: 18rpx; }
.hospital-card .ui-inst-crest { width: 76rpx; height: 76rpx; border-radius: 18rpx; }
.hospital-card-main { flex: 1; min-width: 0; }
.hospital-card-name { font-family: "Songti SC", "Noto Serif SC", serif; font-size: 36rpx; font-weight: 600; line-height: 1.35; color: #171D1B; }
.hospital-card-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 10rpx; }
.hospital-card-select {
  flex-shrink: 0;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid #0F5B50;
  color: #0F5B50;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hospital-card-meta { font-size: 24rpx; color: #8A938F; margin-top: 14rpx; line-height: 1.6; }
.hospital-card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #EFEEE8;
}
.hospital-card-meta-small { font-size: 22rpx; color: #8A938F; flex: 1; min-width: 0; }
.hospital-card-region { font-size: 22rpx; color: #B6BDB9; flex-shrink: 0; }
