.container {
  min-height: 100vh;
  background: #f0fdfa;
  padding-bottom: 40rpx;
}

.header {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  padding: 30rpx;
  padding-top: calc(env(safe-area-inset-top) + 30rpx);
  position: relative;
  box-shadow: 0 10rpx 24rpx rgba(13, 148, 136, 0.22);
}

.back-btn {
  display: flex;
  align-items: center;
  color: #fff;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.back-text {
  font-size: 32rpx;
  margin-left: 12rpx;
  color: #fff;
}

.title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.card-section {
  padding: 30rpx;
}

.info-card {
  background: #fff;
  border-radius: 36rpx;
  padding: 40rpx;
  border: 1rpx solid #e6fffa;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.14);
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 40rpx;
  border-bottom: 1rpx solid #f0fdfa;
  margin-bottom: 40rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.avatar-img {
  width: 48rpx;
  height: 48rpx;
}

.name {
  font-size: 36rpx;
  font-weight: bold;
  color: #143634;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-label {
  font-size: 30rpx;
  color: #5b7c7a;
}

.info-value {
  font-size: 30rpx;
  color: #143634;
  font-weight: 500;
  text-align: right;
  max-width: 60%;
  word-break: break-all;
}

.btn-section {
  padding: 30rpx;
}

.btn-edit 
{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 30rpx;
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  border-radius: 999rpx;
  box-shadow: 0 10rpx 24rpx rgba(13, 148, 136, 0.28);
}

.btn-edit:active {
  opacity: 0.8;
}
