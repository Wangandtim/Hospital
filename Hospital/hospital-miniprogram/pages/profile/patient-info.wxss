page { background: var(--paper); }
.patient-archive-page { padding-top: 8rpx; padding-bottom: 48rpx; }
.archive-head { display: flex; align-items: center; gap: 20rpx; padding: 28rpx 26rpx 24rpx; }
.archive-avatar {
  width: 104rpx; height: 104rpx; border-radius: 50%;
  background: var(--tint-2); color: var(--primary);
  font-family: var(--font-serif); font-size: 42rpx;
  display: flex; align-items: center; justify-content: center;
}
.archive-name { font-size: 44rpx; color: var(--ink); }
.archive-edit { margin-top: 32rpx; }
