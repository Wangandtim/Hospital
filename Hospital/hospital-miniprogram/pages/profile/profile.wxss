.profile-page { min-height: 100vh; padding-top: 4rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }

.profile-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  padding: 30rpx 26rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-1);
}
.profile-ava {
  width: 104rpx; height: 104rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  font-family: var(--font-serif);
  font-size: 44rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.profile-main { flex: 1; min-width: 0; }
.profile-name {
  font-family: var(--font-serif);
  font-size: 42rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
}
.profile-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }
.profile-hint { font-size: 24rpx; color: var(--ink-3); margin-top: 10rpx; }

.profile-row-ico {
  width: 64rpx; height: 64rpx;
  border-radius: 18rpx;
  background: var(--tint-2);
  color: var(--primary);
  font-family: var(--font-serif);
  font-size: 26rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.profile-row-ico.gold { background: var(--gold-tint); color: var(--gold-ink); }
.profile-danger { color: var(--danger); }

.profile-version {
  text-align: center;
  padding: 32rpx 0 16rpx;
  font-size: 22rpx;
  color: var(--ink-4);
  letter-spacing: 0.06em;
}
