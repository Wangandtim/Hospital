.page {
  min-height: 100vh;
  background: #e2f0ec;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* 顶部个人信息 */
.profile-hero {
  position: relative;
  overflow: hidden;
  padding: 52rpx 36rpx 108rpx;
  background: #0b5e58;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.hero-overlay {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  background: linear-gradient(105deg, rgba(3, 52, 50, 0.86) 0%, rgba(4, 66, 62, 0.55) 55%, rgba(4, 66, 62, 0.16) 88%);
}

.hero-glow {
  position: absolute;
  top: -180rpx;
  right: -140rpx;
  width: 520rpx;
  height: 520rpx;
  border-radius: 50%;
  z-index: 1;
  background: radial-gradient(circle, rgba(45, 212, 191, 0.42) 0%, rgba(45, 212, 191, 0) 70%);
}

.user-row {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 26rpx;
}

.avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  border: 4rpx solid rgba(255, 255, 255, 0.68);
  background: rgba(255, 255, 255, 0.16);
  box-shadow: 0 16rpx 34rpx rgba(3, 52, 50, 0.34);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-icon {
  width: 62rpx;
  height: 62rpx;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
  line-height: 1.25;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.user-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tag-solid {
  font-size: 22rpx;
  font-weight: 600;
  color: #0f766e;
  background: #ffffff;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  line-height: 1.3;
}

.tag-ghost {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  line-height: 1.3;
}

.user-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.84);
  margin-top: 14rpx;
}

.btn-login {
  flex-shrink: 0;
  background: #ffffff;
  color: #0f766e;
  border: none;
  border-radius: 999rpx;
  padding: 14rpx 40rpx;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.4;
  box-shadow: 0 12rpx 26rpx rgba(3, 52, 50, 0.26);
}

.btn-login::after {
  border: none;
}

.btn-hover {
  transform: scale(0.94);
  opacity: 0.9;
}

/* 内容区：圆角上浮面板，避免标题被顶部图压住 */
.content {
  position: relative;
  z-index: 2;
  margin-top: -56rpx;
  padding: 40rpx 24rpx 0;
  background: #e2f0ec;
  border-radius: 40rpx 40rpx 0 0;
}

.menu-section {
  margin-bottom: 28rpx;
}

.menu-group-title {
  font-size: 25rpx;
  color: #4f7570;
  font-weight: 600;
  padding: 0 12rpx 14rpx;
  letter-spacing: 1rpx;
}

.menu-card {
  background: #ffffff;
  border-radius: 28rpx;
  border: 2rpx solid #b9ddd7;
  box-shadow: 0 10rpx 28rpx rgba(13, 148, 136, 0.12);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 22rpx 26rpx;
}

.menu-item + .menu-item {
  border-top: 2rpx solid #dcebe8;
}

.icon-chip {
  width: 52rpx;
  height: 52rpx;
  border-radius: 15rpx;
  background: linear-gradient(145deg, #e2faf5 0%, #c8f0e9 100%);
  border: 2rpx solid #9ed6cb;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.icon-chip.danger {
  background: #fef2f2;
  border-color: #fee2e2;
}

.menu-icon {
  width: 32rpx;
  height: 32rpx;
}

.menu-text {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  color: #143634;
  font-weight: 500;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.menu-text.danger {
  color: #ef4444;
}

.menu-value 
{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #0f766e;
  background: #effaf7;
  border: 2rpx solid #cdeae4;
  border-radius: 999rpx;
  padding: 5rpx 14rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.menu-arrow {
  flex-shrink: 0;
  font-size: 32rpx;
  color: #5d8b86;
  line-height: 1;
}

.menu-hover {
  background: #f4fbf9;
}

.version-info {
  text-align: center;
  padding: 32rpx 0 24rpx;
  font-size: 22rpx;
  color: #7b9b97;
  letter-spacing: 0.5rpx;
}
