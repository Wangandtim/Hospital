<view class="ui-page profile-page {{elderly ? 'elderly' : ''}}">
  <view class="ui-head">
    <view class="ui-brand">
      <view class="ui-brand-word">我的</view>
      <view class="ui-brand-rule"></view>
      <view class="ui-brand-sub">ACCOUNT · SMART HOSPITAL</view>
    </view>
    <view class="ui-icon-btn" bindtap="goToSettings">设置</view>
  </view>

  <view class="profile-card">
    <view class="profile-ava">{{initial}}</view>
    <view class="profile-main">
      <view class="profile-name">{{hasLogin ? (displayName || '微信用户') : '未登录'}}</view>
      <view class="profile-tags" wx:if="{{hasLogin}}">
        <view class="ui-tag ui-tag-gold">{{userRole === 'doctor' ? '医生' : userRole === 'admin' ? '管理员' : '患者'}}</view>
        <view class="ui-tag" wx:if="{{userRole === 'patient' && hasPatientInfo}}">已绑定就诊人</view>
      </view>
      <view class="profile-hint" wx:else>登录后可预约挂号、查看就诊记录</view>
    </view>
    <view class="ui-btn ui-btn-primary ui-btn-sm" wx:if="{{!hasLogin}}" bindtap="handleLogin">登录</view>
  </view>

  <view class="ui-panel" wx:if="{{userRole === 'patient'}}">
    <view class="ui-panel-head">
      <view class="ui-panel-title">就医服务</view>
      <view class="ui-micro">PATIENT</view>
    </view>
    <view class="ui-panel-body ui-panel-body-flush">
      <view class="ui-row" bindtap="goToMyAppointments" hover-class="hover-fade">
        <view class="profile-row-ico"><image class="profile-row-ico-img" src="/images/ui-icons/appointment.svg" mode="aspectFit" /></view>
        <view class="ui-row-main">
          <view class="ui-row-title">我的预约</view>
          <view class="ui-row-desc">待就诊、已完成与取消记录</view>
        </view>
        <view class="ui-chev">›</view>
      </view>
      <view class="ui-row" bindtap="goToPatients" hover-class="hover-fade">
        <view class="profile-row-ico"><image class="profile-row-ico-img" src="/images/ui-icons/patients.svg" mode="aspectFit" /></view>
        <view class="ui-row-main">
          <view class="ui-row-title">就诊人管理</view>
          <view class="ui-row-desc">本人与家庭成员，最多 8 位</view>
        </view>
        <view class="ui-chev">›</view>
      </view>
      <view class="ui-row" bindtap="viewPatientInfo" hover-class="hover-fade">
        <view class="profile-row-ico"><image class="profile-row-ico-img" src="/images/ui-icons/record.svg" mode="aspectFit" /></view>
        <view class="ui-row-main">
          <view class="ui-row-title">患者档案</view>
        </view>
        <view class="ui-chev">›</view>
      </view>
      <view class="ui-row" bindtap="goToNotice" hover-class="hover-fade">
        <view class="profile-row-ico gold"><image class="profile-row-ico-img" src="/images/ui-icons/notice.svg" mode="aspectFit" /></view>
        <view class="ui-row-main">
          <view class="ui-row-title">医院公告</view>
          <view class="ui-row-desc">停诊通知、就诊须知与院内动态</view>
        </view>
        <view class="ui-chev">›</view>
      </view>
      <view class="ui-row" bindtap="goToNavigation" hover-class="hover-fade">
        <view class="profile-row-ico"><image class="profile-row-ico-img" src="/images/ui-icons/navigation.svg" mode="aspectFit" /></view>
        <view class="ui-row-main">
          <view class="ui-row-title">院内导航</view>
          <view class="ui-row-desc">楼层、诊区与就诊路线</view>
        </view>
        <view class="ui-chev">›</view>
      </view>
    </view>
  </view>

  <view class="ui-panel" wx:if="{{userRole === 'doctor'}}">
    <view class="ui-panel-head">
      <view class="ui-panel-title">医生工作</view>
      <view class="ui-micro">DOCTOR</view>
    </view>
    <view class="ui-panel-body ui-panel-body-flush">
      <view class="ui-row" bindtap="goToDoctorWorkspace" hover-class="hover-fade">
        <view class="profile-row-ico"><image class="profile-row-ico-img" src="/images/ui-icons/workspace.svg" mode="aspectFit" /></view>
        <view class="ui-row-main"><view class="ui-row-title">医生工作台</view></view>
        <view class="ui-chev">›</view>
      </view>
      <view class="ui-row" bindtap="goToMyPatients" hover-class="hover-fade">
        <view class="profile-row-ico"><image class="profile-row-ico-img" src="/images/ui-icons/patient.svg" mode="aspectFit" /></view>
        <view class="ui-row-main"><view class="ui-row-title">我的患者</view></view>
        <view class="ui-chev">›</view>
      </view>
    </view>
  </view>

  <view class="ui-panel" wx:if="{{userRole === 'admin'}}">
    <view class="ui-panel-head">
      <view class="ui-panel-title">管理后台</view>
      <view class="ui-micro">ADMIN</view>
    </view>
    <view class="ui-panel-body ui-panel-body-flush">
      <view class="ui-row" bindtap="goToAdminDashboard" hover-class="hover-fade">
        <view class="profile-row-ico"><image class="profile-row-ico-img" src="/images/ui-icons/workspace.svg" mode="aspectFit" /></view>
        <view class="ui-row-main"><view class="ui-row-title">管理后台</view></view>
        <view class="ui-chev">›</view>
      </view>
      <view class="ui-row" bindtap="goToDoctorManage" hover-class="hover-fade">
        <view class="profile-row-ico"><image class="profile-row-ico-img" src="/images/ui-icons/id-card.svg" mode="aspectFit" /></view>
        <view class="ui-row-main"><view class="ui-row-title">医生管理</view></view>
        <view class="ui-chev">›</view>
      </view>
    </view>
  </view>

  <view class="ui-panel">
    <view class="ui-panel-head">
      <view class="ui-panel-title">通用设置</view>
      <view class="ui-micro">SETTINGS</view>
    </view>
    <view class="ui-panel-body ui-panel-body-flush">
      <view class="ui-row" bindtap="goToSettings" hover-class="hover-fade">
        <view class="profile-row-ico"><image class="profile-row-ico-img" src="/images/ui-icons/settings.svg" mode="aspectFit" /></view>
        <view class="ui-row-main">
          <view class="ui-row-title">设置</view>
          <view class="ui-row-desc" wx:if="{{elderly}}">长辈模式已开启</view>
        </view>
        <view class="ui-chev">›</view>
      </view>
      <view class="ui-row" bindtap="goToHelpCenter" hover-class="hover-fade">
        <view class="profile-row-ico"><image class="profile-row-ico-img" src="/images/ui-icons/help.svg" mode="aspectFit" /></view>
        <view class="ui-row-main"><view class="ui-row-title">帮助中心</view></view>
        <view class="ui-chev">›</view>
      </view>
      <view class="ui-row" bindtap="goToContact" hover-class="hover-fade">
        <view class="profile-row-ico"><image class="profile-row-ico-img" src="/images/ui-icons/phone.svg" mode="aspectFit" /></view>
        <view class="ui-row-main"><view class="ui-row-title">联系我们</view></view>
        <view class="ui-chev">›</view>
      </view>
    </view>
  </view>

  <view class="ui-panel" wx:if="{{hasLogin}}">
    <view class="ui-panel-body ui-panel-body-flush">
      <view class="ui-row" bindtap="handleLogout" hover-class="hover-fade">
        <view class="ui-row-main"><view class="ui-row-title profile-danger">退出登录</view></view>
      </view>
    </view>
  </view>

  <view class="profile-version">健康联防智慧预约 · 版本 1.0.0</view>
</view>
