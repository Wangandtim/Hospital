<view class="container">
  <view class="header">
    <view class="back-btn" bindtap="goBack" hover-class="hover-fade">
      <image class="back-icon" src="/images/icons/ic-arrow-ffffff.png" mode="aspectFit" />
      <text class="back-text">返回</text>
    </view>
    <view class="title">患者档案</view>
  </view>

  <view class="card-section">
    <view class="info-card">
      <view class="avatar-section">
        <view class="avatar">
          <image class="avatar-img" src="/images/icons/ic-user-ffffff.png" mode="aspectFit" />
        </view>
        <view class="name">{{patientInfo.patientName}}</view>
      </view>

      <view class="info-list">
        <view class="info-item">
          <view class="info-label">身份证号</view>
          <view class="info-value">{{patientInfo.idCard}}</view>
        </view>
        <view class="info-item">
          <view class="info-label">手机号码</view>
          <view class="info-value">{{patientInfo.phone}}</view>
        </view>
        <view class="info-item">
          <view class="info-label">性别</view>
          <view class="info-value">{{patientInfo.gender === 1 ? '男' : '女'}}</view>
        </view>
        <view class="info-item">
          <view class="info-label">出生日期</view>
          <view class="info-value">{{patientInfo.birthday}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="btn-section">
    <button class="btn-edit" bindtap="editPatientInfo" hover-class="hover-scale">编辑信息</button>
  </view>
</view>
