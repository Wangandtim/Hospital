<view class="ui-page patient-archive-page">
  <view class="ui-head">
    <view class="ui-brand">
      <view class="ui-brand-word">患者档案</view>
      <view class="ui-brand-rule"></view>
      <view class="ui-brand-sub">PATIENT ARCHIVE</view>
    </view>
    <view class="ui-icon-btn" bindtap="goBack">返回</view>
  </view>

  <view class="ui-panel">
    <view class="archive-head">
      <view class="archive-avatar">{{avatarText}}</view>
      <view class="archive-name ui-serif">{{patientInfo.patientName}}</view>
    </view>
    <view class="ui-panel-body ui-panel-body-flush">
      <view class="ui-row"><view class="ui-row-label">身份证号</view><view class="ui-row-main"></view><view class="ui-row-val">{{patientInfo.idCard}}</view></view>
      <view class="ui-row"><view class="ui-row-label">手机号码</view><view class="ui-row-main"></view><view class="ui-row-val">{{patientInfo.phone}}</view></view>
      <view class="ui-row"><view class="ui-row-label">性别</view><view class="ui-row-main"></view><view class="ui-row-val">{{patientInfo.gender === 1 ? '男' : '女'}}</view></view>
      <view class="ui-row"><view class="ui-row-label">出生日期</view><view class="ui-row-main"></view><view class="ui-row-val">{{patientInfo.birthday}}</view></view>
    </view>
  </view>

  <button class="ui-btn ui-btn-primary archive-edit" bindtap="editPatientInfo">编辑信息</button>
</view>
