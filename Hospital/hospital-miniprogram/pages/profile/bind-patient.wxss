page { background: var(--paper); }
.bind-page { padding-top: 8rpx; padding-bottom: 48rpx; }
.bind-form { padding: 8rpx 26rpx 26rpx; }
.bind-input { flex: 1; font-size: var(--fs-h3); color: var(--ink); }
.bind-gender { margin-top: 4rpx; }
.bind-gender .ui-seg { flex: 1; }
.bind-date { flex: 1; font-size: var(--fs-h3); color: var(--ink); }
.bind-date.is-empty { color: var(--ink-4); }
.bind-submit { margin-top: 32rpx; }
