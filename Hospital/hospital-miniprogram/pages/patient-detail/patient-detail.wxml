<view class="container">
  <view class="header">
    <view hover-class="hover-press" hover-stay-time="150" class="back-btn" bindtap="goBack">
      <text class="back-icon">←</text>
    </view>
    <text class="title">患者详情</text>
    <view class="placeholder"></view>
  </view>

  <view class="content" wx:if="{{patient}}">
    <view class="card">
      <view class="card-header">
        <text class="card-title">基本信息</text>
      </view>
      <view class="card-body">
        <view class="info-row">
          <text class="label">姓名</text>
          <text class="value">{{patient.name || '未填写'}}</text>
        </view>
        <view class="info-row">
          <text class="label">性别</text>
          <text class="value">{{patient.gender === 'M' ? '男' : patient.gender === 'F' ? '女' : patient.gender || '未填写'}}</text>
        </view>
        <view class="info-row">
          <text class="label">年龄</text>
          <text class="value">{{patient.age > 0 ? patient.age + '岁' : '未填写'}}</text>
        </view>
        <view class="info-row">
          <text class="label">手机号</text>
          <text class="value">{{patient.phone || '未填写'}}</text>
        </view>
        <view class="info-row">
          <text class="label">病历号</text>
          <text class="value">{{patient.patientId || '未填写'}}</text>
        </view>
        <view class="info-row" wx:if="{{patient.medicalHistory}}">
          <text class="label">病史</text>
          <text class="value">{{patient.medicalHistory}}</text>
        </view>
      </view>
    </view>

    <view class="card" wx:if="{{appointment}}">
      <view class="card-header">
        <text class="card-title">预约信息</text>
      </view>
      <view class="card-body">
        <view class="info-row">
          <text class="label">就诊科室</text>
          <text class="value">{{deptName || '未知科室'}}</text>
        </view>
        <view class="info-row">
          <text class="label">就诊日期</text>
          <text class="value">{{appointment.appointmentDate || '未填写'}}</text>
        </view>
        <view class="info-row">
          <text class="label">就诊时间</text>
          <text class="value">{{appointment.timeSlot || '未填写'}}</text>
        </view>
        <view class="info-row">
          <text class="label">预约状态</text>
          <text class="value status status-{{appointment.status}}">
            {{appointment.status === 0 ? '已取消' : appointment.status === 1 ? '待就诊' : appointment.status === 2 ? '已完成' : appointment.status === 3 ? '进行中' : '未知'}}
          </text>
        </view>
      </view>
    </view>

    <view class="card" wx:if="{{parsedQuestionnaire}}">
      <view class="card-header">
        <text class="card-title">健康问卷</text>
        <text class="card-subtitle">{{parsedQuestionnaire.deptName}}</text>
      </view>
      <view class="card-body">
        <view class="questionnaire-item" wx:for="{{parsedQuestionnaire.answers}}" wx:key="index">
          <view class="question">
            <text class="question-label">{{index + 1}}. {{item.question}}</text>
          </view>
          <view class="answer">
            <text class="answer-text">{{item.answer || '未作答'}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="card" wx:if="{{!parsedQuestionnaire && questionnaireData}}">
      <view class="card-header">
        <text class="card-title">问卷数据</text>
      </view>
      <view class="card-body">
        <text class="raw-data">{{questionnaireData}}</text>
      </view>
    </view>

    <view class="action-area" wx:if="{{appointment && appointment.status === 1}}">
      <button hover-class="hover-press" hover-stay-time="150" class="action-btn primary" bindtap="markCompleted">确认就诊完成</button>
    </view>
  </view>

  <view class="empty-state" wx:else>
    <text class="empty-text">暂无数据</text>
  </view>
</view>