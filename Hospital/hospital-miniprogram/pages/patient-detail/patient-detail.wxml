<view class="ui-page patient-detail">
  <view class="ui-back" bindtap="goBack"><text>←</text></view>

  <view class="ui-title-block">
    <view class="ui-eyebrow ui-eyebrow-gold">PATIENT</view>
    <view class="ui-title">患者详情</view>
  </view>

  <view wx:if="{{patient}}">
    <view class="ui-panel">
      <view class="ui-panel-head">
        <view class="ui-panel-title">基本信息</view>
      </view>
      <view class="ui-panel-body ui-panel-body-flush">
        <view class="ui-row">
          <view class="ui-row-label">姓名</view>
          <view class="ui-row-main"></view>
          <view class="ui-row-val">{{patient.name || '未填写'}}</view>
        </view>
        <view class="ui-row">
          <view class="ui-row-label">性别</view>
          <view class="ui-row-main"></view>
          <view class="ui-row-val">{{patient.gender === 'M' ? '男' : patient.gender === 'F' ? '女' : patient.gender || '未填写'}}</view>
        </view>
        <view class="ui-row">
          <view class="ui-row-label">年龄</view>
          <view class="ui-row-main"></view>
          <view class="ui-row-val">{{patient.age > 0 ? patient.age + '岁' : '未填写'}}</view>
        </view>
        <view class="ui-row">
          <view class="ui-row-label">手机号</view>
          <view class="ui-row-main"></view>
          <view class="ui-row-val">{{patient.phone || '未填写'}}</view>
        </view>
        <view class="ui-row">
          <view class="ui-row-label">病历号</view>
          <view class="ui-row-main"></view>
          <view class="ui-row-val">{{patient.patientId || '未填写'}}</view>
        </view>
        <view class="ui-row" wx:if="{{patient.medicalHistory}}">
          <view class="ui-row-label">病史</view>
          <view class="ui-row-main"></view>
          <view class="ui-row-val">{{patient.medicalHistory}}</view>
        </view>
      </view>
    </view>

    <view class="ui-panel" wx:if="{{appointment}}">
      <view class="ui-panel-head">
        <view class="ui-panel-title">预约信息</view>
      </view>
      <view class="ui-panel-body ui-panel-body-flush">
        <view class="ui-row">
          <view class="ui-row-label">就诊科室</view>
          <view class="ui-row-main"></view>
          <view class="dept-inline">
            <view class="ui-plate"><image class="ui-plate-img" src="{{deptIcon || '/images/dept-icons/fallback.png'}}" mode="aspectFit" /></view>
            <text class="ui-row-val">{{deptName || '未知科室'}}</text>
          </view>
        </view>
        <view class="ui-row">
          <view class="ui-row-label">就诊日期</view>
          <view class="ui-row-main"></view>
          <view class="ui-row-val">{{appointment.appointmentDate || '未填写'}}</view>
        </view>
        <view class="ui-row">
          <view class="ui-row-label">就诊时间</view>
          <view class="ui-row-main"></view>
          <view class="ui-row-val">{{appointment.timeSlot || '未填写'}}</view>
        </view>
        <view class="ui-row">
          <view class="ui-row-label">预约状态</view>
          <view class="ui-row-main"></view>
          <view class="ui-pill {{appointment.status === 1 ? 'ui-pill-wait' : appointment.status === 2 ? 'ui-pill-done' : 'ui-pill-cancel'}}">
            {{appointment.status === 0 ? '已取消' : appointment.status === 1 ? '待就诊' : appointment.status === 2 ? '已完成' : appointment.status === 3 ? '进行中' : '未知'}}
          </view>
        </view>
      </view>
    </view>

    <view class="ui-panel" wx:if="{{parsedQuestionnaire}}">
      <view class="ui-panel-head">
        <view class="ui-panel-title">健康问卷</view>
        <view class="dept-inline" wx:if="{{parsedQuestionnaire.deptName}}">
          <view class="ui-plate"><image class="ui-plate-img" src="{{questionnaireDeptIcon || '/images/dept-icons/fallback.png'}}" mode="aspectFit" /></view>
          <text class="ui-row-desc">{{parsedQuestionnaire.deptName}}</text>
        </view>
      </view>
      <view class="ui-panel-body">
        <view class="questionnaire-item" wx:for="{{parsedQuestionnaire.answers}}" wx:key="index">
          <view class="question">
            <text class="question-label">{{index + 1}}. {{item.question}}</text>
          </view>
          <view class="answer">
            <text class="answer-text">{{item.answer || '未作答'}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="ui-panel" wx:if="{{!parsedQuestionnaire && questionnaireData}}">
      <view class="ui-panel-head">
        <view class="ui-panel-title">问卷数据</view>
      </view>
      <view class="ui-panel-body">
        <text class="raw-data">{{questionnaireData}}</text>
      </view>
    </view>
  </view>

  <view class="ui-empty" wx:else>
    <view class="ui-empty-mark">患</view>
    <view class="ui-empty-title">暂无数据</view>
  </view>

  <view class="action-area" wx:if="{{appointment && appointment.status === 1}}">
    <view class="ui-action-bar">
      <button class="ui-btn ui-btn-primary action-btn" bindtap="markCompleted">确认就诊完成</button>
    </view>
  </view>
</view>
