.patient-detail {
  min-height: 100vh;
  padding-top: 16rpx;
  padding-bottom: 200rpx;
}

.dept-inline {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-shrink: 0;
}

.dept-inline .ui-row-val {
  flex: none;
}

.questionnaire-item + .questionnaire-item {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}

.question {
  margin-bottom: 12rpx;
}

.question-label {
  font-size: var(--fs-caption);
  color: var(--ink);
  font-weight: 500;
  line-height: 1.6;
}

.answer {
  padding: 16rpx 20rpx;
  background: var(--tint-2);
  border: 1rpx solid var(--line);
  border-radius: var(--r-sm);
}

.answer-text {
  font-size: var(--fs-caption);
  color: var(--ink-2);
  line-height: 1.65;
}

.raw-data {
  font-size: var(--fs-micro);
  color: var(--ink-3);
  font-family: monospace;
  word-break: break-all;
  line-height: 1.7;
}

.action-area {
  position: relative;
}

.action-btn {
  flex: 1;
}
