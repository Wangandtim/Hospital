.contact-page {
  min-height: 100vh;
  padding-top: 8rpx;
}

.contact-inner {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.plate-char {
  font-family: var(--font-serif);
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary);
}

/* ---------- 我的就诊 ---------- */
.visit-head {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.visit-main {
  flex: 1;
  min-width: 0;
}

.visit-name {
  font-family: var(--font-serif);
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
}

.visit-sub {
  margin-top: 8rpx;
  font-size: var(--fs-caption);
  color: var(--ink-2);
  line-height: 1.6;
}

.visit-state {
  margin-right: 10rpx;
}

.visit-dept {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
}

.visit-dept-name {
  font-size: var(--fs-caption);
  color: var(--ink);
}

.visit-dept-doctor {
  font-size: var(--fs-micro);
  color: var(--ink-3);
}

.visit-address {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  border-radius: var(--r-sm);
  font-size: var(--fs-caption);
  color: var(--ink-2);
  line-height: 1.55;
}

.visit-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.mini-act {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-caption);
  font-weight: 500;
  border-radius: var(--r-sm);
}

.mini-act.primary {
  background: var(--primary);
  color: #fff;
}

.mini-act.primary:active {
  background: var(--primary-deep);
}

.mini-act.ghost {
  background: transparent;
  color: var(--ink);
  border: 1rpx solid var(--line-strong);
}

.mini-act.ghost:active {
  background: var(--tint-2);
}

.mini-act.select {
  margin-top: 20rpx;
}

.multi-hint {
  margin-top: 14rpx;
  font-size: var(--fs-micro);
  color: var(--gold-ink);
  text-align: center;
}

.empty .visit-name {
  color: var(--ink-2);
}

/* ---------- 服务反馈 ---------- */
.fb-head {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.fb-title {
  font-family: var(--font-serif);
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
}

.fb-sub {
  font-size: var(--fs-micro);
  color: var(--ink-3);
}

.stars {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 22rpx;
}

.star {
  font-size: 48rpx;
  line-height: 1;
  color: var(--ink-4);
}

.star.active {
  color: var(--gold);
}

.rating-text {
  margin-left: 8rpx;
  font-size: var(--fs-micro);
  font-weight: 600;
  color: var(--gold-ink);
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.fb-textarea {
  margin-top: 22rpx;
  min-height: 200rpx;
}

.fb-foot {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 16rpx;
}

.fb-contact {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  font-size: var(--fs-caption);
  padding: 0 20rpx;
}

.fb-count {
  font-size: var(--fs-micro);
  color: var(--ink-3);
  flex-shrink: 0;
}

.submit-btn {
  margin-top: 22rpx;
  width: 100%;
}

.submit-btn.disabled {
  opacity: 0.6;
}

.last-ticket {
  margin-top: 16rpx;
  text-align: center;
  font-size: var(--fs-micro);
  color: var(--primary);
}

/* ---------- 平台客服 ---------- */
.mini-call {
  flex-shrink: 0;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: var(--r-pill);
  background: var(--primary);
  color: #fff;
  font-size: var(--fs-micro);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.copy-link {
  flex-shrink: 0;
  font-size: var(--fs-caption);
  color: var(--gold-ink);
}

/* ---------- 紧急情况 ---------- */
.emergency-card {
  margin-top: 32rpx;
  padding: 24rpx 26rpx;
  border-radius: var(--r-lg);
  background: var(--danger-tint);
  border: 1rpx solid #EAD2CE;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.emergency-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.emergency-title {
  font-size: var(--fs-caption);
  font-weight: 700;
  color: var(--danger);
}

.emergency-desc {
  font-size: var(--fs-micro);
  color: var(--ink-2);
  line-height: 1.7;
}

.emergency-btn {
  width: 100%;
  height: 88rpx;
}
