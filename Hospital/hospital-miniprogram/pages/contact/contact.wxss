.page {
  min-height: 100vh;
  background: #f0fdfa;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.hero-mini {
  position: relative;
  overflow: hidden;
  padding: 40rpx 32rpx 56rpx;
  background: #0b5e58;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  background: linear-gradient(96deg, rgba(3, 52, 50, 0.78) 0%, rgba(4, 66, 62, 0.5) 55%, rgba(4, 66, 62, 0.14) 86%);
}

.hero-inner {
  position: relative;
  z-index: 2;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  text-shadow: 0 4rpx 16rpx rgba(0, 30, 28, 0.32);
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.content {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 36rpx;
  border: 1rpx solid #e6fffa;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.14);
  padding: 6rpx 26rpx;
  overflow: hidden;
}

.hotline-card {
  padding: 28rpx;
}

.hotline-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.icon-chip {
  width: 72rpx;
  height: 72rpx;
  border-radius: 26rpx;
  background: linear-gradient(145deg, #ecfdf9 0%, #ccfbf1 100%);
  border: 1rpx solid #d9f2ef;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.row-icon {
  width: 38rpx;
  height: 38rpx;
}

.hotline-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.hotline-title {
  font-size: 28rpx;
  color: #143634;
  font-weight: 600;
}

.hotline-desc {
  font-size: 23rpx;
  color: #2f504d;
}

.hotline-number {
  margin: 22rpx 0 24rpx;
  font-size: 52rpx;
  font-weight: 700;
  color: #0f766e;
  letter-spacing: 1rpx;
}

.hotline-actions {
  display: flex;
  gap: 16rpx;
}

.action {
  flex: 1;
  height: 84rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.action.primary {
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(13, 148, 136, 0.28);
}

.action.ghost {
  background: #f0fdfa;
  color: #0f766e;
  border: 1rpx solid #d9f2ef;
}

.action-icon {
  width: 30rpx;
  height: 30rpx;
}

.group-title {
  font-size: 24rpx;
  color: #2f504d;
  font-weight: 600;
  margin: 26rpx 8rpx 12rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0fdfa;
}

.row:last-child {
  border-bottom: none;
}

.row-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.row-title {
  font-size: 28rpx;
  color: #143634;
  font-weight: 600;
}

.row-desc {
  font-size: 23rpx;
  color: #2f504d;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-arrow {
  font-size: 34rpx;
  color: #b6cfcb;
}

.copy-link {
  font-size: 24rpx;
  color: #0d9488;
  flex-shrink: 0;
}

.mini-call 
{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #14b8a6, #0d9488);
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  box-shadow: 0 8rpx 18rpx rgba(13, 148, 136, 0.22);
}

.emergency-card {
  margin-top: 26rpx;
  padding: 26rpx;
  border-radius: 32rpx;
  background: #fff5f5;
  border: 1rpx solid #fde2e2;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.emergency-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.emergency-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #b91c1c;
}

.emergency-desc {
  font-size: 23rpx;
  color: #7f1d1d;
  line-height: 1.6;
}

.emergency-btn {
  height: 80rpx;
  border-radius: 999rpx;
  background: #dc2626;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 27rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 24rpx rgba(220, 38, 38, 0.24);
}

/* ============ 我的就诊 + 服务反馈 ============ */
.visit-card {
  padding: 28rpx;
}

.visit-head {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.visit-main {
  flex: 1;
  min-width: 0;
}

.visit-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #143634;
  line-height: 1.4;
}

.visit-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #2f504d;
  font-weight: 500;
  line-height: 1.5;
}

.visit-state {
  display: inline-flex; align-items: center; justify-content: center;
  margin-right: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 20rpx;
  font-weight: 700;
}

.visit-state.on {
  background: #ccfbf1;
  color: #0b5e58;
}

.visit-address {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  background: #f0fdfa;
  border-radius: 20rpx;
  font-size: 23rpx;
  color: #2f504d;
  line-height: 1.5;
}

.visit-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}

.mini-act {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 22rpx;
}

.mini-act.primary {
  background: linear-gradient(135deg, #14b8a6, #0d9488);
  color: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(13, 148, 136, 0.24);
}

.mini-act.ghost {
  background: #f0fdfa;
  color: #0f766e;
  border: 1rpx solid #d9f2ef;
}

.mini-act.select {
  margin-top: 20rpx;
}

.mini-icon {
  width: 28rpx;
  height: 28rpx;
}

.multi-hint {
  margin-top: 14rpx;
  font-size: 21rpx;
  color: #0f766e;
  text-align: center;
}

.feedback-card {
  padding: 28rpx;
}

.fb-head {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.fb-title {
  font-size: 29rpx;
  font-weight: 700;
  color: #143634;
}

.fb-sub {
  font-size: 22rpx;
  color: #2f504d;
  font-weight: 500;
}

.stars {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 22rpx;
}

.star {
  font-size: 46rpx;
  line-height: 1;
  color: #cfe9e5;
  transition: transform 0.14s ease, color 0.14s ease;
}

.star.active {
  color: #0d9488;
  text-shadow: 0 6rpx 14rpx rgba(13, 148, 136, 0.28);
}

.rating-text {
  margin-left: 8rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: #0f766e;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.tag-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: #0f766e;
  background: #f0fdfa;
  border: 1rpx solid #d9f2ef;
  transition: all 0.16s ease;
}

.tag-chip.active {
  color: #ffffff;
  font-weight: 600;
  background: linear-gradient(135deg, #14b8a6, #0d9488);
  border-color: transparent;
  box-shadow: 0 8rpx 18rpx rgba(13, 148, 136, 0.22);
}

.fb-textarea {
  width: 100%;
  height: 200rpx;
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  box-sizing: border-box;
  background: #f8fdfc;
  border: 1rpx solid #d9f2ef;
  border-radius: 22rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #143634;
}

.fb-foot {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 16rpx;
}

.fb-contact {
  flex: 1;
  height: 76rpx;
  padding: 0 20rpx;
  background: #f8fdfc;
  border: 1rpx solid #d9f2ef;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #143634;
}

.fb-count {
  font-size: 21rpx;
  color: #6f8f8b;
  flex-shrink: 0;
}

.submit-btn {
  margin-top: 22rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #14b8a6, #0d9488);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 14rpx 28rpx rgba(13, 148, 136, 0.26);
  transition: transform 0.14s ease;
}

.submit-btn.disabled {
  opacity: 0.6;
  box-shadow: none;
}

.last-ticket {
  margin-top: 16rpx;
  text-align: center;
  font-size: 21rpx;
  color: #0f766e;
}

.empty .visit-name {
  color: #3f6663;
}

