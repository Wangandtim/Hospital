<view class="ui-page dw-page">
  <view class="ui-head">
    <view class="ui-brand">
      <view class="ui-brand-word">医生工作台</view>
      <view class="ui-brand-rule"></view>
      <view class="ui-brand-sub">WORKSPACE · TODAY</view>
    </view>
    <view class="ui-head-actions">
      <view class="ui-btn ui-btn-outline ui-btn-sm" bindtap="handleLogout" hover-class="hover-scale">退出</view>
    </view>
  </view>

  <view class="dw-hero" bindlongpress="applyEmergencyAccess">
    <view class="ui-doctor-photo dw-ava">医</view>
    <view class="dw-hero-main">
      <view class="dw-name">{{doctorName}}</view>
      <view class="dw-title">{{doctorTitle}}</view>
      <view class="dw-dept">
        <view class="ui-plate">
          <image class="ui-plate-img" src="{{doctorDeptIcon}}" mode="aspectFit" />
        </view>
        <text class="dw-dept-name">{{doctorDept || '未设置科室'}}</text>
      </view>
    </view>
  </view>

  <view class="dw-stats">
    <view class="dw-stat">
      <view class="dw-stat-value ui-num">{{todayCount}}</view>
      <view class="dw-stat-label">今日预约</view>
    </view>
    <view class="dw-stat">
      <view class="dw-stat-value ui-num">{{inProgressCount}}</view>
      <view class="dw-stat-label">进行中</view>
    </view>
    <view class="dw-stat">
      <view class="dw-stat-value ui-num">{{completedCount}}</view>
      <view class="dw-stat-label">已完成</view>
    </view>
    <view class="dw-stat">
      <view class="dw-stat-value dw-stat-gold ui-num">{{pendingCount}}</view>
      <view class="dw-stat-label">待就诊</view>
    </view>
  </view>

  <view class="dw-banner" wx:if="{{emergencyNeedReport}}" bindtap="openEmergencyReportFromBanner">
    <view class="dw-banner-tag">待提交</view>
    <view class="dw-banner-main">
      <view class="dw-banner-title">应急结束报告</view>
      <view class="dw-banner-desc">请核对改动范围并填写影响预估，24 小时内未提交将暂停再次申请</view>
    </view>
  </view>

  <view class="ui-panel" wx:if="{{weeklyConfirmPending}}">
    <view class="ui-panel-head">
      <view class="ui-panel-title">下周排班待确认</view>
      <view class="ui-tag ui-tag-gold">{{weeklyConfirmLabel}}</view>
    </view>
    <view class="ui-panel-body">
      <view class="dw-panel-desc">{{weeklyConfirmSummary}}</view>
      <view class="dw-btn-row">
        <button class="ui-btn ui-btn-primary dw-mini-btn" hover-class="hover-press" hover-stay-time="150" bindtap="confirmWeeklyInherit">沿用上周</button>
        <button class="ui-btn ui-btn-outline dw-mini-btn" hover-class="hover-press" hover-stay-time="150" bindtap="goToScheduleEdit">需要修改</button>
      </view>
      <view class="dw-panel-tip">未确认将自动沿用上一周排班</view>
    </view>
  </view>

  <view class="dw-warn" wx:if="{{scheduleWarning}}" bindtap="goToMinimumSchedule" hover-class="hover-fade">
    <view class="dw-warn-mark">!</view>
    <view class="dw-warn-main">
      <view class="dw-warn-title">排班时间不足</view>
      <view class="dw-warn-desc">{{scheduleWarningText}}</view>
    </view>
    <view class="ui-chev">›</view>
  </view>

  <view class="ui-panel">
    <view class="ui-panel-body ui-panel-body-flush">
      <view class="ui-row" bindtap="goToMySchedule" hover-class="hover-fade">
        <view class="ui-plate tiny">排</view>
        <view class="ui-row-main"><view class="ui-row-title">我的排班</view></view>
        <view class="ui-tag ui-tag-primary">可自定义预约时间</view>
        <view class="ui-chev">›</view>
      </view>
      <view class="ui-row" bindtap="goToMyPatients" hover-class="hover-fade">
        <view class="ui-plate tiny">患</view>
        <view class="ui-row-main"><view class="ui-row-title">我的患者</view></view>
        <view class="ui-chev">›</view>
      </view>
      <view class="ui-row" bindtap="goToQuestionnaires" hover-class="hover-fade">
        <view class="ui-plate tiny">卷</view>
        <view class="ui-row-main"><view class="ui-row-title">患者问卷</view></view>
        <view class="ui-tag ui-tag-gold" wx:if="{{questionnaireCount > 0}}">{{questionnaireCount}}</view>
        <view class="ui-chev">›</view>
      </view>
      <view class="ui-row" bindtap="goToProfile" hover-class="hover-fade">
        <view class="ui-plate tiny">设</view>
        <view class="ui-row-main"><view class="ui-row-title">个人设置</view></view>
        <view class="ui-chev">›</view>
      </view>
    </view>
  </view>

  <view class="ui-section-head">
    <view class="ui-section-title">预约列表</view>
    <view class="ui-section-sub">{{appointments.length}} 条</view>
  </view>

  <view class="dw-appt-list">
    <view class="dw-appt" wx:for="{{appointments}}" wx:key="appointmentId">
      <view class="dw-appt-main" bindtap="goToPatientDetail" data-appointment-id="{{item.appointmentId}}" data-dept-id="{{item.doctor.deptId || ''}}" hover-class="hover-fade">
        <view class="dw-patient">{{item.patient ? item.patient.name : '未知患者'}}</view>
        <view class="dw-appt-desc">{{item.appointmentDate}} · {{item.timeSlot}}</view>
        <view class="ui-tag ui-tag-primary dw-appt-tag" wx:if="{{item.questionnaireData}}">有问卷</view>
      </view>
      <view class="ui-state {{item.status === 1 ? 'ui-state-low' : (item.status === 2 ? 'ui-state-ok' : (item.status === 3 ? 'ui-state-sel' : 'ui-state-full'))}}">
        <i></i>{{item.status === 1 ? '待就诊' : (item.status === 2 ? '已完成' : (item.status === 3 ? '进行中' : '已取消'))}}
      </view>
    </view>
  </view>

  <view class="ui-empty" wx:if="{{appointments.length === 0}}">
    <view class="ui-empty-mark">诊</view>
    <view class="ui-empty-title">暂无预约记录</view>
    <view class="ui-empty-hint">新的预约会在这里出现</view>
  </view>

  <view class="dw-em-mask" wx:if="{{emergencyModalVisible}}">
    <view class="dw-em-card">
      <view class="dw-em-title">应急通道</view>
      <view class="dw-em-desc">仅供主任医师在管理员账号不可用时使用。提交后立即开通 2 小时权限，不等待审批；院管同步收到知会，卫健委事后稽核，操作全程留痕。</view>
      <textarea class="ui-textarea dw-em-textarea" placeholder="请填写申请原因（至少4个字）" value="{{emergencyReason}}" bindinput="onEmergencyReasonInput" maxlength="100" />
      <input class="ui-input dw-em-input" password placeholder="再次输入医生账号密码" value="{{emergencyPassword}}" bindinput="onEmergencyPasswordInput" />
      <view class="dw-em-cert-row" wx:if="{{!emergencyCertReady}}">
        <view class="dw-em-cert" data-type="idCard" bindtap="uploadEmergencyCert">
          <image wx:if="{{emergencyCertIdPreview}}" class="dw-em-cert-img" src="{{emergencyCertIdPreview}}" mode="aspectFill" />
          <view class="dw-em-cert-label">{{emergencyCertIdPreview ? '身份证已选择' : '上传身份证人像面'}}</view>
        </view>
        <view class="dw-em-cert" data-type="license" bindtap="uploadEmergencyCert">
          <image wx:if="{{emergencyCertLicensePreview}}" class="dw-em-cert-img" src="{{emergencyCertLicensePreview}}" mode="aspectFill" />
          <view class="dw-em-cert-label">{{emergencyCertLicensePreview ? '资格证已选择' : '上传医师资格证'}}</view>
        </view>
      </view>
      <view class="dw-em-cert-tip" wx:else>证件已归档，无需重复上传</view>
      <view class="dw-em-actions">
        <button class="ui-btn ui-btn-outline" bindtap="closeEmergencyModal">取消</button>
        <button class="ui-btn ui-btn-primary" bindtap="submitEmergencyRequest" loading="{{emergencySubmitting}}">立即开通</button>
      </view>
    </view>
  </view>

  <view class="dw-em-mask" wx:if="{{emergencyReportModalVisible}}">
    <view class="dw-em-card">
      <view class="dw-em-title">提交应急结束报告</view>
      <view class="dw-em-desc">改动范围由系统按应急操作自动生成，请核对补充；影响预估必填；确认无未完成事项。</view>
      <textarea class="ui-textarea dw-em-textarea dw-em-scope" placeholder="改动范围" value="{{emergencyReportScope}}" bindinput="onReportScopeInput" maxlength="1000" />
      <textarea class="ui-textarea dw-em-textarea" placeholder="影响预估（必填，至少4个字）" value="{{emergencyReportImpact}}" bindinput="onReportImpactInput" maxlength="500" />
      <checkbox-group class="dw-em-check-group" bindchange="onReportCompleteChange">
        <label class="dw-em-check-label">
          <checkbox value="complete" checked="{{emergencyReportComplete}}" color="#0F5B50" />
          <text>确认已无未完成事项</text>
        </label>
      </checkbox-group>
      <view class="dw-em-actions">
        <button class="ui-btn ui-btn-outline" bindtap="closeEmergencyReport">取消</button>
        <button class="ui-btn ui-btn-primary" bindtap="submitEmergencyReport" loading="{{emergencyReportSubmitting}}">提交报告</button>
      </view>
    </view>
  </view>
</view>
