.dw-page { padding-top: 8rpx; padding-bottom: calc(72rpx + env(safe-area-inset-bottom)); }

.dw-page .ui-row { min-height: 96rpx; }

.dw-hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-1);
  padding: 28rpx;
}

.dw-ava { width: 108rpx; height: 108rpx; font-size: var(--fs-h2); }

.dw-hero-main { flex: 1; min-width: 0; }

.dw-name {
  font-family: var(--font-serif);
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--ink);
  line-height: 1.3;
}

.dw-title {
  font-size: var(--fs-caption);
  color: var(--ink-2);
  margin-top: 6rpx;
}

.dw-dept {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.dw-dept-name { font-size: var(--fs-caption); color: var(--primary); }

.dw-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin: 24rpx 0;
}

.dw-stat {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  box-shadow: var(--shadow-1);
  min-height: 132rpx;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
}

.dw-stat-value {
  font-family: var(--font-serif);
  font-size: var(--fs-h1);
  line-height: 1.1;
  color: var(--ink);
}

.dw-stat-gold { color: var(--gold-ink); }

.dw-stat-label { font-size: var(--fs-micro); color: var(--ink-3); }

.dw-banner {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 24rpx;
  background: var(--gold-tint);
  border: 1rpx solid var(--gold-line);
  border-radius: var(--r-md);
}

.dw-banner-tag {
  flex-shrink: 0;
  font-size: var(--fs-micro);
  font-weight: 600;
  color: var(--gold-ink);
}

.dw-banner-main { flex: 1; min-width: 0; }

.dw-banner-title {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
}

.dw-banner-desc {
  font-size: var(--fs-micro);
  color: var(--ink-2);
  line-height: 1.6;
  margin-top: 4rpx;
}

.dw-panel-desc {
  font-size: var(--fs-caption);
  color: var(--ink-2);
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.dw-btn-row { display: flex; gap: 16rpx; }

.dw-mini-btn {
  flex: 1;
  height: 80rpx;
  font-size: var(--fs-caption);
}

.dw-panel-tip {
  margin-top: 14rpx;
  font-size: var(--fs-micro);
  color: var(--ink-3);
}

.dw-warn {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: var(--warn-tint);
  border: 1rpx solid var(--gold-line);
  border-radius: var(--r-md);
  padding: 22rpx 24rpx;
  margin-bottom: 24rpx;
  min-height: 96rpx;
}

.dw-warn-mark {
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
  border-radius: 50%;
  border: 1rpx solid var(--gold-line);
  color: var(--warn-ink);
  font-family: var(--font-serif);
  font-size: var(--fs-h3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.dw-warn-main { flex: 1; min-width: 0; }

.dw-warn-title {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--warn-ink);
}

.dw-warn-desc {
  font-size: var(--fs-micro);
  color: var(--warn-ink);
  line-height: 1.6;
  margin-top: 4rpx;
}

.dw-appt-list { display: flex; flex-direction: column; gap: 16rpx; }

.dw-appt {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  box-shadow: var(--shadow-1);
  padding: 22rpx 24rpx;
  min-height: 120rpx;
}

.dw-appt-main { flex: 1; min-width: 0; }

.dw-patient {
  font-family: var(--font-serif);
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
}

.dw-appt-desc {
  font-size: var(--fs-caption);
  color: var(--ink-2);
  margin-top: 4rpx;
}

.dw-appt-tag { margin-top: 10rpx; }

.dw-em-mask {
  position: fixed;
  inset: 0;
  background: rgba(23, 29, 27, 0.48);
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--gutter);
  box-sizing: border-box;
}

.dw-em-card {
  width: 100%;
  max-height: 86vh;
  overflow-y: auto;
  background: var(--surface);
  border-radius: var(--r-lg);
  padding: 32rpx 32rpx 28rpx;
  box-sizing: border-box;
  animation: ui-rise 0.24s ease both;
}

.dw-em-title {
  font-family: var(--font-serif);
  font-size: var(--fs-h2);
  color: var(--ink);
  margin-bottom: 10rpx;
}

.dw-em-desc {
  font-size: var(--fs-micro);
  color: var(--ink-2);
  line-height: 1.7;
  margin-bottom: 22rpx;
}

.dw-em-textarea {
  min-height: 140rpx;
  margin-bottom: 18rpx;
}

.dw-em-input {
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 22rpx;
}

.dw-em-cert-row {
  display: flex;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.dw-em-cert {
  flex: 1;
  min-height: 150rpx;
  border: 1rpx dashed var(--line-strong);
  border-radius: var(--r-sm);
  background: var(--surface-2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
  box-sizing: border-box;
}

.dw-em-cert-img {
  width: 100%;
  height: 120rpx;
  border-radius: 12rpx;
}

.dw-em-cert-label {
  margin-top: 8rpx;
  font-size: var(--fs-micro);
  color: var(--ink-2);
  text-align: center;
}

.dw-em-cert-tip {
  margin-bottom: 18rpx;
  font-size: var(--fs-micro);
  color: var(--ink-2);
  background: var(--surface-2);
  border-radius: var(--r-sm);
  padding: 16rpx 18rpx;
}

.dw-em-scope { min-height: 200rpx; }

.dw-em-check-group { margin-bottom: 22rpx; }

.dw-em-check-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 64rpx;
  font-size: var(--fs-caption);
  color: var(--ink);
}

.dw-em-actions { display: flex; gap: 18rpx; }
.dw-em-actions .ui-btn { flex: 1; }
