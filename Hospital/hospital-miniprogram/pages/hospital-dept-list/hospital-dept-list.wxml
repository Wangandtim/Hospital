<view class="container">
  <view class="header">
    <view class="back-btn" bindtap="goBack" hover-class="hover-fade">
      <text>←</text>
    </view>
    <view class="header-title">科室管理</view>
    <view class="header-placeholder"></view>
  </view>

  <view class="search-bar">
    <input class="search-input" placeholder="搜索科室名称或编码" value="{{searchText}}" bindinput="onSearchInput" />
  </view>

  <view class="dept-list">
    <view wx:if="{{filteredDepts.length === 0}}" class="empty-state">
      <image class="empty-icon" src="/images/icons/ic-hospital-14b8a6.png" mode="aspectFit" />
      <view class="empty-text">暂无科室</view>
    </view>
    
    <view wx:for="{{filteredDepts}}" wx:key="deptId" class="dept-card" bindtap="goToDeptDetail" hover-class="hover-fade" data-deptid="{{item.deptId}}">
      <view class="dept-header">
        <text class="dept-name">{{item.deptName}}</text>
        <text class="dept-code">{{item.deptCode}}</text>
      </view>
      <view class="dept-desc" wx:if="{{item.description}}">{{item.description}}</view>
      <view class="dept-footer">
        <view class="dept-info">
          <text class="info-item">负责人：{{item.manager || '未设置'}}</text>
        </view>
        <view class="dept-edit" catchtap="editDept" data-deptid="{{item.deptId}}" hover-class="hover-fade">编辑</view>
        <view class="dept-arrow">›</view>
      </view>
    </view>
  </view>
</view>
