page { background: var(--paper); }
.dept-mgr-page { padding-top: 8rpx; padding-bottom: 48rpx; }
.dept-mgr-search { margin-top: 8rpx; margin-bottom: 20rpx; }
.dept-mgr-input { flex: 1; font-size: var(--fs-h3); color: var(--ink); }
.dept-mgr-list { border: 1rpx solid var(--line); border-radius: var(--r-lg); overflow: hidden; background: var(--surface); }
.dept-mgr-edit {
  flex-shrink: 0;
  font-size: var(--fs-micro);
  color: var(--primary);
  border: 1rpx solid var(--line);
  border-radius: var(--r-pill);
  padding: 8rpx 20rpx;
}
