page {
  background: #f0fdfa;
  min-height: 100vh;
}

.container {
  padding-bottom: 40rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  color: white;
}

.back-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
}

.header-placeholder {
  width: 80rpx;
}

.search-bar {
  padding: 20rpx 30rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e6fffa;
}

.search-input {
  width: 100%;
  height: 80rpx;
  background: #f0fdfa;
  border: 1rpx solid #e6fffa;
  border-radius: 50rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #143634;
}

.dept-list {
  padding: 20rpx 30rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 30rpx;
  opacity: 0.7;
}

.empty-text {
  font-size: 28rpx;
  color: #94aeab;
}

.dept-card {
  background: #ffffff;
  border: 1rpx solid #e6fffa;
  border-radius: 36rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.14);
}

.dept-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.dept-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #143634;
}

.dept-code 
{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #0f766e;
  background: #ecfdf9;
  border: 1rpx solid #ccfbf1;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.dept-desc {
  font-size: 26rpx;
  color: #5b7c7a;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.dept-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0fdfa;
}

.info-item {
  font-size: 26rpx;
  color: #94aeab;
}

.dept-arrow {
  font-size: 40rpx;
  color: #94aeab;
}

.dept-edit {
  font-size: 24rpx;
  color: #0f766e;
  padding: 6rpx 20rpx;
  border-radius: 16rpx;
  background: #f0fdfa;
  border: 1rpx solid #d9f2ef;
  margin-left: auto;
  margin-right: 16rpx;
}
