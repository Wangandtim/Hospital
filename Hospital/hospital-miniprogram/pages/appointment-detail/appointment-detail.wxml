<view class="appt-detail-page">
  <view class="ui-page appt-detail-inner" wx:if="{{detail}}">
    <view class="ui-title-block">
      <view class="ui-eyebrow ui-eyebrow-gold">APPOINTMENT</view>
      <view class="ui-title">预约详情</view>
    </view>

    <view class="appt-detail-hero">
      <view class="appt-detail-date">
        <view class="appt-detail-day ui-num">{{detail.dayText}}</view>
        <view class="appt-detail-month">{{detail.monthText}} · {{detail.timeSlot}}</view>
      </view>
      <view class="ui-state {{detail.statusState === 'ok' ? 'ui-state-ok' : 'ui-state-full'}}"><i></i>{{detail.statusText}}</view>
    </view>

    <ui-process
      steps="{{['已预约','待签到','就诊中','已完成']}}"
      current="{{detail.flowCurrent}}"
    />

    <view class="appt-detail-ticket">
      <view class="appt-detail-ticket-head">
        <view class="appt-detail-doctor">{{detail.doctorName}} <text class="appt-detail-title">{{detail.doctorTitle}}</text></view>
        <view class="appt-detail-dept-row">
          <view class="ui-plate tiny"><image class="ui-plate-img" src="{{detail.deptIcon}}" mode="aspectFit" /></view>
          <view class="appt-detail-dept">{{detail.deptName || '门诊科室'}}</view>
        </view>
      </view>
      <view class="appt-detail-ticket-grid">
        <view class="appt-detail-cell"><view class="ui-micro">就诊医院</view><view class="appt-detail-cell-value">{{hospitalName || '—'}}</view></view>
        <view class="appt-detail-cell"><view class="ui-micro">就诊序号</view><view class="appt-detail-cell-value">{{detail.queueNo}}</view></view>
        <view class="appt-detail-cell"><view class="ui-micro">就诊人</view><view class="appt-detail-cell-value">{{detail.patientName || '—'}}</view></view>
        <view class="appt-detail-cell"><view class="ui-micro">手机号</view><view class="appt-detail-cell-value">{{detail.patientPhone || '—'}}</view></view>
      </view>
      <view class="appt-detail-ticket-code">
        <canvas wx:if="{{voucherCode}}" canvas-id="voucherQr" class="appt-qr-canvas"></canvas>
        <view wx:if="{{voucherLoading}}" class="appt-qr-placeholder">正在生成就诊码…</view>
        <view wx:if="{{!voucherLoading && !voucherCode}}" class="appt-qr-placeholder">{{voucherTip || '当前暂不可出示就诊码'}}</view>
        <view class="appt-detail-qr-text">
          <view class="ui-micro">到院扫码报到</view>
          <view class="appt-detail-code ui-num" wx:if="{{voucherCode}}">{{voucherShort}}</view>
          <view class="appt-voucher-countdown" wx:if="{{voucherCountdown}}">{{voucherCountdown}}</view>
          <view class="appt-voucher-links" wx:if="{{!voucherLoading}}">
            <view class="appt-voucher-refresh" bindtap="fetchVoucher" hover-class="hover-fade">{{voucherCode ? '重新获取' : '出示就诊码'}}</view>
            <view class="appt-voucher-refresh" wx:if="{{voucherCode}}" bindtap="copyVoucher" hover-class="hover-fade">复制凭证</view>
          </view>
        </view>
      </view>
    </view>

    <view>
      <view class="ui-section-head">
        <text class="ui-section-title">费用</text>
        <text class="ui-section-sub">PAYMENT</text>
      </view>
      <view class="ui-panel">
        <view class="ui-panel-body ui-panel-body-flush">
          <view class="ui-row"><view class="ui-row-label">挂号费</view><view class="ui-row-main"></view><view class="ui-row-val">¥{{detail.fee}}</view></view>
          <view class="ui-row"><view class="ui-row-label">医保统筹</view><view class="ui-row-main"></view><view class="ui-row-val">- ¥{{detail.insurance}}</view></view>
          <view class="ui-row"><view class="ui-row-label">实付</view><view class="ui-row-main"></view><view class="ui-row-val ui-row-val-gold">¥{{detail.fee > detail.insurance ? detail.fee - detail.insurance : 0}}</view></view>
        </view>
      </view>
    </view>

    <view class="appt-detail-meta">
      <view wx:if="{{detail.createTime}}">下单时间 · {{detail.createTime}}</view>
      <view>如需取消，请提前 2 小时操作；就诊当日请提前 30 分钟签到。</view>
    </view>

    <view class="appt-detail-actions">
      <button wx:if="{{canCancel}}" class="ui-btn ui-btn-danger" bindtap="cancelAppointment">取消预约</button>
      <button class="ui-btn ui-btn-primary" bindtap="bookAgain">再约该医生</button>
    </view>
  </view>

  <view class="appt-detail-skeleton" wx:if="{{loading}}">
    <view class="ui-skeleton ui-skeleton-card" wx:for="{{[1,2,3]}}" wx:key="index"></view>
  </view>

  <ui-empty
    wx:if="{{loaded && !detail}}"
    mark="约"
    title="未找到该预约"
    hint="预约可能已被删除或取消"
    actionText="返回我的预约"
    bindaction="goBack"
  />
</view>
