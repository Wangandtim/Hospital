<view class="page">
  <view class="header">
    <view class="back-btn" bindtap="goBack" hover-class="hover-fade">
      <text class="back-icon">←</text>
    </view>
    <view class="header-title">预约详情</view>
    <view class="header-placeholder"></view>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view class="empty" wx:if="{{loaded && !detail}}">
    <image class="empty-icon" src="/images/icons/ic-calendar-14b8a6.png" mode="aspectFit" />
    <text class="empty-text">未找到该预约</text>
    <text class="empty-hint">预约可能已被删除</text>
  </view>

  <view class="content" wx:if="{{detail}}">
    <view class="hero-card">
      <view class="hero-top">
        <view class="hero-date">{{detail.appointmentDate}}</view>
        <view class="status-tag status-{{detail.status}}">{{detail.statusText}}</view>
      </view>
      <view class="hero-time">
        <image class="hero-icon" src="/images/icons/ic-clock-14b8a6.png" mode="aspectFit" />
        <text>{{detail.timeSlot || '时段未知'}}</text>
      </view>
    </view>

    <view class="card">
      <view class="row">
        <view class="icon-chip"><image class="row-icon" src="/images/icons/ic-doctor-14b8a6.png" mode="aspectFit" /></view>
        <view class="row-text">
          <text class="row-title">{{detail.doctorName}}</text>
          <text class="row-desc">{{detail.doctorTitle || '医生'}}{{detail.deptName ? ' · ' + detail.deptName : ''}}</text>
        </view>
      </view>
      <view class="row" wx:if="{{hospitalName}}">
        <view class="icon-chip"><image class="row-icon" src="/images/icons/ic-hospital-14b8a6.png" mode="aspectFit" /></view>
        <view class="row-text">
          <text class="row-title">{{hospitalName}}</text>
          <text class="row-desc">就诊医院</text>
        </view>
      </view>
      <view class="row" wx:if="{{detail.patientName}}">
        <view class="icon-chip"><image class="row-icon" src="/images/icons/ic-user-14b8a6.png" mode="aspectFit" /></view>
        <view class="row-text">
          <text class="row-title">{{detail.patientName}}</text>
          <text class="row-desc">{{detail.patientPhone || '就诊人'}}</text>
        </view>
      </view>
      <view class="row" wx:if="{{detail.createTime}}">
        <view class="icon-chip"><image class="row-icon" src="/images/icons/ic-calendar-14b8a6.png" mode="aspectFit" /></view>
        <view class="row-text">
          <text class="row-title">下单时间</text>
          <text class="row-desc">{{detail.createTime}}</text>
        </view>
      </view>
    </view>

    <view class="notice">请按预约时间提前 15 分钟到院，凭就诊人信息到导诊台报到。</view>

    <view class="action-group">
      <button wx:if="{{canCancel}}" class="btn-ghost danger" bindtap="cancelAppointment" hover-class="btn-hover">取消预约</button>
      <button class="btn-primary" bindtap="bookAgain" hover-class="btn-hover">再预约该医生</button>
    </view>
  </view>
</view>
