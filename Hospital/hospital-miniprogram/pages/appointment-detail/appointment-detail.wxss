.appt-detail-page { min-height: 100vh; padding-top: 16rpx; }
.appt-detail-inner { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }

.appt-detail-hero { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 16rpx; }
.appt-detail-day { font-family: "Songti SC", serif; font-size: 96rpx; line-height: 0.95; color: #171D1B; letter-spacing: -0.03em; }
.appt-detail-month { font-size: 26rpx; color: #8A938F; margin-top: 8rpx; }

.appt-detail-ticket {
  margin-top: 20rpx;
  background: #FFFDFA;
  border: 1rpx solid #E5E5DE;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(23, 29, 27, 0.06);
}
.appt-detail-ticket-head { padding: 26rpx 26rpx 20rpx; border-bottom: 1rpx solid #EFEEE8; }
.appt-detail-doctor { font-family: "Songti SC", serif; font-size: 44rpx; color: #171D1B; }
.appt-detail-title { font-family: inherit; font-size: 24rpx; color: #8A938F; margin-left: 10rpx; }
.appt-detail-dept-row { display: flex; align-items: center; gap: 12rpx; margin-top: 8rpx; }
.appt-detail-dept { font-size: 24rpx; color: #4B5652; margin-top: 0; }

.appt-detail-ticket-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx 16rpx;
  padding: 24rpx 26rpx;
}
.appt-detail-cell-value { font-size: 26rpx; color: #171D1B; margin-top: 4rpx; line-height: 1.5; }

.appt-detail-ticket-code {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 26rpx 26rpx;
  border-top: 1rpx dashed #E5D7BC;
}
.appt-qr-canvas {
  width: 400rpx;
  height: 400rpx;
  flex-shrink: 0;
  border: 1rpx solid #E5E5DE;
  background: #FFFFFF;
}
.appt-qr-placeholder {
  width: 400rpx;
  height: 400rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  box-sizing: border-box;
  border: 1rpx dashed #E5E5DE;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #8A938F;
  text-align: center;
  line-height: 1.6;
}
.appt-voucher-countdown { font-size: 22rpx; color: #8A938F; margin-top: 8rpx; }
.appt-voucher-links { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.appt-voucher-refresh {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: #E6EFEB;
  color: #0F5B50;
  font-size: 24rpx;
}
.appt-detail-qr-text { flex: 1; min-width: 0; }
.appt-detail-code { font-size: 32rpx; color: #171D1B; letter-spacing: 0.06em; margin-top: 4rpx; }

.appt-detail-meta { font-size: 22rpx; color: #8A938F; line-height: 1.9; margin-top: 28rpx; }

.appt-detail-actions { display: flex; gap: 16rpx; margin-top: 32rpx; }
.appt-detail-actions .ui-btn { flex: 1; }

.appt-detail-skeleton { padding: 48rpx; }
