.patient-page {
  min-height: 100vh;
  padding-top: 8rpx;
}

.search-bar {
  margin-bottom: var(--s3);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-size: var(--fs-body);
  color: var(--ink);
}

.patient-list {
  padding-bottom: var(--s3);
}

.patient-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 28rpx;
}

.plate-char {
  font-family: var(--font-serif);
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary);
}

.patient-info {
  flex: 1;
  min-width: 0;
}

.patient-name {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
  line-height: 1.35;
}

.patient-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  font-size: var(--fs-caption);
  color: var(--ink-2);
  margin-top: 6rpx;
}

.meta-divider {
  color: var(--ink-4);
}

.last-visit {
  font-size: var(--fs-micro);
  color: var(--ink-3);
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
