.container {
  min-height: 100vh;
  background: #f0fdfa;
  padding: 20rpx;
}

.search-bar {
  background: #ffffff;
  border-radius: 26rpx;
  border: 1rpx solid #e6fffa;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.14);
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.search-input {
  width: 100%;
  height: 60rpx;
  background: #ecfdf9;
  border: 1rpx solid #ccfbf1;
  border-radius: 40rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.patient-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.patient-item {
  background: #ffffff;
  border-radius: 36rpx;
  border: 1rpx solid #e6fffa;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.14);
  padding: 30rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.patient-avatar {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.patient-avatar-icon {
  width: 52rpx;
  height: 52rpx;
}

.patient-info {
  flex: 1;
  min-width: 0;
}

.patient-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #143634;
  margin-bottom: 12rpx;
}

.patient-meta {
  font-size: 26rpx;
  color: #5b7c7a;
  margin-bottom: 8rpx;
}

.meta-item {
  margin-right: 12rpx;
}

.meta-divider {
  margin-right: 12rpx;
  color: #ddd;
}

.last-visit {
  font-size: 24rpx;
  color: #94aeab;
}

.patient-arrow {
  font-size: 32rpx;
  color: #94aeab;
  flex-shrink: 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #5b7c7a;
}
