<view class="ui-page patient-page">
  <view class="ui-title-block">
    <view class="ui-eyebrow ui-eyebrow-gold">PATIENTS</view>
    <view class="ui-title">我的患者</view>
    <view class="ui-subtitle">共 {{filteredPatients.length}} 位</view>
  </view>

  <view class="ui-search search-bar">
    <view class="ui-search-ico"></view>
    <input class="search-input" placeholder="搜索患者姓名" bindinput="onSearchInput" value="{{searchKeyword}}" />
  </view>

  <view class="patient-list">
    <view class="ui-panel patient-item" wx:for="{{filteredPatients}}" wx:key="patientId" bindtap="viewPatientDetail" data-id="{{item.patientId}}" hover-class="hover-fade">
      <view class="ui-plate"><text class="plate-char">患</text></view>
      <view class="patient-info">
        <view class="patient-name">{{item.name}}</view>
        <view class="patient-meta">
          <text>{{item.gender === 'M' ? '男' : item.gender === 'F' ? '女' : '未知'}} · {{item.age}}岁</text>
          <text class="meta-divider">·</text>
          <text>{{item.phone}}</text>
        </view>
        <view class="last-visit">病历: {{item.medicalHistory || '暂无'}}</view>
      </view>
      <view class="ui-chev">›</view>
    </view>
  </view>

  <view class="ui-empty" wx:if="{{filteredPatients.length === 0}}">
    <view class="ui-empty-mark">患</view>
    <view class="ui-empty-title">{{searchKeyword ? '未找到患者' : '暂无患者'}}</view>
  </view>
</view>
