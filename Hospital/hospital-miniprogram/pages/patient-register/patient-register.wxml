<view class="ui-page patient-register">
  <view class="ui-back" bindtap="goBack"><text>←</text></view>

  <view class="ui-title-block">
    <view class="ui-eyebrow ui-eyebrow-gold">REGISTER</view>
    <view class="ui-title">患者注册</view>
    <view class="ui-subtitle">完善基本信息后即可预约就诊</view>
  </view>

  <view class="ui-panel">
    <view class="ui-panel-body">
      <view class="ui-field">
        <view class="ui-field-label">手机号 *</view>
        <input class="ui-input form-input" placeholder="请输入手机号" placeholder-class="ui-input-ph" bindinput="onPhoneInput" value="{{formData.phone}}" />
      </view>

      <view class="ui-field">
        <view class="ui-field-label">密码 *</view>
        <input class="ui-input form-input" placeholder="请输入密码" placeholder-class="ui-input-ph" password bindinput="onPasswordInput" value="{{formData.password}}" />
      </view>

      <view class="ui-field">
        <view class="ui-field-label">确认密码 *</view>
        <input class="ui-input form-input" placeholder="请再次输入密码" placeholder-class="ui-input-ph" password bindinput="onConfirmPasswordInput" value="{{formData.confirmPassword}}" />
      </view>

      <view class="ui-field">
        <view class="ui-field-label">姓名 *</view>
        <input class="ui-input form-input" placeholder="请输入姓名" placeholder-class="ui-input-ph" bindinput="onNameInput" value="{{formData.name}}" />
      </view>

      <view class="ui-field">
        <view class="ui-field-label">性别 *</view>
        <picker mode="selector" range="{{genders}}" bindchange="onGenderChange" value="{{genderIndex}}">
          <view class="ui-input picker-value {{genderIndex >= 0 ? '' : 'picker-placeholder'}}">{{genderIndex >= 0 ? genders[genderIndex] : '请选择性别'}}</view>
        </picker>
      </view>

      <view class="ui-field">
        <view class="ui-field-label">年龄</view>
        <input class="ui-input form-input" type="number" placeholder="请输入年龄" placeholder-class="ui-input-ph" bindinput="onAgeInput" value="{{formData.age}}" />
      </view>

      <view class="ui-field">
        <view class="ui-field-label">身份证号</view>
        <input class="ui-input form-input" placeholder="请输入身份证号" placeholder-class="ui-input-ph" bindinput="onIdCardInput" value="{{formData.idCard}}" />
      </view>

      <view class="ui-field">
        <view class="ui-field-label">既往病史</view>
        <textarea class="ui-textarea" placeholder="请输入既往病史（选填）" placeholder-class="ui-input-ph" bindinput="onMedicalHistoryInput" value="{{formData.medicalHistory}}"></textarea>
      </view>
    </view>
  </view>

  <button hover-class="hover-press" hover-stay-time="150" class="ui-btn ui-btn-primary btn-register" bindtap="handleRegister">注册</button>

  <view hover-class="hover-fade" hover-stay-time="150" class="ui-btn ui-btn-text login-link" bindtap="goToLogin">已有账号？立即登录</view>
</view>
