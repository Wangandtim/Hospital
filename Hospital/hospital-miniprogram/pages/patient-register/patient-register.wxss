.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #0d9488 0%, #08979c 100%);
  padding-bottom: 40rpx;
}

.header {
  display: flex;
  align-items: center;
  padding: 80rpx 40rpx 30rpx;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 48rpx;
  color: white;
  font-weight: bold;
}

.title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  color: white;
  margin-right: 60rpx;
}

.form {
  margin: 20rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 30rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.15);
}

.form-item {
  margin-bottom: 25rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  border: 2rpx solid #e8e8e8;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  border: 2rpx solid #e8e8e8;
}

.picker-value {
  font-size: 28rpx;
  color: #333;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  text-align: center;
  border: 2rpx solid #e8e8e8;
}

.btn-register 
{
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 30rpx 20rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #0d9488, #08979c);
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 50rpx;
  box-shadow: 0 4rpx 20rpx rgba(13, 148, 136, 0.4);
  border: none;
}

.btn-register::after {
  border: none;
}

.login-link {
  text-align: center;
  color: rgba(255, 255, 255, 0.85);
  font-size: 28rpx;
  margin-top: 20rpx;
}