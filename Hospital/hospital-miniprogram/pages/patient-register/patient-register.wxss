.patient-register {
  min-height: 100vh;
  padding-top: 16rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.form-input {
  width: 100%;
  box-sizing: border-box;
}

.picker-value {
  justify-content: flex-start;
}

.picker-placeholder {
  color: var(--ink-4);
}

.btn-register {
  margin-top: var(--s4);
  width: 100%;
}

.login-link {
  margin-top: var(--s2);
  width: 100%;
  justify-content: center;
}
