<view class="ui-page ts-page">
  <view class="ui-title-block">
    <view class="ui-eyebrow ui-eyebrow-gold">TEST PAGE</view>
    <view class="ui-title">排班测试</view>
  </view>

  <view class="ui-panel">
    <view class="ui-panel-head">
      <view class="ui-panel-title">日历点击</view>
    </view>
    <view class="ui-panel-body">
      <view class="ts-calendar">
        <view
          hover-class="hover-press"
          hover-stay-time="150"
          class="ts-date"
          wx:for="{{testDates}}"
          wx:key="date"
          bindtap="onDateClick"
          data-date="{{item.date}}"
        >
          <text class="ts-date-num">{{item.day}}</text>
          <view class="ts-dot" wx:if="{{item.hasSchedule}}"></view>
        </view>
      </view>
    </view>
  </view>

  <view class="ui-panel">
    <view class="ui-panel-head">
      <view class="ui-panel-title">添加排班</view>
    </view>
    <view class="ui-panel-body">
      <view class="ui-field">
        <view class="ui-field-label">日期</view>
        <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
          <view class="ui-input ts-picker">
            <text>{{form.date || '选择日期'}}</text>
            <text class="ui-chev">▾</text>
          </view>
        </picker>
      </view>
      <view class="ui-field ts-field-last">
        <view class="ui-field-label">时间</view>
        <picker mode="time" value="{{form.time}}" bindchange="onTimeChange">
          <view class="ui-input ts-picker">
            <text>{{form.time || '选择时间'}}</text>
            <text class="ui-chev">▾</text>
          </view>
        </picker>
      </view>
      <button hover-class="hover-press" hover-stay-time="150" class="ui-btn ui-btn-primary ts-submit" bindtap="onSubmit">提交测试</button>
    </view>
  </view>

  <view class="ui-panel">
    <view class="ui-panel-head">
      <view class="ui-panel-title">测试结果</view>
    </view>
    <view class="ui-panel-body">
      <view class="ts-result">{{resultText}}</view>
    </view>
  </view>
</view>
