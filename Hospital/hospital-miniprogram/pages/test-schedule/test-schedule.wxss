page {
  background-color: #f0fdfa;
  padding: 30rpx;
}

.container {
  padding: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 40rpx;
  color: #333;
}

.test-section {
  background-color: #fff;
  border-radius: 22rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
  display: block;
}

.calendar-preview {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.date-box {
  width: 100rpx;
  height: 100rpx;
  background-color: #f0fdfa;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #333;
}

.date-box:active {
  background-color: #0d9488;
  color: #fff;
}

.dot {
  font-size: 16rpx;
  color: #0d9488;
  margin-top: 5rpx;
}

.form-group {
  margin-bottom: 20rpx;
}

.label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
  display: block;
}

.picker {
  padding: 20rpx;
  background-color: #f0fdfa;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.submit-btn {
  width: 100%;
  padding: 25rpx;
  background-color: #0d9488;
  color: #fff;
  border-radius: 22rpx;
  font-size: 30rpx;
  margin-top: 20rpx;
}

.result-box {
  padding: 20rpx;
  background-color: #f6ffed;
  border-radius: 12rpx;
}

.result-text {
  font-size: 28rpx;
  color: #52c41a;
}