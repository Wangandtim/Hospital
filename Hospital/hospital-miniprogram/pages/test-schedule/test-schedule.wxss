.ts-page { padding-top: 8rpx; padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }

.ts-calendar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.ts-date {
  height: 96rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-sm);
  background: var(--surface-2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.ts-date-num {
  font-size: var(--fs-body);
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

.ts-date:active {
  background: var(--primary);
}
.ts-date:active .ts-date-num { color: #fff; }

.ts-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--gold);
}

.ts-picker {
  justify-content: space-between;
  font-size: var(--fs-body);
}

.ts-field-last { margin-bottom: 4rpx; }

.ts-submit {
  width: 100%;
  margin-top: 16rpx;
}

.ts-result {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  border-radius: var(--r-sm);
  font-size: var(--fs-caption);
  color: var(--primary);
  line-height: 1.6;
  word-break: break-all;
}
