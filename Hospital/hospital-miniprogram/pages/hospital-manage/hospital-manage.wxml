<view class="ui-page hm-page">
  <view class="ui-head">
    <view class="ui-brand">
      <view class="ui-brand-word">医院管理</view>
      <view class="ui-brand-rule"></view>
      <view class="ui-brand-sub">HOSPITALS · {{hospitals.length}}</view>
    </view>
    <view class="ui-head-actions">
      <view class="ui-btn ui-btn-primary ui-btn-sm" wx:if="{{canManage}}" bindtap="showAddModal" hover-class="hover-scale">＋ 添加医院</view>
    </view>
  </view>

  <view class="ui-search hm-search">
    <view class="ui-search-ico"></view>
    <input class="hm-search-input" placeholder="搜索医院名称" bindinput="onSearchInput" value="{{searchKeyword}}" />
  </view>

  <view class="hm-list">
    <view class="ui-panel hm-card" wx:for="{{hospitals}}" wx:key="hospitalId">
      <view class="hm-card-head" bindtap="toggleExpand" data-id="{{item.hospitalId}}" hover-class="hover-fade">
        <view class="ui-plate hm-plate-text">院</view>
        <view class="hm-head-main">
          <view class="hm-name">{{item.hospitalName}}</view>
          <view class="ui-tag hm-level">{{item.level || '未评级'}}</view>
        </view>
        <view class="ui-icon-btn hm-toggle">{{expandedId === item.hospitalId ? '▼' : '▶'}}</view>
      </view>

      <view class="hm-body" wx:if="{{expandedId === item.hospitalId}}">
        <view class="hm-detail">
          <view class="hm-detail-row">
            <text class="hm-detail-label">地址</text>
            <text class="hm-detail-value">{{item.address}}</text>
          </view>
          <view class="hm-detail-row">
            <text class="hm-detail-label">电话</text>
            <text class="hm-detail-value">{{item.phone || '暂无'}}</text>
          </view>
          <view class="hm-detail-row">
            <text class="hm-detail-label">等级</text>
            <text class="hm-detail-value">{{item.level || '未评级'}}</text>
          </view>
          <view class="hm-detail-row">
            <text class="hm-detail-label">地区</text>
            <text class="hm-detail-value">{{item.province}} {{item.city}} {{item.district}}</text>
          </view>
        </view>

        <view class="hm-manage">
          <view class="ui-micro hm-manage-title">快捷管理</view>
          <view class="hm-manage-grid">
            <view class="hm-manage-item" bindtap="goToDepartmentManage" data-hospital-id="{{item.hospitalId}}" data-hospital-name="{{item.hospitalName}}" hover-class="hover-scale">
              <view class="ui-plate tiny">科</view>
              <view class="hm-manage-text">科室管理</view>
            </view>
            <view class="hm-manage-item" bindtap="goToDoctorManage" data-hospital-id="{{item.hospitalId}}" data-hospital-name="{{item.hospitalName}}" hover-class="hover-scale">
              <view class="ui-plate tiny">医</view>
              <view class="hm-manage-text">医生管理</view>
            </view>
            <view class="hm-manage-item" bindtap="goToScheduleManage" data-hospital-id="{{item.hospitalId}}" data-hospital-name="{{item.hospitalName}}" hover-class="hover-scale">
              <view class="ui-plate tiny">排</view>
              <view class="hm-manage-text">排班管理</view>
            </view>
          </view>
        </view>

        <view class="hm-actions" wx:if="{{canManage}}">
          <view class="ui-btn ui-btn-outline ui-btn-sm" bindtap="editHospital" data-id="{{item.hospitalId}}" hover-class="hover-fade">编辑</view>
          <view class="ui-btn ui-btn-danger ui-btn-sm" bindtap="deleteHospital" data-id="{{item.hospitalId}}" hover-class="hover-fade">删除</view>
        </view>
      </view>
    </view>
  </view>

  <view class="ui-empty" wx:if="{{hospitals.length === 0}}">
    <view class="ui-empty-mark">院</view>
    <view class="ui-empty-title">暂无医院数据</view>
    <view class="ui-empty-hint">调整搜索关键词或稍后重试</view>
  </view>

  <view class="hm-pager" wx:if="{{totalPages > 1}}">
    <view class="ui-btn ui-btn-outline ui-btn-sm" bindtap="prevPage" wx:if="{{currentPage > 1}}" hover-class="hover-scale">上一页</view>
    <view class="hm-pager-info ui-num">第 {{currentPage}} / {{totalPages}} 页</view>
    <view class="ui-btn ui-btn-outline ui-btn-sm" bindtap="nextPage" wx:if="{{currentPage < totalPages}}" hover-class="hover-scale">下一页</view>
  </view>

  <view class="hm-mask" wx:if="{{showModal}}" bindtap="hideModal"></view>
  <view class="hm-modal" wx:if="{{showModal}}" catchtap="stopPropagation">
    <view class="hm-modal-head">
      <view class="hm-modal-title">{{isEdit ? '编辑医院' : '添加医院'}}</view>
      <view class="ui-icon-btn hm-modal-close" bindtap="hideModal" hover-class="hover-fade">×</view>
    </view>
    <view class="hm-modal-body">
      <view class="ui-field">
        <view class="ui-field-label">医院名称 *</view>
        <input class="ui-input hm-input" placeholder="请输入医院名称" bindinput="onNameInput" value="{{formData.hospitalName}}" />
      </view>
      <view class="ui-field">
        <view class="ui-field-label">医院等级</view>
        <input class="ui-input hm-input" placeholder="如：三级甲等" bindinput="onLevelInput" value="{{formData.level}}" />
      </view>
      <view class="ui-field">
        <view class="ui-field-label">联系电话</view>
        <input class="ui-input hm-input" placeholder="请输入联系电话" bindinput="onPhoneInput" value="{{formData.phone}}" />
      </view>
      <view class="ui-field">
        <view class="ui-field-label">地址 *</view>
        <input class="ui-input hm-input" placeholder="请输入地址" bindinput="onAddressInput" value="{{formData.address}}" />
      </view>
      <view class="ui-field">
        <view class="ui-field-label">省份</view>
        <input class="ui-input hm-input" placeholder="请输入省份" bindinput="onProvinceInput" value="{{formData.province}}" />
      </view>
      <view class="ui-field">
        <view class="ui-field-label">城市</view>
        <input class="ui-input hm-input" placeholder="请输入城市" bindinput="onCityInput" value="{{formData.city}}" />
      </view>
      <view class="ui-field hm-field-last">
        <view class="ui-field-label">区县</view>
        <input class="ui-input hm-input" placeholder="请输入区县" bindinput="onDistrictInput" value="{{formData.district}}" />
      </view>
    </view>
    <view class="hm-modal-actions">
      <button class="ui-btn ui-btn-outline" bindtap="hideModal" hover-class="hover-fade">取消</button>
      <button class="ui-btn ui-btn-primary" bindtap="saveHospital" hover-class="hover-scale">{{isEdit ? '保存修改' : '添加医院'}}</button>
    </view>
  </view>
</view>
