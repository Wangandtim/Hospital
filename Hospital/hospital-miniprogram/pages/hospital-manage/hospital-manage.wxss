.hm-page { padding-top: 8rpx; padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }

.hm-search { margin-bottom: 24rpx; height: 96rpx; }

.hm-search-input {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  color: var(--ink);
}

.hm-list { display: flex; flex-direction: column; gap: 20rpx; }

.hm-card { margin-bottom: 0; }

.hm-card-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 112rpx;
  padding: 20rpx 24rpx;
}

.hm-plate-text {
  font-family: var(--font-serif);
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--primary);
}

.hm-head-main { flex: 1; min-width: 0; }

.hm-name {
  font-family: var(--font-serif);
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
  line-height: 1.35;
}

.hm-level { margin-top: 8rpx; }

.hm-toggle { flex-shrink: 0; font-size: var(--fs-caption); color: var(--ink-3); }

.hm-body { border-top: 1rpx solid var(--line); }

.hm-detail { padding: 4rpx 24rpx; }

.hm-detail-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  min-height: 96rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.hm-detail-row:last-child { border-bottom: none; }

.hm-detail-label {
  width: 110rpx;
  flex-shrink: 0;
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.hm-detail-value {
  flex: 1;
  font-size: var(--fs-caption);
  color: var(--ink);
  line-height: 1.6;
  word-break: break-all;
}

.hm-manage {
  margin: 0 24rpx 20rpx;
  padding: 20rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
}

.hm-manage-title { margin-bottom: 14rpx; }

.hm-manage-grid { display: flex; gap: 14rpx; }

.hm-manage-item {
  flex: 1;
  min-height: 132rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-sm);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.hm-manage-text {
  font-size: var(--fs-micro);
  color: var(--ink);
}

.hm-actions {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx 24rpx;
  border-top: 1rpx solid var(--line);
}
.hm-actions .ui-btn { flex: 1; }

.hm-pager {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 32rpx 0 8rpx;
}

.hm-pager-info { font-size: var(--fs-caption); color: var(--ink-3); }

.hm-mask {
  position: fixed;
  inset: 0;
  background: rgba(23, 29, 27, 0.48);
  z-index: 30;
}

.hm-modal {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  max-height: 84vh;
  overflow-y: auto;
  background: var(--surface);
  border-radius: var(--r-lg);
  padding: 30rpx var(--s4) 26rpx;
  box-sizing: border-box;
  z-index: 40;
  animation: ui-rise 0.24s ease both;
}

.hm-modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
}

.hm-modal-title {
  font-family: var(--font-serif);
  font-size: var(--fs-h2);
  color: var(--ink);
}

.hm-modal-close { flex-shrink: 0; }

.hm-modal-body { padding-bottom: 4rpx; }

.hm-input { width: 100%; box-sizing: border-box; }

.hm-field-last { margin-bottom: 0; }

.hm-modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}
.hm-modal-actions .ui-btn { flex: 1; }
