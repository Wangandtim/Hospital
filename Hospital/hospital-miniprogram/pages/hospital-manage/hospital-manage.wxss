.container {
  padding: 30rpx;
  min-height: 100vh;
  background: #f5f7fa;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.add-btn 
{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #0d9488, #08979c);
  color: #fff;
  font-size: 28rpx;
  padding: 15rpx 30rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 15rpx rgba(13, 148, 136, 0.4);
}

.search-bar {
  margin-bottom: 25rpx;
}

.search-input {
  width: 100%;
  height: 80rpx;
  background: #fff;
  border-radius: 50rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
}

.hospital-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.hospital-card {
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
  overflow: hidden;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 30rpx;
}

.hospital-info {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.hospital-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #143634;
}

.hospital-level {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #ecfdf9;
  border: 1rpx solid #ccfbf1;
  color: #0f766e;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 14rpx;
}

.expand-icon {
  font-size: 28rpx;
  color: #999;
}

.card-body {
  padding: 0 30rpx 30rpx;
  border-top: 1rpx solid #e6fffa;
}

.detail-section {
  padding: 20rpx 0;
}

.detail-row {
  display: flex;
  padding: 12rpx 0;
  align-items: center;
}

.detail-label {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 26rpx;
  color: #5b7c7a;
  min-width: 130rpx;
}

.detail-label-icon {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

.detail-value {
  font-size: 26rpx;
  color: #143634;
  flex: 1;
  word-break: break-all;
}

.manage-section {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #f0fdfa;
  border: 1rpx solid #e6fffa;
  border-radius: 26rpx;
}

.section-title {
  font-size: 26rpx;
  color: #5b7c7a;
  margin-bottom: 15rpx;
}

.manage-grid {
  display: flex;
  gap: 20rpx;
}

.manage-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 15rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.manage-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 10rpx;
}

.manage-text {
  font-size: 24rpx;
  color: #143634;
}

.card-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e6fffa;
}

.action-btn 
{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  text-align: center;
  padding: 18rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.action-btn.edit {
  background: #e8f4f2;
  color: #0d9488;
}

.action-btn.delete {
  background: #fff2f0;
  color: #ff4d4f;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 30rpx;
  padding: 40rpx 0;
}

.page-btn {
  padding: 15rpx 30rpx;
  background: #fff;
  border-radius: 25rpx;
  font-size: 28rpx;
  color: #0d9488;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.page-info {
  font-size: 28rpx;
  color: #666;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 90%;
  max-width: 650rpx;
  background: #fff;
  border-radius: 32rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-close-icon {
  width: 32rpx;
  height: 32rpx;
}

.modal-body {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 25rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx 35rpx;
}

.btn-cancel 
{
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 88rpx;
  background: #f0fdfa;
  color: #666;
  font-size: 30rpx;
  border-radius: 54rpx;
  border: none;
}

.btn-cancel::after {
  border: none;
}

.btn-confirm 
{
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 88rpx;
  background: linear-gradient(135deg, #0d9488, #08979c);
  color: #fff;
  font-size: 30rpx;
  border-radius: 54rpx;
  border: none;
}

.btn-confirm::after {
  border: none;
}