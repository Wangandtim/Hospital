page {
  background: #f0fdfa;
}

.container {
  min-height: 100vh;
  padding: 0 24rpx 180rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  padding-top: 16rpx;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: #ffffff;
  color: #0f766e;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(13, 148, 136, 0.12);
}

.header-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #0f2e2e;
}

.header-placeholder {
  width: 64rpx;
}

.tip-card {
  background: #e6fffa;
  border: 1rpx solid #d9f2ef;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #0f766e;
  line-height: 1.6;
}

.article-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.empty-state {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 60rpx 24rpx;
  text-align: center;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.1);
}

.empty-title {
  display: block;
  font-size: 30rpx;
  color: #0f2e2e;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #5b7c7a;
}

.article-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 14rpx 32rpx rgba(13, 148, 136, 0.12);
  border: 1rpx solid #e6fffa;
}

.article-main {
  display: flex;
  gap: 20rpx;
}

.article-cover {
  width: 190rpx;
  height: 130rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: #f0fdfa;
}

.article-cover.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #94aeac;
}

.article-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.article-title-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.article-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #0f2e2e;
  line-height: 1.4;
}

.article-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
}

.article-status.online {
  background: #ccfbf1;
  color: #0f766e;
}

.article-status.offline {
  background: #f1f5f9;
  color: #64748b;
}

.article-summary {
  font-size: 24rpx;
  color: #5b7c7a;
  line-height: 1.5;
}

.article-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.article-cat {
  font-size: 22rpx;
  color: #0f766e;
  background: #f0fdfa;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  border: 1rpx solid #d9f2ef;
}

.article-time {
  font-size: 22rpx;
  color: #94aeac;
}

.article-actions {
  display: flex;
  justify-content: flex-end;
  gap: 28rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f1f7f6;
}

.action-link {
  font-size: 24rpx;
  color: #0f766e;
}

.action-link.danger {
  color: #ef4444;
}

.fab {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  bottom: 60rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #14b8a6;
  color: #ffffff;
  font-size: 28rpx;
  padding: 20rpx 44rpx;
  border-radius: 999rpx;
  box-shadow: 0 18rpx 40rpx rgba(20, 184, 166, 0.35);
  z-index: 20;
}

.fab-plus {
  font-size: 34rpx;
  font-weight: 600;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(6, 40, 38, 0.45);
  z-index: 30;
}

.form-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 86vh;
  overflow-y: auto;
  background: #ffffff;
  border-radius: 36rpx 36rpx 0 0;
  padding: 32rpx 32rpx 44rpx;
  box-sizing: border-box;
  z-index: 40;
  animation: rise-in 0.22s ease both;
}

.form-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #0f2e2e;
  margin-bottom: 24rpx;
}

.form-row {
  margin-bottom: 22rpx;
}

.form-row.column {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.form-row.two {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-label {
  font-size: 24rpx;
  color: #5b7c7a;
}

.form-input {
  background: #f7fdfc;
  border: 1rpx solid #d9f2ef;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  color: #0f2e2e;
}

.form-picker {
  display: inline-block;
  background: #f7fdfc;
  border: 1rpx solid #d9f2ef;
  border-radius: 16rpx;
  padding: 14rpx 24rpx;
  font-size: 26rpx;
  color: #0f766e;
}

.form-textarea {
  width: 100%;
  height: 220rpx;
  background: #f7fdfc;
  border: 1rpx solid #d9f2ef;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  color: #0f2e2e;
  box-sizing: border-box;
}

.cover-picker {
  width: 220rpx;
  height: 150rpx;
  border-radius: 20rpx;
  border: 1rpx dashed #a7ded8;
  background: #f7fdfc;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.cover-preview {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  font-size: 24rpx;
  color: #0f766e;
}

.form-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}

.form-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 20rpx;
  font-size: 28rpx;
}

.form-btn.ghost {
  background: #f0fdfa;
  color: #0f766e;
  border: 1rpx solid #d9f2ef;
}

.form-btn.primary {
  background: #14b8a6;
  color: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(20, 184, 166, 0.3);
}
