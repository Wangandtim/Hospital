.art-page { padding-bottom: calc(200rpx + env(safe-area-inset-bottom)); }

.art-switch { min-height: 108rpx; }

.art-hint {
  font-size: var(--fs-micro);
  color: var(--ink-3);
  line-height: 1.7;
  padding: 20rpx 4rpx 24rpx;
}

.art-list { display: flex; flex-direction: column; gap: 20rpx; }

.art-card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: var(--shadow-1);
}

.art-main { display: flex; gap: 20rpx; }

.art-cover {
  width: 190rpx;
  height: 132rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: var(--surface-2);
}

.art-cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-micro);
  color: var(--ink-4);
  border: 1rpx solid var(--line);
}

.art-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.art-title-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.art-title {
  flex: 1;
  font-family: var(--font-serif);
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
}

.art-summary {
  font-size: var(--fs-micro);
  color: var(--ink-2);
  line-height: 1.6;
}

.art-meta { display: flex; align-items: center; gap: 14rpx; }
.art-time { font-size: var(--fs-micro); color: var(--ink-3); }

.art-actions {
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
}
.art-actions .ui-btn { min-width: 130rpx; }

.art-fab {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 20;
  min-width: 360rpx;
  gap: 10rpx;
  box-shadow: var(--shadow-3);
}

.art-fab-plus { font-size: var(--fs-h3); line-height: 1; }

.art-mask {
  position: fixed;
  inset: 0;
  background: rgba(23, 29, 27, 0.48);
  z-index: 30;
}

.art-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 88vh;
  overflow-y: auto;
  background: var(--surface);
  border-radius: var(--r-lg) var(--r-lg) 0 0;
  padding: 32rpx var(--gutter) calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  z-index: 40;
  animation: ui-rise 0.24s ease both;
}

.art-sheet-head { padding: 4rpx 0 24rpx; }

.art-sheet-title {
  font-family: var(--font-serif);
  font-size: var(--fs-h2);
  color: var(--ink);
  margin-top: 8rpx;
}

.art-input { width: 100%; box-sizing: border-box; }

.art-picker {
  justify-content: space-between;
  font-size: var(--fs-h3);
  color: var(--ink);
}

.art-cover-picker {
  width: 240rpx;
  height: 160rpx;
  border-radius: var(--r-sm);
  border: 1rpx dashed var(--line-strong);
  background: var(--surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.art-cover-preview { width: 100%; height: 100%; }

.art-cover-placeholder {
  font-size: var(--fs-caption);
  color: var(--ink-2);
}

.art-sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}
.art-sheet-actions .ui-btn { flex: 1; }
