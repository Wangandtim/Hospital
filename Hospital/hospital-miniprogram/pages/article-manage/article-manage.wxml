<view class="ui-page art-page">
  <view class="ui-title-block">
    <view class="ui-back" bindtap="goBack" hover-class="hover-fade">←</view>
    <view class="ui-eyebrow ui-eyebrow-gold">CONTENT</view>
    <view class="ui-title">医院内容管理</view>
    <view class="ui-subtitle">公告与动态的发布、上下架</view>
  </view>

  <view class="ui-panel">
    <view class="ui-row art-switch">
      <view class="ui-row-main">
        <view class="ui-row-title">公告开关</view>
      </view>
      <switch checked="{{noticeEnabled}}" color="#0F5B50" disabled="{{noticeLoading || noticeSaving}}" bindchange="onNoticeSwitchChange" />
    </view>
  </view>

  <view class="art-list">
    <view class="ui-empty" wx:if="{{articles.length === 0}}">
      <view class="ui-empty-mark">文</view>
      <view class="ui-empty-title">还没有发布内容</view>
    </view>

    <view class="art-card" wx:for="{{articles}}" wx:key="articleId">
      <view class="art-main">
        <image class="art-cover" wx:if="{{item.coverFull}}" src="{{item.coverFull}}" mode="aspectFill" />
        <view class="art-cover art-cover-empty" wx:else>暂无封面</view>
        <view class="art-info">
          <view class="art-title-row">
            <text class="art-title">{{item.title}}</text>
            <view class="ui-state {{item.status === 1 ? 'ui-state-ok' : 'ui-state-full'}}"><i></i>{{item.status === 1 ? '已发布' : '已下架'}}</view>
          </view>
          <text class="art-summary" wx:if="{{item.summary}}">{{item.summary}}</text>
          <view class="art-meta">
            <view class="ui-tag">{{item.category || '文章'}}</view>
            <text class="art-time">{{item.timeText}}</text>
          </view>
        </view>
      </view>
      <view class="art-actions">
        <view class="ui-btn ui-btn-outline ui-btn-sm" bindtap="openEdit" data-article="{{item}}" hover-class="hover-fade">编辑</view>
        <view class="ui-btn ui-btn-primary ui-btn-sm" bindtap="toggleStatus" data-article="{{item}}" hover-class="hover-fade">{{item.status === 1 ? '下架' : '发布'}}</view>
        <view class="ui-btn ui-btn-danger ui-btn-sm" bindtap="removeArticle" data-article="{{item}}" hover-class="hover-fade">删除</view>
      </view>
    </view>
  </view>

  <view class="art-fab ui-btn ui-btn-primary" bindtap="openCreate" hover-class="hover-press">
    <text class="art-fab-plus">＋</text>
    <text>发布内容</text>
  </view>

  <!-- 编辑弹层 -->
  <view class="art-mask" wx:if="{{showForm}}" bindtap="closeForm"></view>
  <view class="art-sheet" wx:if="{{showForm}}">
    <view class="art-sheet-head">
      <view class="ui-eyebrow ui-eyebrow-gold">PUBLISH</view>
      <view class="art-sheet-title">{{editingId ? '编辑内容' : '发布内容'}}</view>
    </view>

    <view class="ui-field">
      <view class="ui-field-label">类型</view>
      <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="ui-input art-input art-picker">
          <text>{{categories[categoryIndex]}}</text>
          <text class="ui-chev">▾</text>
        </view>
      </picker>
    </view>

    <view class="ui-field">
      <view class="ui-field-label">标题</view>
      <input class="ui-input art-input" placeholder="例如：冬季呼吸道疾病防治提醒" value="{{form.title}}" data-field="title" bindinput="onInput" />
    </view>

    <view class="ui-field">
      <view class="ui-field-label">摘要（可选，列表中展示）</view>
      <input class="ui-input art-input" placeholder="一句话说明重点" value="{{form.summary}}" data-field="summary" bindinput="onInput" />
    </view>

    <view class="ui-field">
      <view class="ui-field-label">封面图</view>
      <view class="art-cover-picker" bindtap="chooseCover" hover-class="hover-fade">
        <image class="art-cover-preview" wx:if="{{form.coverUrl}}" src="{{baseUrl}}{{form.coverUrl}}" mode="aspectFill" />
        <text class="art-cover-placeholder" wx:else>{{uploading ? '上传中…' : '＋ 上传封面'}}</text>
      </view>
    </view>

    <view class="ui-field">
      <view class="ui-field-label">正文 / 通知内容</view>
      <textarea class="ui-textarea" placeholder="输入正文" value="{{form.content}}" data-field="content" bindinput="onInput" maxlength="2000" />
    </view>

    <view class="art-sheet-actions">
      <view class="ui-btn ui-btn-outline" bindtap="closeForm" hover-class="hover-fade">取消</view>
      <view class="ui-btn ui-btn-primary" bindtap="submitForm" hover-class="hover-press">{{editingId ? '保存修改' : '立即发布'}}</view>
    </view>
  </view>
</view>
