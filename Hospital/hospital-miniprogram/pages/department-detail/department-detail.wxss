.dept-detail { min-height: 100vh; }
.dept-detail-page { padding-top: 16rpx; padding-bottom: 160rpx; }

.dept-crumb { font-size: 24rpx; color: #8A938F; display: flex; align-items: center; gap: 10rpx; margin-bottom: 24rpx; }
.dept-crumb-link { color: #4B5652; }
.dept-crumb-sep { color: #B6BDB9; }

.dept-hero { padding-bottom: 8rpx; }
.dept-hero-title { font-size: 64rpx; line-height: 1.25; letter-spacing: -0.04em; margin-top: 12rpx; }
.dept-hero-desc { font-size: 26rpx; color: #4B5652; line-height: 1.85; margin-top: 16rpx; }

.dept-stats {
  display: flex;
  align-items: center;
  background: #FFFDFA;
  border: 1rpx solid #E5E5DE;
  border-radius: 24rpx;
  padding: 24rpx 16rpx;
  margin-top: 24rpx;
}
.dept-stat { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.dept-stat-num { font-family: "Songti SC", serif; font-size: 44rpx; color: #0F5B50; line-height: 1.2; }
.dept-stat-zone { font-size: 28rpx; font-family: inherit; color: #171D1B; }
.dept-stat-label { font-size: 22rpx; color: #8A938F; letter-spacing: 0.06em; }
.dept-stat-sep { width: 1rpx; height: 48rpx; background: #E5E5DE; }

.dept-tags { display: flex; flex-wrap: wrap; gap: 10rpx; }

.dept-stop { color: #8A938F; }
.dept-location { font-size: 22rpx; color: #8A938F; line-height: 1.7; margin-top: 14rpx; }

.dept-award { display: flex; align-items: flex-start; gap: 14rpx; padding: 8rpx 0; }
.dept-award-text { flex: 1; font-size: 26rpx; color: #4B5652; line-height: 1.7; }

.dept-detail-bottom { height: 40rpx; }

.dept-loading { padding: 48rpx; }
