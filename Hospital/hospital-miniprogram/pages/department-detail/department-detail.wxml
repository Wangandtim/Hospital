<view class="dept-detail" wx:if="{{!loading && department}}">
  <view class="ui-page dept-detail-page">
    <view class="dept-crumb" wx:if="{{hospital}}">
      <text class="dept-crumb-link">{{hospital.hospitalName}}</text>
      <text class="dept-crumb-sep">›</text>
      <text>{{department.deptName}}</text>
    </view>

    <view class="dept-hero">
      <view class="ui-eyebrow ui-eyebrow-gold" wx:if="{{department.flagshipText}}">{{department.flagshipText}}</view>
      <view class="ui-eyebrow" wx:else>DEPARTMENT</view>
      <view class="dept-hero-title ui-serif">{{department.deptName}}</view>
      <view class="dept-hero-desc" wx:if="{{department.description}}">{{department.description}}</view>
      <view class="dept-stats">
        <view class="dept-stat">
          <view class="dept-stat-num ui-num">{{department.todayDoctors}}</view>
          <view class="dept-stat-label">今日出诊</view>
        </view>
        <view class="dept-stat-sep"></view>
        <view class="dept-stat">
          <view class="dept-stat-num ui-num">{{department.remaining}}</view>
          <view class="dept-stat-label">剩余号源</view>
        </view>
        <view class="dept-stat-sep"></view>
        <view class="dept-stat">
          <view class="dept-stat-num dept-stat-zone">{{department.floorZone}}</view>
          <view class="dept-stat-label">诊区位置</view>
        </view>
      </view>
    </view>

    <view wx:if="{{department.diseaseTags.length > 0}}">
      <view class="ui-section-head">
        <text class="ui-section-title">主治方向</text>
      </view>
      <view class="dept-tags">
        <view class="ui-tag" wx:for="{{department.diseaseTags}}" wx:key="index">{{item}}</view>
      </view>
    </view>

    <view>
      <view class="ui-section-head">
        <text class="ui-section-title">门诊时间</text>
        <text class="ui-section-sub">CLINIC HOURS</text>
      </view>
      <view class="ui-panel">
        <view class="ui-panel-body ui-panel-body-flush">
          <view class="ui-row" wx:for="{{department.serviceTimeRows}}" wx:key="label">
            <view class="ui-row-main">
              <view class="ui-row-title">{{item.label}}</view>
              <view class="ui-row-desc">{{item.detail}}</view>
            </view>
            <view class="ui-row-val {{item.value === '停诊' ? 'dept-stop' : ''}}">{{item.value}}</view>
          </view>
        </view>
      </view>
      <view class="dept-location">就诊位置：{{department.floorZone}} · {{department.locationHint}}</view>
    </view>

    <view wx:if="{{department.awardList.length > 0}}">
      <view class="ui-section-head">
        <text class="ui-section-title">科室荣誉</text>
      </view>
      <view class="ui-panel">
        <view class="ui-panel-body">
          <view class="dept-award" wx:for="{{department.awardList}}" wx:key="index">
            <view class="ui-tag ui-tag-gold">荣誉</view>
            <view class="dept-award-text">{{item}}</view>
          </view>
        </view>
      </view>
    </view>

    <view>
      <view class="ui-section-head">
        <text class="ui-section-title">科室医生</text>
        <text class="ui-section-more" bindtap="goDoctorList">全部 {{pager.total || ''}} 位 ›</text>
      </view>

      <view class="ui-doctor" wx:for="{{doctors}}" wx:key="doctorId" hover-class="hover-fade">
        <view class="ui-doctor-ava" bindtap="viewDoctor" data-id="{{item.doctorId}}">{{item.avatarText}}</view>
        <view class="ui-doctor-main" bindtap="viewDoctor" data-id="{{item.doctorId}}">
          <view class="ui-doctor-name-row">
            <text class="ui-doctor-name">{{item.name}}</text>
            <text class="ui-doctor-title">{{item.titleText}} · 从业 {{item.years}} 年</text>
          </view>
          <view class="ui-doctor-line1">{{item.expertise || '科室常见病诊疗'}}</view>
          <view class="ui-doctor-flags">
            <view class="ui-tag" wx:for="{{item.flags}}" wx:for-item="flag" wx:key="index">{{flag}}</view>
          </view>
        </view>
        <view class="ui-doctor-side">
          <view class="ui-doctor-fee">¥{{item.consultationFee || 40}}</view>
          <view class="ui-doctor-left">余 {{item.remaining}}</view>
          <view class="ui-doctor-book" catchtap="makeAppointment" data-id="{{item.doctorId}}">预约</view>
        </view>
      </view>

      <ui-empty
        wx:if="{{pager.status === 'empty'}}"
        mark="医"
        title="暂无出诊医生"
        hint="该科室今日没有排班，可查看其他日期"
      />

      <view bindtap="onReachBottom">
        <ui-pager
          status="{{pager.status}}"
          hasMore="{{pager.hasMore}}"
          total="{{pager.total}}"
          error="{{pager.error}}"
          bindretry="retryDoctors"
        />
      </view>
    </view>

    <view class="dept-detail-bottom"></view>
  </view>

  <view class="ui-action-bar">
    <view class="ui-action-total">今日余号 <text class="ui-num">{{department.remaining}}</text></view>
    <button class="ui-btn ui-btn-primary" bindtap="goDoctorList">选择医生</button>
  </view>
</view>

<view class="dept-loading" wx:if="{{loading}}">
  <view class="ui-skeleton ui-skeleton-card" wx:for="{{[1,2,3]}}" wx:key="index"></view>
</view>
