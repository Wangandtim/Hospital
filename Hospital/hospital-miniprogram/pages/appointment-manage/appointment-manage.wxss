.am-page { padding-top: 8rpx; padding-bottom: 64rpx; }

.am-page .ui-row { min-height: 96rpx; }

.am-label { width: 96rpx; color: var(--ink-3); font-size: var(--fs-caption); }

.am-picker {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.am-card { padding: 24rpx 26rpx; }

.am-card-top {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.am-main { flex: 1; min-width: 0; }

.am-name-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  flex-wrap: wrap;
}

.am-name {
  font-family: var(--font-serif);
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
  line-height: 1.35;
}

.am-dept {
  margin-top: 6rpx;
  font-size: var(--fs-caption);
  color: var(--ink-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.am-card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
  min-height: 52rpx;
}

.am-time {
  font-size: var(--fs-body);
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

.am-count { font-size: var(--fs-caption); color: var(--ink-3); }
.am-count .ui-num { color: var(--ink); font-size: var(--fs-body); }
