<view class="ui-page am-page">
  <view class="ui-title-block">
    <view class="ui-back" bindtap="goBack" hover-class="hover-fade">←</view>
    <view class="ui-eyebrow ui-eyebrow-gold">SCHEDULE BOARD</view>
    <view class="ui-title">排班查看</view>
    <view class="ui-subtitle">按医院、科室、医生与日期查看到岗安排</view>
  </view>

  <view class="ui-panel">
    <view class="ui-panel-body ui-panel-body-flush">
      <view class="ui-row">
        <view class="ui-row-label am-label">医院</view>
        <picker class="am-picker" mode="selector" range="{{hospitalList}}" range-key="hospitalName" bindchange="onHospitalChange">
          <view class="ui-row-main"><view class="ui-row-title">{{selectedHospitalName}}</view></view>
          <view class="ui-chev">›</view>
        </picker>
      </view>
      <view class="ui-row">
        <view class="ui-row-label am-label">科室</view>
        <picker class="am-picker" mode="selector" range="{{departments}}" range-key="deptName" bindchange="onDeptChange">
          <view class="ui-row-main"><view class="ui-row-title">{{selectedDeptName}}</view></view>
          <view class="ui-chev">›</view>
        </picker>
      </view>
      <view class="ui-row">
        <view class="ui-row-label am-label">医生</view>
        <picker class="am-picker" mode="selector" range="{{doctors}}" range-key="name" bindchange="onDoctorChange">
          <view class="ui-row-main"><view class="ui-row-title">{{selectedDoctorName}}</view></view>
          <view class="ui-chev">›</view>
        </picker>
      </view>
      <view class="ui-row">
        <view class="ui-row-label am-label">日期</view>
        <picker class="am-picker" mode="date" value="{{selectedDate}}" bindchange="onDateChange">
          <view class="ui-row-main"><view class="ui-row-title">{{selectedDate || '请选择日期'}}</view></view>
        </picker>
        <view class="ui-btn ui-btn-outline ui-btn-sm" bindtap="selectToday" hover-class="hover-fade">今天</view>
      </view>
    </view>
  </view>

  <view wx:if="{{dateGroups.length > 0}}">
    <view wx:for="{{dateGroups}}" wx:key="date" wx:for-item="group">
      <view class="ui-group-title">{{group.date}} · {{group.weekday}}</view>
      <view class="ui-panel am-card" wx:for="{{group.schedules}}" wx:key="scheduleId" wx:for-item="schedule">
        <view class="am-card-top">
          <view class="ui-plate">
            <image class="ui-plate-img" src="{{schedule.deptIcon}}" mode="aspectFit" />
          </view>
          <view class="am-main">
            <view class="am-name-row">
              <text class="am-name">{{schedule.doctorName}}</text>
              <view class="ui-tag" wx:if="{{schedule.doctorTitle}}">{{schedule.doctorTitle}}</view>
            </view>
            <view class="am-dept">{{schedule.deptName}}</view>
          </view>
          <view class="ui-state ui-state-ok" wx:if="{{schedule.remainingSlots > 0}}"><i></i>余 {{schedule.remainingSlots}}</view>
          <view class="ui-state ui-state-full" wx:else><i></i>约满</view>
        </view>
        <view class="am-card-foot">
          <view class="am-time">{{schedule.timeSlot}}</view>
          <view class="am-count">总号源 <text class="ui-num">{{schedule.maxPatients}}</text></view>
        </view>
      </view>
    </view>
  </view>

  <view class="ui-empty" wx:if="{{dateGroups.length === 0}}">
    <view class="ui-empty-mark">排</view>
    <view class="ui-empty-title">暂无排班数据</view>
    <view class="ui-empty-hint">更换日期或筛选条件后再试</view>
  </view>
</view>
