<view class="container">
  <view class="header">
    <view class="back-btn" bindtap="goBack" hover-class="hover-fade">
      <text class="back-icon">←</text>
    </view>
    <view class="title">排班查看</view>
  </view>

  <view class="filter-section">
    <view class="filter-item">
      <view class="filter-label">医院</view>
      <picker mode="selector" range="{{hospitalList}}" range-key="hospitalName" bindchange="onHospitalChange">
        <view class="picker-value">{{selectedHospitalName}}</view>
      </picker>
    </view>
    <view class="filter-item">
      <view class="filter-label">科室</view>
      <picker mode="selector" range="{{departments}}" range-key="deptName" bindchange="onDeptChange">
        <view class="picker-value">{{selectedDeptName}}</view>
      </picker>
    </view>
    <view class="filter-item">
      <view class="filter-label">医生</view>
      <picker mode="selector" range="{{doctors}}" range-key="name" bindchange="onDoctorChange">
        <view class="picker-value">{{selectedDoctorName}}</view>
      </picker>
    </view>
  </view>

  <view class="date-section">
    <picker mode="date" value="{{selectedDate}}" bindchange="onDateChange">
      <view class="date-picker" hover-class="hover-fade">
        <image class="date-icon" src="/images/icons/ic-calendar-14b8a6.png" mode="aspectFit" />
        <view class="date-text">{{selectedDate || '请选择日期'}}</view>
      </view>
    </picker>
    <view class="date-today" bindtap="selectToday" hover-class="hover-scale">今天</view>
  </view>

  <view class="schedule-list" wx:if="{{dateGroups.length > 0}}">
    <view class="schedule-date-group" wx:for="{{dateGroups}}" wx:key="date">
      <view class="group-header">
        <view class="group-date">{{item.date}}</view>
        <view class="group-weekday">{{item.weekday}}</view>
      </view>
      <view class="schedule-cards">
        <view class="schedule-card" wx:for="{{item.schedules}}" wx:key="scheduleId" wx:for-item="schedule">
          <view class="card-header">
            <view class="doctor-name">{{schedule.doctorName}}</view>
            <view class="doctor-title">{{schedule.doctorTitle}}</view>
          </view>
          <view class="card-body">
            <view class="time-slot">{{schedule.timeSlot}}</view>
            <view class="slot-info">
              <view class="slot-available">
                <text class="slot-num">{{schedule.remainingSlots}}</text>
                <text class="slot-label">剩余号源</text>
              </view>
              <view class="slot-divider"></view>
              <view class="slot-total">
                <text class="slot-num">{{schedule.maxPatients}}</text>
                <text class="slot-label">总号源</text>
              </view>
            </view>
          </view>
          <view class="card-footer">
            <text class="dept-name">{{schedule.deptName}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-tip" wx:if="{{dateGroups.length === 0}}">
    <text>暂无排班数据</text>
  </view>
</view>