.sr-page { min-height: 100vh; padding-top: 4rpx; padding-bottom: 40rpx; }

.sr-bar { display: flex; align-items: center; gap: 16rpx; }
.sr-search { flex: 1; padding: 0 22rpx; }
.sr-input { flex: 1; min-width: 0; font-size: 30rpx; color: var(--ink); }
.sr-ph { color: var(--ink-4); }
.sr-clear {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: var(--line); color: var(--ink-3);
  font-size: 26rpx; line-height: 40rpx; text-align: center;
  flex-shrink: 0;
}
.sr-go {
  flex-shrink: 0;
  height: 92rpx; padding: 0 30rpx;
  border-radius: var(--r-md);
  background: var(--primary);
  color: #fff;
  font-size: 28rpx;
  display: flex; align-items: center;
}

.sr-tabs { margin: 28rpx 0 8rpx; }
.sr-chip-num { color: var(--ink-3); font-size: 22rpx; margin-left: 4rpx; }
.ui-chip-active .sr-chip-num { color: rgba(255, 255, 255, 0.78); }

.sr-list { padding-bottom: 24rpx; }
.sr-item {
  display: flex; align-items: center; gap: 18rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  padding: 24rpx;
  margin-bottom: 14rpx;
}
.sr-type {
  width: 72rpx; height: 72rpx; border-radius: 18rpx;
  background: var(--tint-2); color: var(--primary);
  font-family: var(--font-serif);
  font-size: 26rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.sr-type-article { background: var(--gold-tint); color: var(--gold-ink); }
.sr-type-hospital { background: var(--tint); color: var(--primary-deep); }
.sr-main { flex: 1; min-width: 0; }
.sr-title {
  font-family: var(--font-serif);
  font-size: 34rpx; font-weight: 600; color: var(--ink);
  line-height: 1.4;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.sr-sub {
  font-size: 26rpx; color: var(--ink-2); margin-top: 6rpx;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.sr-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 12rpx; }

.sr-sec { padding-top: 12rpx; }
.sr-sec-head {
  display: flex; align-items: baseline; justify-content: space-between;
  padding: 28rpx 0 18rpx;
}
.sr-sec-title { font-family: var(--font-serif); font-size: 36rpx; font-weight: 600; color: var(--ink); }
.sr-sec-action { font-size: 26rpx; color: var(--ink-3); }
.sr-tag-wrap { display: flex; flex-wrap: wrap; gap: 14rpx; }
.sr-tag {
  padding: 12rpx 26rpx;
  border-radius: var(--r-pill);
  border: 1rpx solid var(--line);
  background: var(--surface);
  font-size: 26rpx; color: var(--ink-2);
}
.sr-hot-list {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  overflow: hidden;
}
.sr-hot { display: flex; align-items: center; gap: 18rpx; padding: 24rpx 26rpx; }
.sr-hot + .sr-hot { border-top: 1rpx solid var(--line); }
.sr-hot-no {
  width: 44rpx; height: 44rpx; border-radius: 12rpx;
  background: var(--surface-2); color: var(--ink-3);
  font-family: var(--font-serif); font-size: 26rpx;
  display: flex; align-items: center; justify-content: center;
}
.sr-hot:first-child .sr-hot-no { background: var(--gold-tint); color: var(--gold-ink); }
.sr-hot-text { flex: 1; font-size: 30rpx; color: var(--ink); }
