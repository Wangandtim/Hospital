.dbg-page { padding-top: 8rpx; padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }

.dbg-top {
  display: flex;
  align-items: flex-start;
  padding-top: 24rpx;
}
.dbg-top .ui-back { margin-bottom: 0; }

.dbg-row { min-height: 112rpx; }

.dbg-switch { flex-shrink: 0; }

.dbg-value {
  font-family: "SF Pro Display", "DIN Alternate", monospace;
  font-size: var(--fs-caption);
  color: var(--primary);
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  border-radius: var(--r-sm);
  padding: 18rpx 20rpx;
  word-break: break-all;
}

.dbg-notice { margin-top: 4rpx; align-items: flex-start; }

.dbg-tip {
  flex: 1;
  font-size: var(--fs-micro);
  color: var(--ink-2);
  line-height: 1.7;
}

.dbg-back {
  width: 100%;
  margin-top: 28rpx;
}
