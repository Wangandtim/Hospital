page {
  background-color: #f0fdfa;
  min-height: 100vh;
}

.container {
  padding: 30rpx;
}

.header {
  padding: 40rpx 0;
  text-align: center;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background-color: #fff;
  border-radius: 22rpx;
  margin-bottom: 20rpx;
}

.setting-label {
  font-size: 30rpx;
  color: #333;
}

.setting-switch {
  transform: scale(1.2);
}

.info-box {
  padding: 30rpx;
  background-color: #fff;
  border-radius: 22rpx;
  margin-bottom: 20rpx;
}

.info-title {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 10rpx;
  display: block;
}

.info-value {
  font-size: 28rpx;
  color: #0d9488;
  font-family: monospace;
}

.tip-box {
  padding: 20rpx;
  background-color: #f6ffed;
  border-radius: 22rpx;
  border: 1rpx solid #b7eb8f;
  margin-bottom: 30rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #52c41a;
  display: block;
  margin-bottom: 10rpx;
}

.action-btn 
{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  background-color: #0d9488;
  color: #fff;
  text-align: center;
  border-radius: 22rpx;
  font-size: 32rpx;
}