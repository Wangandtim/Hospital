.page {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 24rpx 24rpx calc(100rpx + env(safe-area-inset-bottom));
}

.intro-card {
  background: linear-gradient(135deg, #0d9488 0%, #08979c 100%);
  border-radius: 36rpx;
  padding: 30rpx;
  color: #ffffff;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.24);
}

.intro-title {
  font-size: 36rpx;
  font-weight: 700;
}

.intro-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.92);
}

.form-card {
  margin-top: 22rpx;
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
  padding: 26rpx;
}

.form-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #143634;
}

.copy-btn 
{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #ecfdf9;
  border: 1rpx solid #b7ece4;
  font-size: 23rpx;
  font-weight: 600;
  color: #0b5e58;
}

.field-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #2f504d;
  font-weight: 500;
}

.import-textarea {
  margin-top: 18rpx;
  width: 100%;
  min-height: 320rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #f8fffe;
  border: 1rpx solid #d9f2ef;
  font-size: 24rpx;
  line-height: 1.6;
  color: #143634;
}

.form-foot {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.parsed {
  font-size: 24rpx;
  font-weight: 600;
  color: #0b5e58;
}

.parsed.muted {
  color: #7b9895;
}

.preview-btn 
{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #234542;
  font-size: 24rpx;
  font-weight: 600;
}

.preview-card {
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #e2e8f0;
  padding: 22rpx 26rpx;
}

.preview-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #143634;
  margin-bottom: 10rpx;
}

.preview-row {
  display: flex;
  gap: 14rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f0fdfa;
}

.preview-row:last-child {
  border-bottom: none;
}

.preview-index {
  width: 36rpx;
  color: #7b9895;
  font-size: 23rpx;
}

.preview-text {
  flex: 1;
  font-size: 24rpx;
  color: #2f504d;
  font-weight: 500;
}

.submit-btn {
  margin-top: 26rpx;
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 26rpx;
  background: #0d9488;
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 700;
  border: none;
  box-shadow: 0 14rpx 30rpx rgba(13, 148, 136, 0.28);
}

.submit-btn.disabled {
  background: #9fdcd3;
  box-shadow: none;
}

.btn-hover {
  opacity: 0.85;
}

.result-card {
  margin-top: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #e2e8f0;
  padding: 24rpx 26rpx;
}

.result-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #143634;
}

.result-stats {
  margin-top: 16rpx;
  display: flex;
  gap: 16rpx;
}

.stat {
  flex: 1;
  background: #f0fdfa;
  border-radius: 24rpx;
  padding: 18rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stat-value {
  font-size: 38rpx;
  font-weight: 700;
  color: #0b5e58;
}

.stat-value.fail {
  color: #b91c1c;
}

.stat-label {
  font-size: 22rpx;
  color: #2f504d;
  font-weight: 600;
}

.error-list {
  margin-top: 16rpx;
  border-top: 1rpx solid #f0fdfa;
  padding-top: 12rpx;
}

.error-item {
  display: flex;
  gap: 14rpx;
  padding: 8rpx 0;
}

.error-row {
  width: 120rpx;
  color: #b91c1c;
  font-size: 23rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.error-msg {
  flex: 1;
  font-size: 23rpx;
  color: #475569;
}

.error-more {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #7b9895;
}
