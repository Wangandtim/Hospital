.bi-page { padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }

.bi-hint {
  font-size: var(--fs-micro);
  color: var(--ink-3);
  line-height: 1.7;
  margin-bottom: 16rpx;
}

.bi-textarea {
  min-height: 300rpx;
  font-size: var(--fs-caption);
  line-height: 1.7;
}

.bi-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  min-height: 64rpx;
}

.bi-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 104rpx;
  padding: 16rpx 26rpx;
}
.bi-row + .bi-row { border-top: 1rpx solid var(--line); }

.bi-index {
  width: 32rpx;
  flex-shrink: 0;
  font-size: var(--fs-micro);
  color: var(--ink-3);
}

.bi-main { flex: 1; min-width: 0; }
.bi-name { font-size: var(--fs-body); color: var(--ink); }

.bi-sub {
  font-size: var(--fs-micro);
  color: var(--ink-3);
  margin-top: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.bi-submit {
  width: 100%;
  margin-top: 28rpx;
}

.bi-stats { display: flex; gap: 16rpx; }

.bi-stat {
  flex: 1;
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  padding: 22rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.bi-stat-value {
  font-family: var(--font-serif);
  font-size: var(--fs-h2);
  color: var(--primary);
  line-height: 1.2;
}
.bi-stat-value.fail { color: var(--danger); }
.bi-stat-label { font-size: var(--fs-micro); color: var(--ink-3); }

.bi-errors {
  margin-top: 22rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid var(--line);
}

.bi-err-row {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  min-height: 72rpx;
  padding: 14rpx 0;
}

.bi-err-row-no {
  width: 130rpx;
  flex-shrink: 0;
  font-size: var(--fs-micro);
  font-weight: 600;
  color: var(--danger);
}

.bi-err-msg {
  flex: 1;
  font-size: var(--fs-micro);
  color: var(--ink-2);
  line-height: 1.6;
}

.bi-err-more {
  margin-top: 8rpx;
  font-size: var(--fs-micro);
  color: var(--ink-3);
}
