/* 首页：上方纯色实心区 → 渐变衔接整幅医院实景 → 纸感内容区 */

.home { min-height: 100vh; background: var(--paper); }
.home-hero {
  background: var(--primary);
  padding: 24rpx 0 40rpx;
}
.home-hero-inner { padding: 0 48rpx; }

.home-hero-head .ui-brand-word { color: #FFFFFF; }
.home-hero-head .ui-brand-rule { background: rgba(255, 255, 255, 0.38); }
.home-hero-head .ui-brand-sub { color: rgba(255, 255, 255, 0.62); }
.home-hero-head .ui-avatar-btn {
  background: rgba(255, 255, 255, 0.14);
  color: #FFFFFF;
  border-color: rgba(255, 255, 255, 0.28);
}
.home-loc {
  width: auto;
  padding: 0 20rpx;
  gap: 10rpx;
  font-size: 22rpx;
  color: var(--primary);
  letter-spacing: 0.02em;
}
.home-loc-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--primary); }

/* 顶部搜索 */
.home-hero-search {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 88rpx;
  margin-top: 22rpx;
  padding: 0 24rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 20rpx;
}
.home-hero-search-ico {
  width: 26rpx; height: 26rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}
.home-hero-search-ico::after {
  content: '';
  position: absolute;
  right: -8rpx; bottom: -7rpx;
  width: 12rpx; height: 2rpx;
  background: rgba(255, 255, 255, 0.78);
  transform: rotate(45deg);
}
.home-hero-search-ph { flex: 1; min-width: 0; font-size: 26rpx; color: rgba(255, 255, 255, 0.82); }
.home-hero-search-key {
  flex-shrink: 0;
  height: 44rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  border-radius: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  display: flex; align-items: center;
}

/* 普通模式：医院信息 */
.home-hero-inst { margin-top: 30rpx; }
.home-hero-inst-top { display: flex; align-items: flex-start; gap: 18rpx; }
.home-hero-crest {
  width: 60rpx; height: 60rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  background: rgba(255, 255, 255, 0.10);
  flex-shrink: 0;
}
.home-hero-crest-img { width: 48rpx; height: 48rpx; display: block; }
.home-hero-inst-main { flex: 1; min-width: 0; }
.home-hero-inst-name { font-size: 38rpx; font-weight: 600; color: #FFFFFF; line-height: 1.35; }
.home-hero-inst-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 10rpx; }
.home-hero-level {
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  background: var(--gold);
  color: #FFFFFF;
  font-size: 22rpx;
  display: flex; align-items: center;
}
.home-hero-tag {
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  color: rgba(255, 255, 255, 0.86);
  font-size: 22rpx;
  display: flex; align-items: center;
}
.home-hero-inst-meta { font-size: 22rpx; color: rgba(255, 255, 255, 0.7); margin-top: 10rpx; line-height: 1.6; }
.home-hero-chev { color: rgba(255, 255, 255, 0.7); font-size: 32rpx; padding-left: 8rpx; }

.home-hero-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.home-hero-action {
  flex: 1;
  height: 72rpx;
  border-radius: 14rpx;
  background: #FFFFFF;
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 600;
  display: flex; align-items: center; justify-content: center;
}
.home-hero-action-ghost {
  background: rgba(255, 255, 255, 0.10);
  border: 1rpx solid rgba(255, 255, 255, 0.30);
  color: #FFFFFF;
  font-weight: 400;
}

/* 普通模式：主要入口 */
.home-quick { margin-top: 28rpx; }
.home-quick .ui-quick {
  background: rgba(255, 255, 255, 0.10);
  border-color: rgba(255, 255, 255, 0.16);
}
.home-quick .ui-quick-label { color: rgba(255, 255, 255, 0.92); }
.home-quick .ui-quick-ico { background: rgba(255, 255, 255, 0.14); color: #FFFFFF; }

/* 顶部空态 / 骨架 */
.home-hero-skeleton { margin-top: 28rpx; }
.home-hero-empty {
  margin-top: 28rpx;
  padding: 32rpx 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 18rpx;
}
.home-hero-empty-title { font-size: 32rpx; color: #FFFFFF; font-weight: 600; }
.home-hero-empty-hint { font-size: 24rpx; color: rgba(255, 255, 255, 0.7); margin-top: 8rpx; line-height: 1.6; }
.home-hero-empty-btn {
  margin-top: 20rpx;
  background: #FFFFFF;
  color: var(--primary);
  font-weight: 600;
}

/* 长辈模式 */
.elder-home { margin-top: 26rpx; }
.elder-home-title { font-size: 56rpx; line-height: 1.25; color: #FFFFFF; letter-spacing: -0.02em; }
.elder-home-sub { font-size: 32rpx; color: rgba(255, 255, 255, 0.82); margin-top: 14rpx; line-height: 1.6; }
.elder-home-inst {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 16rpx;
}
.elder-home-inst-name { font-size: 34rpx; color: #FFFFFF; font-weight: 600; }
.elder-home-inst-meta { font-size: 28rpx; color: rgba(255, 255, 255, 0.74); margin-top: 6rpx; }
/* 长辈首页主入口：中央大话筒，一进页面就能看见、点得到 */
.elder-mic {
  width: 260rpx; height: 260rpx;
  margin: 34rpx auto 0;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 18rpx 50rpx rgba(0, 0, 0, 0.18), 0 0 0 12rpx rgba(255,255,255,0.18);
}
.elder-mic-hover { background: #F2F7F4; transform: scale(0.97); }
.elder-mic-ico { display: flex; flex-direction: column; align-items: center; }
.elder-mic-body { width: 52rpx; height: 92rpx; border-radius: 26rpx; background: #0F5B50; }
.elder-mic-stem { width: 7rpx; height: 32rpx; background: #0F5B50; margin-top: 5rpx; }
.elder-mic-base { width: 70rpx; height: 7rpx; border-radius: 7rpx; background: #0F5B50; }
.elder-mic-hint { text-align: center; font-size: 32rpx; color: #FFFFFF; margin-top: 22rpx; font-weight: 600; }

.elder-home-btn {
  margin-top: 28rpx;
  background: #FFFFFF;
  color: var(--primary);
  font-size: 38rpx;
  font-weight: 600;
  height: 112rpx;
  line-height: 112rpx;
  border-radius: 20rpx;
}
.elder-home-btn-sub { margin-top: 20rpx; background: rgba(255,255,255,0.16); color: #FFFFFF; border: 1rpx solid rgba(255,255,255,0.42); font-size: 30rpx; height: 92rpx; line-height: 92rpx; white-space: nowrap; }
.elder-home-grid { margin-top: 26rpx; }
.elder-home-grid .ui-quick {
  background: rgba(255, 255, 255, 0.12);
  border-color: rgba(255, 255, 255, 0.20);
  min-height: 156rpx;
}
.elder-home-grid .ui-quick-label { color: #FFFFFF; font-size: 30rpx; }
.elder-home-grid .ui-quick-ico { background: rgba(255, 255, 255, 0.16); color: #FFFFFF; width: 64rpx; height: 64rpx; }

/* 实景图：顶部自纯色渐变进入，底部渐变回到纸面 */
.home-scene {
  position: relative;
  width: 100%;
  height: 520rpx;
  overflow: hidden;
  background: var(--primary);
}
.home-scene-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.home-scene-top-fade {
  position: absolute; left: 0; top: 0; width: 100%; height: 58%;
  background: linear-gradient(180deg, var(--primary) 0%, rgba(15, 91, 80, 0.55) 34%, rgba(15, 91, 80, 0) 100%);
}
.home-scene-bottom-fade {
  position: absolute; left: 0; bottom: 0; width: 100%; height: 26%;
  background: linear-gradient(0deg, var(--paper) 0%, rgba(246, 245, 240, 0) 100%);
}
.home-scene-caption {
  position: absolute; left: 48rpx; top: 30rpx;
  color: #FFFFFF;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.35);
}
.home-scene-caption-title { font-size: 26rpx; letter-spacing: 0.14em; }
.home-scene-caption-sub { font-size: 22rpx; color: rgba(255, 255, 255, 0.82); margin-top: 6rpx; }

/* 纸感内容区 */
.home-body { padding: 0 48rpx; }
.home-notice { margin-top: 28rpx; }
/* 全页金色只保留顶部医院等级一处，公告与余号改为中性色 */
.home-notice .ui-notice-tag { color: var(--ink-3); border-right-color: var(--line); }
.home-notice .ui-notice-chev { color: var(--ink-3); }
.home .ui-doctor-left { color: var(--ink-3); }
.home-result { margin-top: 24rpx; }
.home-result-dept { display: flex; align-items: center; gap: 10rpx; }
.home-result-dept-ico { width: 32rpx; height: 32rpx; display: block; flex-shrink: 0; }
.home-result-close {
  text-align: center;
  font-size: 26rpx;
  color: var(--ink-3);
  padding: 16rpx 0 8rpx;
}

.home-doctor-empty { padding-top: 32rpx; padding-bottom: 32rpx; }

/* 智能分诊入口 */
.home-triage {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 28rpx;
  padding: 26rpx 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  box-shadow: 0 1rpx 2rpx rgba(23, 29, 27, 0.04);
}
.home-triage-ico {
  width: 72rpx; height: 72rpx; border-radius: 16rpx;
  background: var(--tint-2);
  color: var(--primary);
  font-family: "Songti SC", serif;
  font-size: 28rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.home-triage-body { flex: 1; min-width: 0; }
.home-triage-title { font-size: 34rpx; color: var(--ink); }
.home-triage-sub { font-size: 24rpx; color: var(--ink-3); margin-top: 4rpx; }

/* 医院动态 */
.home-article {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 26rpx;
  align-items: flex-start;
}
.home-article + .home-article { border-top: 1rpx solid var(--line); }
.home-article-body { flex: 1; min-width: 0; }
.home-article-meta { font-size: 22rpx; color: var(--ink-3); letter-spacing: 0.06em; }
.home-article-title { font-size: 32rpx; color: var(--ink); margin-top: 6rpx; line-height: 1.45; }
.home-article-brief {
  font-size: 24rpx; color: var(--ink-3); margin-top: 6rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.home-article-thumb { width: 168rpx; height: 120rpx; border-radius: 12rpx; flex-shrink: 0; }

/* 就诊须知 */
.home-note { margin-top: 40rpx; padding-top: 28rpx; border-top: 1rpx solid var(--line); }
.home-note-row { font-size: 24rpx; color: var(--ink-3); line-height: 1.9; margin-top: 6rpx; }

.home-bottom-space { height: 48rpx; }

/* 长辈模式放大实景与正文 */
.elderly .home-hero-search { height: 104rpx; }
.elderly .home-hero-search-ph { font-size: 30rpx; }
.elderly .home-hero-search-key { height: 52rpx; font-size: 26rpx; }
.elderly .home-scene { height: 640rpx; }
.elderly .home-scene-caption-title { font-size: 30rpx; }
.elderly .home-scene-caption-sub { font-size: 26rpx; }
.elderly .home-note-row { font-size: 30rpx; }
.elderly .ui-section-sub { font-size: 24rpx; }
