.home { min-height: 100vh; padding-top: 8rpx; }

.home-loc {
  width: auto;
  padding: 0 20rpx;
  gap: 10rpx;
  font-size: 22rpx;
  color: #4B5652;
  letter-spacing: 0.02em;
}
.home-loc-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #A8874F; }

.home-search { margin-top: 8rpx; }
.home-result { margin-top: 20rpx; }
.home-result-close {
  text-align: center;
  font-size: 26rpx;
  color: #8A938F;
  padding: 16rpx 0 8rpx;
}

.home-inst { margin-top: 24rpx; }
.home-inst-top { display: flex; align-items: flex-start; }
.home-skeleton { margin-top: 24rpx; }
.home-inst-empty {
  margin-top: 24rpx;
  background: #FFFDFA;
  border: 1rpx dashed #D4D7D0;
  border-radius: 32rpx;
}

/* 长辈模式一步入口 */
.elder-home {
  margin-top: 32rpx;
  padding: 36rpx 32rpx;
  background: #0F5B50;
  border-radius: 36rpx;
  color: #fff;
}
.elder-home-title { font-size: 52rpx; line-height: 1.3; color: #fff; letter-spacing: -0.03em; }
.elder-home-sub { font-size: 30rpx; color: rgba(255, 255, 255, 0.82); margin-top: 12rpx; line-height: 1.6; }
.elder-home-btn {
  margin-top: 28rpx;
  background: #F7F1E4;
  color: #0B473F;
  font-size: 38rpx;
  height: 112rpx;
  border-radius: 28rpx;
}
.elder-home-grid { margin-top: 24rpx; }
.elder-home-grid .ui-quick { background: rgba(255, 255, 255, 0.12); border-color: rgba(255, 255, 255, 0.2); }
.elder-home-grid .ui-quick-label { color: #fff; }
.elder-home-grid .ui-quick-ico { background: rgba(255, 255, 255, 0.16); color: #F7F1E4; }

/* 智能分诊入口 */
.home-triage {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 28rpx;
  padding: 26rpx 24rpx;
  background: #FFFDFA;
  border: 1rpx solid #E5E5DE;
  border-left: 4rpx solid #A8874F;
  border-radius: 26rpx;
  box-shadow: 0 1rpx 2rpx rgba(23, 29, 27, 0.04);
}
.home-triage-ico {
  width: 72rpx; height: 72rpx; border-radius: 20rpx;
  background: #F7F1E4;
  color: #87672F;
  font-family: "Songti SC", serif;
  font-size: 28rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.home-triage-body { flex: 1; min-width: 0; }
.home-triage-title { font-size: 34rpx; color: #171D1B; }
.home-triage-sub { font-size: 24rpx; color: #8A938F; margin-top: 4rpx; }

.home-quick { margin-top: 24rpx; }

.home-doctor-empty { padding-top: 32rpx; padding-bottom: 32rpx; }

/* 医院动态 */
.home-article {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 26rpx;
  align-items: flex-start;
}
.home-article + .home-article { border-top: 1rpx solid #E5E5DE; }
.home-article-body { flex: 1; min-width: 0; }
.home-article-meta { font-size: 22rpx; color: #8A938F; letter-spacing: 0.06em; }
.home-article-title { font-size: 32rpx; color: #171D1B; margin-top: 6rpx; line-height: 1.45; }
.home-article-brief {
  font-size: 24rpx; color: #8A938F; margin-top: 6rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.home-article-thumb { width: 168rpx; height: 120rpx; border-radius: 16rpx; flex-shrink: 0; }

/* 就诊须知 */
.home-note { margin-top: 40rpx; padding-top: 28rpx; border-top: 1rpx solid #E5E5DE; }
.home-note-row { font-size: 24rpx; color: #8A938F; line-height: 1.9; margin-top: 6rpx; }

.home-bottom-space { height: 48rpx; }

.elderly .home-loc { font-size: 28rpx; }
.elderly .ui-section-sub { font-size: 24rpx; }
.elderly .home-note-row { font-size: 30rpx; }
