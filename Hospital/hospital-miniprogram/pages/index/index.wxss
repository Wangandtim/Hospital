/* 页面容器 */
.page-container {
  min-height: 100vh;
  background: #f0fdfa;
  padding-bottom: 40rpx;
}

/* ================= 顶部头图（背景图） ================= */
.hero {
  position: relative;
  overflow: hidden;
  padding: 34rpx 32rpx 104rpx;
  background: #0b5e58;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  background: linear-gradient(96deg, rgba(3, 52, 50, 0.78) 0%, rgba(4, 66, 62, 0.5) 48%, rgba(4, 66, 62, 0.1) 82%);
}

.hero-top {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  animation: rise-in 0.42s ease both;
}

.location-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx 8rpx 10rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 999rpx;
}

.loc-icon {
  width: 30rpx;
  height: 30rpx;
}

.location-text {
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 500;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.loc-refresh {
  color: rgba(255, 255, 255, 0.72);
  font-size: 21rpx;
  margin-left: 6rpx;
}

.hero-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 500;
}

.hero-title {
  position: relative;
  z-index: 2;
  margin-top: 30rpx;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-shadow: 0 4rpx 18rpx rgba(0, 30, 28, 0.35);
  animation: rise-in 0.5s 0.06s ease both;
}

.hero-sub {
  position: relative;
  z-index: 2;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  animation: rise-in 0.5s 0.12s ease both;
}

@keyframes rise-in {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 卡片入场动画 */
.rise-1 {
  animation: rise-in 0.46s 0.14s ease both;
}

.rise-2 {
  animation: rise-in 0.46s 0.2s ease both;
}

.rise-3 {
  animation: rise-in 0.46s 0.26s ease both;
}

.rise-4 {
  animation: rise-in 0.46s 0.32s ease both;
}

/* ================= 搜索（浮起） ================= */
.search-container {
  position: relative;
  margin: -64rpx 24rpx 0;
  padding: 12rpx;
  background: #ffffff;
  border-radius: 40rpx;
  border: 1rpx solid #e6fffa;
  box-shadow: 0 24rpx 56rpx rgba(13, 148, 136, 0.22);
  z-index: 3;
}

.search-box {
  display: flex;
  align-items: center;
  background: #f0fdfa;
  border: 1rpx solid #d9f2ef;
  border-radius: 28rpx;
  padding: 4rpx;
  height: 80rpx;
}

.search-type-picker {
  padding: 0 22rpx;
  border-right: 1rpx solid #d9f2ef;
}

.type-text {
  font-size: 25rpx;
  color: #0f766e;
  font-weight: 500;
  white-space: nowrap;
}

.search-input {
  flex: 1;
  height: 70rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #143634;
  background: transparent;
}

.search-btn {
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  color: #ffffff;
  padding: 0 30rpx;
  height: 66rpx;
  line-height: 66rpx;
  border-radius: 22rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 22rpx rgba(13, 148, 136, 0.26);
  transition: transform 0.14s ease, box-shadow 0.14s ease;
}

/* ================= 已选医院 ================= */
.selected-hospital-bar {
  margin: 22rpx 24rpx 0;
  padding: 20rpx 26rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #d9f2ef;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 28rpx rgba(13, 148, 136, 0.12);
}

.hospital-tag {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.tag-icon {
  width: 32rpx;
  height: 32rpx;
}

.tag-text {
  font-size: 26rpx;
  color: #0f766e;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.change-text {
  font-size: 24rpx;
  color: #14b8a6;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* ================= 搜索结果 ================= */
.search-result {
  background: #ffffff;
  margin: 24rpx;
  border-radius: 36rpx;
  padding: 26rpx;
  border: 1rpx solid #e6fffa;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.14);
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #e6fffa;
  margin-bottom: 8rpx;
}

.result-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #143634;
}

.result-count {
  font-size: 24rpx;
  color: #94aeab;
}

.result-list {
  max-height: 600rpx;
}

.result-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0fdfa;
}

.result-item:last-child {
  border-bottom: none;
}

.result-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #143634;
  margin-bottom: 6rpx;
}

.result-info {
  font-size: 24rpx;
  color: #5b7c7a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.close-btn {
  text-align: center;
  padding: 20rpx;
  color: #0f766e;
  font-size: 26rpx;
  margin-top: 12rpx;
  background: #f0fdfa;
  border-radius: 24rpx;
}

.empty-tip {
  text-align: center;
  padding: 48rpx 0;
  color: #94aeab;
  font-size: 26rpx;
}

/* ================= 主内容 ================= */
.main-content {
  padding: 24rpx;
}

/* 当前医院卡片 */
.current-hospital-card {
  background: #ffffff;
  border-radius: 36rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #e6fffa;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.14);
}

.hospital-main {
  display: flex;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.hospital-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 32rpx;
  background: linear-gradient(145deg, #ccfbf1 0%, #e6fffa 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: inset 0 0 0 1rpx #d9f2ef;
}

.hospital-icon-img {
  width: 52rpx;
  height: 52rpx;
}

.hospital-detail {
  flex: 1;
  min-width: 0;
}

.hospital-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.hospital-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #143634;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 400rpx;
}

.hospital-level-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #ccfbf1;
  color: #0f766e;
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
  font-size: 21rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.hospital-address {
  font-size: 24rpx;
  color: #5b7c7a;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.hospital-distance {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.distance-icon {
  width: 26rpx;
  height: 26rpx;
}

.distance-text {
  font-size: 24rpx;
  color: #0f766e;
  font-weight: 600;
}

.hospital-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #e6fffa;
  overflow: hidden;
}

.tag-label {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #f0fdfa;
  color: #0f766e;
  padding: 4rpx 12rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  border: 1rpx solid #d9f2ef;
  flex-shrink: 0;
}

.tag-value {
  font-size: 24rpx;
  color: #5b7c7a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

/* 快捷入口 */
.quick-entry {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  background: #ffffff;
  border-radius: 36rpx;
  padding: 30rpx 18rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #e6fffa;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.14);
}

.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 6rpx 0;
}

.entry-icon-bg {
  width: 92rpx;
  height: 92rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.16s ease, box-shadow 0.16s ease;
}

.entry-icon-img {
  width: 46rpx;
  height: 46rpx;
}

.bg-teal {
  background: linear-gradient(145deg, #2dd4bf 0%, #14b8a6 100%);
  box-shadow: 0 12rpx 24rpx rgba(20, 184, 166, 0.3);
}

.bg-cyan {
  background: linear-gradient(145deg, #22d3ee 0%, #06b6d4 100%);
  box-shadow: 0 12rpx 24rpx rgba(6, 182, 212, 0.28);
}

.bg-mint {
  background: linear-gradient(145deg, #34d399 0%, #10b981 100%);
  box-shadow: 0 12rpx 24rpx rgba(16, 185, 129, 0.26);
}

.bg-sky {
  background: linear-gradient(145deg, #38bdf8 0%, #0ea5e9 100%);
  box-shadow: 0 12rpx 24rpx rgba(14, 165, 233, 0.26);
}

.entry-label {
  font-size: 23rpx;
  color: #33504d;
  font-weight: 500;
}

/* 模块卡片 */
.section-container {
  background: #ffffff;
  border-radius: 36rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #e6fffa;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.14);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
}

.section-title {
  font-size: 31rpx;
  font-weight: 700;
  color: #143634;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 8rpx;
  border-radius: 12rpx;
  background: linear-gradient(180deg, #14b8a6 0%, #5eead4 100%);
}

.section-more {
  font-size: 24rpx;
  color: #0f766e;
}

/* 科室网格 */
.dept-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.dept-card {
  background: #f0fdfa;
  border: 1rpx solid #d9f2ef;
  border-radius: 26rpx;
  padding: 24rpx;
  position: relative;
  overflow: hidden;
  transition: transform 0.16s ease, box-shadow 0.16s ease;
}

.dept-card::after {
  content: '';
  position: absolute;
  right: -18rpx;
  bottom: -18rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(20, 184, 166, 0.12);
}

.dept-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #143634;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dept-brief {
  font-size: 21rpx;
  color: #5b7c7a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.dept-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  background: #14b8a6;
  color: #ffffff;
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  font-size: 18rpx;
  font-weight: 500;
  z-index: 1;
}

/* 长辈模式：一步式预约卡片 */
/* 智能分诊入口 */
.triage-entry {
  margin: 12rpx 24rpx 24rpx;
  padding: 26rpx 28rpx;
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 2rpx solid #b9e3da;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 26rpx rgba(13, 148, 136, 0.12);
}

.triage-entry-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #0d9488, #14b8a6);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

.triage-entry-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.triage-entry-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0b3b38;
}

.triage-entry-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #4c736f;
}

.triage-entry-arrow {
  flex-shrink: 0;
  font-size: 44rpx;
  color: #9bbdb8;
}

.elder-booking-card {
  margin: 12rpx 24rpx 24rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #0f766e, #14b8a6);
  color: #ffffff;
  box-shadow: 0 18rpx 40rpx rgba(13, 148, 136, 0.28);
}

.elder-card-title {
  font-size: 40rpx;
  font-weight: 700;
}

.elder-card-sub {
  font-size: 26rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}

.elder-book-btn {
  margin-top: 24rpx;
  height: 108rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #0f766e;
  font-size: 38rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.elder-sub-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.elder-sub-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  color: #ffffff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.article-section {
  margin-top: 24rpx;
  background: #ffffff;
  border-radius: 36rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.12);
  border: 1rpx solid #e6fffa;
}

.article-item {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2faf9;
}

.article-item:last-child {
  border-bottom: none;
  padding-bottom: 4rpx;
}

.article-thumb {
  width: 190rpx;
  height: 140rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: #e6fffa;
  border: 1rpx solid #d9f2ef;
  box-sizing: border-box;
}

.article-thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #0f766e;
  background: linear-gradient(135deg, #e6fffa, #d9f2ef);
}

.article-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.article-meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.article-cat {
  font-size: 20rpx;
  color: #0f766e;
  background: #f0fdfa;
  border: 1rpx solid #d9f2ef;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.article-date {
  font-size: 20rpx;
  color: #94aeac;
}

.article-title-text {
  font-size: 27rpx;
  font-weight: 600;
  color: #0f2e2e;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.article-brief {
  font-size: 22rpx;
  color: #5b7c7a;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 医生列表 */
.doctor-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

/* 今日无医生排班：弱提示占位，沿用卡片视觉 */
.doctor-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 40rpx 22rpx;
  border: 1rpx solid #d9f2ef;
  box-shadow: 0 10rpx 22rpx rgba(13, 148, 136, 0.1);
}

.doctor-empty-icon {
  width: 42rpx;
  height: 42rpx;
  opacity: 0.75;
}

.doctor-empty-text {
  font-size: 26rpx;
  color: #5b7c7a;
}

.doctor-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 22rpx;
  gap: 16rpx;
  border: 1rpx solid #d9f2ef;
  box-shadow: 0 10rpx 22rpx rgba(13, 148, 136, 0.1);
  overflow: hidden;
}

.doctor-left {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.doctor-avatar {
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #ccfbf1 0%, #e6fffa 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: inset 0 0 0 1rpx #d9f2ef;
}

.doctor-avatar-img {
  width: 48rpx;
  height: 48rpx;
}

.doctor-info {
  flex: 1;
  min-width: 0;
  max-width: 450rpx;
}

.doctor-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 4rpx;
  flex-wrap: wrap;
}

.doctor-name {
  font-size: 29rpx;
  font-weight: 700;
  color: #143634;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 180rpx;
}

.doctor-title 
{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #0f766e;
  background: #ccfbf1;
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  white-space: nowrap;
}

.doctor-expertise {
  font-size: 21rpx;
  color: #5b7c7a;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.doctor-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-fee {
  font-size: 24rpx;
  color: #0f766e;
  font-weight: 700;
}

.meta-separator {
  color: #d9f2ef;
}

.meta-available {
  font-size: 19rpx;
  color: #0f766e;
  background: #f0fdfa;
  border: 1rpx solid #d9f2ef;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
}

.doctor-action {
  flex-shrink: 0;
  margin-left: auto;
}

.action-btn 
{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  color: #ffffff;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 22rpx rgba(13, 148, 136, 0.28);
  min-width: 88rpx;
  text-align: center;
  transition: transform 0.14s ease, box-shadow 0.14s ease;
}

/* 注意事项 */
.notice-container {
  background: #ffffff;
  border-radius: 36rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #d9f2ef;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.12);
}

.notice-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.notice-badge {
  width: 44rpx;
  height: 44rpx;
  border-radius: 16rpx;
  background: linear-gradient(145deg, #2dd4bf 0%, #0d9488 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.notice-icon {
  width: 26rpx;
  height: 26rpx;
}

.notice-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f766e;
}

.notice-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.notice-item {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.notice-dot {
  color: #14b8a6;
  font-size: 24rpx;
  line-height: 1.6;
}

.notice-text {
  font-size: 24rpx;
  color: #5b7c7a;
  line-height: 1.6;
}

.page-bottom-space {
  height: 24rpx;
}

/* 加载状态 */
.loading-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(240, 253, 250, 0.94);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #ccfbf1;
  border-top-color: #14b8a6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 26rpx;
  color: #5b7c7a;
}
