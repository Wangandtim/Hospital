.dr-page { padding-top: 8rpx; padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }

.dr-top {
  display: flex;
  align-items: flex-start;
  padding-top: 24rpx;
}
.dr-top .ui-back { margin-bottom: 0; }

.dr-input { width: 100%; box-sizing: border-box; }

.dr-picker {
  justify-content: space-between;
  gap: 12rpx;
}

.dr-dept-picker { justify-content: flex-start; }

.dr-picker-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: var(--ink);
}

.dr-field-last { margin-bottom: 8rpx; }

.dr-upload {
  width: 100%;
  height: 200rpx;
  border: 1rpx dashed var(--line-strong);
  border-radius: var(--r-md);
  background: var(--surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.dr-uploaded {
  width: 100%;
  height: 100%;
}

.dr-upload-placeholder {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.dr-upload-text {
  font-size: var(--fs-caption);
  color: var(--ink-2);
}

.dr-upload-tip {
  margin-top: 10rpx;
  font-size: var(--fs-micro);
  color: var(--ink-3);
}

.dr-submit {
  width: 100%;
  margin-top: 28rpx;
}

.dr-tips {
  margin-top: 20rpx;
  text-align: center;
  font-size: var(--fs-micro);
  color: var(--ink-3);
}
