.container {
  padding: 30rpx;
  min-height: 100vh;
  background: #f0fdfa;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
  padding-top: 60rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #143634;
}

.subtitle {
  font-size: 28rpx;
  color: #5b7c7a;
  margin-top: 10rpx;
}

.form {
  background: #ffffff;
  border-radius: 36rpx;
  border: 1rpx solid #e6fffa;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.14);
  padding: 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 14rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  background: #f0fdfa;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 14rpx;
  padding: 20rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  background: #f0fdfa;
}

.picker-value {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 14rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  line-height: 80rpx;
  color: #94aeab;
  background: #f0fdfa;
  box-sizing: border-box;
}

.btn-register 
{
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #0d9488, #08979c);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 54rpx;
  margin-top: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2);
}

.btn-register::after {
  border: none;
}

.login-link {
  text-align: center;
  margin-top: 30rpx;
  color: #fff;
  font-size: 28rpx;
}

.upload-area {
  width: 100%;
  height: 200rpx;
  border: 2rpx dashed #ccfbf1;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0fdfa;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.upload-icon {
  width: 48rpx;
  height: 48rpx;
}

.upload-text {
  font-size: 26rpx;
  color: #999;
}

.uploaded-image {
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
}

.upload-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}