.da-page { padding-top: 8rpx; padding-bottom: calc(200rpx + env(safe-area-inset-bottom)); }

.da-top {
  display: flex;
  align-items: flex-start;
  padding-top: 24rpx;
}
.da-top .ui-back { margin-bottom: 0; }

.da-name-field {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.da-name-input {
  flex: 1;
  min-width: 0;
  width: 100%;
  box-sizing: border-box;
}

.da-picker {
  justify-content: space-between;
  font-size: var(--fs-h3);
}

.da-field-last { margin-bottom: 8rpx; }

.da-bar .ui-btn { flex: 1; }
