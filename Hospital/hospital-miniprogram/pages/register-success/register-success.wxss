.register-success {
  min-height: 100vh;
  padding-top: var(--s6);
}

.success-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding-bottom: var(--s5);
}

.success-mark {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--tint);
  border: 1rpx solid var(--line);
  color: var(--primary);
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.success-title {
  font-size: var(--fs-h2);
}

.form-input {
  width: 100%;
  box-sizing: border-box;
}

.btn-activate {
  margin-top: var(--s3);
  width: 100%;
}

.status-info {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 8rpx 0 32rpx;
}

.status-label {
  font-size: var(--fs-caption);
  color: var(--ink-2);
}
