.dp-page { padding-top: 8rpx; padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }

.dp-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-top: 24rpx;
}
.dp-top .ui-back { margin-bottom: 0; }

.dp-page-title { padding-top: 24rpx; }

.dp-page .ui-row { min-height: 96rpx; }

.dp-hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-1);
  padding: 30rpx 28rpx;
  margin: 8rpx 0 24rpx;
}

.dp-ava { width: 112rpx; height: 112rpx; font-size: var(--fs-h2); }

.dp-hero-main { flex: 1; min-width: 0; }

.dp-name {
  font-family: var(--font-serif);
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--ink);
  line-height: 1.3;
}

.dp-title {
  font-size: var(--fs-caption);
  color: var(--ink-2);
  margin-top: 6rpx;
}

.dp-dept {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.dp-dept-name {
  font-size: var(--fs-caption);
  color: var(--primary);
}

.dp-hospital {
  font-size: var(--fs-micro);
  color: var(--ink-3);
  margin-top: 8rpx;
}

.dp-row { min-height: 104rpx; }

.dp-row-col {
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
  padding-top: 22rpx;
  padding-bottom: 22rpx;
}

.dp-label {
  width: 170rpx;
  flex-shrink: 0;
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.dp-value {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  color: var(--ink);
}

.dp-value-multi {
  white-space: pre-wrap;
  line-height: 1.7;
}

.dp-input {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  color: var(--ink);
  height: 72rpx;
}

.dp-textarea {
  width: 100%;
  min-height: 200rpx;
}

.dp-btn-row {
  display: flex;
  gap: 20rpx;
  padding: 0 26rpx 26rpx;
}
.dp-btn-row .ui-btn { flex: 1; }

.dp-mask {
  position: fixed;
  inset: 0;
  background: rgba(23, 29, 27, 0.48);
  z-index: 30;
}

.dp-modal {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  top: 50%;
  transform: translateY(-50%);
  max-height: 80vh;
  overflow-y: auto;
  background: var(--surface);
  border-radius: var(--r-lg);
  padding: 32rpx var(--s4) 28rpx;
  box-sizing: border-box;
  z-index: 40;
  animation: ui-rise 0.24s ease both;
}

.dp-modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
}

.dp-modal-title {
  font-family: var(--font-serif);
  font-size: var(--fs-h2);
  color: var(--ink);
}

.dp-modal-close { flex-shrink: 0; }

.dp-modal-body { padding-bottom: 4rpx; }

.dp-field-last { margin-bottom: 0; }

.dp-modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}
.dp-modal-actions .ui-btn { flex: 1; }
