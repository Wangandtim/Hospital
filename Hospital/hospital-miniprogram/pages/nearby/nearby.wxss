.nearby-page {
  min-height: 100vh;
  padding-top: 8rpx;
}

.nearby-inner {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* ---------- 地图 ---------- */
.map-section {
  position: relative;
  height: 400rpx;
  border-radius: var(--r-lg);
  overflow: hidden;
  margin-bottom: var(--s3);
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow-1);
}

.map {
  width: 100%;
  height: 100%;
}

.no-location {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.map-legend {
  position: absolute;
  left: 20rpx;
  bottom: 20rpx;
  z-index: 100;
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-pill);
  font-size: var(--fs-micro);
  color: var(--ink-2);
  box-shadow: var(--shadow-1);
}

/* ---------- 定位概览 ---------- */
.overview-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  margin-bottom: var(--s3);
}

.overview-card.locating {
  z-index: auto;
}

.overview-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.plate-char {
  font-family: var(--font-serif);
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary);
}

.overview-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.overview-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
}

.overview-meta {
  font-size: var(--fs-micro);
  font-weight: 500;
  color: var(--gold-ink);
  background: var(--gold-tint);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.overview-sub {
  font-size: var(--fs-caption);
  color: var(--ink-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.spin {
  animation: icon-spin 1.4s linear infinite;
}

@keyframes icon-spin {
  to {
    transform: rotate(360deg);
  }
}

.range-wrap {
  position: relative;
  flex-shrink: 0;
}

.range-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 64rpx;
  padding: 0 22rpx;
  border-radius: var(--r-pill);
  background: var(--surface);
  border: 1rpx solid var(--line-strong);
  color: var(--primary);
  font-size: var(--fs-caption);
  font-weight: 600;
}

.range-arrow {
  font-size: 24rpx;
  line-height: 1;
  transition: transform 0.2s ease;
}

.range-pill.open .range-arrow {
  transform: rotate(180deg);
}

.range-pop {
  position: absolute;
  top: calc(100% + 12rpx);
  right: 0;
  width: 196rpx;
  padding: 8rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  box-shadow: var(--shadow-2);
  z-index: 300;
}

.range-option {
  padding: 16rpx 0;
  text-align: center;
  font-size: var(--fs-caption);
  font-weight: 600;
  color: var(--ink-2);
  border-radius: var(--r-sm);
}

.range-option.active {
  background: var(--primary);
  color: #fff;
}

.range-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 240;
  background: transparent;
}

/* ---------- 搜索 ---------- */
.search-card {
  margin-bottom: var(--s3);
}

.search-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  height: 92rpx;
  padding: 0 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  box-shadow: var(--shadow-1);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-size: var(--fs-body);
  color: var(--ink);
}

.btn-search {
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: var(--r-sm);
  background: var(--primary);
  color: #fff;
  font-size: var(--fs-caption);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

/* ---------- 医院列表 ---------- */
.hospital-list {
  margin-bottom: var(--s3);
}

.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 4rpx 0 20rpx;
}

.list-title {
  font-family: var(--font-serif);
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
}

.hospital-item {
  padding: 26rpx 28rpx 24rpx;
}

.hospital-main {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.head-main {
  flex: 1;
  min-width: 0;
}

.title-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.hospital-name {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sub-line {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.distance-badge {
  display: inline-flex;
  align-items: center;
  font-size: var(--fs-micro);
  font-weight: 600;
  color: var(--gold-ink);
}

.hospital-address {
  margin-top: 18rpx;
  font-size: var(--fs-caption);
  color: var(--ink-2);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.action-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
}

.action {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-caption);
  font-weight: 500;
  border-radius: var(--r-sm);
}

.action.primary {
  background: var(--primary);
  color: #fff;
}

.action.primary:active {
  background: var(--primary-deep);
}

.action.ghost {
  background: transparent;
  color: var(--ink);
  border: 1rpx solid var(--line-strong);
}

.action.ghost:active {
  background: var(--tint-2);
}

/* ---------- 分页 ---------- */
.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0 8rpx;
}

.page-btn {
  min-width: 176rpx;
}

.page-btn::after {
  border: none;
}

.page-btn[disabled] {
  background: var(--surface-2);
  color: var(--ink-4);
  border-color: var(--line);
}

.page-info {
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

/* ---------- 加载 ---------- */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 40rpx;
  gap: 16rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid var(--line);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: icon-spin 1s linear infinite;
}

.loading-text {
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

/* ---------- 医院详情浮层 ---------- */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(23, 29, 27, 0.46);
  z-index: 900;
}

.hospital-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 901;
  background: var(--surface);
  border-top: 1rpx solid var(--line);
  border-radius: var(--r-xl) var(--r-xl) 0 0;
  padding: 20rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  box-shadow: var(--shadow-3);
  animation: sheet-up 0.24s cubic-bezier(0.2, 0.9, 0.3, 1);
}

@keyframes sheet-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.sheet-handle {
  width: 72rpx;
  height: 6rpx;
  border-radius: var(--r-pill);
  background: var(--line-strong);
  margin: 0 auto 24rpx;
}

.sheet-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.sheet-titles {
  flex: 1;
  min-width: 0;
}

.sheet-name {
  font-family: var(--font-serif);
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sheet-sub {
  margin-top: 6rpx;
  font-size: var(--fs-micro);
  color: var(--ink-3);
  display: flex;
  gap: 8rpx;
}

.sheet-dot {
  color: var(--ink-4);
}

.sheet-close {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--r-pill);
  border: 1rpx solid var(--line);
  background: var(--surface);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 32rpx;
  color: var(--ink-3);
  line-height: 1;
}

.sheet-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.sheet-label {
  width: 72rpx;
  flex-shrink: 0;
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.sheet-value {
  flex: 1;
  font-size: var(--fs-caption);
  color: var(--ink);
  line-height: 1.6;
}

.sheet-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-top: 26rpx;
}

.sheet-btn {
  flex: 1;
  height: 88rpx;
  font-size: var(--fs-caption);
}

.sheet-btn::after {
  border: none;
}
