.container {
  padding: 20rpx;
  background: #f0fdfa;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 地图 */
.map-section {
  position: relative;
  height: 400rpx;
  border-radius: 36rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  background: #e6fffa;
  border: 1rpx solid #d9f2ef;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.14);
}

.map {
  width: 100%;
  height: 100%;
}

.no-location {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5b7c7a;
  font-size: 26rpx;
}

.map-controls {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  z-index: 100;
}

.map-legend {
  position: absolute;
  left: 20rpx;
  bottom: 20rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx 8rpx 10rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #d9f2ef;
  border-radius: 999rpx;
  box-shadow: 0 10rpx 24rpx rgba(13, 148, 136, 0.18);
  font-size: 21rpx;
  color: #0f766e;
  font-weight: 600;
}

.map-legend-icon {
  width: 28rpx;
  height: 28rpx;
}

.control-btn {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #d9f2ef;
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  color: #0f766e;
  font-weight: 600;
  line-height: 1.4;
  margin: 0;
  box-shadow: 0 10rpx 24rpx rgba(13, 148, 136, 0.18);
}

.control-btn::after {
  border: none;
}

.control-icon {
  width: 28rpx;
  height: 28rpx;
}

.btn-hover {
  transform: scale(0.94);
  opacity: 0.9;
}

/* 当前位置 */
.location-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 36rpx;
  border: 1rpx solid #e6fffa;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.14);
}

.location-icon-chip {
  width: 72rpx;
  height: 72rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #ecfdf9 0%, #ccfbf1 100%);
  border: 1rpx solid #d9f2ef;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.location-icon {
  width: 40rpx;
  height: 40rpx;
}

.location-text {
  flex: 1;
  min-width: 0;
}

.location-label {
  font-size: 22rpx;
  color: #94aeab;
  margin-bottom: 6rpx;
}

.location-value {
  font-size: 27rpx;
  color: #143634;
  font-weight: 600;
  word-break: break-all;
}

.location-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  font-size: 21rpx;
  color: #94aeab;
}

.refresh-icon {
  width: 28rpx;
  height: 28rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

/* 搜索 */
.search-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 36rpx;
  border: 1rpx solid #e6fffa;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.14);
}

.search-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 18rpx;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 76rpx;
  background: #f0fdfa;
  border: 1rpx solid #d9f2ef;
  border-radius: 24rpx;
  padding: 0 22rpx;
  font-size: 26rpx;
  color: #143634;
  box-sizing: border-box;
}

.btn-search {
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  color: #ffffff;
  border-radius: 24rpx;
  padding: 0 30rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
  box-shadow: 0 10rpx 22rpx rgba(13, 148, 136, 0.26);
}

.radius-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx 16rpx;
}

.radius-label {
  font-size: 24rpx;
  color: #5b7c7a;
  flex-shrink: 0;
}

.radius-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.radius-chip {
  min-width: 104rpx;
  text-align: center;
  font-size: 23rpx;
  color: #0f766e;
  background: #f0fdfa;
  border: 1rpx solid #d9f2ef;
  border-radius: 999rpx;
  padding: 9rpx 18rpx;
  line-height: 1.4;
  transition: all 0.16s ease;
}

.radius-chip.active {
  color: #ffffff;
  font-weight: 700;
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  border-color: transparent;
  box-shadow: 0 10rpx 22rpx rgba(13, 148, 136, 0.26);
}

/* 医院列表 */
.hospital-list {
  margin-bottom: 20rpx;
}

.list-header {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 4rpx 8rpx 16rpx;
  font-size: 25rpx;
  color: #5b7c7a;
}

.search-tag {
  font-size: 21rpx;
  color: #0f766e;
  background: #ecfdf9;
  border: 1rpx solid #ccfbf1;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.hospital-item {
  padding: 26rpx;
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 36rpx;
  border: 1rpx solid #e6fffa;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.14);
}

.hospital-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.hospital-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.hospital-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #143634;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selected-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 19rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #2dd4bf 0%, #0d9488 100%);
  padding: 3rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.hospital-distance 
{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  color: #0f766e;
  font-weight: 600;
  flex-shrink: 0;
  background: #ecfdf9;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.hospital-meta {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.level-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 19rpx;
  color: #0f766e;
  background: #f0fdfa;
  border: 1rpx solid #d9f2ef;
  padding: 3rpx 10rpx;
  border-radius: 12rpx;
  margin-top: 2rpx;
}

.hospital-address {
  font-size: 24rpx;
  color: #5b7c7a;
  line-height: 1.5;
  flex: 1;
}

.hospital-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f0fdfa;
}

.footer-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.pill-btn {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  border: none;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 600;
  padding: 10rpx 22rpx;
  line-height: 1.4;
  margin: 0;
}

.pill-btn.book {
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  color: #ffffff;
  padding: 11rpx 30rpx;
  box-shadow: 0 10rpx 22rpx rgba(13, 148, 136, 0.28);
  flex-shrink: 0;
}

.pill-btn::after {
  border: none;
}

.pill-icon {
  width: 26rpx;
  height: 26rpx;
}

.pill-btn.call {
  background: #ecfdf9;
  color: #0f766e;
  border: 1rpx solid #ccfbf1;
}

.pill-btn.web {
  background: #ecfeff;
  color: #0e7490;
  border: 1rpx solid #cffafe;
}

.pill-btn.nav {
  background: #f0f9ff;
  color: #0369a1;
  border: 1rpx solid #e0f2fe;
}

/* 分页 */
.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 28rpx;
  padding: 20rpx;
  margin-top: 8rpx;
  background: #ffffff;
  border-radius: 32rpx;
  border: 1rpx solid #e6fffa;
  box-shadow: 0 12rpx 28rpx rgba(13, 148, 136, 0.12);
}

.page-btn {
  background: #ecfdf9;
  color: #0f766e;
  border: 1rpx solid #ccfbf1;
  border-radius: 999rpx;
  padding: 12rpx 30rpx;
  font-size: 25rpx;
  font-weight: 600;
  margin: 0;
}

.page-btn::after {
  border: none;
}

.page-btn[disabled] {
  background: #f5fbfa;
  color: #b6cfcb;
  border-color: #eef7f5;
}

.page-info {
  font-size: 25rpx;
  color: #5b7c7a;
}

/* 加载 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  gap: 18rpx;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 5rpx solid #ccfbf1;
  border-top-color: #14b8a6;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-text {
  font-size: 25rpx;
  color: #5b7c7a;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  gap: 20rpx;
  text-align: center;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 27rpx;
  color: #94aeab;
}

/* 医院详情浮层 */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(6, 40, 38, 0.45);
  z-index: 900;
  animation: mask-in 0.2s ease-out;
}

@keyframes mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

.hospital-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 901;
  background: #ffffff;
  border-radius: 42rpx 42rpx 0 0;
  padding: 20rpx 30rpx calc(28rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -20rpx 50rpx rgba(6, 60, 56, 0.24);
  animation: sheet-up 0.24s cubic-bezier(0.2, 0.9, 0.3, 1);
}

@keyframes sheet-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 12rpx;
  background: #d9f2ef;
  margin: 0 auto 24rpx;
}

.sheet-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.sheet-icon-chip {
  width: 72rpx;
  height: 72rpx;
  border-radius: 26rpx;
  background: linear-gradient(145deg, #ecfdf9 0%, #ccfbf1 100%);
  border: 1rpx solid #d9f2ef;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sheet-icon {
  width: 40rpx;
  height: 40rpx;
}

.sheet-titles {
  flex: 1;
  min-width: 0;
}

.sheet-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #143634;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sheet-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #5b7c7a;
  display: flex;
  gap: 8rpx;
}

.sheet-dot {
  color: #b6cfcb;
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f0fdfa;
  border: 1rpx solid #e6fffa;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sheet-close-icon {
  width: 26rpx;
  height: 26rpx;
}

.sheet-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0fdfa;
}

.sheet-label {
  width: 72rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #94aeab;
}

.sheet-value {
  flex: 1;
  font-size: 25rpx;
  color: #143634;
  line-height: 1.6;
}

.sheet-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-top: 26rpx;
}

.sheet-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 84rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  margin: 0;
  padding: 0;
}

.sheet-btn::after {
  border: none;
}

.sheet-btn.primary {
  flex: 1.5;
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(13, 148, 136, 0.28);
}

.sheet-btn.ghost {
  background: #f0fdfa;
  color: #0f766e;
  border: 1rpx solid #d9f2ef;
}

.sheet-btn-icon {
  width: 28rpx;
  height: 28rpx;
}

/* 定位概览 + 折叠搜索范围 */
.range-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 240;
  background: transparent;
}

.overview-card {
  position: relative;
  z-index: 250;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 20rpx 24rpx 0;
  padding: 22rpx 24rpx;
  background: #ffffff;
  border: 1rpx solid #e6fffa;
  border-radius: 32rpx;
  box-shadow: 0 14rpx 30rpx rgba(13, 148, 136, 0.13);
}

.overview-card.locating {
  z-index: auto;
}

.overview-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.overview-pin {
  width: 66rpx;
  height: 66rpx;
  border-radius: 26rpx;
  background: #f0fdfa;
  border: 1rpx solid #d9f2ef;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.overview-pin-icon {
  width: 30rpx;
  height: 30rpx;
}

@keyframes icon-spin {
  to {
    transform: rotate(360deg);
  }
}

.spin {
  animation: icon-spin 1.4s linear infinite;
}

.overview-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.overview-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #143634;
}

.overview-meta {
  font-size: 20rpx;
  font-weight: 500;
  color: #0f766e;
  background: #f0fdfa;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.overview-sub {
  font-size: 23rpx;
  color: #3f6663;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.range-wrap {
  position: relative;
  flex-shrink: 0;
}

.range-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 22rpx rgba(13, 148, 136, 0.26);
  transition: transform 0.16s ease, box-shadow 0.16s ease;
}

.range-arrow {
  width: 22rpx;
  height: 22rpx;
  transition: transform 0.2s ease;
}

.range-pill.open .range-arrow {
  transform: rotate(90deg);
}

.range-pop {
  position: absolute;
  top: calc(100% + 12rpx);
  right: 0;
  width: 196rpx;
  padding: 10rpx;
  background: #ffffff;
  border: 1rpx solid #d9f2ef;
  border-radius: 26rpx;
  box-shadow: 0 18rpx 40rpx rgba(6, 60, 56, 0.18);
  z-index: 300;
  animation: pop-in 0.18s ease both;
}

@keyframes pop-in {
  from {
    opacity: 0;
    transform: translateY(-8rpx) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.range-option {
  padding: 16rpx 0;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #0f766e;
  border-radius: 16rpx;
}

.range-option.active {
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  color: #ffffff;
}


/* 医院列表：更舒展的卡片布局 */
.list-header {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 10rpx 8rpx 18rpx;
}

.list-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #143634;
}

.hospital-item {
  background: #ffffff;
  border: 1rpx solid #e6fffa;
  border-radius: 44rpx;
  padding: 30rpx 28rpx 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 16rpx 34rpx rgba(13, 148, 136, 0.12);
  transition: transform 0.16s ease, box-shadow 0.16s ease;
}

.card-head {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.hospital-logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 34rpx;
  background: linear-gradient(145deg, #ecfdf9 0%, #ccfbf1 100%);
  border: 1rpx solid #d9f2ef;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hospital-logo-icon {
  width: 44rpx;
  height: 44rpx;
}

.head-main {
  flex: 1;
  min-width: 0;
}

.title-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.sub-line {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.distance-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
  font-weight: 600;
  color: #0f766e;
  background: #ecfdf9;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

.hospital-address {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #5b7c7a;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.action-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 22rpx;
}

.action {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 28rpx;
  transition: transform 0.14s ease, box-shadow 0.14s ease;
}

.action.primary {
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  color: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(13, 148, 136, 0.24);
}

.action.ghost {
  background: #f0fdfa;
  color: #0f766e;
  border: 1rpx solid #d9f2ef;
}

.action-icon {
  width: 28rpx;
  height: 28rpx;
}


.excluded-tip {
  font-size: 21rpx;
  color: #6f8f8b;
}

/* 提升列表与概览的正文对比度 */
.overview-sub {
  color: #2f504d;
}

.hospital-address {
  color: #2f504d;
}

.selected-tag {
  font-size: 20rpx;
}

.level-chip {
  font-size: 21rpx;
}




