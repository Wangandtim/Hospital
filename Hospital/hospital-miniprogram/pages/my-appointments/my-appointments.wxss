.appts-page { min-height: 100vh; padding-top: 8rpx; }
.appts-tabs { margin: 8rpx 0 24rpx; }
.appts-tabs .ui-seg { font-size: 24rpx; padding: 0 4rpx; }
.appts-list { padding-bottom: 32rpx; }

.appt-card {
  display: flex;
  background: #FFFDFA;
  border: 1rpx solid #E5E5DE;
  border-radius: 28rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: 0 1rpx 2rpx rgba(23, 29, 27, 0.04);
}
.appt-card-date {
  width: 132rpx;
  flex-shrink: 0;
  background: #FBFAF6;
  border-right: 1rpx solid #EFEEE8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 8rpx;
}
.appt-card-day { font-family: "Songti SC", serif; font-size: 52rpx; line-height: 1.1; color: #171D1B; }
.appt-card-month { font-size: 22rpx; color: #8A938F; margin-top: 2rpx; }
.appt-card-week { font-size: 18rpx; color: #B6BDB9; margin-top: 6rpx; transform: scale(0.9); }

.appt-card-body { flex: 1; min-width: 0; padding: 22rpx 24rpx 18rpx; }
.appt-card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; }
.appt-card-doctor { font-family: "Songti SC", serif; font-size: 36rpx; color: #171D1B; line-height: 1.35; min-width: 0; }
.appt-card-dept { font-family: "PingFang SC", sans-serif; font-size: 24rpx; color: #8A938F; margin-left: 10rpx; }
.appt-card-time { font-size: 26rpx; color: #4B5652; margin-top: 8rpx; }
.appt-card-hospital { font-size: 22rpx; color: #8A938F; margin-top: 2rpx; }
.appt-card-foot { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 16rpx; padding-top: 14rpx; border-top: 1rpx solid #EFEEE8; }
.appt-card-code { font-size: 20rpx; color: #B6BDB9; letter-spacing: 0.08em; flex: 1; min-width: 0; }
.appt-card-actions { display: flex; gap: 12rpx; flex-shrink: 0; }
.appt-card-actions .ui-btn { padding: 0 20rpx; }

/* 排班取消弹窗 */
.appts-modal {
  position: fixed;
  inset: 0;
  background: rgba(23, 29, 27, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 90;
  padding: 48rpx;
}
.appts-modal-card {
  width: 100%;
  background: #FFFDFA;
  border-radius: 32rpx;
  padding: 36rpx 32rpx 28rpx;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.2);
}
.appts-modal-title { font-size: 42rpx; margin-top: 8rpx; }
.appts-modal-desc { font-size: 26rpx; color: #4B5652; line-height: 1.75; margin-top: 10rpx; }
.appts-modal-info { margin-top: 20rpx; border: 1rpx solid #E5E5DE; border-radius: 20rpx; overflow: hidden; }
.appts-modal-actions { display: flex; gap: 16rpx; margin-top: 28rpx; }
.appts-modal-actions .ui-btn { flex: 1; }
