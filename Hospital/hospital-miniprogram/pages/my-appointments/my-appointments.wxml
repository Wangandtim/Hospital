<view class="appts-page {{elderly ? 'elderly' : ''}}">
  <view class="ui-page">
    <view class="ui-head">
      <view class="ui-brand">
        <view class="ui-brand-word">我的预约</view>
        <view class="ui-brand-rule"></view>
        <view class="ui-brand-sub">APPOINTMENTS · {{pager.total || 0}} 条</view>
      </view>
      <view class="ui-icon-btn" bindtap="goTriage">分诊</view>
    </view>

    <view class="ui-segmented appts-tabs">
      <view
        class="ui-seg {{currentTab === item.key ? 'ui-seg-active' : ''}}"
        wx:for="{{tabs}}"
        wx:key="key"
        bindtap="switchTab"
        data-key="{{item.key}}"
      >{{item.label}}</view>
    </view>

    <view class="appts-list">
      <view class="appt-card" wx:for="{{appointments}}" wx:key="appointmentId">
        <view class="appt-card-date">
          <view class="appt-card-day ui-num">{{item.dayText}}</view>
          <view class="appt-card-month">{{item.monthText}}</view>
          <view class="appt-card-week">{{item.appointmentDate}}</view>
        </view>
        <view class="appt-card-body">
          <view class="appt-card-top">
            <view class="appt-card-doctor">
              <text>{{item.doctorName || '未知医生'}}</text>
              <view class="appt-card-dept-row">
                <image class="appt-card-dept-ico" src="{{item.deptIcon}}" mode="aspectFit" />
                <text class="appt-card-dept">{{item.deptName || '未知科室'}}</text>
              </view>
            </view>
            <view class="ui-state {{item.state === 'pending' ? 'ui-state-ok' : item.state === 'unpaid' ? 'ui-state-low' : 'ui-state-full'}}">
              <i></i>{{item.statusText || (item.state === 'unpaid' ? '待付款' : item.state === 'pending' ? '待就诊' : item.state === 'completed' ? '已完成' : '已取消')}}
            </view>
          </view>
          <view class="appt-card-time">{{item.timeSlot || '时段未知'}} · {{item.queueNo}}</view>
          <view class="appt-card-hospital">{{item.hospitalName || ''}}</view>
          <view class="appt-card-foot">
            <view class="appt-card-code">NO. {{item.appointmentNo || item.appointmentId}}</view>
            <view class="appt-card-actions">
              <view wx:if="{{item.state === 'pending' || item.state === 'unpaid'}}" class="ui-btn ui-btn-danger ui-btn-sm" catchtap="cancelAppointment" data-appointment-id="{{item.appointmentId}}">取消</view>
              <view class="ui-btn ui-btn-outline ui-btn-sm" catchtap="goToDetail" data-appointment-id="{{item.appointmentId}}">详情</view>
            </view>
          </view>
        </view>
      </view>

      <ui-empty
        wx:if="{{pager.status === 'empty'}}"
        mark="约"
        title="{{currentTab === 'all' ? '还没有预约记录' : '这个分类下暂无记录'}}"
        hint="去首页挑选合适的医生，或先用智能分诊判断科室"
        actionText="去首页"
        bindaction="goHome"
      />

      <view bindtap="onReachBottom">
        <ui-pager
          status="{{pager.status}}"
          hasMore="{{pager.hasMore}}"
          total="{{pager.total}}"
          error="{{pager.error}}"
          bindretry="retryLoad"
        />
      </view>
    </view>
  </view>

  <view class="appts-modal" wx:if="{{showScheduleCancelModal}}" bindtap="closeScheduleCancelModal">
    <view class="appts-modal-card" catchtap="stopPropagation">
      <view class="ui-eyebrow ui-eyebrow-gold">SCHEDULE CHANGED</view>
      <view class="appts-modal-title ui-serif">医生排班已取消</view>
      <view class="appts-modal-desc">您预约的医生排班时间已被取消，请重新预约或联系医院。</view>
      <view class="appts-modal-info">
        <view class="ui-row"><view class="ui-row-label">医生</view><view class="ui-row-main"></view><view class="ui-row-val">{{cancelledScheduleInfo.doctorName}}</view></view>
        <view class="ui-row"><view class="ui-row-label">日期</view><view class="ui-row-main"></view><view class="ui-row-val">{{cancelledScheduleInfo.appointmentDate}}</view></view>
        <view class="ui-row"><view class="ui-row-label">时段</view><view class="ui-row-main"></view><view class="ui-row-val">{{cancelledScheduleInfo.timeSlot}}</view></view>
      </view>
      <view class="appts-modal-actions">
        <button class="ui-btn ui-btn-outline" bindtap="closeScheduleCancelModal">我知道了</button>
        <button class="ui-btn ui-btn-primary" bindtap="reschedule">重新预约</button>
      </view>
    </view>
  </view>
</view>
