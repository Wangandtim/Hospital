.schedule-page {
  min-height: 100vh;
  padding-top: 16rpx;
  padding-bottom: 48rpx;
}

.schedule-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 4rpx;
}

.schedule-month {
  font-family: var(--font-serif);
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
}

.weekday-row {
  display: flex;
  padding: 4rpx 0 12rpx;
}

.weekday-item {
  flex: 1;
  text-align: center;
  font-size: var(--fs-micro);
  color: var(--ink-3);
}

.calendar-panel {
  margin-bottom: var(--s4);
}

.calendar-grid {
  display: flex;
  flex-wrap: wrap;
}

.date-item {
  width: calc(100% / 7);
  height: 84rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: var(--r-sm);
}

.date-num {
  font-size: var(--fs-caption);
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

.schedule-dot {
  position: absolute;
  bottom: 8rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--gold);
}

.date-item.empty {
  opacity: 0;
}

.date-item.today {
  background: var(--primary);
}

.date-item.today .date-num {
  color: #fff;
  font-weight: 600;
}

.date-item.selected {
  background: var(--tint);
}

.date-item.selected .date-num {
  color: var(--primary);
  font-weight: 600;
}

.date-item.past {
  background: var(--surface-2);
}
.date-item.past .date-num {
  color: var(--ink-2);
  text-decoration: line-through;
  text-decoration-color: var(--ink-4);
}

.date-item.has-schedule .date-num {
  color: var(--ink);
}

.schedule-search { margin-bottom: 20rpx; }

.schedule-list {
  padding-bottom: var(--s3);
}

.doctor-group {
  margin-bottom: 16rpx;
}

.doctor-header {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 26rpx;
}

.doctor-detail {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.doctor-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.doctor-name {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
}

.doctor-title {
  font-size: var(--fs-caption);
  color: var(--ink-2);
}

.doctor-dept {
  font-size: var(--fs-micro);
  color: var(--ink-3);
}

.schedule-items {
  border-top: 1rpx solid var(--line);
  padding: 20rpx 26rpx 24rpx;
}

.schedule-item + .schedule-item {
  margin-top: 16rpx;
}

.schedule-card {
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  border-radius: var(--r-sm);
  padding: 18rpx 20rpx;
}

.schedule-time {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.time-value {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
}

.schedule-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.patient-count {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.count-label {
  font-size: var(--fs-micro);
  color: var(--ink-3);
}

.count-value {
  font-size: var(--fs-caption);
  font-weight: 600;
  color: var(--primary);
}

.schedule-titles { margin-bottom: 20rpx; }

.dept-group { margin-bottom: 28rpx; }

.dept-group-head {
  position: sticky;
  top: 0;
  z-index: 6;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 0 12rpx;
  background: var(--paper);
  border-bottom: 1rpx solid var(--line);
}

.dept-group-name {
  flex: 1;
  min-width: 0;
  font-family: var(--font-serif);
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.dept-group-count {
  flex-shrink: 0;
  font-size: var(--fs-micro);
  color: var(--ink-3);
}

.dept-group-more {
  text-align: center;
  padding: 18rpx 0 8rpx;
  font-size: var(--fs-caption);
  color: var(--primary);
}

.slot-doctor {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  min-width: 0;
}

.slot-doctor-name {
  font-size: var(--fs-caption);
  color: var(--ink);
}

.slot-doctor-title {
  font-size: var(--fs-micro);
  color: var(--ink-3);
}

.slot-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-shrink: 0;
}

.slot-status {
  font-size: var(--fs-micro);
  color: var(--primary);
  white-space: nowrap;
}

.schedule-retry {
  margin-top: 20rpx;
  display: inline-flex;
}
