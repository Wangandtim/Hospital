page {
  background-color: #f0fdfa;
  min-height: 100vh;
}

.container {
  padding: 20rpx;
  padding-bottom: 40rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.header-left, .header-right {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #fff;
  border-radius: 50%;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.arrow {
  font-size: 48rpx;
  color: #333;
  font-weight: bold;
}

.current-month {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.hospital-info {
  background-color: #ffffff;
  border-radius: 36rpx;
  border: 1rpx solid #e6fffa;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.14);
}

.hospital-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #143634;
}

.weekday-row {
  display: flex;
  background-color: #0d9488;
  border-radius: 16rpx;
  padding: 20rpx 0;
  margin-bottom: 10rpx;
}

.weekday-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
}

.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  background-color: #ffffff;
  border-radius: 36rpx;
  border: 1rpx solid #e6fffa;
  padding: 20rpx;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.14);
  margin-bottom: 30rpx;
}

.date-item {
  width: calc(100% / 7);
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 10rpx;
}

.date-num {
  font-size: 28rpx;
  color: #333;
}

.schedule-indicator {
  position: absolute;
  bottom: 5rpx;
  font-size: 16rpx;
  color: #0d9488;
}

.date-item.empty {
  opacity: 0;
}

.date-item.today {
  background-color: #0d9488;
  border-radius: 50%;
}

.date-item.today .date-num {
  color: #fff;
}

.date-item.selected {
  background-color: #e8f4f2;
  border-radius: 50%;
}

.date-item.selected .date-num {
  color: #0d9488;
  font-weight: 600;
}

.date-item.past {
  opacity: 0.4;
}

.date-item.has-schedule {
  background-color: #f6ffed;
  border-radius: 50%;
}

.schedule-section {
  background-color: #ffffff;
  border-radius: 36rpx;
  border: 1rpx solid #e6fffa;
  padding: 24rpx;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.14);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #e6fffa;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.schedule-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.doctor-group {
  background-color: #ffffff;
  border-radius: 36rpx;
  border: 1rpx solid #e6fffa;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.14);
  overflow: hidden;
}

.doctor-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background-color: #fff;
}

.doctor-info {
  display: flex;
  align-items: center;
}

.doctor-avatar {
  width: 80rpx;
  height: 80rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border-radius: 50%;
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  flex-shrink: 0;
  margin-right: 20rpx;
}

.doctor-detail {
  display: flex;
  flex-direction: column;
}

.doctor-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.doctor-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.gender-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  background: #ecfdf9;
  border: 1rpx solid #ccfbf1;
  color: #0f766e;
  border-radius: 26rpx;
}

.doctor-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.dept-name {
  font-size: 24rpx;
  color: #999;
}

.expand-icon {
  font-size: 24rpx;
  color: #999;
}

.schedule-items {
  border-top: 1rpx solid #e6fffa;
  padding: 0 24rpx 24rpx;
}

.schedule-item {
  margin-top: 20rpx;
}

.schedule-card {
  background: linear-gradient(135deg, #f0fdfa 0%, #ecfdf9 100%);
  border: 1rpx solid #ccfbf1;
  border-radius: 22rpx;
  padding: 20rpx;
}

.schedule-time {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.time-label {
  font-size: 24rpx;
  color: #999;
}

.time-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #0d9488;
}

.schedule-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.patient-count {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.count-label {
  font-size: 24rpx;
  color: #999;
}

.count-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #52c41a;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 20rpx;
  border-radius: 26rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: #f6ffed;
  color: #52c41a;
}

.status-tag.booked {
  background: #fff7e6;
  color: #fa8c16;
}

.status-tag.closed {
  background: #f0fdfa;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.empty-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #666;
}