<view class="ui-page schedule-page">
  <view class="schedule-head">
    <view class="ui-icon-btn" bindtap="goBack"><text>←</text></view>
    <view class="schedule-month">{{currentYear}}年{{currentMonth}}月</view>
    <view class="ui-icon-btn" bindtap="nextMonth"><text>›</text></view>
  </view>

  <view class="ui-title-block">
    <view class="ui-eyebrow ui-eyebrow-gold">SCHEDULE</view>
    <view class="ui-title">医院排班</view>
    <view class="ui-subtitle">{{hospitalName}}</view>
  </view>

  <view class="weekday-row">
    <text class="weekday-item">日</text>
    <text class="weekday-item">一</text>
    <text class="weekday-item">二</text>
    <text class="weekday-item">三</text>
    <text class="weekday-item">四</text>
    <text class="weekday-item">五</text>
    <text class="weekday-item">六</text>
  </view>

  <view class="ui-panel calendar-panel">
    <view class="ui-panel-body">
      <view class="calendar-grid">
        <view
          class="date-item {{item.dateClass}}"
          wx:for="{{calendarData}}"
          wx:key="dateStr"
          bindtap="selectDate"
          data-date="{{item.dateStr}}"
          hover-class="hover-fade"
        >
          <text class="date-num">{{item.day}}</text>
          <view class="schedule-dot" wx:if="{{item.hasSchedule}}"></view>
        </view>
      </view>
    </view>
  </view>

  <view class="ui-section-head">
    <text class="ui-section-title">{{selectedDate}} 的排班</text>
  </view>

  <view class="schedule-list" wx:if="{{groupedSchedules.length > 0}}">
    <view wx:for="{{groupedSchedules}}" wx:key="doctorId" class="ui-panel doctor-group">
      <view class="doctor-header" bindtap="toggleDoctor" data-doctor-id="{{item.doctorId}}" hover-class="hover-fade">
        <view class="ui-plate"><image class="ui-plate-img" src="{{item.deptIcon}}" mode="aspectFit" /></view>
        <view class="doctor-detail">
          <view class="doctor-name-row">
            <text class="doctor-name">{{item.doctorName}}</text>
            <text class="ui-tag">{{item.genderText}}</text>
          </view>
          <text class="doctor-title">{{item.title}}</text>
          <text class="doctor-dept">{{item.deptName}}</text>
        </view>
        <view class="ui-chev">{{expandedDoctors[item.doctorId] ? '▾' : '›'}}</view>
      </view>

      <view wx:if="{{expandedDoctors[item.doctorId]}}" class="schedule-items">
        <view wx:for="{{item.schedules}}" wx:key="scheduleId" wx:for-item="schedule" class="schedule-item">
          <view class="schedule-card">
            <view class="schedule-time">
              <text class="ui-micro">排班时间</text>
              <text class="time-value ui-num">{{schedule.displayTimeSlot || schedule.timeSlot}}</text>
            </view>
            <view class="schedule-info">
              <view class="patient-count">
                <text class="count-label">已预约</text>
                <text class="count-value ui-num">{{schedule.bookedCount || 0}}/{{schedule.maxPatients || 1}}</text>
              </view>
              <view class="ui-pill ui-pill-done" wx:if="{{schedule.status === 1 || schedule.status === 'available'}}">可预约</view>
              <view class="ui-pill ui-pill-wait" wx:elif="{{schedule.status === 2 || schedule.status === 'booked'}}">已预约</view>
              <view class="ui-pill ui-pill-cancel" wx:else>已关闭</view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="ui-empty" wx:else>
    <view class="ui-empty-mark">班</view>
    <view class="ui-empty-title">当天暂无排班</view>
  </view>
</view>
