.ms-page { padding-top: 8rpx; padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }

.ms-calendar { padding: 20rpx 18rpx 24rpx; }

.ms-cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 4rpx 8rpx 18rpx;
}

.ms-month {
  font-family: var(--font-serif);
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--ink);
}

.ms-weekdays {
  display: flex;
  padding: 0 4rpx;
  margin-bottom: 4rpx;
}

.ms-weekday {
  width: 14.2857%;
  text-align: center;
  font-size: var(--fs-micro);
  color: var(--ink-3);
  letter-spacing: 0.08em;
  line-height: 40rpx;
}

.ms-grid {
  display: flex;
  flex-wrap: wrap;
}

.ms-date {
  width: 14.2857%;
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: var(--r-sm);
}

.ms-date-num {
  font-size: var(--fs-caption);
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

.ms-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--gold);
  margin-top: 6rpx;
}

.ms-date.empty { opacity: 0; }

.ms-date.today {
  background: var(--primary);
}
.ms-date.today .ms-date-num { color: #fff; }
.ms-date.today .ms-dot { background: #fff; }

.ms-date.selected {
  background: var(--tint);
  box-shadow: inset 0 0 0 1rpx var(--primary);
}
.ms-date.selected .ms-date-num { color: var(--primary); font-weight: 600; }

.ms-date.past { background: var(--surface-2); }
.ms-date.past .ms-date-num {
  color: var(--ink-2);
  text-decoration: line-through;
  text-decoration-color: var(--ink-4);
}

.ms-date.has-schedule { background: var(--surface-2); }
.ms-date.has-schedule.selected { background: var(--tint); }
.ms-date.has-schedule.today { background: var(--primary); }

.ms-list { display: flex; flex-direction: column; }

.ms-item {
  display: flex;
  align-items: stretch;
  min-height: 128rpx;
}
.ms-item + .ms-item { border-top: 1rpx solid var(--line); }

.ms-time {
  width: 150rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 16rpx 10rpx;
  border-right: 1rpx solid var(--line);
  background: var(--surface-2);
}

.ms-time.on { background: var(--tint); }
.ms-time.off { background: var(--surface-2); }

.ms-time-text {
  font-size: var(--fs-micro);
  font-weight: 600;
  color: var(--primary);
  text-align: center;
  line-height: 1.4;
  font-variant-numeric: tabular-nums;
}
.ms-time.off .ms-time-text { color: var(--ink-3); }

.ms-time-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--gold);
}

.ms-main {
  flex: 1;
  min-width: 0;
  padding: 20rpx 18rpx;
}

.ms-slot-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.ms-slot-detail {
  font-size: var(--fs-micro);
  color: var(--ink-3);
}

.ms-patients {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--line);
}

.ms-toggle {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 56rpx;
}

.ms-toggle-icon { font-size: var(--fs-micro); color: var(--gold-ink); }

.ms-toggle-text { font-size: var(--fs-caption); color: var(--primary); }

.ms-patient-list {
  margin-top: 10rpx;
  background: var(--surface-2);
  border-radius: var(--r-sm);
  padding: 4rpx 14rpx;
}

.ms-patient {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 96rpx;
  padding: 10rpx 0;
}
.ms-patient + .ms-patient { border-top: 1rpx solid var(--line); }

.ms-patient-main { flex: 1; min-width: 0; }

.ms-patient-name {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink);
}

.ms-patient-phone {
  display: block;
  font-size: var(--fs-micro);
  color: var(--ink-3);
  margin-top: 2rpx;
}

.ms-actions {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
  padding: 14rpx 16rpx;
  border-left: 1rpx solid var(--line);
  flex-shrink: 0;
}

.ms-mask {
  position: fixed;
  inset: 0;
  background: rgba(23, 29, 27, 0.48);
  z-index: 30;
}

.ms-modal {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  max-height: 86vh;
  overflow-y: auto;
  background: var(--surface);
  border-radius: var(--r-lg);
  padding: 30rpx var(--s4) 26rpx;
  box-sizing: border-box;
  z-index: 40;
  animation: ui-rise 0.24s ease both;
}

.ms-modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
}

.ms-modal-title {
  font-family: var(--font-serif);
  font-size: var(--fs-h2);
  color: var(--ink);
}

.ms-modal-close { flex-shrink: 0; }

.ms-modal-body { padding-bottom: 4rpx; }

.ms-picker {
  justify-content: space-between;
  font-size: var(--fs-body);
}

.ms-hint {
  font-size: var(--fs-micro);
  color: var(--ink-3);
  line-height: 1.6;
  margin: -4rpx 0 18rpx;
}

.ms-modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}
.ms-modal-actions .ui-btn { flex: 1; }
