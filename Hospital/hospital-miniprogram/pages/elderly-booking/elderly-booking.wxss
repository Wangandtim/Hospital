page {
  background: var(--paper);
}

.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* 当前医院 */
.hospital-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 24rpx 32rpx 0;
  padding: 24rpx 28rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
}

.hb-icon { width: 44rpx; height: 44rpx; flex-shrink: 0; }
.hb-name {
  flex: 1; min-width: 0;
  font-size: 34rpx; font-weight: 700; color: var(--ink);
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.hb-tip {
  flex-shrink: 0;
  font-size: 26rpx; color: var(--primary);
  background: var(--tint); border-radius: var(--r-pill);
  padding: 8rpx 20rpx;
}

/* 三步进度 */
.steps { display: flex; align-items: flex-start; padding: 40rpx 40rpx 12rpx; }
.step-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.step-circle {
  width: 68rpx; height: 68rpx; border-radius: 50%;
  background: var(--surface); border: 1rpx solid var(--line-strong);
  color: var(--ink-3); font-size: 30rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  box-sizing: border-box;
}
.step-item.current .step-circle { background: var(--primary); border-color: var(--primary); color: #fff; }
.step-item.done .step-circle { background: var(--tint); border-color: #BFD8D0; color: var(--primary); }
.step-label { font-size: 28rpx; color: var(--ink-3); margin-top: 12rpx; }
.step-item.current .step-label, .step-item.done .step-label { color: var(--ink); font-weight: 700; }
.step-line { width: 56rpx; height: 2rpx; margin-top: 34rpx; background: var(--line); flex-shrink: 0; }
.step-line.on { background: #BFD8D0; }

/* 面板 */
.panel {
  margin: 12rpx 32rpx 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  padding: 30rpx 28rpx;
}
.panel-title { font-family: var(--font-serif); font-size: 40rpx; font-weight: 700; color: var(--ink); margin-bottom: 24rpx; }
.panel-loading, .panel-empty { font-size: 32rpx; color: var(--ink-3); text-align: center; padding: 40rpx 0; }

.no-schedule { text-align: center; padding: 24rpx 0 8rpx; }
.no-schedule-text { font-size: 32rpx; color: var(--ink-2); margin-bottom: 24rpx; }
.no-schedule-btn {
  display: inline-flex; align-items: center; justify-content: center;
  min-height: 100rpx; padding: 0 56rpx;
  border-radius: var(--r-pill);
  background: var(--primary); color: #fff;
  font-size: 32rpx; font-weight: 700;
}

/* 第一步：科室 */
.dept-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.dept-item {
  min-height: 140rpx;
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
}
.dept-item.active { background: var(--tint-2); border-color: var(--primary); }
.dept-icon { width: 56rpx; height: 56rpx; flex-shrink: 0; }
.dept-text { font-size: 34rpx; font-weight: 600; color: var(--ink); line-height: 1.3; }
.dept-item.active .dept-text { color: var(--primary); }

/* 已选摘要行 */
.chosen-row {
  display: flex; align-items: center;
  margin: 12rpx 32rpx 24rpx;
  padding: 26rpx 30rpx;
  background: var(--tint-2);
  border: 1rpx solid #D3E2DC;
  border-radius: var(--r-md);
}
.chosen-label { font-size: 30rpx; color: var(--ink-3); flex-shrink: 0; }
.chosen-value {
  flex: 1; min-width: 0;
  font-size: 34rpx; font-weight: 700; color: var(--ink);
  margin-left: 18rpx;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.chosen-edit { flex-shrink: 0; font-size: 30rpx; font-weight: 700; color: var(--primary); padding-left: 18rpx; }

/* 第二步：医生 */
.doctor-item {
  display: flex; align-items: center; gap: 20rpx;
  padding: 26rpx 22rpx;
  margin-bottom: 16rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
}
.doctor-item.active { border-color: var(--primary); background: var(--tint-2); }
.doctor-avatar {
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: var(--tint-2);
  color: var(--primary);
  font-family: var(--font-serif);
  font-size: 38rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; overflow: hidden;
}
.doctor-avatar-img { width: 100%; height: 100%; display: block; }
.doctor-main { flex: 1; min-width: 0; }
.doctor-name { font-size: 34rpx; font-weight: 700; color: var(--ink); }
.doctor-title { font-size: 26rpx; font-weight: 400; color: var(--ink-3); margin-left: 8rpx; }
.doctor-expertise {
  font-size: 26rpx; color: var(--ink-2); margin-top: 6rpx;
  overflow: hidden; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical;
}
.doctor-fee { flex-shrink: 0; font-family: var(--font-serif); font-size: 34rpx; font-weight: 700; color: var(--ink); }

/* 第三步：时间 */
.date-scroll { white-space: nowrap; width: 100%; height: 168rpx; margin-bottom: 20rpx; }
.date-item {
  display: inline-flex; flex-direction: column; align-items: center; justify-content: center;
  width: 152rpx; height: 152rpx;
  margin-right: 16rpx;
  box-sizing: border-box;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
}
.date-item.active { background: var(--primary); border-color: var(--primary); }
.date-label { font-size: 34rpx; font-weight: 600; color: var(--ink); }
.date-week { font-size: 26rpx; color: var(--ink-3); margin-top: 4rpx; }
.date-item.active .date-label, .date-item.active .date-week { color: #fff; }
.date-item.active .date-week { color: #DFEDE9; }

.slot-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.slot-item {
  min-height: 128rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx;
  box-sizing: border-box;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
}
.slot-item.active { background: var(--primary); border-color: var(--primary); }
.slot-item.disabled { background: var(--surface-2); border-color: var(--line); }
.slot-text { font-size: 34rpx; font-weight: 600; color: var(--ink); }
.slot-left { font-size: 26rpx; color: var(--ink-3); }
.slot-item.active .slot-text, .slot-item.active .slot-left { color: #fff; }
.slot-item.disabled .slot-text, .slot-item.disabled .slot-left { color: var(--ink-4); }

/* 三步选完后的确认区 */
.confirm-box { margin-top: 30rpx; padding-top: 26rpx; border-top: 1rpx solid var(--line); }
.confirm-summary { margin-bottom: 20rpx; }
.confirm-main { display: block; font-size: 34rpx; font-weight: 700; color: var(--ink); }
.confirm-sub { display: block; font-size: 30rpx; color: var(--ink-2); margin-top: 8rpx; }
.confirm-tip { font-size: 30rpx; color: var(--ink-3); text-align: center; margin-bottom: 20rpx; }
.confirm-btn {
  height: 112rpx; border-radius: var(--r-pill);
  background: var(--primary); color: #fff;
  font-size: 38rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.confirm-btn.disabled { background: #DDDCD5; color: #fff; }

/* 支付弹层 */
.mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; background: rgba(6, 40, 38, 0.45); z-index: 30; }
.pay-panel {
  position: fixed; left: 24rpx; right: 24rpx; bottom: 40rpx;
  background: var(--surface); border-radius: 36rpx;
  padding: 36rpx 32rpx 28rpx; z-index: 40;
  box-shadow: 0 24rpx 60rpx rgba(6, 40, 38, 0.22);
  animation: rise-in 0.22s ease both;
}
@keyframes rise-in {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.pay-title { font-size: 28rpx; color: var(--ink-3); text-align: center; }
.pay-amount { font-family: var(--font-serif); font-size: 72rpx; font-weight: 700; color: var(--ink); text-align: center; margin: 8rpx 0 20rpx; }
.pay-line {
  display: flex; justify-content: space-between;
  font-size: 30rpx; color: var(--ink);
  padding: 16rpx 0; border-bottom: 1rpx solid var(--line);
}
.pay-btn {
  margin-top: 28rpx; height: 104rpx; border-radius: var(--r-pill);
  background: var(--primary); color: #fff;
  font-size: 38rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.pay-cancel { text-align: center; font-size: 28rpx; color: var(--ink-3); padding: 24rpx 0 6rpx; }

/* 成功页 */
.success-view { padding: 100rpx 32rpx 40rpx; text-align: center; }
.success-circle {
  width: 152rpx; height: 152rpx; margin: 0 auto 28rpx;
  border-radius: 50%; background: var(--primary);
  color: #fff; font-size: 72rpx;
  display: flex; align-items: center; justify-content: center;
}
.success-title { font-family: var(--font-serif); font-size: 52rpx; font-weight: 700; color: var(--ink); margin-bottom: 28rpx; }
.success-card { padding: 28rpx 26rpx 0; text-align: left; }
.success-row { display: flex; justify-content: space-between; gap: 24rpx; font-size: 32rpx; padding: 16rpx 0; color: var(--ink); }
.success-row .label { color: var(--ink-3); flex-shrink: 0; }
.success-row .value { text-align: right; }
.success-tip { font-size: 28rpx; color: var(--ink-2); padding: 24rpx 0 28rpx; line-height: 1.7; text-align: left; }
.success-btn {
  margin-top: 28rpx; height: 108rpx; line-height: 108rpx;
  border-radius: var(--r-pill);
  background: var(--primary); color: #fff;
  font-size: 36rpx; font-weight: 700; text-align: center;
}
.success-btn.ghost { background: var(--surface); color: var(--primary); border: 1rpx solid var(--primary); }
