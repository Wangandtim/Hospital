.container {
  min-height: 100vh;
  background: #f0fdfa;
  padding: 20rpx;
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

/* 品牌模块 */
.brand-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 8rpx 6rpx 24rpx;
}

.brand-logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(13, 148, 136, 0.28);
}

.brand-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #143634;
  letter-spacing: 1rpx;
}

.brand-sub 
{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-left: auto;
  font-size: 22rpx;
  color: #5b7c7a;
  background: #ffffff;
  border: 1rpx solid #d9f2ef;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

/* 医生名片 */
.hero-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: linear-gradient(150deg, #ffffff 0%, #f7fffe 100%);
  border-radius: 40rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #e6fffa;
  box-shadow: 0 24rpx 56rpx rgba(13, 148, 136, 0.18);
}

.doctor-avatar {
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #ccfbf1 0%, #e6fffa 100%);
  border: 3rpx solid #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(13, 148, 136, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.doctor-avatar-img {
  width: 68rpx;
  height: 68rpx;
}

.doctor-info {
  flex: 1;
  min-width: 0;
}

.doctor-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.doctor-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #143634;
}

.doctor-title 
{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #2dd4bf 0%, #0d9488 100%);
  padding: 3rpx 14rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  box-shadow: 0 6rpx 14rpx rgba(13, 148, 136, 0.24);
}

.doctor-dept {
  font-size: 25rpx;
  color: #5b7c7a;
  margin-bottom: 14rpx;
}

.doctor-meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.meta-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #0f766e;
  background: #ecfdf9;
  border: 1rpx solid #ccfbf1;
  padding: 5rpx 14rpx;
  border-radius: 14rpx;
  font-weight: 500;
}

.meta-chip.muted {
  color: #94aeab;
  background: #f5fbfa;
  border-color: #e6f5f3;
}

/* 内容模块 */
.section-card {
  background: #ffffff;
  border-radius: 36rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #e6fffa;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.14);
}

.section-header {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.section-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 22rpx;
  background: linear-gradient(145deg, #ecfdf9 0%, #ccfbf1 100%);
  border: 1rpx solid #d9f2ef;
  display: flex;
  align-items: center;
  justify-content: center;
}

.section-icon {
  width: 32rpx;
  height: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #143634;
}

.section-content {
  font-size: 26rpx;
  color: #3f5f5c;
  line-height: 1.8;
}

.dept-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.dept-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #143634;
}

.dept-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #2dd4bf 0%, #0d9488 100%);
  padding: 3rpx 12rpx;
  border-radius: 12rpx;
}

.dept-desc {
  font-size: 24rpx;
  color: #5b7c7a;
  line-height: 1.75;
}

.notice-row {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.notice-dot {
  color: #14b8a6;
  font-size: 24rpx;
  line-height: 1.8;
}

.notice-text {
  font-size: 25rpx;
  color: #3f5f5c;
  line-height: 1.8;
}

/* 底部预约 */
.bottom-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.94);
  padding: 18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -12rpx 32rpx rgba(13, 148, 136, 0.16);
}

.appointment-btn {
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  color: #ffffff;
  border: none;
  border-radius: 46rpx;
  font-size: 31rpx;
  height: 92rpx;
  line-height: 92rpx;
  width: 100%;
  font-weight: 700;
  letter-spacing: 2rpx;
  box-shadow: 0 16rpx 34rpx rgba(13, 148, 136, 0.34);
}

.appointment-btn::after {
  border: none;
}

.btn-hover {
  transform: scale(0.97) translateY(2rpx);
  opacity: 0.92;
  box-shadow: 0 8rpx 18rpx rgba(13, 148, 136, 0.24);
}

.no-schedule-card {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #d9f2ef;
  box-shadow: 0 10rpx 24rpx rgba(13, 148, 136, 0.1);
}

.no-schedule-icon {
  width: 34rpx;
  height: 34rpx;
}

.no-schedule-text {
  font-size: 25rpx;
  color: #5b7c7a;
}

/* 加载 */
.loading-container {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 5rpx solid #ccfbf1;
  border-top-color: #14b8a6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 26rpx;
  color: #5b7c7a;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
