.doctor-detail { min-height: 100vh; }
.doctor-detail-page { padding-top: 16rpx; padding-bottom: 180rpx; }
.doctor-crumb { font-size: 24rpx; color: #8A938F; margin-bottom: 20rpx; }

.doctor-hero { padding-bottom: 8rpx; }
.doctor-hero-top { display: flex; gap: 24rpx; align-items: flex-start; }
.doctor-admin-entry {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border: 1rpx solid #D3E2DC;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #0F5B50;
}
.doctor-hero-ava {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: #EFF4F1;
  border: 1rpx solid #D3E2DC;
  color: #0F5B50;
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}
.doctor-hero-photo { width: 100%; height: 100%; display: block; }
.doctor-hero-state { margin-top: 2rpx; }

.doctor-cert-rail { white-space: nowrap; padding: 4rpx 0 8rpx; }
.doctor-cert {
  display: inline-block; width: 280rpx; margin-right: 16rpx;
  vertical-align: top;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  overflow: hidden;
}
.doctor-cert-img { width: 280rpx; height: 168rpx; display: block; }
.doctor-cert-plate {
  width: 280rpx; height: 168rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--tint-2);
  font-family: var(--font-serif);
  font-size: 40rpx; color: var(--primary);
}
.doctor-cert-title {
  font-size: var(--fs-caption); color: var(--ink); font-weight: 600;
  padding: 14rpx 18rpx 0;
  white-space: normal;
}
.doctor-cert-meta {
  font-size: var(--fs-micro); color: var(--ink-3);
  padding: 4rpx 18rpx 18rpx;
  white-space: normal;
}
.doctor-hero-main { flex: 1; min-width: 0; padding-top: 4rpx; }
.doctor-hero-name { font-size: 56rpx; line-height: 1.2; letter-spacing: -0.03em; }
.doctor-hero-title { font-size: 26rpx; color: #4B5652; margin-top: 8rpx; line-height: 1.6; }
.doctor-hero-flags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 14rpx; }

.doctor-hero-stats {
  display: flex;
  align-items: center;
  background: #FFFDFA;
  border: 1rpx solid #E5E5DE;
  border-radius: 24rpx;
  padding: 24rpx 16rpx;
  margin-top: 28rpx;
}
.doctor-stat { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.doctor-stat-num { font-family: "Songti SC", serif; font-size: 44rpx; color: #171D1B; line-height: 1.2; }
.doctor-stat-gold { color: #87672F; }
.doctor-stat-label { font-size: 22rpx; color: #8A938F; }
.doctor-stat-sep { width: 1rpx; height: 44rpx; background: #E5E5DE; }

.doctor-tags { display: flex; flex-wrap: wrap; gap: 10rpx; }

.doctor-prose { font-size: 28rpx; color: #4B5652; line-height: 1.9; margin-bottom: 16rpx; }

.doctor-dept { padding: 24rpx 26rpx 26rpx; }
.doctor-dept-row { display: flex; align-items: center; gap: 16rpx; }
.doctor-dept-name { font-family: "Songti SC", serif; font-size: 34rpx; color: #171D1B; }
.doctor-dept-desc { font-size: 26rpx; color: #8A938F; line-height: 1.75; margin-top: 8rpx; }
.doctor-dept .ui-inst-tags { margin-top: 12rpx; }

.doctor-note { margin-top: 40rpx; padding-top: 28rpx; border-top: 1rpx solid #E5E5DE; }
.doctor-note-row { font-size: 24rpx; color: #8A938F; line-height: 1.9; margin-top: 6rpx; }

.doctor-detail-bottom { height: 40rpx; }
.doctor-loading { padding: 48rpx; }

.elderly .doctor-hero-ava { width: 156rpx; height: 156rpx; font-size: 56rpx; }
.elderly .doctor-hero-name { font-size: 64rpx; }
.elderly .doctor-prose, .elderly .doctor-note-row { font-size: 32rpx; }
