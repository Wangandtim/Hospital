<view class="container {{elderly ? 'elderly' : ''}}" wx:if="{{!loading}}">
  <view class="brand-bar">
    <image class="brand-logo" src="/images/logo.png" mode="aspectFit" />
    <view class="brand-text">健康联防</view>
    <view class="brand-sub">医生主页</view>
  </view>

  <view class="hero-card">
    <view class="doctor-avatar">
      <image class="doctor-avatar-img" src="/images/icons/ic-doctor-14b8a6.png" mode="aspectFit" />
    </view>
    <view class="doctor-info">
      <view class="doctor-name-row">
        <text class="doctor-name">{{doctor.name}}</text>
        <text class="doctor-title">{{doctor.title}}</text>
      </view>
      <view class="doctor-dept">
        {{department && department.deptName ? department.deptName : '临床科室'}}
      </view>
      <view class="doctor-meta-row">
        <view class="meta-chip">挂号费 ¥{{doctor.consultationFee || '—'}}</view>
        <view class="meta-chip" wx:if="{{hasSchedule}}">今日可预约</view>
        <view class="meta-chip muted" wx:else>今日休息</view>
      </view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-header">
      <view class="section-icon-wrap">
        <image class="section-icon" src="/images/icons/ic-doc-14b8a6.png" mode="aspectFit" />
      </view>
      <text class="section-title">个人简介</text>
    </view>
    <view class="section-content">
      <text>{{doctor.introduction || doctor.title + '，从事临床工作多年，经验丰富，擅长' + (doctor.expertise || '常见病诊疗') + '。'}}</text>
    </view>
  </view>

  <view class="section-card">
    <view class="section-header">
      <view class="section-icon-wrap">
        <image class="section-icon" src="/images/icons/ic-target-14b8a6.png" mode="aspectFit" />
      </view>
      <text class="section-title">专业特长</text>
    </view>
    <view class="section-content">
      <text>{{doctor.expertise || '暂无信息'}}</text>
    </view>
  </view>

  <view class="section-card" wx:if="{{doctor.education}}">
    <view class="section-header">
      <view class="section-icon-wrap">
        <image class="section-icon" src="/images/icons/ic-cap-14b8a6.png" mode="aspectFit" />
      </view>
      <text class="section-title">学历背景</text>
    </view>
    <view class="section-content">
      <text>{{doctor.education}}</text>
    </view>
  </view>

  <view class="section-card" wx:if="{{doctor.moral}}">
    <view class="section-header">
      <view class="section-icon-wrap">
        <image class="section-icon" src="/images/icons/ic-heart-14b8a6.png" mode="aspectFit" />
      </view>
      <text class="section-title">医德医风</text>
    </view>
    <view class="section-content">
      <text>{{doctor.moral}}</text>
    </view>
  </view>

  <view class="section-card" wx:if="{{doctor.experience}}">
    <view class="section-header">
      <view class="section-icon-wrap">
        <image class="section-icon" src="/images/icons/ic-clock-14b8a6.png" mode="aspectFit" />
      </view>
      <text class="section-title">临床经验</text>
    </view>
    <view class="section-content">
      <text>{{doctor.experience}}</text>
    </view>
  </view>

  <view class="section-card" wx:if="{{department}}">
    <view class="section-header">
      <view class="section-icon-wrap">
        <image class="section-icon" src="/images/icons/ic-grid-14b8a6.png" mode="aspectFit" />
      </view>
      <text class="section-title">所在科室</text>
    </view>
    <view class="section-content">
      <view class="dept-info">
        <text class="dept-name">{{department.deptName}}</text>
        <view class="dept-badge" wx:if="{{department.flagshipText}}">{{department.flagshipText}}</view>
      </view>
      <text class="dept-desc">{{department.description}}</text>
    </view>
  </view>

  <view class="section-card">
    <view class="section-header">
      <view class="section-icon-wrap">
        <image class="section-icon" src="/images/icons/ic-info-14b8a6.png" mode="aspectFit" />
      </view>
      <text class="section-title">就诊须知</text>
    </view>
    <view class="section-content">
      <view class="notice-row"><text class="notice-dot">·</text><text class="notice-text">预约成功后请按预约时段到院就诊</text></view>
      <view class="notice-row"><text class="notice-dot">·</text><text class="notice-text">请携带身份证或医保卡等有效证件</text></view>
      <view class="notice-row"><text class="notice-dot">·</text><text class="notice-text">如需取消，请提前 2 小时操作</text></view>
    </view>
  </view>

  <view class="bottom-btn" wx:if="{{hasSchedule}}">
    <button class="appointment-btn" bindtap="makeAppointment" hover-class="btn-hover">立即预约</button>
  </view>
  <view class="no-schedule-card" wx:else>
    <image class="no-schedule-icon" src="/images/icons/ic-clock-14b8a6.png" mode="aspectFit" />
    <text class="no-schedule-text">该医生今日暂无排班</text>
  </view>
</view>

<view class="loading-container" wx:if="{{loading}}">
  <view class="loading-spinner"></view>
  <text class="loading-text">加载中...</text>
</view>
