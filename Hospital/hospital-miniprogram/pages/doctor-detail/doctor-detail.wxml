<view class="doctor-detail {{elderly ? 'elderly' : ''}}" wx:if="{{!loading && doctor}}">
  <view class="ui-page doctor-detail-page">
    <view class="doctor-crumb" wx:if="{{department}}">{{department.deptName}}{{department.floorZone ? ' · ' + department.floorZone : ''}}</view>

    <view class="doctor-hero">
      <view class="doctor-hero-top">
        <view class="doctor-hero-ava {{doctor.photoUrlFull ? 'has-photo' : ''}}">
          <image wx:if="{{doctor.photoUrlFull}}" class="doctor-hero-photo" src="{{doctor.photoUrlFull}}" mode="aspectFill" />
          <text wx:else>{{doctor.avatarText}}</text>
        </view>
        <view class="doctor-hero-main">
          <view class="doctor-hero-name ui-serif">{{doctor.name}}</view>
          <view class="doctor-hero-title">{{doctor.titleText}}</view>
          <view class="doctor-hero-flags">
            <view class="ui-tag ui-tag-gold" wx:for="{{doctor.flags}}" wx:key="index">{{item}}</view>
            <view class="ui-state {{hasSchedule ? 'ui-state-ok' : 'ui-state-full'}} doctor-hero-state"><i></i>{{hasSchedule ? '今日可约' : '今日休息'}}</view>
          </view>
        </view>
        <view class="doctor-admin-entry" wx:if="{{isAdmin}}" bindtap="goEditIntro">编辑介绍</view>
      </view>
    </view>

    <view wx:if="{{certificates.length > 0}}">
      <view class="ui-section-head">
        <text class="ui-section-title">荣誉证书</text>
        <text class="ui-section-sub">{{certificates.length}} 项</text>
      </view>
      <scroll-view class="doctor-cert-rail" scroll-x>
        <view class="doctor-cert" wx:for="{{certificates}}" wx:key="certificateId" bindtap="previewCertificate" data-index="{{index}}">
          <image wx:if="{{item.imageUrlFull}}" class="doctor-cert-img" src="{{item.imageUrlFull}}" mode="aspectFill" />
          <view wx:else class="doctor-cert-plate">证</view>
          <view class="doctor-cert-title">{{item.title}}</view>
          <view class="doctor-cert-meta">{{item.issuer || ''}}{{item.issuedDate ? ' · ' + item.issuedDate : ''}}</view>
        </view>
      </scroll-view>
    </view>

    <view wx:if="{{doctor.scheduleRows.length > 0}}">
      <view class="ui-section-head">
        <text class="ui-section-title">本周出诊</text>
        <text class="ui-section-sub">SCHEDULE</text>
      </view>
      <view class="ui-panel">
        <view class="ui-panel-body ui-panel-body-flush">
          <view class="ui-row" wx:for="{{doctor.scheduleRows}}" wx:key="label">
            <view class="ui-row-main">
              <view class="ui-row-title">{{item.label}}</view>
              <view class="ui-row-desc">{{item.detail}}</view>
            </view>
            <view class="ui-state {{item.tone === 'wait' ? 'ui-state-ok' : 'ui-state-full'}}"><i></i>{{item.pill}}</view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{doctor.specialtyTags.length > 0}}">
      <view class="ui-section-head">
        <text class="ui-section-title">专业特长</text>
      </view>
      <view class="doctor-tags">
        <view class="ui-tag" wx:for="{{doctor.specialtyTags}}" wx:key="index">{{item}}</view>
      </view>
    </view>

    <view wx:if="{{doctor.expertiseDesc}}">
      <view class="ui-section-head">
        <text class="ui-section-title">擅长</text>
      </view>
      <view class="doctor-prose">{{doctor.expertiseDesc}}</view>
    </view>

    <view wx:if="{{doctor.introduction}}">
      <view class="ui-section-head">
        <text class="ui-section-title">医生简介</text>
      </view>
      <view class="doctor-prose">{{doctor.introduction}}</view>
    </view>

    <view wx:if="{{doctor.workExperience}}">
      <view class="ui-section-head">
        <text class="ui-section-title">执业经历</text>
      </view>
      <view class="doctor-prose">{{doctor.workExperience}}</view>
    </view>

    <view wx:if="{{doctor.education}}">
      <view class="ui-section-head">
        <text class="ui-section-title">教育背景</text>
      </view>
      <view class="doctor-prose">{{doctor.education}}</view>
    </view>

    <view wx:if="{{doctor.academicAppointments}}">
      <view class="ui-section-head">
        <text class="ui-section-title">学术任职</text>
      </view>
      <view class="doctor-prose">{{doctor.academicAppointments}}</view>
    </view>

    <view wx:if="{{doctor.qualification}}">
      <view class="ui-section-head">
        <text class="ui-section-title">资质</text>
      </view>
      <view class="doctor-prose">{{doctor.qualification}}</view>
    </view>

    <view wx:if="{{department}}">
      <view class="ui-section-head">
        <text class="ui-section-title">所在科室</text>
        <text class="ui-section-more" bindtap="goDeptDetail">科室详情 ›</text>
      </view>
      <view class="ui-panel">
        <view class="ui-panel-body doctor-dept">
          <view class="doctor-dept-row">
            <view class="ui-plate tiny"><image class="ui-plate-img" src="{{department.deptIcon}}" mode="aspectFit" /></view>
            <view class="doctor-dept-name">{{department.deptName}}</view>
          </view>
          <view class="doctor-dept-desc">{{department.description || department.locationHint}}</view>
          <view class="ui-inst-tags" wx:if="{{department.flagshipText}}">
            <view class="ui-inst-tag ui-inst-tag-gold">{{department.flagshipText}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="doctor-note">
      <view class="ui-eyebrow">就诊须知</view>
      <view class="doctor-note-row">预约成功后请按预约时段到院，提前 30 分钟签到。</view>
      <view class="doctor-note-row">请携带身份证或医保卡；如需取消，请提前 2 小时操作。</view>
    </view>

    <view class="doctor-detail-bottom"></view>
  </view>

  <view class="ui-action-bar" wx:if="{{hasSchedule}}">
    <view class="ui-action-total">挂号费 <text class="ui-num">¥{{doctor.consultationFee || '—'}}</text></view>
    <button class="ui-btn ui-btn-primary" bindtap="makeAppointment">立即预约</button>
  </view>
  <view class="ui-action-bar" wx:else>
    <view class="ui-action-total">今日暂无排班</view>
    <button class="ui-btn ui-btn-outline" bindtap="goDeptDetail">查看科室其他医生</button>
  </view>
</view>

<view class="doctor-loading" wx:if="{{loading}}">
  <view class="ui-skeleton ui-skeleton-card" wx:for="{{[1,2,3]}}" wx:key="index"></view>
</view>
