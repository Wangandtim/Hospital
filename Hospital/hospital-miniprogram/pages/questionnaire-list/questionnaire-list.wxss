.questionnaire-page {
  min-height: 100vh;
  padding-top: 16rpx;
  padding-bottom: 48rpx;
}

.plate-char {
  font-family: var(--font-serif);
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary);
}

.questionnaire-list {
  padding-bottom: var(--s3);
}

.questionnaire-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 28rpx;
}

.patient-info {
  flex: 1;
  min-width: 0;
}

.patient-name {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
  line-height: 1.35;
}

.patient-detail {
  margin-top: 6rpx;
  font-size: var(--fs-caption);
  color: var(--ink-2);
}

/* ---------- 问卷弹层 ---------- */
.questionnaire-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(23, 29, 27, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 40rpx;
}

.modal-content {
  width: 100%;
  max-height: 80vh;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  overflow: hidden;
  box-shadow: var(--shadow-3);
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
}

.modal-title {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-family: var(--font-serif);
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--r-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  line-height: 1;
  color: var(--ink-3);
}

.modal-body {
  padding: 28rpx;
  overflow-y: auto;
}

.patient-header {
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--line);
}

.patient-header .patient-name {
  font-family: var(--font-serif);
}

.patient-meta {
  margin-top: 6rpx;
  font-size: var(--fs-caption);
  color: var(--ink-2);
}

.questionnaire-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.question-answer {
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  border-radius: var(--r-sm);
  padding: 20rpx 22rpx;
}

.question-text {
  font-size: var(--fs-caption);
  font-weight: 600;
  color: var(--ink);
  line-height: 1.6;
  margin-bottom: 10rpx;
}

.answer-text {
  font-size: var(--fs-caption);
  color: var(--ink-2);
  line-height: 1.65;
}
