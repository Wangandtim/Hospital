<view class="container">
  <view class="header">
    <view class="back-btn" bindtap="goBack" hover-class="hover-fade">
      <text>←</text>
    </view>
    <view class="header-title">患者问卷</view>
    <view class="header-count">共 {{questionnaires.length}} 份</view>
  </view>

  <view class="questionnaire-list">
    <view class="questionnaire-item" wx:for="{{questionnaires}}" wx:key="appointmentId" bindtap="viewQuestionnaire" hover-class="hover-fade" data-index="{{index}}">
      <view class="patient-info">
        <view class="patient-name">{{item.patientName || '未知患者'}}</view>
        <view class="patient-detail">{{item.appointmentDate}} · {{item.timeSlot}}</view>
      </view>
      <view class="questionnaire-status">
        <image class="status-tag" src="/images/icons/ic-doc-14b8a6.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{questionnaires.length === 0}}">
    <image class="empty-icon" src="/images/icons/ic-doc-14b8a6.png" mode="aspectFit" />
    <view class="empty-text">暂无患者问卷</view>
  </view>

  <view hover-class="hover-press" hover-stay-time="150" class="questionnaire-modal" wx:if="{{showModal}}" bindtap="closeModal">
    <view hover-class="hover-press" hover-stay-time="150" class="modal-content" catchtap="noop">
      <view class="modal-header">
        <view class="modal-title">
          <image class="modal-title-icon" src="/images/icons/ic-doc-ffffff.png" mode="aspectFit" />
          <text>患者问卷</text>
        </view>
        <image class="modal-close" src="/images/icons/ic-close-ffffff.png" mode="aspectFit" bindtap="closeModal" hover-class="hover-fade" />
      </view>
      <view class="modal-body">
        <view class="patient-header">
          <view class="patient-name">{{currentPatientName}}</view>
          <view class="patient-meta">{{currentAppointmentDate}} · {{currentTimeSlot}}</view>
        </view>
        <view class="questionnaire-content">
          <view class="question-answer" wx:for="{{currentAnswers}}" wx:key="*this" wx:for-item="qa">
            <view class="question-text">Q: {{qa.question}}</view>
            <view class="answer-text">A: {{qa.answer}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
