<view class="ui-page questionnaire-page">
  <view class="ui-back" bindtap="goBack"><text>←</text></view>

  <view class="ui-title-block">
    <view class="ui-eyebrow ui-eyebrow-gold">QUESTIONNAIRES</view>
    <view class="ui-title">患者问卷</view>
    <view class="ui-subtitle">共 {{questionnaires.length}} 份</view>
  </view>

  <view class="questionnaire-list">
    <view class="ui-panel questionnaire-item" wx:for="{{questionnaires}}" wx:key="appointmentId" bindtap="viewQuestionnaire" hover-class="hover-fade" data-index="{{index}}">
      <view class="ui-plate"><text class="plate-char">卷</text></view>
      <view class="patient-info">
        <view class="patient-name">{{item.patientName || '未知患者'}}</view>
        <view class="patient-detail">{{item.appointmentDate}} · {{item.timeSlot}}</view>
      </view>
      <view class="ui-chev">›</view>
    </view>
  </view>

  <view class="ui-empty" wx:if="{{questionnaires.length === 0}}">
    <view class="ui-empty-mark">卷</view>
    <view class="ui-empty-title">暂无患者问卷</view>
  </view>

  <view hover-class="hover-press" hover-stay-time="150" class="questionnaire-modal" wx:if="{{showModal}}" bindtap="closeModal">
    <view hover-class="hover-press" hover-stay-time="150" class="modal-content" catchtap="noop">
      <view class="modal-header">
        <view class="modal-title">
          <view class="ui-plate sm"><text class="plate-char">卷</text></view>
          <text>患者问卷</text>
        </view>
        <view class="modal-close" bindtap="closeModal" hover-class="hover-fade">×</view>
      </view>
      <view class="modal-body">
        <view class="patient-header">
          <view class="patient-name">{{currentPatientName}}</view>
          <view class="patient-meta">{{currentAppointmentDate}} · {{currentTimeSlot}}</view>
        </view>
        <view class="questionnaire-content">
          <view class="question-answer" wx:for="{{currentAnswers}}" wx:key="*this" wx:for-item="qa">
            <view class="question-text">Q: {{qa.question}}</view>
            <view class="answer-text">A: {{qa.answer}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
