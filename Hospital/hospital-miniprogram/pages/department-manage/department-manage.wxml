<view class="ui-page dm-page">
  <view class="dm-top">
    <view class="ui-back" bindtap="goBack" hover-class="hover-fade">←</view>
    <view class="ui-btn ui-btn-primary ui-btn-sm" bindtap="openAddModal" hover-class="hover-scale">＋ 添加</view>
  </view>

  <view class="ui-title-block dm-title">
    <view class="ui-eyebrow ui-eyebrow-gold">DEPARTMENTS</view>
    <view class="ui-title">科室管理</view>
    <view class="ui-subtitle">共 {{departments.length}} 个科室</view>
  </view>

  <view class="dm-filters">
    <picker mode="selector" range="{{hospitalList}}" range-key="hospitalName" bindchange="onHospitalChange">
      <view class="ui-input dm-hospital">
        <text class="dm-hospital-name">{{selectedHospitalName}}</text>
        <text class="ui-chev">▾</text>
      </view>
    </picker>
    <view class="ui-search dm-search">
      <view class="ui-search-ico"></view>
      <input class="dm-search-input" placeholder="搜索科室名称" bindinput="onSearchInput" value="{{searchKeyword}}" />
    </view>
  </view>

  <view class="dm-list" wx:if="{{departments.length > 0}}">
    <view class="ui-panel dm-card" wx:for="{{departments}}" wx:key="deptId">
      <view class="dm-head">
        <view class="ui-plate">
          <image class="ui-plate-img" src="{{item.deptIcon}}" mode="aspectFit" />
        </view>
        <view class="dm-head-main">
          <view class="dm-name">{{item.deptName}}</view>
          <view class="ui-tag dm-hospital-tag">{{item.hospitalName}}</view>
        </view>
      </view>
      <view class="dm-info">
        <view class="dm-info-row" wx:if="{{item.description}}">
          <text class="dm-info-label">简介</text>
          <text class="dm-info-value">{{item.description}}</text>
        </view>
        <view class="dm-info-row" wx:if="{{item.diseases}}">
          <text class="dm-info-label">诊疗范围</text>
          <text class="dm-info-value">{{item.diseases}}</text>
        </view>
        <view class="dm-info-row" wx:if="{{item.serviceTime}}">
          <text class="dm-info-label">门诊时间</text>
          <text class="dm-info-value">{{item.serviceTime}}</text>
        </view>
      </view>
      <view class="dm-actions">
        <view class="ui-btn ui-btn-outline ui-btn-sm" bindtap="openEditModal" data-dept="{{item}}" hover-class="hover-fade">编辑</view>
        <view class="ui-btn ui-btn-danger ui-btn-sm" bindtap="deleteDepartment" data-dept="{{item}}" hover-class="hover-fade">删除</view>
      </view>
    </view>
  </view>

  <view class="ui-empty" wx:if="{{departments.length === 0}}">
    <view class="ui-empty-mark">科</view>
    <view class="ui-empty-title">暂无科室数据</view>
    <view class="ui-empty-hint">添加科室，或切换医院后再查看</view>
  </view>

  <view class="dm-mask" wx:if="{{showAddModal}}" bindtap="closeModal"></view>
  <view class="dm-sheet" wx:if="{{showAddModal}}">
    <view class="dm-sheet-head">
      <view class="dm-sheet-title">{{editingDept ? '编辑科室' : '添加科室'}}</view>
      <view class="ui-icon-btn dm-close" bindtap="closeModal" hover-class="hover-fade">×</view>
    </view>
    <view class="dm-sheet-body">
      <view class="ui-field" wx:if="!editingDept">
        <view class="ui-field-label">所属医院 *</view>
        <picker mode="selector" range="{{hospitalList}}" range-key="hospitalName" bindchange="onHospitalSelectChange">
          <view class="ui-input dm-hospital">
            <text class="dm-hospital-name">{{selectedHospitalNameForModal || '请选择医院'}}</text>
            <text class="ui-chev">▾</text>
          </view>
        </picker>
      </view>
      <view class="ui-field">
        <view class="ui-field-label">科室名称 *</view>
        <view class="dm-name-field">
          <view class="ui-plate">
            <image class="ui-plate-img" src="{{formDeptIcon}}" mode="aspectFit" />
          </view>
          <input class="ui-input dm-name-input" data-field="deptName" bindinput="onFormInput" value="{{formData.deptName}}" placeholder="请输入科室名称" />
        </view>
      </view>
      <view class="ui-field">
        <view class="ui-field-label">科室简介</view>
        <textarea class="ui-textarea" data-field="description" bindinput="onFormInput" value="{{formData.description}}" placeholder="填写科室简介" />
      </view>
      <view class="ui-field">
        <view class="ui-field-label">诊疗范围</view>
        <textarea class="ui-textarea" data-field="diseases" bindinput="onFormInput" value="{{formData.diseases}}" placeholder="多个方向用逗号或换行分隔" />
      </view>
      <view class="ui-field">
        <view class="ui-field-label">门诊时间</view>
        <textarea class="ui-textarea" data-field="serviceTime" bindinput="onFormInput" value="{{formData.serviceTime}}" placeholder="每行一个时段，例如：周一至周五 08:00–12:00" />
      </view>
    </view>
    <view class="dm-sheet-actions">
      <button class="ui-btn ui-btn-outline" bindtap="closeModal" hover-class="hover-fade">取消</button>
      <button class="ui-btn ui-btn-primary" bindtap="submitDepartment" hover-class="hover-scale">保存</button>
    </view>
  </view>
</view>
