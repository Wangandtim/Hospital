<view class="container">
  <view class="header">
    <view class="back-btn" bindtap="goBack" hover-class="hover-fade">
      <text class="back-icon">←</text>
    </view>
    <view class="title">科室管理</view>
    <view class="add-btn" bindtap="openAddModal" hover-class="hover-scale">+ 添加</view>
  </view>

  <view class="filter-section">
    <view class="hospital-picker">
      <picker mode="selector" range="{{hospitalList}}" range-key="hospitalName" bindchange="onHospitalChange">
        <view class="picker-value">
          <text>{{selectedHospitalName}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>
    <view class="search-bar">
      <input class="search-input" placeholder="搜索科室名称/编码" bindinput="onSearchInput" value="{{searchKeyword}}" />
    </view>
  </view>

  <view class="dept-list" wx:if="{{departments.length > 0}}">
    <view class="dept-card" wx:for="{{departments}}" wx:key="deptId">
      <view class="dept-header">
        <view class="dept-name">{{item.deptName}}</view>
        <view class="hospital-tag">{{item.hospitalName}}</view>
      </view>
      <view class="dept-body">
        <view class="dept-info-row">
          <text class="info-label">编码：</text>
          <text class="info-value">{{item.deptCode || '无'}}</text>
        </view>
        <view class="dept-info-row">
          <text class="info-label">负责人：</text>
          <text class="info-value">{{item.manager || '无'}}</text>
        </view>
        <view class="dept-info-row">
          <text class="info-label">电话：</text>
          <text class="info-value">{{item.phone || '无'}}</text>
        </view>
        <view class="dept-info-row" wx:if="{{item.description}}">
          <text class="info-label">描述：</text>
          <text class="info-value">{{item.description}}</text>
        </view>
      </view>
      <view class="dept-footer">
        <view class="action-btn action-edit" bindtap="openEditModal" data-dept="{{item}}" hover-class="hover-fade">编辑</view>
        <view class="action-btn action-delete" bindtap="deleteDepartment" data-dept="{{item}}" hover-class="hover-fade">删除</view>
      </view>
    </view>
  </view>

  <view class="empty-tip" wx:if="{{departments.length === 0}}">
    <text>暂无科室数据</text>
  </view>

  <view class="modal" wx:if="{{showAddModal}}">
    <view hover-class="hover-press" hover-stay-time="150" class="modal-mask" bindtap="closeModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text>{{editingDept ? '编辑科室' : '添加科室'}}</text>
        <view class="modal-close" bindtap="closeModal" hover-class="hover-fade">
          <image class="modal-close-icon" src="/images/icons/ic-close-94aeab.png" mode="aspectFit" />
        </view>
      </view>
      <view class="modal-body">
        <view class="form-item" wx:if="!editingDept">
          <view class="form-label">所属医院 *</view>
          <picker mode="selector" range="{{hospitalList}}" range-key="hospitalName" bindchange="onHospitalSelectChange">
            <view class="picker-value">{{selectedHospitalNameForModal || '请选择医院'}}</view>
          </picker>
        </view>
        <view class="form-item">
          <view class="form-label">科室名称 *</view>
          <input class="form-input" data-field="deptName" bindinput="onFormInput" value="{{formData.deptName}}" placeholder="请输入科室名称" />
        </view>
        <view class="form-item">
          <view class="form-label">科室编码</view>
          <input class="form-input" data-field="deptCode" bindinput="onFormInput" value="{{formData.deptCode}}" placeholder="请输入科室编码" />
        </view>
        <view class="form-item">
          <view class="form-label">负责人</view>
          <input class="form-input" data-field="manager" bindinput="onFormInput" value="{{formData.manager}}" placeholder="请输入负责人姓名" />
        </view>
        <view class="form-item">
          <view class="form-label">联系电话</view>
          <input class="form-input" data-field="phone" bindinput="onFormInput" value="{{formData.phone}}" placeholder="请输入联系电话" />
        </view>
        <view class="form-item">
          <view class="form-label">科室描述</view>
          <textarea class="form-textarea" data-field="description" bindinput="onFormInput" value="{{formData.description}}" placeholder="请输入科室描述" />
        </view>
      </view>
      <view class="modal-footer">
        <button class="btn-cancel" bindtap="closeModal" hover-class="hover-fade">取消</button>
        <button class="btn-confirm" bindtap="submitDepartment" hover-class="hover-scale">保存</button>
      </view>
    </view>
  </view>
</view>