.dm-page { padding-top: 8rpx; padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }

.dm-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-top: 24rpx;
}
.dm-top .ui-back { margin-bottom: 0; }

.dm-title { padding-top: 24rpx; }

.dm-filters {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.dm-hospital {
  justify-content: space-between;
  gap: 12rpx;
}

.dm-hospital-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.dm-search { height: 96rpx; }

.dm-search-input {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  color: var(--ink);
}

.dm-list { display: flex; flex-direction: column; gap: 20rpx; }

.dm-card { margin-bottom: 0; }

.dm-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 26rpx;
  border-bottom: 1rpx solid var(--line);
}

.dm-head-main { flex: 1; min-width: 0; }

.dm-name {
  font-family: var(--font-serif);
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
  line-height: 1.35;
}

.dm-hospital-tag { margin-top: 8rpx; }

.dm-info { padding: 4rpx 26rpx; }

.dm-info-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  min-height: 96rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.dm-info-row:last-child { border-bottom: none; }

.dm-info-label {
  width: 130rpx;
  flex-shrink: 0;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  line-height: 1.6;
}

.dm-info-value {
  flex: 1;
  font-size: var(--fs-caption);
  color: var(--ink);
  line-height: 1.6;
  word-break: break-all;
}

.dm-actions {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 26rpx 24rpx;
  border-top: 1rpx solid var(--line);
}
.dm-actions .ui-btn { flex: 1; }

.dm-mask {
  position: fixed;
  inset: 0;
  background: rgba(23, 29, 27, 0.48);
  z-index: 30;
}

.dm-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 88vh;
  overflow-y: auto;
  background: var(--surface);
  border-radius: var(--r-lg) var(--r-lg) 0 0;
  padding: 30rpx var(--gutter) calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  z-index: 40;
  animation: ui-rise 0.24s ease both;
}

.dm-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 24rpx;
}

.dm-sheet-title {
  font-family: var(--font-serif);
  font-size: var(--fs-h2);
  color: var(--ink);
}

.dm-close { flex-shrink: 0; }

.dm-sheet-body { padding-bottom: 8rpx; }

.dm-name-field {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.dm-name-input {
  flex: 1;
  min-width: 0;
  width: 100%;
  box-sizing: border-box;
}

.dm-sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}
.dm-sheet-actions .ui-btn { flex: 1; }
