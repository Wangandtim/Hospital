page {
  background: #f0fdfa;
  min-height: 100vh;
}

.container {
  padding: 32rpx;
  padding-bottom: 140rpx;
}

/* 医院横幅样式 */
.hospital-banner {
  margin-bottom: 36rpx;
  background: linear-gradient(135deg, #0d9488 0%, #14b8a6 55%, #2dd4bf 100%);
  color: white;
  padding: 48rpx;
  border-radius: 36rpx;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.22);
  position: relative;
  overflow: hidden;
}

.hospital-banner::before {
  content: '';
  position: absolute;
  top: -60%;
  right: -30%;
  width: 280rpx;
  height: 280rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 50%;
  animation: pulse 4s ease-in-out infinite;
}

.hospital-banner::after {
  content: '';
  position: absolute;
  bottom: -40%;
  left: -20%;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 0.12; }
  50% { transform: scale(1.2); opacity: 0.18; }
}

.hospital-banner .hospital-name {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 1;
  letter-spacing: 2rpx;
}

.hospital-banner .hospital-level {
  font-size: 26rpx;
  background: rgba(255, 255, 255, 0.22);
  padding: 8rpx 20rpx;
  border-radius: 32rpx;
  display: inline-flex; align-items: center; justify-content: center;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 1;
  backdrop-filter: blur(12px);
  font-weight: 500;
}

.hospital-banner .hospital-address {
  font-size: 28rpx;
  opacity: 0.95;
  line-height: 1.7;
  position: relative;
  z-index: 1;
}

/* 进度条样式 */
.progress-container {
  padding: 48rpx 0 36rpx;
  margin-bottom: 24rpx;
}

.progress-bar {
  position: relative;
  height: 10rpx;
  background: #e6fffa;
  border-radius: 8rpx;
  margin-bottom: 40rpx;
  border: 2rpx solid #ccfbf1;
}

.progress-line {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  background: linear-gradient(90deg, #0d9488 0%, #14b8a6 50%, #2dd4bf 100%);
  border-radius: 8rpx;
  transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 0 16rpx rgba(13, 148, 136, 0.4);
}

.progress-steps {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.progress-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  flex: 1;
}

.step-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #94aeab;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  border: 4rpx solid #e6fffa;
  box-shadow: 0 6rpx 16rpx rgba(13, 148, 136, 0.1);
  box-sizing: border-box;
}

.step-check {
  width: 36rpx;
  height: 36rpx;
}

.progress-step.active .step-icon {
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  color: white;
  transform: scale(1.2);
  box-shadow: 0 10rpx 24rpx rgba(13, 148, 136, 0.35);
  border-color: rgba(255, 255, 255, 0.5);
}

.progress-step.done .step-icon {
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  color: white;
  box-shadow: 0 6rpx 16rpx rgba(13, 148, 136, 0.3);
  border-color: rgba(255, 255, 255, 0.5);
}

.step-text {
  font-size: 26rpx;
  color: #94aeab;
  text-align: center;
  line-height: 1.5;
  transition: all 0.3s ease;
  font-weight: 500;
}

.progress-step.active .step-text {
  color: #0f766e;
  font-weight: 600;
  font-size: 28rpx;
}

.progress-step.done .step-text {
  color: #14b8a6;
  font-weight: 600;
  font-size: 28rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 36rpx;
  color: #143634;
  position: relative;
  padding-left: 24rpx;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 36rpx;
  background: linear-gradient(180deg, #14b8a6 0%, #0d9488 100%);
  border-radius: 8rpx;
  box-shadow: 0 0 12rpx rgba(13, 148, 136, 0.35);
}

.dept-list, .doctor-list {
  margin-bottom: 36rpx;
}

.dept-item, .doctor-item {
  padding: 36rpx;
  background: #ffffff;
  border-radius: 36rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #e6fffa;
  transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.14);
}

.dept-item.selected, .doctor-item.selected {
  border-color: #14b8a6;
  background: #ecfdf9;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.2);
}

.dept-selected-fixed {
  margin-bottom: 36rpx;
}

.dept-selected-item {
  background: #ecfdf9;
  border: 1rpx solid #ccfbf1;
  border-radius: 36rpx;
  padding: 36rpx;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.14);
}

.dept-name, .doctor-name {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
  color: #143634;
}

.dept-desc, .doctor-title {
  font-size: 28rpx;
  color: #5b7c7a;
  line-height: 1.6;
}

.doctor-item {
  display: flex;
  align-items: center;
}

.doctor-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(13, 148, 136, 0.3);
  position: relative;
  flex-shrink: 0;
}

.avatar-img {
  width: 64rpx;
  height: 64rpx;
}

.doctor-avatar::after {
  content: '';
  position: absolute;
  inset: 6rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.doctor-info {
  flex: 1;
}

.doctor-expertise {
  font-size: 26rpx;
  color: #94aeab;
  margin-top: 10rpx;
}

.doctor-fee {
  font-size: 32rpx;
  color: #ef4444;
  margin-top: 12rpx;
  font-weight: 600;
}

.doctor-schedule-status {
  margin-left: 20rpx;
}

.no-schedule-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #0f766e;
  background: #ecfdf9;
  padding: 10rpx 24rpx;
  border-radius: 42rpx;
  border: 1rpx solid #ccfbf1;
  font-weight: 500;
}

.no-schedule-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #5b7c7a;
  font-size: 28rpx;
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 26rpx;
  border: 1rpx solid #e6fffa;
  box-shadow: 0 8rpx 20rpx rgba(13, 148, 136, 0.08);
}

.hint-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.75;
  flex-shrink: 0;
}

.date-picker {
  background: #ffffff;
  border-radius: 36rpx;
  padding: 36rpx;
  margin-bottom: 36rpx;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.14);
  border: 1rpx solid #e6fffa;
}

.date-display {
  font-size: 36rpx;
  text-align: center;
  color: #143634;
  font-weight: 600;
}

.time-slots {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-bottom: 36rpx;
}

.time-slot {
  position: relative;
  background: #ffffff;
  border-radius: 26rpx;
  padding: 28rpx 20rpx;
  text-align: center;
  font-size: 28rpx;
  border: 1rpx solid #e6fffa;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 6rpx 18rpx rgba(13, 148, 136, 0.1);
  font-weight: 500;
  color: #143634;
}

.time-slot.selected {
  border-color: #14b8a6;
  background: #ecfdf9;
  color: #0f766e;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(13, 148, 136, 0.2);
}

.time-slot.disabled {
  background: #f4fbfa;
  color: #94aeab;
  border-color: #e6fffa;
}

.time-slot.disabled::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 15%;
  right: 15%;
  height: 2rpx;
  background: #cbd5e1;
  transform: rotate(-15deg);
}

.schedule-warning {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 26rpx;
  margin-bottom: 30rpx;
  border: 1rpx solid #e6fffa;
  box-shadow: 0 10rpx 24rpx rgba(13, 148, 136, 0.1);
}

.warning-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  opacity: 0.75;
}

.warning-text {
  font-size: 28rpx;
  color: #5b7c7a;
  line-height: 1.6;
}

.no-schedule {
  text-align: center;
  padding: 80rpx;
  color: #94aeab;
  font-size: 30rpx;
  background: #ffffff;
  border-radius: 36rpx;
  border: 1rpx dashed #ccfbf1;
}

.confirm-card {
  background: #ffffff;
  border-radius: 36rpx;
  padding: 40rpx;
  margin-bottom: 36rpx;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.14);
  border: 1rpx solid #e6fffa;
}

.confirm-item {
  display: flex;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0fdfa;
  align-items: center;
}

.confirm-item:last-child {
  border-bottom: none;
}

.confirm-item .label {
  color: #5b7c7a;
  width: 180rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.confirm-item .value {
  color: #143634;
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-group {
  display: flex;
  gap: 28rpx;
  /* 底部操作区避让 iPhone 底部指示条 */
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
}

.btn-next, .btn-prev, .btn-submit, .btn-pay, .btn-back, .btn-skip {
  flex: 1;
  padding: 32rpx;
  border-radius: 26rpx;
  font-size: 34rpx;
  border: none;
  font-weight: 600;
  transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.btn-next, .btn-submit {
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  color: white;
  box-shadow: 0 10rpx 24rpx rgba(13, 148, 136, 0.3);
}

.btn-next::after, .btn-submit::after {
  border: none;
}

.btn-prev {
  background: #ffffff;
  color: #5b7c7a;
  border: 1rpx solid #e6fffa;
  box-shadow: 0 6rpx 18rpx rgba(13, 148, 136, 0.08);
}

.btn-skip {
  background: #f4fbfa;
  color: #94aeab;
  border: 1rpx solid #e6fffa;
}

.fee-item {
  border-top: 1rpx dashed #e6fffa;
  padding-top: 36rpx;
  margin-top: 16rpx;
}

.fee {
  color: #ef4444;
  font-size: 48rpx;
  font-weight: 700;
}

.payment-card {
  background: #ffffff;
  border-radius: 36rpx;
  padding: 48rpx;
  margin-bottom: 36rpx;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.14);
  border: 1rpx solid #e6fffa;
}

.payment-amount {
  text-align: center;
  padding: 24rpx 0 40rpx;
  border-bottom: 1rpx solid #f0fdfa;
  margin-bottom: 32rpx;
}

.amount-label {
  font-size: 30rpx;
  color: #5b7c7a;
  display: block;
  margin-bottom: 16rpx;
}

.amount-value {
  font-size: 64rpx;
  color: #ef4444;
  font-weight: 700;
}

.payment-info {
  background: #f0fdfa;
  border-radius: 26rpx;
  padding: 28rpx;
  margin-bottom: 36rpx;
}

.payment-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx dashed #e6fffa;
}

.payment-item:last-child {
  border-bottom: none;
}

.payment-item .label {
  font-size: 30rpx;
  color: #5b7c7a;
  font-weight: 500;
}

.payment-item .value {
  font-size: 30rpx;
  color: #143634;
  font-weight: 600;
  max-width: 60%;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.payment-methods {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.method-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #143634;
}

.method-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.method-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border: 1rpx solid #e6fffa;
  border-radius: 32rpx;
  background: #ffffff;
  transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

.method-item.selected {
  border-color: #14b8a6;
  background: #ecfdf9;
  box-shadow: 0 8rpx 20rpx rgba(13, 148, 136, 0.14);
}

.method-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.method-info {
  flex: 1;
}

.method-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #143634;
  margin-bottom: 8rpx;
}

.method-desc {
  font-size: 26rpx;
  color: #94aeab;
}

.method-check {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

/* 问卷样式 */
.questionnaire-desc {
  font-size: 28rpx;
  color: #5b7c7a;
  margin-bottom: 36rpx;
  line-height: 1.7;
  background: #f0fdfa;
  padding: 28rpx;
  border-radius: 26rpx;
  border-left: 6rpx solid #14b8a6;
}

.questionnaire {
  background: #ffffff;
  border-radius: 36rpx;
  padding: 40rpx;
  margin-bottom: 36rpx;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.14);
  border: 1rpx solid #e6fffa;
}

.question-item {
  margin-bottom: 56rpx;
  padding-bottom: 40rpx;
  border-bottom: 1rpx solid #f0fdfa;
}

.question-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.question-pager {
  text-align: center;
  margin-bottom: 20rpx;
}

.pager-info {
  font-size: 24rpx;
  color: #94aeab;
}

.question-label {
  font-size: 30rpx;
  color: #143634;
  font-weight: 600;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
}

.radio-option, .checkbox-option {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #f0fdfa;
  border-radius: 22rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #e6fffa;
  transition: all 0.3s ease;
}

/* 选项较多的多选题用两列布局，压缩高度避免超出屏幕 */
.option-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.option-grid .checkbox-option {
  width: calc(50% - 6rpx);
  box-sizing: border-box;
  margin-bottom: 0;
}

.radio-option text, .checkbox-option text {
  font-size: 28rpx;
  color: #143634;
  margin-left: 16rpx;
}

.radio-option radio, .checkbox-option checkbox {
  transform: scale(1.2);
}

.question-textarea {
  width: 100%;
  height: 200rpx;
  padding: 28rpx;
  background: #f0fdfa;
  border-radius: 22rpx;
  border: 1rpx solid #e6fffa;
  font-size: 28rpx;
  color: #143634;
  box-sizing: border-box;
}

/* 预约成功页面样式 */
.success-page {
  min-height: 100vh;
  background: #f0fdfa;
  padding: 32rpx;
  padding-bottom: 140rpx;
}

/* 顶部成功区域 */
.success-header {
  text-align: center;
  padding: 60rpx 0 80rpx;
}

.success-ring {
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto 40rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-ring::before {
  content: '';
  position: absolute;
  inset: -20rpx;
  background: linear-gradient(135deg, #14b8a6 0%, #2dd4bf 50%, #99f6e4 100%);
  border-radius: 50%;
  animation: ringPulse 1.5s ease-out infinite;
  opacity: 0.6;
}

@keyframes ringPulse {
  0% {
    transform: scale(1);
    opacity: 0.6;
  }
  100% {
    transform: scale(1.4);
    opacity: 0;
  }
}

.success-icon {
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  border-radius: 50%;
  position: relative;
  z-index: 1;
  padding: 52rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.35);
}

.success-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #143634;
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
}

.success-subtitle {
  font-size: 28rpx;
  color: #5b7c7a;
  line-height: 1.6;
}

/* 预约卡片 */
.appointment-card {
  background: #ffffff;
  border-radius: 36rpx;
  box-shadow: 0 16rpx 36rpx rgba(13, 148, 136, 0.14);
  overflow: hidden;
  margin-bottom: 40rpx;
  border: 1rpx solid #e6fffa;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 40rpx;
  background: #ecfdf9;
  border-bottom: 1rpx solid #ccfbf1;
}

.card-title {
  display: flex;
  align-items: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #143634;
}

.title-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.card-badge {
  padding: 10rpx 24rpx;
  border-radius: 42rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.card-badge.success {
  background: #ecfdf9;
  border: 1rpx solid #ccfbf1;
  color: #0f766e;
}

/* 卡片内容 */
.card-content {
  padding: 36rpx 40rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx dashed #f0fdfa;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-row.highlight {
  background: #ecfdf9;
  margin: 16rpx -40rpx;
  padding: 28rpx 40rpx;
  border-bottom: none;
}

.detail-label {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: #5b7c7a;
  font-weight: 500;
}

.label-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.detail-value {
  font-size: 30rpx;
  color: #143634;
  font-weight: 600;
  text-align: right;
  max-width: 50%;
  word-break: break-all;
}

.detail-value.code {
  font-family: monospace;
  font-size: 26rpx;
  color: #0f766e;
}

.detail-value.time {
  font-size: 32rpx;
  color: #0f766e;
  font-weight: 700;
}

.detail-value.fee {
  font-size: 36rpx;
  color: #ef4444;
  font-weight: 700;
}

/* 卡片底部提示 */
.card-footer {
  padding: 28rpx 40rpx;
  background: #f0fdfa;
  border-top: 1rpx solid #e6fffa;
}

.footer-tip {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #5b7c7a;
}

.tip-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 28rpx;
}

.btn-primary, .btn-secondary 
{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding: 32rpx;
  border-radius: 32rpx;
  font-size: 34rpx;
  border: none;
  font-weight: 600;
  transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.btn-primary {
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  color: white;
  box-shadow: 0 10rpx 24rpx rgba(13, 148, 136, 0.3);
}

.btn-secondary {
  background: #ffffff;
  color: #5b7c7a;
  border: 1rpx solid #e6fffa;
}

.btn-pay {
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  color: white;
  box-shadow: 0 10rpx 24rpx rgba(13, 148, 136, 0.3);
}

.btn-back {
  background: #ffffff;
  color: #5b7c7a;
  border: 1rpx solid #e6fffa;
}

/* 底部按钮固定定位 */
.btn-fixed-bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 -4rpx 20rpx rgba(13, 148, 136, 0.08);
  border-top: 1rpx solid #e6fffa;
}

/* 分割线 */
.divider {
  height: 24rpx;
  background: linear-gradient(90deg, transparent 0%, #e6fffa 50%, transparent 100%);
  margin: 24rpx 0;
}

/* 空状态 */
.empty-state {
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 32rpx;
  display: block;
  opacity: 0.6;
}

.empty-text {
  font-size: 30rpx;
  color: #94aeab;
  font-weight: 500;
}

.empty-hint {
  font-size: 26rpx;
  color: #94aeab;
  margin-top: 16rpx;
}
