.appt { min-height: 100vh; }
.appt-page { padding-top: 16rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }

.appt-brand { display: flex; align-items: baseline; justify-content: space-between; }
.appt-brand-word { font-size: 34rpx; letter-spacing: 0.08em; color: #171D1B; }
.appt-brand-sub { font-size: 22rpx; color: #8A938F; letter-spacing: 0.12em; }

.appt-hospital { margin-top: 12rpx; }
.appt-hospital-name { font-size: 26rpx; color: #4B5652; }
.appt-hospital-meta { font-size: 22rpx; color: #8A938F; margin-top: 2rpx; }

.appt-step { margin-top: 8rpx; }

.appt-pick {
  flex-shrink: 0;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid #D4D7D0;
  color: #8A938F;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.appt-pick-on { border-color: #0F5B50; color: #0F5B50; background: #EFF4F1; }

.appt-actions { display: flex; gap: 16rpx; margin-top: 32rpx; }
.appt-actions .ui-btn { flex: 1; }

.appt-hint { font-size: 24rpx; color: #A64842; text-align: center; margin-top: 16rpx; }
.appt-skip { text-align: center; font-size: 24rpx; color: #87672F; margin-top: 20rpx; }

/* 问卷 */
.appt-question + .appt-question { margin-top: 28rpx; padding-top: 24rpx; border-top: 1rpx solid #EFEEE8; }
.appt-question-label { font-size: 30rpx; color: #171D1B; line-height: 1.6; margin-bottom: 14rpx; }
.appt-choice {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #4B5652;
}
.appt-choice-grid { display: grid; grid-template-columns: repeat(2, 1fr); column-gap: 16rpx; }
.appt-question-page { text-align: center; font-size: 22rpx; color: #8A938F; margin-top: 20rpx; }
.appt-textarea { min-height: 180rpx; margin-top: 8rpx; }

/* 日期 */
.appt-date-rail { display: flex; gap: 12rpx; overflow-x: auto; padding: 4rpx 0 12rpx; }
.appt-date-chip {
  flex-shrink: 0;
  width: 108rpx;
  padding: 16rpx 0;
  border-radius: 18rpx;
  border: 1rpx solid #E5E5DE;
  background: #FFFDFA;
  text-align: center;
}
.appt-date-chip-on { border-color: #0F5B50; background: #0F5B50; }
.appt-date-label { font-size: 22rpx; color: #8A938F; }
.appt-date-day { font-family: "Songti SC", serif; font-size: 34rpx; color: #171D1B; margin-top: 2rpx; }
.appt-date-chip-on .appt-date-label { color: rgba(255, 255, 255, 0.8); }
.appt-date-chip-on .appt-date-day { color: #FFFFFF; }

.appt-date-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 92rpx;
  padding: 0 24rpx;
  background: #FFFDFA;
  border: 1rpx solid #E5E5DE;
  border-radius: 24rpx;
}
.appt-date-picker-label { font-size: 26rpx; color: #8A938F; }
.appt-date-picker-value { font-size: 30rpx; color: #171D1B; }

/* 时段 */
.appt-slot-groups { margin-top: 8rpx; }
.appt-flow { margin: 8rpx calc(-1 * var(--gutter)) 0; }
.appt-summary-dept { display: flex; align-items: center; gap: 16rpx; }
.appt-summary-main { flex: 1; min-width: 0; }
.appt-ticket-dept-row { display: flex; align-items: center; gap: 10rpx; }
.appt-ticket-dept-ico { width: 34rpx; height: 34rpx; display: block; flex-shrink: 0; }
.appt-slot-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }
.appt-slot {
  height: 104rpx;
  padding: 0;
  border-radius: 12rpx;
  border: 1rpx solid var(--line);
  background: var(--surface);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.appt-slot-time { font-size: var(--fs-caption); font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; }
.appt-slot-state { font-size: var(--fs-micro); color: var(--ink-3); }
.appt-slot-on { border-color: var(--primary); background: var(--primary); }
.appt-slot-on .appt-slot-time { color: #fff; }
.appt-slot-on .appt-slot-state { color: #DFEDE9; }
.appt-slot-on .appt-slot-state::before {
  content: ""; display: inline-block; width: 12rpx; height: 6rpx; margin-right: 6rpx;
  border-left: 2rpx solid #fff; border-bottom: 2rpx solid #fff;
  transform: rotate(-45deg); vertical-align: 2rpx;
}
.appt-slot-off { background: var(--surface-2); border-color: var(--line); }
.appt-slot-off .appt-slot-time { color: var(--ink-4); font-weight: 500; }
.appt-slot-off .appt-slot-state { color: var(--ink-4); }
.appt-slot-off .appt-slot-state::before {
  content: ""; display: inline-block; width: 12rpx; height: 12rpx; margin-right: 6rpx;
  border: 1rpx solid var(--ink-4); border-radius: 50%; vertical-align: -2rpx;
  background: linear-gradient(45deg, transparent 42%, var(--ink-4) 42%, var(--ink-4) 58%, transparent 58%);
}

/* 确认 */
.appt-receipt { margin-top: 8rpx; }
.appt-fee-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 4rpx;
  border-bottom: 1rpx solid #E5E5DE;
}

/* 支付 */
.appt-pay-hero { text-align: center; padding: 40rpx 0 24rpx; }
.appt-pay-amount { font-family: "Songti SC", serif; font-size: 80rpx; line-height: 1.2; color: #171D1B; margin-top: 8rpx; }
.appt-pay-desc { font-size: 24rpx; color: #8A938F; margin-top: 10rpx; line-height: 1.6; }
.appt-pay-meta { background: #FFFDFA; border: 1rpx solid #E5E5DE; border-radius: 20rpx; padding: 8rpx 24rpx; }
.appt-pay-meta-row { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 0; font-size: 26rpx; color: #4B5652; }
.appt-pay-meta-row + .appt-pay-meta-row { border-top: 1rpx solid #EFEEE8; }
.appt-pay-meta-row text:last-child { color: #171D1B; }

.appt-method { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 26rpx; }
.appt-method + .appt-method { border-top: 1rpx solid #E5E5DE; }
.appt-method-main { flex: 1; }
.appt-method-on { background: #F8FBF9; }
.appt-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #D4D7D0;
  flex-shrink: 0;
  position: relative;
}
.appt-radio-on { border-color: #0F5B50; }
.appt-radio-on::after {
  content: "";
  position: absolute;
  inset: 8rpx;
  border-radius: 50%;
  background: #0F5B50;
}

/* 成功 */
.appt-success { text-align: center; padding-top: 40rpx; }
.appt-success-mark {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #EFF4F1;
  border: 1rpx solid #D3E2DC;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}
.appt-success-check {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #0F5B50;
  color: #fff;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.appt-success-title { font-size: 64rpx; line-height: 1.25; margin-top: 10rpx; letter-spacing: -0.03em; }
.appt-success-sub { font-size: 26rpx; color: #8A938F; line-height: 1.75; margin-top: 12rpx; }

.appt-ticket {
  margin-top: 36rpx;
  background: #FFFDFA;
  border: 1rpx solid #E5E5DE;
  border-radius: 28rpx;
  text-align: left;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(23, 29, 27, 0.06);
}
.appt-ticket-top { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 26rpx 12rpx; }
.appt-ticket-hospital { font-size: 26rpx; color: #4B5652; }
.appt-ticket-main { padding: 0 26rpx 24rpx; }
.appt-ticket-doctor { font-family: "Songti SC", serif; font-size: 44rpx; color: #171D1B; }
.appt-ticket-title { font-family: inherit; font-size: 24rpx; color: #8A938F; margin-left: 10rpx; }
.appt-ticket-dept { font-size: 26rpx; color: #4B5652; margin-top: 6rpx; }
.appt-ticket-code { margin-top: 18rpx; }
.appt-ticket-id { font-size: 36rpx; color: #171D1B; letter-spacing: 0.04em; margin-top: 4rpx; }
.appt-ticket-cut {
  position: relative;
  height: 36rpx;
  margin: 0 26rpx;
  border-top: 1rpx dashed var(--line-strong);
}
.appt-ticket-cut::before, .appt-ticket-cut::after {
  content: "";
  position: absolute;
  top: -18rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--paper);
  border: 1rpx solid var(--line);
}
.appt-ticket-cut::before { left: -44rpx; }
.appt-ticket-cut::after { right: -44rpx; }
.appt-ticket-foot { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 20rpx 26rpx 24rpx; }
.appt-ticket-fee { font-size: 26rpx; color: #87672F; }
.appt-ticket-tip { font-size: 22rpx; color: #8A938F; text-align: right; }

.appt-bottom { height: 40rpx; }

.elderly .appt-date-chip { width: 128rpx; padding: 20rpx 0; }
.elderly .appt-slot { height: 128rpx; }
.elderly .appt-slot-time { font-size: 30rpx; }
.elderly .appt-slot-state { font-size: 26rpx; }
.elderly .appt-pick { height: 68rpx; font-size: 28rpx; }
