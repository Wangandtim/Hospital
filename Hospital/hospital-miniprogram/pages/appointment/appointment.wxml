<view class="appt {{elderly ? 'elderly' : ''}}">
  <view class="ui-page appt-page">
    <view class="appt-brand">
      <view class="appt-brand-word ui-serif">健康联防</view>
      <view class="appt-brand-sub">预约挂号</view>
    </view>

    <view class="appt-hospital" wx:if="{{currentHospital}}">
      <view class="appt-hospital-name">{{currentHospital.hospitalName}}</view>
      <view class="appt-hospital-meta">{{currentHospital.campus}} · 门诊 {{currentHospital.serviceTime}}</view>
    </view>

    <ui-process
      steps="{{['选科室','选医生','选时段','确认','完成']}}"
      current="{{step <= 1 ? 0 : (step === 2 || step === 3) ? 1 : step === 4 ? 2 : step <= 6 ? 3 : 4}}"
    />

    <!-- 步骤1：选择科室 -->
    <view class="appt-step" wx:if="{{step === 1}}">
      <view class="ui-title-block">
        <view class="ui-eyebrow ui-eyebrow-gold">STEP 1</view>
        <view class="ui-title">先选一个科室</view>
        <view class="ui-subtitle">按今日出诊与余号排序</view>
      </view>

      <view wx:if="{{selectedDept && selectedDoctor}}" class="ui-panel">
        <view class="ui-panel-body">
          <view class="ui-row-title">{{selectedDept.deptName}}</view>
          <view class="ui-row-desc">{{selectedDept.description || selectedDept.locationHint}}</view>
        </view>
      </view>

      <view wx:else>
        <view class="ui-dept-row" wx:for="{{departments}}" wx:key="deptId" bindtap="selectDept" data-dept="{{item}}" hover-class="hover-fade">
          <view class="ui-dept-ico">{{item.initial}}</view>
          <view class="ui-dept-row-main">
            <view class="ui-dept-row-name">{{item.deptName}}</view>
            <view class="ui-dept-row-sub">今日 {{item.todayDoctors}} 位出诊 · {{item.floorZone}}</view>
          </view>
          <view class="ui-dept-row-side">
            <text class="ui-dept-remain">{{item.remaining}}</text>
            <text class="ui-dept-remain-unit">余号</text>
          </view>
          <view class="appt-pick {{selectedDept && selectedDept.deptId === item.deptId ? 'appt-pick-on' : ''}}">
            {{selectedDept && selectedDept.deptId === item.deptId ? '已选' : '选择'}}
          </view>
        </view>
      </view>

      <view class="appt-actions" wx:if="{{selectedDept}}">
        <button class="ui-btn ui-btn-primary" bindtap="nextStep">下一步 · 选医生</button>
      </view>
    </view>

    <!-- 步骤2：选择医生 -->
    <view class="appt-step" wx:if="{{step === 2}}">
      <view class="ui-title-block">
        <view class="ui-eyebrow ui-eyebrow-gold">STEP 2</view>
        <view class="ui-title">选一位医生</view>
        <view class="ui-subtitle">{{selectedDept.deptName || '本科室'}} · 今日出诊医生</view>
      </view>

      <view class="ui-doctor" wx:for="{{doctors}}" wx:key="doctorId" bindtap="selectDoctor" data-doctor="{{item}}" hover-class="hover-fade">
        <view class="ui-doctor-ava">{{item.avatarText}}</view>
        <view class="ui-doctor-main">
          <view class="ui-doctor-name-row">
            <text class="ui-doctor-name">{{item.name}}</text>
            <text class="ui-doctor-title">{{item.titleText}} · 从业 {{item.years}} 年</text>
          </view>
          <view class="ui-doctor-line1">{{item.expertise || '科室常见病诊疗'}}</view>
          <view class="ui-doctor-flags">
            <view class="ui-tag" wx:for="{{item.flags}}" wx:for-item="flag" wx:key="index">{{flag}}</view>
            <view class="ui-tag ui-tag-danger" wx:if="{{scheduleMap[item.doctorId] === false}}">今日无排班</view>
          </view>
        </view>
        <view class="ui-doctor-side">
          <view class="ui-doctor-fee">¥{{item.consultationFee || 30}}</view>
          <view class="appt-pick {{selectedDoctor && selectedDoctor.doctorId === item.doctorId ? 'appt-pick-on' : ''}}">
            {{selectedDoctor && selectedDoctor.doctorId === item.doctorId ? '已选' : '选择'}}
          </view>
        </view>
      </view>

      <ui-empty
        wx:if="{{doctors.length === 0}}"
        mark="医"
        title="该科室今日暂无医生"
        hint="返回上一步换科室，或稍后再试"
      />

      <view class="appt-actions">
        <button class="ui-btn ui-btn-outline" bindtap="prevStep">上一步</button>
        <button
          class="ui-btn ui-btn-primary"
          wx:if="{{selectedDoctor && (doctorHasSchedule !== false || scheduleDates.length > 0)}}"
          bindtap="nextStep"
        >下一步 · 选时段</button>
      </view>
      <view class="appt-hint" wx:if="{{selectedDoctor && doctorHasSchedule === false && scheduleDates.length === 0}}">
        该医生今日暂无排班，请选择其他医生
      </view>
    </view>

    <!-- 步骤3：问卷 -->
    <view class="appt-step" wx:if="{{step === 3 && currentQuestionnaire}}">
      <view class="ui-title-block">
        <view class="ui-eyebrow ui-eyebrow-gold">可选</view>
        <view class="ui-title">{{currentQuestionnaire.deptName}} · 健康问卷</view>
        <view class="ui-subtitle">均为选填，不影响预约；可直接跳过</view>
      </view>

      <view class="ui-panel">
        <view class="ui-panel-body">
          <view class="appt-question" wx:for="{{pagedQuestions}}" wx:key="id">
            <view class="appt-question-label">{{item.label}}</view>

            <view wx:if="{{item.type === 'radio'}}">
              <radio-group bindchange="onRadioChange" data-questionid="{{item.id}}">
                <label class="appt-choice" wx:for="{{item.options}}" wx:for-item="option" wx:key="*this">
                  <radio value="{{option}}" color="#0F5B50" />
                  <text>{{option}}</text>
                </label>
              </radio-group>
            </view>

            <view wx:elif="{{item.type === 'checkbox'}}">
              <checkbox-group class="{{item.options.length >= 7 ? 'appt-choice-grid' : ''}}" bindchange="onCheckboxChange" data-questionid="{{item.id}}">
                <label class="appt-choice" wx:for="{{item.options}}" wx:for-item="option" wx:key="*this">
                  <checkbox value="{{option}}" color="#0F5B50" />
                  <text>{{option}}</text>
                </label>
              </checkbox-group>
            </view>

            <view wx:elif="{{item.type === 'textarea'}}">
              <textarea class="ui-textarea appt-textarea" placeholder="补充说明（选填）" bindinput="onTextareaInput" data-questionid="{{item.id}}" value="{{questionnaireAnswers[item.id] || ''}}" />
            </view>
          </view>

          <view class="appt-question-page" wx:if="{{questionPageCount > 1}}">
            第 {{questionPageIndex + 1}} / {{questionPageCount}} 题
          </view>
        </view>
      </view>

      <view class="appt-actions">
        <button wx:if="{{questionPageIndex > 0}}" class="ui-btn ui-btn-outline" bindtap="prevQuestionPage">上一题</button>
        <button class="ui-btn ui-btn-outline" bindtap="skipQuestionnaire">跳过问卷</button>
        <button class="ui-btn ui-btn-primary" bindtap="nextQuestionPage">{{questionPageIndex < questionPageCount - 1 ? '下一题' : '下一步'}}</button>
      </view>
      <view class="appt-skip" bindtap="onProgressStepTap" data-step="4">直接选择就诊时段 ›</view>
    </view>

    <!-- 步骤4：选择时间 -->
    <view class="appt-step" wx:if="{{step === 4}}">
      <view class="ui-title-block">
        <view class="ui-eyebrow ui-eyebrow-gold">STEP 3</view>
        <view class="ui-title">选择就诊时段</view>
        <view class="ui-subtitle">{{selectedDoctor.name}} · {{selectedDept.deptName}}</view>
      </view>

      <view class="appt-date-rail" wx:if="{{dateChips.length > 0}}">
        <view
          class="appt-date-chip {{selectedDate === item.date ? 'appt-date-chip-on' : ''}}"
          wx:for="{{dateChips}}"
          wx:key="date"
          bindtap="selectDateChip"
          data-date="{{item.date}}"
        >
          <view class="appt-date-label">{{item.label}}</view>
          <view class="appt-date-day">{{item.day}}</view>
        </view>
      </view>

      <picker wx:else mode="date" value="{{selectedDate}}" start="{{today}}" bindchange="onDateChange">
        <view class="appt-date-picker">
          <view class="appt-date-picker-label">就诊日期</view>
          <view class="appt-date-picker-value">{{selectedDate || '请选择日期'}} <text class="ui-chev">›</text></view>
        </view>
      </picker>

      <view wx:if="{{selectedDate && timeSlots.length === 0}}">
        <ui-empty mark="号" title="该日期暂无可约时段" hint="换个日期看看，或选择其他医生" />
      </view>

      <view class="appt-slot-groups" wx:if="{{timeSlots.length > 0}}">
        <view wx:for="{{slotGroups}}" wx:key="label">
          <view class="ui-group-title">{{item.label}}</view>
          <view class="appt-slot-grid">
            <view
              class="appt-slot {{selectedTime === slot ? 'appt-slot-on' : ''}} {{disabledTimeSlots.indexOf(slot) >= 0 ? 'appt-slot-off' : ''}}"
              wx:for="{{item.slots}}"
              wx:for-item="slot"
              wx:key="*this"
              bindtap="selectTime"
              data-time="{{slot}}"
            >
              <text class="appt-slot-time">{{slot}}</text>
              <text class="appt-slot-state">{{disabledTimeSlots.indexOf(slot) >= 0 ? '已过期' : (selectedTime === slot ? '已选' : '可预约')}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="appt-actions">
        <button class="ui-btn ui-btn-outline" bindtap="prevStep">上一步</button>
        <button class="ui-btn ui-btn-primary" wx:if="{{selectedTime}}" bindtap="nextStep">下一步 · 确认</button>
      </view>
    </view>

    <!-- 步骤5：确认预约 -->
    <view class="appt-step" wx:if="{{step === 5}}">
      <view class="ui-title-block">
        <view class="ui-eyebrow ui-eyebrow-gold">STEP 4</view>
        <view class="ui-title">确认预约信息</view>
        <view class="ui-subtitle">提交后将锁定号源，请在 15 分钟内完成支付</view>
      </view>

      <view class="ui-panel appt-receipt">
        <view class="ui-panel-body ui-panel-body-flush">
          <view class="ui-row"><view class="ui-row-label">医院</view><view class="ui-row-main"></view><view class="ui-row-val">{{currentHospital.hospitalName || hospitalName || '—'}}</view></view>
          <view class="ui-row"><view class="ui-row-label">科室</view><view class="ui-row-main"></view><view class="ui-row-val">{{selectedDept.deptName}}</view></view>
          <view class="ui-row"><view class="ui-row-label">医生</view><view class="ui-row-main"></view><view class="ui-row-val">{{selectedDoctor.name}} · {{selectedDoctor.titleText}}</view></view>
          <view class="ui-row"><view class="ui-row-label">日期</view><view class="ui-row-main"></view><view class="ui-row-val">{{selectedDate}}</view></view>
          <view class="ui-row"><view class="ui-row-label">时段</view><view class="ui-row-main"></view><view class="ui-row-val ui-row-val-gold">{{selectedTime}}</view></view>
        </view>
      </view>

      <view class="appt-fee-line">
        <view class="ui-caption">挂号费</view>
        <view class="ui-row-val-gold">¥{{selectedDoctor.consultationFee || 30}}</view>
      </view>

      <view class="appt-actions">
        <button class="ui-btn ui-btn-outline" bindtap="prevStep">上一步</button>
        <button class="ui-btn ui-btn-primary" bindtap="submitAppointment">确认预约</button>
      </view>
    </view>

    <!-- 步骤6：支付 -->
    <view class="appt-step" wx:if="{{step === 6}}">
      <view class="appt-pay-hero">
        <view class="ui-eyebrow">应付金额</view>
        <view class="appt-pay-amount ui-num">¥{{paymentInfo.fee || (selectedDoctor.consultationFee || 30)}}</view>
        <view class="appt-pay-desc">{{selectedDept.deptName}} · {{selectedDoctor.name}} · {{selectedDate}} {{selectedTime}}</view>
      </view>

      <view class="appt-pay-meta">
        <view class="appt-pay-meta-row"><text>订单编号</text><text>{{paymentInfo.orderNo || '—'}}</text></view>
        <view class="appt-pay-meta-row"><text>就诊医院</text><text>{{currentHospital.hospitalName || hospitalName}}</text></view>
      </view>

      <view class="ui-section-head">
        <text class="ui-section-title">支付方式</text>
      </view>

      <view class="ui-panel">
        <view class="ui-panel-body ui-panel-body-flush">
          <view class="appt-method {{selectedPayment === 'wechat' ? 'appt-method-on' : ''}}" bindtap="selectPayment" data-method="wechat">
            <view class="appt-method-main">
              <view class="ui-row-title">微信支付</view>
              <view class="ui-row-desc">推荐使用，即时到账</view>
            </view>
            <view class="appt-radio {{selectedPayment === 'wechat' ? 'appt-radio-on' : ''}}"></view>
          </view>
          <view class="appt-method {{selectedPayment === 'alipay' ? 'appt-method-on' : ''}}" bindtap="selectPayment" data-method="alipay">
            <view class="appt-method-main">
              <view class="ui-row-title">支付宝</view>
              <view class="ui-row-desc">支持花呗分期</view>
            </view>
            <view class="appt-radio {{selectedPayment === 'alipay' ? 'appt-radio-on' : ''}}"></view>
          </view>
          <view class="appt-method {{selectedPayment === 'card' ? 'appt-method-on' : ''}}" bindtap="selectPayment" data-method="card">
            <view class="appt-method-main">
              <view class="ui-row-title">医保卡</view>
              <view class="ui-row-desc">医保统筹支付</view>
            </view>
            <view class="appt-radio {{selectedPayment === 'card' ? 'appt-radio-on' : ''}}"></view>
          </view>
        </view>
      </view>

      <view class="appt-actions">
        <button class="ui-btn ui-btn-outline" bindtap="prevStep">上一步</button>
        <button class="ui-btn ui-btn-primary" bindtap="doPayment">确认支付</button>
      </view>
    </view>

    <!-- 步骤7：成功 -->
    <view class="appt-step appt-success" wx:if="{{step === 7}}">
      <view class="appt-success-mark">
        <view class="appt-success-check">✓</view>
      </view>
      <view class="ui-eyebrow ui-eyebrow-gold">BOOKING CONFIRMED</view>
      <view class="appt-success-title ui-serif">预约成功</view>
      <view class="appt-success-sub">挂号费已支付，请按预约时段提前 30 分钟到院签到</view>

      <view class="appt-ticket">
        <view class="appt-ticket-top">
          <view class="appt-ticket-hospital">{{currentHospital.hospitalName || hospitalName || '医院'}}</view>
          <view class="ui-pill ui-pill-done">已预约</view>
        </view>
        <view class="appt-ticket-main">
          <view class="appt-ticket-doctor">{{selectedDoctor.name}} <text class="appt-ticket-title">{{selectedDoctor.titleText}}</text></view>
          <view class="appt-ticket-dept">{{selectedDept.deptName}} · {{selectedDate}} {{selectedTime}}</view>
          <view class="appt-ticket-code">
            <view class="ui-micro">预约编号</view>
            <view class="ui-num appt-ticket-id">{{currentAppointment.appointmentId}}</view>
          </view>
        </view>
        <view class="appt-ticket-dash"></view>
        <view class="appt-ticket-foot">
          <view class="appt-ticket-fee">挂号费 ¥{{selectedDoctor.consultationFee || 30}}</view>
          <view class="appt-ticket-tip">请携带身份证或医保卡按时就诊</view>
        </view>
      </view>

      <view class="appt-actions">
        <button class="ui-btn ui-btn-outline" bindtap="goBack">返回首页</button>
        <button class="ui-btn ui-btn-primary" bindtap="viewAppointment">查看预约</button>
      </view>
    </view>

    <view class="appt-bottom"></view>
  </view>
</view>
