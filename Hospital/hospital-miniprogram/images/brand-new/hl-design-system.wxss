/* ============================================================
   健康联防 · 新版设计 Token 与组件规范（v2，切角专业体系）
   适用：hospital-miniprogram 全局 app.wxss / 各页面
   视觉主张：非圆、非大圆角方块；以斜切角、细描边、线性图标、
             克制渐变与留白建立专业医疗质感。
   说明：rpx 为小程序单位；H5/规范页可按 1px = 2rpx 换算。
   ============================================================ */

page {
  /* ---------- 品牌色板（沿用现有青绿体系，收敛为有序层级） ---------- */
  --hl-primary:        #14B8A6;  /* 主色：填充、高亮 */
  --hl-primary-deep:   #0D9488;  /* 深青：导航、主按钮渐变深端 */
  --hl-ink:            #0F766E;  /* 青墨：线性图标、文字强调 */
  --hl-accent:         #5EEAD4;  /* 亮青：小面积点缀、渐变浅端 */
  --hl-soft:           #CCFBF1;  /* 浅青：软底标签 */
  --hl-mist:           #F0FDFA;  /* 雾青：页面底 */
  --hl-line:           #D9F2EF;  /* 描边浅青 */
  --hl-line-soft:      #E6FFFA;  /* 更浅分隔线 */

  --hl-success:        #10B981;
  --hl-warning:        #F59E0B;
  --hl-danger:         #EF4444;
  --hl-info-blue:      #06B6D4;

  --hl-ink-text:       #0F2E2E;  /* 主文字 */
  --hl-text-primary:   #143634;
  --hl-text-secondary: #5B7C7A;
  --hl-text-tertiary:  #94AEAB;

  /* ---------- 形状语言：切角半径（单位 rpx） ----------
     区别于旧版 28rpx 大圆角与圆形；统一采用「直角 + 单侧斜切角」。
     cut  = 斜切角尺寸；radius 仅用于输入框等必须柔和的控件。 */
  --hl-cut-sm:  10rpx;
  --hl-cut-md:  16rpx;
  --hl-cut-lg:  22rpx;
  --hl-radius-control: 14rpx;

  /* ---------- 间距 / 字号 ---------- */
  --hl-space-xs: 8rpx;
  --hl-space-sm: 16rpx;
  --hl-space-md: 24rpx;
  --hl-space-lg: 32rpx;

  --hl-font-xs: 22rpx;
  --hl-font-sm: 26rpx;
  --hl-font-md: 30rpx;
  --hl-font-lg: 34rpx;

  /* ---------- 阴影：克制、偏冷青 ---------- */
  --hl-shadow-card:  0 12rpx 30rpx rgba(13, 148, 136, 0.10);
  --hl-shadow-float: 0 20rpx 44rpx rgba(13, 148, 136, 0.16);
  --hl-shadow-press: 0 4rpx 12rpx rgba(13, 148, 136, 0.10);
}

/* ============================================================
   一、基础卡片（切角面板）
   左上 + 右下斜切角形成方向性，替代圆角方块与圆形托底。
   ============================================================ */
.hl-card {
  background: #FFFFFF;
  border: 1rpx solid var(--hl-line-soft);
  box-shadow: var(--hl-shadow-card);
  /* 斜切角：左上、右下各切去一个三角 */
  clip-path: polygon(
    var(--hl-cut-lg) 0, 100% 0,
    100% calc(100% - var(--hl-cut-lg)),
    calc(100% - var(--hl-cut-lg)) 100%,
    0 100%, 0 var(--hl-cut-lg)
  );
  padding: var(--hl-space-lg);
  margin-bottom: var(--hl-space-md);
}

/* 次级浅色卡片 */
.hl-card--soft {
  background: var(--hl-mist);
  border: 1rpx solid var(--hl-line);
  clip-path: polygon(
    var(--hl-cut-md) 0, 100% 0,
    100% calc(100% - var(--hl-cut-md)),
    calc(100% - var(--hl-cut-md)) 100%,
    0 100%, 0 var(--hl-cut-md)
  );
  padding: var(--hl-space-md);
}

/* ============================================================
   二、章节标题（竖切色条 + 标题，替代旧圆角竖条）
   ============================================================ */
.hl-section-title {
  font-size: var(--hl-font-md);
  font-weight: 700;
  color: var(--hl-text-primary);
  position: relative;
  padding-left: 22rpx;
}
.hl-section-title::before {
  content: '';
  position: absolute;
  left: 0; top: 6rpx; bottom: 6rpx;
  width: 8rpx;
  /* 斜切色条：上下端切角，不做圆头 */
  background: linear-gradient(180deg, var(--hl-primary) 0%, var(--hl-accent) 100%);
  clip-path: polygon(0 0, 100% 0, 100% calc(100% - 10rpx), 0 100%);
}

/* ============================================================
   三、图标容器：切角块面，不用圆形 / 圆角方块托底
   ============================================================ */
.hl-icon-box {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 四角斜切的菱形感块面 */
  clip-path: polygon(
    var(--hl-cut-sm) 0, 100% 0,
    100% calc(100% - var(--hl-cut-sm)),
    calc(100% - var(--hl-cut-sm)) 100%,
    0 100%, 0 var(--hl-cut-sm)
  );
  flex-shrink: 0;
}
.hl-icon-box--primary { background: linear-gradient(145deg, var(--hl-primary) 0%, var(--hl-primary-deep) 100%); }
.hl-icon-box--soft    { background: var(--hl-soft); }
.hl-icon-box--outline { background: #FFFFFF; border: 1rpx solid var(--hl-line); }

.hl-icon-box image { width: 46rpx; height: 46rpx; }

/* ============================================================
   四、按钮体系
   ============================================================ */

/* 主按钮：青绿渐变 + 单侧斜切角，非胶囊 */
.hl-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 36rpx;
  font-size: var(--hl-font-md);
  font-weight: 600;
  letter-spacing: 1rpx;
  border: none;
  box-sizing: border-box;
  clip-path: polygon(
    var(--hl-cut-md) 0, 100% 0,
    100% calc(100% - var(--hl-cut-md)),
    calc(100% - var(--hl-cut-md)) 100%,
    0 100%, 0 var(--hl-cut-md)
  );
}
.hl-btn::after { border: none; }

.hl-btn--primary {
  background: linear-gradient(135deg, var(--hl-primary) 0%, var(--hl-primary-deep) 100%);
  color: #FFFFFF;
  box-shadow: 0 12rpx 26rpx rgba(13, 148, 136, 0.26);
}
.hl-btn--primary:active { box-shadow: var(--hl-shadow-press); transform: translateY(2rpx); }

/* 次要按钮：浅青底 + 深青字 + 细描边 */
.hl-btn--secondary {
  background: var(--hl-soft);
  color: var(--hl-ink);
  border: 1rpx solid var(--hl-line);
}

/* 幽灵按钮：透明底 + 描边 */
.hl-btn--ghost {
  background: transparent;
  color: var(--hl-ink);
  border: 1rpx solid var(--hl-line);
}

/* 危险按钮 */
.hl-btn--danger {
  background: var(--hl-danger);
  color: #FFFFFF;
}

/* 小尺寸操作按钮（列表行内） */
.hl-btn--sm {
  height: 60rpx;
  padding: 0 24rpx;
  font-size: var(--hl-font-sm);
  clip-path: polygon(
    var(--hl-cut-sm) 0, 100% 0,
    100% calc(100% - var(--hl-cut-sm)),
    calc(100% - var(--hl-cut-sm)) 100%,
    0 100%, 0 var(--hl-cut-sm)
  );
}

/* ============================================================
   五、标签 / 徽章
   ============================================================ */
.hl-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  font-size: var(--hl-font-xs);
  font-weight: 600;
  background: var(--hl-soft);
  color: var(--hl-ink);
  clip-path: polygon(6rpx 0, 100% 0, 100% 100%, 0 100%, 0 6rpx);
}
.hl-tag--outline { background: #FFFFFF; border: 1rpx solid var(--hl-line); }
.hl-tag--warning { background: #FEF3E2; color: var(--hl-warning); }
.hl-tag--danger  { background: #FEECEC; color: var(--hl-danger); }

/* ============================================================
   六、表单控件
   ============================================================ */
.hl-input {
  width: 100%;
  height: 80rpx;
  background: var(--hl-mist);
  border: 1rpx solid var(--hl-line);
  border-radius: var(--hl-radius-control);
  padding: 0 24rpx;
  font-size: var(--hl-font-sm);
  color: var(--hl-text-primary);
  box-sizing: border-box;
}
.hl-input:focus {
  border-color: var(--hl-primary-deep);
  background: #FFFFFF;
}

/* 菜单条目（个人中心 / 列表） */
.hl-menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 8rpx;
  border-bottom: 1rpx solid var(--hl-line-soft);
}
.hl-menu-item:last-child { border-bottom: none; }
.hl-menu-item .hl-menu-text { flex: 1; font-size: var(--hl-font-sm); color: var(--hl-text-primary); }
.hl-menu-item .hl-menu-arrow { color: var(--hl-text-tertiary); font-size: 30rpx; }
